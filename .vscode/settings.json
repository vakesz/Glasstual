{
  // Indentation comes from .editorconfig. `make format` runs SwiftFormat on
  // Swift files. Saving does not format Swift, because the Swift extension
  // would use swift-format, which disagrees with .swiftformat.
  "editor.formatOnSave": true,
  // Matches --maxwidth in .swiftformat and line_length in .swiftlint.yml.
  "editor.rulers": [140],
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "files.associations": {
    "*.strings": "ini",
    "*.plist": "xml",
    "*.xib": "xml",
    "*.entitlements": "xml"
  },
  "files.exclude": {
    "**/DerivedData": true,
    "**/build": true,
    "**/.tmp": true,
    "**/*.xcodeproj": true,
    "**/*.xcworkspace": true
  },
  "search.exclude": {
    "**/DerivedData": true,
    "**/build": true
  },
  "[swift]": {
    "editor.formatOnSave": false
  },
  "[shellscript]": {
    "editor.defaultFormatter": "foxundermoon.shell-format"
  },
  "[json]": {
    "editor.defaultFormatter": "vscode.json-language-features"
  },
  "[jsonc]": {
    "editor.defaultFormatter": "vscode.json-language-features"
  },
  "[yaml]": {
    "editor.defaultFormatter": "redhat.vscode-yaml"
  },
  "[markdown]": {
    "editor.formatOnSave": false
  },
  "swift.autoGenerateLaunchConfigurations": false,
  "swift.disableAutoResolve": true,
  // shfmt reads its style from the [*.sh] section of .editorconfig.
  "shellformat.useEditorConfig": true,
  "shellcheck.useWorkspaceRootAsCwd": true,
  "yaml.schemas": {
    "https://json.schemastore.org/github-workflow.json": ".github/workflows/*.yml"
  },
  "git.ignoreLimitWarning": true
}
