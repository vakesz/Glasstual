        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeitüberschreitung der Verbindung"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se ha agotado el tiempo de conexión"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Délai de connexion dépassé"
          }
        },
        "ja": {
