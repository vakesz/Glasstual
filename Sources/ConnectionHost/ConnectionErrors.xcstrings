{
  "sourceLanguage": "en",
  "strings": {
    "certificate-not-trusted": {
      "comment": "Error shown when the user declines a server certificate the system would not trust on its own.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The certificate for this server is not trusted"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A kiszolgáló tanúsítványa nem megbízható"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Zertifikat dieses Servers ist nicht vertrauenswürdig"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "El certificado de este servidor no es confiable"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le certificat de ce serveur n'est pas fiable"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "このサーバーの証明書は信頼されていません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O certificado deste servidor não é confiável"
          }
        }
      }
    },
    "connection-already-open": {
      "comment": "Error reported to the application when it asks the connection host to open a connection that is already open.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A connection is already open on this host"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ezen a gépen már nyitva van egy kapcsolat"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf diesem Host ist bereits eine Verbindung geöffnet"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ya hay una conexión abierta en este host"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Une connexion est déjà ouverte sur cet hôte"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "このホストにはすでに接続が確立されています。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Uma conexão já está aberta neste hospedeiro"
          }
        }
      }
    },
    "connection-timed-out": {
      "comment": "Error shown when an IRC connection attempt exceeds its timeout. Migrated from legacy key Connection timed out.",
      "extractionState": "manual",
