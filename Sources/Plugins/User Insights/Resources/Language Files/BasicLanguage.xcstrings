{
  "sourceLanguage" : "en",
  "strings" : {
    "brag-channel-count" : {
      "comment" : "Opening of the brag response. The argument is the number of channels. Migrated from legacy keys 30l-sx-1 and 30l-sx-2.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : { "stringUnit" : { "state" : "translated", "value" : "I am in %ld channel while connected to " } },
              "other" : { "stringUnit" : { "state" : "translated", "value" : "I am in %ld channels while connected to " } }
            }
          }
        }
      }
    },
