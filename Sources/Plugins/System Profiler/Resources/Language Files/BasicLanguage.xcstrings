      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "; #%1$lu: %2$@"
          }
        }
      }
    },
    "additional-display-with-refresh-rate" : {
      "comment" : "Additional display resolution with a refresh rate for the /screens/ command. Arguments are the display number, resolution, and refresh rate. Migrated from legacy key fys-ft.",
