    "application-bandwidth-statistics" : {
      "comment" : "One-line application bandwidth statistics. Arguments are sent command count, received command count, time since last command, inbound byte count, and outbound byte count. Migrated from legacy key rua-9r.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glasstual has sent \u0002%1$@\u0002 commands since startup with a total of \u0002%2$@\u0002 commands received. The last command received on this connection occurred %3$@ ago. This equals roughly \u0002%4$@ in\u0002 and \u0002%5$@ out\u0002 worth of bandwidth."
          }
        }
      }
    },
    "application-memory-usage" : {
      "comment" : "Application memory summary for the /memory/ command. Arguments are memory use and visible line count. Migrated from legacy key scn-br.",
