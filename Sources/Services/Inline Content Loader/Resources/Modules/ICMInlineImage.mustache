
<span class="inlineImage {{classAttribute}}" id="inlineMedia-{{uniqueIdentifier}}" style="display: none;">
	<span class="closeButton" href="#" data-media-id="{{uniqueIdentifier}}" onclick="_ICMInlineImage.hideOnClickEvent(event);">×</span>

	<a href="{{anchorLink}}" onclick="return InlineImageLiveResize.negateAnchorOpen()">
		<img src="{{imageURL}}" class="content" style="max-width: {{preferredMaximumWidth}}px;" />
	</a>
</span>
