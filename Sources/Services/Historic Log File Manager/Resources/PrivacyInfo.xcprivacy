<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<key>NSPrivacyCollectedDataTypes</key>
	<array/>
	<!-- This service compiles TPCPreferencesUserDefaults and keeps the
	     scrollback database filename in the shared app-group suite.

	     That is the whole list. The app also declares file timestamps, free
	     disk space and system boot time, but those are the app's own: this
	     process talks to Core Data and to the app, and calls no FileManager,
	     no stat, no statfs and no systemUptime. Adding the app's codes here
	     would declare an access that does not happen. -->

	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>CA92.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
