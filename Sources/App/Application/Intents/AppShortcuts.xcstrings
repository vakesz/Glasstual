            "value": "${target} megnyitása a(z) ${applicationName} appban"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "${target} in ${applicationName} öffnen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abrir ${target} en ${applicationName}"
          }
