{
  "sourceLanguage": "en",
  "strings": {
    "Open ${target} in ${applicationName}": {
      "comment": "Siri and Shortcuts phrase that opens a conversation. ${target} is the conversation; ${applicationName} is the app name and must stay in every translation.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open ${target} in ${applicationName}"
          }
        },
        "hu": {
