    "join-channel-description": {
      "comment": "Shortcuts action description.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Joins a channel on a server. The server must be connected or connecting."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Csatlakozik egy csatornához egy szerveren. A szervernek csatlakoztatva kell lennie, vagy a csatlakozás folyamatban kell legyen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Betritt einem Kanal auf einem Server. Der Server muss verbunden sein oder gerade eine Verbindung aufbauen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Se une a un canal en un servidor. El servidor debe estar conectado o conectándose."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Rejoint un salon sur un serveur. Le serveur doit être connecté ou en cours de connexion."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "サーバ上のチャンネルに参加します。サーバが接続済みまたは接続中である必要があります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Entra em um canal em um servidor. O servidor deve estar conectado ou conectando."
          }
        }
      }
    },
