    "send-message-title": {
      "comment": "Shortcuts action title.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Send IRC Message"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "IRC-üzenet küldése"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "IRC-Nachricht senden"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Enviar mensaje IRC"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Envoyer un message IRC"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "IRCメッセージを送信"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Enviar mensagem IRC"
          }
        }
      }
    },
    "send-message-description": {
      "comment": "Shortcuts action description.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sends a message to a channel or person. You confirm the text before it is sent. Text starting with a slash is sent as it is, never run as a command."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Üzenetet küld egy csatornának vagy személynek. Küldés előtt megerősíted a szöveget. A perjellel kezdődő szöveg változtatás nélkül megy el, parancsként soha nem fut le."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sendet eine Nachricht an einen Kanal oder eine Person. Du bestätigst den Text vor dem Senden. Text, der mit einem Schrägstrich beginnt, wird unverändert gesendet und nie als Befehl ausgeführt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Envía un mensaje a un canal o a una persona. Confirmas el texto antes de enviarlo. El texto que empieza con una barra se envía tal cual y nunca se ejecuta como comando."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Envoie un message à un salon ou à une personne. Vous confirmez le texte avant l’envoi. Le texte commençant par une barre oblique est envoyé tel quel, jamais exécuté comme commande."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "チャンネルまたは相手にメッセージを送信します。送信前にテキストを確認します。スラッシュで始まるテキストはそのまま送信され、コマンドとして実行されることはありません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Envia uma mensagem a um canal ou pessoa. Você confirma o texto antes do envio. Texto que começa com uma barra é enviado como está, nunca executado como comando."
          }
        }
      }
    },
    "send-message-confirmation": {
      "comment": "Confirmation before sending. The first %@ is the message, the second the conversation, the third the server.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Send “%@” to %@ on %@?"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@” elküldése ide: %@ (%@)?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ an %@ auf %@ senden?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "¿Enviar «%@» a %@ en %@?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Envoyer « %@ » à %@ sur %@ ?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "「%@」を%@(%@)に送信しますか?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Enviar “%@” para %@ em %@?"
          }
        }
      }
    },
    "send-message-done": {
      "comment": "Result after sending. %@ is the conversation.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Message sent to %@."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Üzenet elküldve ide: %@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nachricht an %@ gesendet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mensaje enviado a %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Message envoyé à %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@にメッセージを送信しました。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mensagem enviada para %@."
          }
        }
      }
    },
