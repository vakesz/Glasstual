{
  "sourceLanguage": "en",
  "strings": {
    "title": {
      "comment": "Title: the name of the Glasstual Focus filter in System Settings.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Glasstual Notifications and Status"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Glasstual értesítések és állapot"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Glasstual-Mitteilungen und Status"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Notificaciones y estado de Glasstual"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Notifications et statut de Glasstual"
          }
        },
