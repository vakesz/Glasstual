{
  "sourceLanguage": "en",
  "strings": {
    "title": {
      "comment": "Title: the name of the Glasstual Focus filter in System Settings.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Glasstual Notifications and Status"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Glasstual értesítések és állapot"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Glasstual-Benachrichtigungen und Status"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Notificaciones y estado de Glasstual"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifications et statut de Glasstual"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Glasstualの通知とステータス"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Notificações e status do Glasstual"
          }
        }
      }
    },
    "summary": {
      "comment": "Summary description of the Focus filter.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Silence Glasstual notifications or set your away status while this Focus is on."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Glasstual értesítések némítása vagy távol állapot beállítása, amíg ez a Fókusz be van kapcsolva."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Benachrichtigungen von Glasstual stummschalten oder den Abwesenheitsstatus setzen, solange dieser Fokus aktiv ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Silencia las notificaciones de Glasstual o establece tu estado de ausencia mientras este modo de concentración está activo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Coupez les notifications de Glasstual ou définissez votre statut d’absence tant que cette Concentration est activée."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この集中モードがオンの間、Glasstualの通知を消音するか、不在ステータスを設定します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Silencie as notificações do Glasstual ou defina seu status como ausente enquanto este Foco estiver ativo."
          }
        }
      }
    },
    "mode": {
      "comment": "Parameter title of the Focus filter: the mode that says what the filter does. Leave it unset to turn the filter off.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Action"
          }
        },
        "hu": {
