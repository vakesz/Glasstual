            "value": "Action"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "動作"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ação"
          }
        }
      }
    },
