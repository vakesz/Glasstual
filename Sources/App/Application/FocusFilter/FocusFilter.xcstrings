        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Notificações e status do Glasstual"
          }
        }
      }
    },
    "summary": {
      "comment": "Summary description of the Focus filter.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Silence Glasstual notifications or set your away status while this Focus is on."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Glasstual értesítések némítása vagy távolléti állapot beállítása, amíg ez a fókusz be van kapcsolva."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Glasstual-Mitteilungen stummschalten oder den Abwesenheitsstatus setzen, solange dieser Fokus aktiv ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Silencia las notificaciones de Glasstual o establece tu estado de ausencia mientras este modo de concentración está activo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Coupez les notifications de Glasstual ou définissez votre statut d’absence tant que ce mode de concentration est activé."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "このフォーカスがオンの間、Glasstualの通知を消音するか、不在ステータスにします。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Silencie as notificações do Glasstual ou defina seu status de ausente enquanto este Foco estiver ativo."
          }
        }
      }
    },
    "mode": {
      "comment": "Parameter title of the Focus filter: the mode that says what the filter does. Leave it unset to turn the filter off.",
