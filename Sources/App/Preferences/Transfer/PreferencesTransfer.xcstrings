    "servers-did-not-disconnect": {
      "comment": "Error shown when an import had to disconnect servers first and at least one of them did not disconnect in time. The import is abandoned and the servers reconnect.",
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some servers did not disconnect in time, so no imported settings were applied. Glasstual is reconnecting the servers it disconnected."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Néhány kiszolgáló kapcsolata nem szakadt meg időben, ezért az importált beállítások nem lettek alkalmazva. A Glasstual újracsatlakozik azokhoz a kiszolgálókhoz, amelyek kapcsolatát bontotta."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einige Server wurden nicht rechtzeitig getrennt. Daher wurden keine importierten Einstellungen angewendet. Glasstual verbindet die zuvor getrennten Server erneut."
          }
        }
      }
    },
