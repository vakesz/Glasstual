{
  "sourceLanguage": "en",
  "strings": {
    "apply-settings-and-add-or-update-servers": {
      "comment": "Import preview. What Merge will do, shown under the mode picker.",
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apply the settings in this file and add or update its servers. Keep other servers and settings. Servers being updated will disconnect. A recovery backup is saved first."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Alkalmazza a fájlban lévő beállításokat, és hozzáadja vagy frissíti a kiszolgálókat. A többi kiszolgáló és beállítás megmarad. A frissített kiszolgálók kapcsolata megszakad. Először helyreállítási mentés készül."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wendet die Einstellungen dieser Datei an und fügt deren Server hinzu oder aktualisiert sie. Andere Server und Einstellungen bleiben erhalten. Aktualisierte Server werden getrennt. Zuerst wird eine Wiederherstellungssicherung erstellt."
          }
        }
      }
    },
    "backups-notice": {
      "comment": "Configuration recovery policy, shown in Settings.",
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The five most recent protected local backups are kept here. They retain connect commands and certificate references so removed servers can be recovered. Keychain passwords and certificate objects are not copied. Folder access is not included."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Itt az öt legutóbbi védett helyi biztonsági mentés marad meg. Megőrzik a kapcsolódási parancsokat és a tanúsítványhivatkozásokat, így az eltávolított kiszolgálók visszaállíthatók. A kulcskarika jelszavai és tanúsítványai nem kerülnek bele. A mappahozzáférési engedélyeket sem tartalmazzák."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die fünf neuesten geschützten lokalen Sicherungen bleiben hier erhalten. Sie enthalten Verbindungsbefehle und Zertifikatsverweise, damit entfernte Server wiederhergestellt werden können. Schlüsselbundpasswörter und Zertifikatsobjekte werden nicht kopiert. Ordnerzugriffsrechte sind nicht enthalten."
          }
        }
      }
    },
    "configuration-changed-after-preview": {
      "comment": "Error shown when the settings or servers changed between preparing a preview and applying it.",
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The current settings changed after this preview was prepared. Cancel and preview the file again. No imported settings were applied."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A jelenlegi beállítások megváltoztak az előnézet elkészítése óta. Szakítsd meg a műveletet, majd nyisd meg újra a fájl előnézetét. Egyetlen importált beállítás sem lett alkalmazva."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die aktuellen Einstellungen wurden seit dem Erstellen dieser Vorschau geändert. Brich ab und öffne die Vorschau erneut. Es wurden keine importierten Einstellungen angewendet."
          }
        }
      }
    },
    "configuration-file-exceeds-size-limit": {
      "comment": "Error shown when a configuration file is larger, or more deeply nested, than the importer accepts.",
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The settings file exceeds the 16 MB size limit or contains too many nested values. No settings were changed."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A beállításfájl meghaladja a 16 MB-os mérethatárt, vagy túl sok egymásba ágyazott értéket tartalmaz. A beállítások nem változtak."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Einstellungsdatei überschreitet das Größenlimit von 16 MB oder enthält zu tief verschachtelte Werte. Es wurden keine Einstellungen geändert."
          }
        }
      }
    },
    "configuration-imported-settings-changed": {
      "comment": "Counts in order: changed preferences, added servers, updated servers, removed servers, ignored keys.",
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Settings imported. Values changed: %1$lld. Servers added: %2$lld; updated: %3$lld; removed: %4$lld. Values not imported: %5$lld. The recovery backup is available in Settings."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A beállítások importálva. Módosított értékek: %1$lld. Hozzáadott kiszolgálók: %2$lld; frissítve: %3$lld; eltávolítva: %4$lld. Nem importált értékek: %5$lld. A helyreállítási mentés a Beállításokban érhető el."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einstellungen importiert. Geänderte Werte: %1$lld. Server hinzugefügt: %2$lld; aktualisiert: %3$lld; entfernt: %4$lld. Nicht importierte Werte: %5$lld. Die Wiederherstellungssicherung ist in den Einstellungen verfügbar."
          }
        }
      }
    },
    "configuration-snapshot-uses-a-newer-format": {
      "comment": "Error shown when a configuration file was written by a newer version of the application.",
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This settings file uses a newer format. Update Glasstual before importing it. No settings were changed."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez a beállításfájl újabb formátumot használ. Importálás előtt frissítsd a Glasstualt. A beállítások nem változtak."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Einstellungsdatei verwendet ein neueres Format. Aktualisiere Glasstual vor dem Import. Es wurden keine Einstellungen geändert."
          }
        }
      }
    },
    "configuration-transfer-complete": {
      "comment": "Title of the alert shown after settings are imported or exported successfully.",
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Settings transfer complete"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Beállítások átvitele befejezve"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einstellungsübertragung abgeschlossen"
          }
        }
      }
    },
    "configuration-transfer-in-progress": {
      "comment": "Error shown when an import or export is started while another one is still running.",
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A settings transfer is already in progress."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Már folyamatban van egy beállításátvitel."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Einstellungsübertragung läuft bereits."
          }
        }
      }
    },
    "configuration-transfer-stopped": {
      "comment": "Title of the alert shown when a settings import or export fails.",
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Settings transfer stopped"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Beállítások átvitele leállt"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einstellungsübertragung gestoppt"
          }
        }
      }
    },
    "connect-commands-warning": {
      "comment": "Warning next to an export option that defaults to off. Commands are copied verbatim if the user opts in.",
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect commands may contain passwords or other private information. Enable this option only if you intend to include every command in the exported file. Keychain passwords and certificate references are never included in portable exports."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A kapcsolódási parancsok jelszavakat vagy más személyes adatokat tartalmazhatnak. Csak akkor kapcsold be ezt a lehetőséget, ha minden parancsot bele szeretnél foglalni az exportált fájlba. A kulcskarika jelszavai és a tanúsítványhivatkozások sosem kerülnek bele a hordozható exportokba."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbindungsbefehle können Passwörter oder andere private Informationen enthalten. Aktiviere diese Option nur, wenn du sämtliche Befehle in die exportierte Datei aufnehmen möchtest. Schlüsselbundpasswörter und Zertifikatsverweise werden nie in portable Exporte aufgenommen."
          }
        }
      }
    },
    "enter-a-valid-whole-number": {
      "comment": "Validation note under a Settings number field that was given something that is not a whole number.",
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter a valid whole number. The saved value has not changed."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Adj meg érvényes egész számot. A mentett érték nem változott."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib eine gültige ganze Zahl ein. Der gespeicherte Wert wurde nicht geändert."
          }
        }
      }
    },
    "export-configuration": {
      "comment": "Settings button that exports settings to a file. The ellipsis marks a button that opens a dialog, so keep it.",
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Export Settings…"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Beállítások exportálása…"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einstellungen exportieren…"
          }
        }
      }
    },
    "export-options": {
      "comment": "Title of the sheet that asks what an exported settings file should include.",
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Export Settings"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Beállítások exportálása"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einstellungen exportieren"
          }
        }
      }
    },
    "export-succeeded": {
      "comment": "Confirmation shown after a configuration file has been written.",
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your settings were exported successfully."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A beállítások exportálása sikerült."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Einstellungen wurden erfolgreich exportiert."
          }
        }
      }
    },
    "file-is-not-a-valid-configuration-snapshot": {
      "comment": "Error shown when the chosen file is not a configuration this application wrote.",
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This file is not a settings file that Glasstual wrote. No settings were changed."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ezt a beállításfájlt nem a Glasstual hozta létre. A beállítások nem változtak."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Datei ist keine von Glasstual erstellte Einstellungsdatei. Es wurden keine Einstellungen geändert."
          }
        }
      }
    },
    "import-configuration": {
      "comment": "Settings button that imports settings from a file. The ellipsis marks a button that opens a dialog, so keep it.",
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Import Settings…"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Beállítások importálása…"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einstellungen importieren…"
          }
        }
      }
    },
    "include-connect-commands": {
      "comment": "Export option. Checkbox that puts each server's connect commands into the exported file.",
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Include connect commands"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapcsolódási parancsok belefoglalása"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbindungsbefehle einschließen"
          }
        }
      }
    },
    "invalid-value": {
      "comment": "Error shown when an imported file fails the validation a setting declares for itself.",
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This file holds an invalid value, or values that conflict. No settings were changed."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A fájl érvénytelen vagy egymásnak ellentmondó értékeket tartalmaz. A beállítások nem változtak."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Datei enthält einen ungültigen Wert oder widersprüchliche Werte. Es wurden keine Einstellungen geändert."
          }
        }
      }
    },
    "keys-not-imported": {
      "comment": "Number of unknown or machine-local settings that were not imported. %lld is the count.",
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Settings not imported: %lld"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nem importált beállítások: %lld"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht importierte Einstellungen: %lld"
          }
        }
      }
    },
    "legacy-notice": {
      "comment": "Import preview. Note shown for an older, partial configuration file, which can only be merged.",
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This legacy file contains only selected settings. It can be merged, but cannot be used to restore a complete configuration."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez a régi fájl csak néhány beállítást tartalmaz. Összevonható a jelenlegi beállításokkal, de teljes konfiguráció visszaállítására nem használható."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese ältere Datei enthält nur ausgewählte Einstellungen. Sie kann zusammengeführt werden, aber keine vollständige Konfiguration wiederherstellen."
          }
        }
      }
    },
    "local-recovery-notice": {
      "comment": "Import preview. What a protected local backup restores that a portable file cannot.",
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This protected local backup restores original connect commands and certificate references, including for removed servers. Keychain objects stay on this Mac and are not imported. Recovered servers do not connect automatically."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez a védett helyi biztonsági mentés visszaállítja az eredeti kapcsolódási parancsokat és tanúsítványhivatkozásokat, az eltávolított kiszolgálókét is. A kulcskarika elemei ezen a Macen maradnak, és nem lesznek importálva. A visszaállított kiszolgálókhoz nem kapcsolódunk automatikusan."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese geschützte lokale Sicherung stellt ursprüngliche Verbindungsbefehle und Zertifikatsverweise wieder her, auch für entfernte Server. Schlüsselbundobjekte bleiben auf diesem Mac und werden nicht importiert. Wiederhergestellte Server verbinden sich nicht automatisch."
          }
        }
      }
    },
    "merge": {
      "comment": "Import mode, and the button that applies it: add to the current configuration.",
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Merge"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Összevonás"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zusammenführen"
          }
        }
      }
    },
    "mode": {
      "comment": "Label of the picker that chooses between merging and restoring an imported configuration.",
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Import mode"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Importálási mód"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Importmodus"
          }
        }
      }
    },
    "passwords-and-certificates-stay-on-this-mac": {
      "comment": "Import preview. What a portable configuration file does and does not carry.",
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keychain passwords and certificate references are not imported from portable files. Included connect commands replace current commands; omitted commands are kept. Included commands may contain passwords. Imported servers do not connect automatically."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A kulcskarika jelszavai és a tanúsítványhivatkozások nem importálhatók hordozható fájlokból. A fájlban szereplő kapcsolódási parancsok lecserélik a jelenlegieket; a hiányzók megmaradnak. A parancsok jelszavakat is tartalmazhatnak. Az importált kiszolgálókhoz nem kapcsolódunk automatikusan."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schlüsselbundpasswörter und Zertifikatsverweise werden nicht aus portablen Dateien importiert. Enthaltene Verbindungsbefehle ersetzen die aktuellen; fehlende bleiben erhalten. Enthaltene Befehle können Passwörter enthalten. Importierte Server verbinden sich nicht automatisch."
          }
        }
      }
    },
    "preferences-changed": {
      "comment": "%lld is the number of preference keys that will change.",
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Settings to change: %lld"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Módosítandó beállítások: %lld"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zu ändernde Einstellungen: %lld"
          }
        }
      }
    },
    "preview-backup": {
      "comment": "Button that shows what restoring one protected local backup would change.",
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Preview Recovery"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Helyreállítás előnézete"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiederherstellungsvorschau"
          }
        }
      }
    },
    "preview-title": {
      "comment": "Title of the sheet that shows what importing a settings file would change.",
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Preview Settings Import"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Beállításimportálás előnézete"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vorschau des Einstellungsimports"
          }
        }
      }
    },
    "restore": {
      "comment": "Import mode, and the button that applies it: replace the current configuration.",
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restore"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Visszaállítás"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiederherstellen"
          }
        }
      }
    },
    "restore-notice": {
      "comment": "Import preview. What Restore will do, shown under the mode picker.",
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Replace portable settings and remove servers missing from this snapshot. Changed or removed servers will disconnect. Restore proceeds only after a recovery backup has been saved."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Lecseréli a hordozható beállításokat, és eltávolítja a pillanatképből hiányzó kiszolgálókat. A módosított vagy eltávolított kiszolgálók kapcsolata megszakad. A visszaállítás csak helyreállítási mentés készítése után folytatódik."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ersetzt portable Einstellungen und entfernt Server, die in diesem Stand fehlen. Geänderte oder entfernte Server werden getrennt. Die Wiederherstellung erfolgt erst nach dem Sichern einer Wiederherstellungskopie."
          }
        }
      }
    },
    "review-before-importing": {
      "comment": "Import preview. Heading of the block listing changes that can send commands or widen what Glasstual trusts.",
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Review Before Importing"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ellenőrzés importálás előtt"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vor dem Import prüfen"
          }
        }
      }
    },
    "risky-changes-notice": {
      "comment": "Import preview. Explains the block that lists changes which can send commands or widen what Glasstual trusts.",
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This file changes settings that can send commands to servers or change what Glasstual trusts. Read each one before importing."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez a fájl olyan beállításokat módosít, amelyek parancsokat küldhetnek a kiszolgálóknak, vagy megváltoztathatják, miben bízik meg a Glasstual. Importálás előtt olvasd el mindegyiket."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Datei ändert Einstellungen, die Befehle an Server senden oder beeinflussen können, welchen Inhalten Glasstual vertraut. Lies jeden Eintrag vor dem Import."
          }
        }
      }
    },
    "risky-chat-filter-action": {
      "comment": "Import preview. A chat filter the file adds or changes that runs commands. The first argument is the filter's title, the second is its action text, which can span several lines.",
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Chat filter “%1$@” runs:\n%2$@"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A(z) \"%1$@\" csevegésszűrő ezt futtatja:\n%2$@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Chatfilter \"%1$@\" führt aus:\n%2$@"
          }
        }
      }
    },
    "risky-connect-commands": {
      "comment": "Import preview. Commands a server in the file sends each time it connects. The first argument is the server's name, the second is its commands, one per line.",
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Server “%1$@” sends when it connects:\n%2$@"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A(z) \"%1$@\" kiszolgáló kapcsolódáskor ezt küldi:\n%2$@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Server \"%1$@\" sendet beim Verbinden:\n%2$@"
          }
        }
      }
    },
    "risky-ctcp-version-reply": {
      "comment": "Import preview. The file changes the reply sent to CTCP VERSION requests. The argument is that reply.",
      "extractionState": "manual",
