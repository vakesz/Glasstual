      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add Server"
          }
        }
      }
    },
    "connect-securely" : {
      "comment" : "Column heading and accessibility label for the TLS toggle in the alternate-server list.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Secure"
          }
        }
      }
    },
    "enter-a-whole-number-between-1" : {
      "comment" : "Validation message shown under the list when a row has no properly formatted server port. Legacy key: ox2-od.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enter a whole number between 1 and 65,535."
          }
        }
      }
    },
    "explanation" : {
      "comment" : "Explains that alternate servers are tried in the displayed order.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glasstual tries these servers from top to bottom. Use the arrow buttons to change their order; the first server is primary."
          }
        }
      }
    },
    "move-down" : {
      "comment" : "Accessibility label and help for moving the selected server endpoint down.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Move Down"
          }
        }
      }
    },
    "move-up" : {
