{
  "sourceLanguage": "en",
  "strings": {
	"search-placeholder": {
	  "comment": "Placeholder in the Settings sidebar search field. Search matches localized pane titles and setting labels.",
	  "extractionState": "manual",
	  "localizations": {
	    "en": { "stringUnit": { "state": "translated", "value": "Search Settings" } }
	  }
	},
    "accessibility-label-settings": {
      "comment": "Accessibility label for the Settings sidebar. Legacy key: sb-tt.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Settings"
          }
        }
      }
    },
    "add-ons": {
      "comment": "Title of the Add-ons group in the Settings sidebar. Legacy key: sb-gr-ad.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add-ons"
          }
        }
      }
    },
    "addons-commands-heading": {
      "comment": "Header of the Add-ons pane section that lists the commands add-ons provide.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Custom Commands"
          }
        }
      }
    },
    "addons-commands-list": {
      "comment": "Accessibility label for the list of commands installed add-ons provide.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Installed Add-ons"
          }
        }
      }
    },
    "addons-commands-note": {
      "comment": "Explanation below the list of add-on commands.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The commands listed above are performed like any other: write a forward slash (/) followed by the name of the command plus any required arguments. Glasstual will perform the command and output the results accordingly."
          }
        }
      }
    },
    "addons-folder-heading": {
      "comment": "Header of the Add-ons pane section that holds the folder commands. Legacy key: addons-location-label.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add-ons Folder"
          }
        }
      }
    },
    "addons-install-note": {
      "comment": "Footer of the Add-ons folder section. %@ is the folder name, which is the application bundle identifier.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To install an add-on, put it in [home folder] › Library › Application Scripts › %@. Create this folder if it does not exist."
          }
        }
      }
    },
    "addons-open-in-finder": {
      "comment": "Button that reveals the custom add-ons folder.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open in Finder"
          }
        }
      }
    },
    "addons-open-in-finder-help": {
      "comment": "Accessibility label for the button revealing the custom add-ons folder.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open the Add-ons folder in Finder"
          }
        }
      }
    },
    "channel-management": {
      "comment": "Title of the Channel Management pane in the Settings sidebar. Legacy key: sb-channelManagement.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Channel Management"
          }
        }
      }
    },
    "channel-management-ban-format-exact": {
      "comment": "Ban format matching the exact hostmask.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "nickname!username@address"
          }
        }
      }
    },
    "channel-management-ban-format-label": {
      "comment": "Label of the popup choosing the default hostmask ban format.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hostmask ban format"
          }
        }
      }
    },
    "channel-management-ban-format-note": {
      "comment": "Explanation below the hostmask ban format popup.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When used in the context of a hostmask, an asterisk (*) represents a wildcard character that is matched by any possible value."
          }
        }
      }
    },
    "channel-management-ban-format-whainn": {
      "comment": "Ban format matching every nickname for one user name at one address.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "*!ident@address"
          }
        }
      }
    },
    "channel-management-ban-format-whanni": {
      "comment": "Ban format matching one nickname at one address.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "nickname!*@address"
          }
        }
      }
    },
    "channel-management-ban-format-whnin": {
      "comment": "Ban format matching every nickname and user name at one address.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "*!*@address"
          }
        }
      }
    },
    "channel-management-kick-reason-label": {
