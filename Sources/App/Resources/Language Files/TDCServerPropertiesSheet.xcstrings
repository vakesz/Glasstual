      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Edit Highlight"
          }
        }
      }
    },
    "remove-highlight-button": {
      "comment": "Help tag and accessibility label for the button that removes the selected highlight rule.",
