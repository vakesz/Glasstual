      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove Entry"
          }
        }
      }
    },
    "reload-button": {
      "comment": "Button that reloads the connection's configuration, discarding unsaved edits in the sheet.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reload"
          }
        }
      }
    },
    "add-user-ignore-entry": {
      "comment": "Menu item that adds an Address Book entry which ignores a user.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add User Ignore Entry…"
          }
        }
      }
    },
    "add-user-tracking-entry": {
      "comment": "Menu item that adds an Address Book entry which tracks a user.",
