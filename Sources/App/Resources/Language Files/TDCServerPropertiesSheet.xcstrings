      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove Highlight"
          }
        }
      }
    },
    "add-address-book-entry-button": {
      "comment": "Help tag and accessibility label for the menu button that adds an Address Book entry.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add Entry"
          }
        }
      }
    },
    "edit-address-book-entry-button": {
      "comment": "Help tag and accessibility label for the button that edits the selected Address Book entry.",
