      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copy NickServ Command"
          }
        }
      }
    },
    "copy-nickserv-command-for": {
      "comment": "Help tag and accessibility label for the button beside one certificate fingerprint. The placeholder names the digest, such as “SHA-256 Fingerprint”.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copy NickServ Command for %@"
          }
        }
      }
    },
    "certificate-fingerprint-help": {
      "comment": "Explanation under the certificate fingerprints, saying what the copied command is for.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The command tells NickServ to recognise you by this certificate. Send it once you are identified."
          }
        }
      }
