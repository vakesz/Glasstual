      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Disconnect when no PING response is received"
          }
        }
      }
    },
    "disconnect-on-reachability-change": {
      "comment": "Toggle that disconnects when the network reachability changes.",
