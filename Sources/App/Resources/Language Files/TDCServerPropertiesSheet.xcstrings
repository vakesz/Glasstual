      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Disconnect when reachability changes"
          }
        }
      }
    },
    "disconnect-on-sasl-failure": {
      "comment": "Toggle for disconnecting when SASL authentication is rejected.",
