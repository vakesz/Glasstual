      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add Highlight"
          }
        }
      }
    },
    "edit-highlight-button": {
      "comment": "Help tag and accessibility label for the button that edits the selected highlight rule.",
