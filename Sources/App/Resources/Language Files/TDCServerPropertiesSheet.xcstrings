    "alternative-nicknames": {
      "comment": "Field label for the space separated fallback nicknames.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Alternative Nicknames"
          }
        }
      }
    },
    "autojoin-delay-after-connect-commands": {
      "comment": "Server properties Connect Commands pane. Stepper that sets how long the autojoin pauses after the commands were sent. The argument is the number of seconds.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Wait %ld second after these commands before joining"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Wait %ld seconds after these commands before joining"
                }
              }
            }
          }
        }
      }
    },
    "autojoin-waits-for-connect-commands": {
      "comment": "Server properties Connect Commands pane. Checkbox that holds the autojoin back until the commands above have been sent.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Join channels only after these commands have run"
          }
        }
      }
    },
    "autojoin-waits-for-nickserv": {
      "comment": "Toggle that delays autojoin until NickServ identification succeeds.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wait for identification before joining channels"
          }
        }
      }
    },
    "away-nickname": {
      "comment": "Field label for the nickname used while marked away.",
