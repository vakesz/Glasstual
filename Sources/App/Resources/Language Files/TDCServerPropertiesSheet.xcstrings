{
  "sourceLanguage": "en",
  "strings": {
    "add-channel-button": {
      "comment": "Help tag and accessibility label for the button that adds a channel to the server's channel list.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add Channel"
          }
        }
      }
    },
    "edit-channel-button": {
      "comment": "Help tag and accessibility label for the button that edits the selected channel.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Edit Channel"
          }
        }
      }
    },
    "remove-channel-button": {
      "comment": "Help tag and accessibility label for the button that removes the selected channel.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove Channel"
          }
        }
      }
    },
    "add-highlight-button": {
      "comment": "Help tag and accessibility label for the button that adds a highlight rule.",
