    "address-type-automatic": {
      "comment": "Address family option that lets the system pick between IPv4 and IPv6.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatically choose"
          }
        }
      }
    },
    "address-type-ipv4": {
      "comment": "Address family option that pins the connection to IPv4.",
