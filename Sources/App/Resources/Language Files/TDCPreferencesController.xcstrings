    "flood-control-who-limit-note": {
      "comment": "Explanation below the WHO command channel size slider.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Glasstual must periodically poll the channels that you are in to find out when the away status of each user changes. This preference defines the maximum number of users a channel can contain before the channel is skipped over.\n\nA lower value is always better especially when in a large number of channels."
          }
        }
      }
    },
