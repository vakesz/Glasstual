{
  "sourceLanguage": "en",
  "strings": {
    "70s-c6": {
      "comment": "Placeholder when no transcript log folder is selected.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No Log Location Selected"
          }
        }
      }
    },
    "721-ie": {
      "comment": "Placeholder when no file-transfer download folder is selected.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No Location Selected"
          }
        }
      }
    },
    "5jv-aw": {
      "comment": "Title of the alert shown before opening a bundled style's source files.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Are you opening this style because you are interested in modifying it?"
          }
        }
      }
    },
    "ojj-ap": {
      "comment": "Body of the alert explaining how to customize a bundled style without editing its source files.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It’s possible to modify the appearance of this style without editing its source files.\n\nClick “Edit Style” to add your own style sheet rules. This feature can also be found in the Developers section of Preferences."
          }
        }
      }
    },
    "aib-iy": {
      "comment": "Button that opens the user's style override for editing.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Edit Style"
          }
        }
      }
    },
    "dj8-1t": {
      "comment": "Button that creates an editable copy of a bundled style.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create Copy"
          }
        }
      }
    },
    "6ws-av": {
      "comment": "Button that opens a bundled style's source files.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "View Files"
          }
        }
      }
    },
    "uc0-z7": {
      "comment": "Title of the alert describing preferences overridden by the selected style.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Preferred Selection"
          }
        }
      }
    },
    "q4o-2f": {
      "comment": "Alert body describing preferences overridden by a style. Arguments are the style name and a newline-separated preference list.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The style named “%1$@” has chosen to override the following preferences with ones that it prefers for the best viewing experience:\n\n%2$@"
          }
        }
      }
    },
    "77t-de": {
      "comment": "List item naming the nickname format preference overridden by a style.",
      "extractionState": "manual",
      "localizations": {
