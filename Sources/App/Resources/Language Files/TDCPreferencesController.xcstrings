    "channel-management": {
      "comment": "Title of the Channel Management pane in the Settings sidebar. Legacy key: sb-channelManagement.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Channel Management"
          }
        }
      }
    },
    "channel-management-ban-format-exact": {
      "comment": "Ban format matching the exact hostmask.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "nickname!username@address"
          }
        }
      }
    },
    "channel-management-ban-format-label": {
      "comment": "Label of the popup choosing the default hostmask ban format.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hostmask Ban Format:"
          }
        }
      }
    },
    "channel-management-ban-format-note": {
      "comment": "Explanation below the hostmask ban format popup.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When used in the context of a hostmask, an asterisk (*) represents a wildcard character that is matched by any possible value."
          }
        }
      }
    },
    "channel-management-ban-format-whainn": {
      "comment": "Ban format matching every nickname for one user name at one address.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "*!ident@address"
          }
        }
      }
    },
    "channel-management-ban-format-whanni": {
      "comment": "Ban format matching one nickname at one address.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "nickname!*@address"
          }
        }
      }
    },
    "channel-management-ban-format-whnin": {
      "comment": "Ban format matching every nickname and user name at one address.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "*!*@address"
          }
        }
      }
    },
    "channel-management-kick-reason-label": {
      "comment": "Label of the default kick reason field.",
