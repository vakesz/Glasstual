    "flood-control-note": {
      "comment": "Flood-control explanation below the channel join delay sliders.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Joining too many channels at once may be detected as an attack by some IRC networks. You could be disconnected or banned as a result. It is recommended to use a moderate delay (~2.5 seconds) for both timers when joining a large number of channels."
          }
        }
      }
    },
    "flood-control-seconds-value": {
