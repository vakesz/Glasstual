      "comment": "Explanation below the typing notifications checkbox in the Behavior pane.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lets other people in a channel or query see when you are writing a message."
