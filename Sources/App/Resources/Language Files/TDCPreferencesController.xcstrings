{
  "sourceLanguage": "en",
  "strings": {
    "accessibility-label-settings": {
      "comment": "Accessibility label for the Settings sidebar. Legacy key: sb-tt.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Settings"
          }
        }
      }
    },
    "accessibility-label-style": {
      "comment": "Accessibility label for the style selection control. Legacy key: ax-theme.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Style"
          }
        }
      }
    },
    "add-ons": {
      "comment": "Title of the Add-ons group in the Settings sidebar. Legacy key: sb-gr-ad.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add-ons"
          }
        }
      }
    },
    "addons-commands-label": {
      "comment": "Label above the list of commands installed add-ons provide.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The following custom commands are available:"
          }
        }
      }
    },
    "addons-commands-list": {
      "comment": "Accessibility label for the list of commands installed add-ons provide.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Installed Addons"
          }
        }
      }
    },
    "addons-commands-note": {
      "comment": "Explanation below the list of add-on commands.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The commands listed above are performed like any other: write a forward slash (/) followed by the name of the command plus any required arguments. Glasstual will perform the command and output the results accordingly."
          }
        }
      }
    },
    "addons-location-label": {
      "comment": "Label before the button that reveals the custom add-ons folder.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Custom Addons Location:"
          }
        }
      }
    },
    "addons-open-in-finder": {
      "comment": "Button that reveals the custom add-ons folder.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open In Finder"
          }
        }
      }
    },
    "addons-open-in-finder-help": {
      "comment": "Accessibility label for the button revealing the custom add-ons folder.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Custom Addons Location in Finder"
          }
        }
      }
    },
    "are-you-opening-this-style-because": {
      "comment": "Title of the alert shown before opening a bundled style's source files. Legacy key: 5jv-aw.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Are you opening this style because you are interested in modifying it?"
          }
        }
      }
    },
    "behavior-autojoin-on-invite": {
      "comment": "Checkbox in the Behavior pane.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatically join a channel when invited"
          }
        }
      }
    },
    "behavior-away-on-screen-sleep": {
      "comment": "Checkbox in the Behavior pane.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Toggle away status when your display goes to sleep"
          }
