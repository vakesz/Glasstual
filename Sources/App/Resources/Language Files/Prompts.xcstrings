    "plugin-has-not-been-loaded-before": {
      "comment": "Legacy key: b4n-8z.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The plugin “%1$@” has not been loaded before.\n\nBundle identifier: %2$@\nTeam ID: %3$@\nLocation: %4$@\n\nPlugins run with the same access as Glasstual itself. Only load plugins from developers you trust. This choice is remembered until the plugin is signed by a different Team ID or the approvals are reset in Settings > Addons."
          }
        }
      }
    },
    "plugins-installed-outside-of-glasstual-must": {
      "comment": "Legacy key: t8y-4p.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Plugins installed outside of Glasstual must be signed with a valid Developer ID or Apple-issued certificate. The listed addons are unsigned, ad-hoc signed, or their signature is damaged, so they were not loaded.\n\nContact the developer of each addon for a signed copy."
          }
        }
      }
    },
