    "t8y-4p": {
      "comment": "Migrated from legacy key t8y-4p. Preserve the original English wording and printf placeholder contract.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Plugins installed outside of Glasstual must be signed with a valid Developer ID or Apple-issued certificate. The listed addons are unsigned, ad-hoc signed, or their signature is damaged, so they were not loaded.\n\nContact the developer of each addon for a signed copy."
          }
        }
      }
    },
    "qy4-5o": {
      "comment": "Migrated from legacy key qy4-5o. Preserve the original English wording and printf placeholder contract.",
