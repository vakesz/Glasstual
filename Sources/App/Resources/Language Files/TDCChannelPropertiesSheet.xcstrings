{
  "sourceLanguage": "en",
  "strings": {
    "please-enter-a-properly-formatted-channel": {
      "comment": "Validation error shown when the channel name is not properly formatted. Legacy key: 1nd-7x.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Please enter a properly formatted channel name."
          }
        }
      }
    },
    "this-channels-configuration-has-changed-do": {
      "comment": "Title of the alert shown when the edited channel configuration changed outside the sheet. Legacy key: mvl-r5.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This channel's configuration has changed. Do you want to reload the Channel Properties dialog?"
          }
        }
      }
    },
    "you-will-loose-unsaved-changes-if": {
      "comment": "Alert body warning that reloading the externally changed channel configuration discards unsaved edits. The original wording is preserved for translation parity. Legacy key: qby-hi.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You will loose unsaved changes if you click “Yes”"
          }
        }
      }
    }
  },
  "version": "1.0"
}

