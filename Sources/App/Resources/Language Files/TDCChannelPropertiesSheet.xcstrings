{
  "sourceLanguage": "en",
  "strings": {
    "channel-properties-window-title": {
      "comment": "Title of the channel properties sheet, shown as its heading.",
      "extractionState": "manual",
      "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Channel Properties" } } }
    },
    "reload-button": {
      "comment": "Button that reloads the channel's configuration from the connection, discarding unsaved edits in the sheet.",
      "extractionState": "manual",
      "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Reload" } } }
    },
    "defaults": {
      "comment": "Title of the default channel values pane.",
      "extractionState": "manual",
      "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Defaults" } } }
    },
    "defaults-help": {
      "comment": "Explanation under the default topic and modes fields.",
      "extractionState": "manual",
      "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Applied when you are the first person to join the channel." } } }
    },
    "disable-general-event-messages": {
      "comment": "Channel option to suppress general event messages.",
      "extractionState": "manual",
      "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Disable general event messages" } } }
    },
    "disable-highlights": {
      "comment": "Channel option to disable highlights.",
      "extractionState": "manual",
      "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Disable highlights" } } }
    },
    "disable-inline-media": {
      "comment": "Channel option to disable inline media.",
      "extractionState": "manual",
      "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Disable inline media" } } }
    },
    "general": {
      "comment": "Title of the general channel properties pane.",
      "extractionState": "manual",
      "localizations": { "en": { "stringUnit": { "state": "translated", "value": "General" } } }
    },
    "join-on-connect": {
      "comment": "Channel option to join when the server connects.",
      "extractionState": "manual",
      "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Join on connect" } } }
    },
    "label-help": {
      "comment": "Explanation of the optional channel label.",
      "extractionState": "manual",
      "localizations": { "en": { "stringUnit": { "state": "translated", "value": "When you give a channel a label, that label will appear in the Server List in lieu of the channel name." } } }
    },
    "label-label": {
      "comment": "Label for the channel label field.",
      "extractionState": "manual",
      "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Label" } } }
    },
    "modes-label": {
      "comment": "Label for the default channel modes field.",
      "extractionState": "manual",
      "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Modes" } } }
    },
    "name-label": {
      "comment": "Label for the channel name field.",
      "extractionState": "manual",
      "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Name" } } }
    },
    "notifications": {
      "comment": "Title of the channel notification overrides pane.",
      "extractionState": "manual",
      "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Notifications" } } }
    },
    "optional": {
      "comment": "Placeholder for an optional channel property.",
      "extractionState": "manual",
      "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Optional" } } }
    },
    "password-label": {
      "comment": "Label for the channel password field.",
      "extractionState": "manual",
      "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Password" } } }
    },
    "show-inline-media": {
      "comment": "Channel option to force inline media on.",
      "extractionState": "manual",
      "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Show inline media" } } }
    },
    "show-notifications-for-channel": {
      "comment": "Channel option to enable channel notifications.",
      "extractionState": "manual",
      "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Show notifications for channel" } } }
    },
    "show-unread-count-in-channel-list": {
      "comment": "Channel option to show its unread count in the channel list.",
      "extractionState": "manual",
      "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Show unread count in channel list" } } }
    },
    "topic-label": {
      "comment": "Label for the default channel topic field.",
      "extractionState": "manual",
      "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Topic" } } }
    },
    "please-enter-a-properly-formatted-channel": {
      "comment": "Validation error shown when the channel name is not properly formatted. Legacy key: 1nd-7x.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter a channel name beginning with a channel prefix, such as #example."
          }
        }
      }
    },
    "this-channels-configuration-has-changed-do": {
      "comment": "Title of the alert shown when the edited channel configuration changed outside the sheet. Legacy key: mvl-r5.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reload the channel’s settings?"
          }
        }
      }
    },
    "you-will-loose-unsaved-changes-if": {
      "comment": "Alert body warning that reloading the externally changed channel configuration discards unsaved edits. Legacy key: qby-hi.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your unsaved changes will be discarded."
          }
        }
      }
    },
    "channel-name-placeholder": {
      "comment": "Placeholder showing the shape of a channel name.",
      "extractionState": "manual",
      "localizations": { "en": { "stringUnit": { "state": "translated", "value": "#example" } } }
    },
    "section-picker-label": {
      "comment": "Accessibility label for the segmented picker that chooses a channel properties pane.",
      "extractionState": "manual",
      "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Section" } } }
    },
    "password-help": {
      "comment": "Explanation under the channel password field.",
      "extractionState": "manual",
      "localizations": { "en": { "stringUnit": { "state": "translated", "value": "The channel’s key, sent when joining. Stored in your keychain." } } }
    },
    "secret-key-length": {
      "comment": "Counter under the channel secret key field, saying how much of the length the server accepts is used. The first argument is how many UTF-8 bytes the submitted key token uses and the second is the maximum.",
      "extractionState": "manual",
      "localizations": { "en": { "stringUnit": { "state": "translated", "value": "%1$ld of %2$ld bytes" } } }
    },
    "secret-key-too-long": {
      "comment": "Warning under the channel secret key field once the key is too long for the server. The first argument is the network name and the second is the maximum number of UTF-8 bytes.",
      "extractionState": "manual",
      "localizations": { "en": { "stringUnit": { "state": "translated", "value": "%1$@ accepts at most %2$ld bytes. Anything past that may be cut off." } } }
    }
  },
  "version": "1.0"
}
