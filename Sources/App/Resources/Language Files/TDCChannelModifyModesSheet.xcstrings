      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No external channel messages (+n)"
          }
        }
      }
    },
    "operator-topic-mode" : {
      "comment" : "Title of the checkbox for IRC operator-only topic mode +t. Migrated from the legacy XIB.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only operators can change topic (+t)"
