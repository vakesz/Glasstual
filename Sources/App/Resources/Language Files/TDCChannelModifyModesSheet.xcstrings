        }
      }
    },
    "private-channel-mode" : {
      "comment" : "Title of the checkbox for IRC private-channel mode +p. Migrated from the legacy XIB.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Private channel (+p)"
          }
        }
      }
    },
    "secret-channel-mode" : {
      "comment" : "Title of the checkbox for IRC secret-channel mode +s. Migrated from the legacy XIB.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Secret channel (+s)"
          }
        }
      }
    },
    "user-limit-field-hint" : {
      "comment" : "Accessibility hint for the numeric channel user-limit field.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enter a maximum from 0 through 99999."
          }
        }
      }
    },
    "user-limit-mode" : {
      "comment" : "Title of the checkbox for IRC channel user-limit mode +l. Migrated from the legacy XIB.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Limit number of users (+l)"
          }
        }
      }
    },
    "change-modes-button" : {
      "comment" : "Title of the button that submits the edited channel modes.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Change Modes"
          }
        }
      }
    },
    "channel-key-placeholder" : {
      "comment" : "Placeholder in the empty channel key field.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Channel key"
          }
        }
      }
    },
    "user-limit-placeholder" : {
      "comment" : "Placeholder in the empty channel user-limit field. The range is the one the sheet accepts.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "0–99999"
          }
        }
      }
    },
    "channel-key-characters-over-limit" : {
      "comment" : "Footer below the channel key field once the key is longer than the server accepts. Replaces the warning alert that used to interrupt typing. The Change Modes button stays disabled until the key fits.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "substitutions" : {
            "arg1" : {
              "argNum" : 1,
              "formatSpecifier" : "lld",
              "variations" : {
                "plural" : {
                  "one" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "%arg byte too many"
                    }
                  },
                  "other" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "%arg bytes too many"
                    }
                  }
                }
              }
            }
          },
          "stringUnit" : {
            "state" : "translated",
            "value" : "%#@arg1@"
          }
        }
      }
    }
  },
  "version" : "1.0"
}