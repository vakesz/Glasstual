{
  "sourceLanguage" : "en",
  "strings" : {
    "channel-key-field-hint" : {
      "comment" : "Accessibility hint for the text field containing the IRC channel key.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enter the channel key used by members when joining."
          }
        }
      }
    },
    "channel-key-mode" : {
      "comment" : "Title of the checkbox that enables IRC channel key mode +k. Named for the IRC term rather than “password”, which is what the legacy XIB called it. Migrated from the legacy XIB.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Channel key (+k)"
          }
        }
      }
    },
    "heading" : {
      "comment" : "Heading above the editable channel modes. The argument is the IRC channel name.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modes for %@"
          }
        }
      }
    },
    "invite-only-mode" : {
      "comment" : "Title of the checkbox for IRC invite-only mode +i. Migrated from the legacy XIB.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Invite-only channel (+i)"
          }
        }
      }
    },
    "moderated-mode" : {
      "comment" : "Title of the checkbox for IRC moderated mode +m. Migrated from the legacy XIB.",
