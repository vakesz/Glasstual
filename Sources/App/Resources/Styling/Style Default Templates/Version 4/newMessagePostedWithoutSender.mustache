
{{#showDateIndicator}}
	{{> dateIndicator}}
{{/showDateIndicator}}

<div
	class="line {{lineClassAttribute}}"
	id="line-{{lineNumber}}"

	data-command="{{command}}"
	data-line-type="{{lineType}}"

{{^ isEmpty(messageIdentifier) }}
	data-msgid="{{messageIdentifier}}"
{{/ isEmpty(messageIdentifier) }}

{{^ isEmpty(deliveryState) }}
	data-delivery-state="{{deliveryState}}"
{{/ isEmpty(deliveryState) }}

{{^isRemoteMessage}}
	data-member-type="{{nicknameType}}"
{{/isRemoteMessage}}

	data-timestamp="{{timestamp}}">

	<p>
		<span class="time"

		{{^ isEmpty(localizedTimestamp) }}
		title="{{localizedTimestamp}}"
		{{/ isEmpty(localizedTimestamp) }}>{{formattedTimestamp}} </span>

		<span class="message">
			{{{formattedMessage}}}
		</span>
	</p>
</div>

{{#showSessionIndicator}}
	{{> sessionIndicator}}
{{/showSessionIndicator}}
