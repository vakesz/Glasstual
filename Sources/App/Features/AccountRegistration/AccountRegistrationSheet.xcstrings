    "success-saved": {
      "comment": "Text after a successful registration whose password was saved.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The password is saved in your keychain and Glasstual signs in with SASL from now on."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A jelszó a kulcskarikádba került, és a Glasstual mostantól SASL-lel jelentkezik be."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Passwort ist in deinem Schlüsselbund gesichert, und Glasstual meldet sich ab jetzt per SASL an."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La contraseña se guardó en tu llavero y Glasstual iniciará sesión con SASL a partir de ahora."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le mot de passe est enregistré dans votre trousseau et Glasstual se connecte désormais avec SASL."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パスワードはキーチェーンに保存され、今後Glasstualは SASL でサインインします。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A senha foi salva nas suas chaves e o Glasstual passa a entrar com SASL."
          }
        }
      }
    },
    "success-not-saved": {
      "comment": "Text after a successful registration whose password could not be saved.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The password could not be saved in your keychain. Add it in Server Properties to sign in automatically."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A jelszót nem sikerült a kulcskarikába menteni. Az automatikus bejelentkezéshez add meg a Kiszolgáló tulajdonságai ablakban."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Passwort konnte nicht in deinem Schlüsselbund gesichert werden. Füge es in den Servereigenschaften hinzu, um dich automatisch anzumelden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo guardar la contraseña en tu llavero. Añádela en Propiedades del servidor para iniciar sesión automáticamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le mot de passe n’a pas pu être enregistré dans votre trousseau. Ajoutez-le dans les propriétés du serveur pour vous connecter automatiquement."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パスワードをキーチェーンに保存できませんでした。自動でサインインするには、サーバのプロパティで追加してください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível salvar a senha nas suas chaves. Adicione-a nas Propriedades do Servidor para entrar automaticamente."
          }
        }
      }
    },
