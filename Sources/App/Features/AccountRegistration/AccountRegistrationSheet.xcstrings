    "password-bounds-range": {
      "comment": "Footnote with the password length the server accepts. The arguments are the minimum and maximum lengths.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld–%2$lld characters"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld–%2$lld karakter"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld–%2$lld Zeichen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld–%2$lld caracteres"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
