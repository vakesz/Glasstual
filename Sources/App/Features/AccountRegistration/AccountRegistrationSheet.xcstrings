{
  "sourceLanguage": "en",
  "strings": {
    "title": {
      "comment": "Title of the Register Account sheet.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Register Account"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Fiók regisztrálása"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Account registrieren"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Registrar cuenta"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrer un compte"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウントを登録"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Registrar Conta"
          }
        }
      }
    },
    "subtitle": {
      "comment": "Subtitle of the Register Account sheet. The argument is the network name.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create an account on %@ so Glasstual can sign you in automatically."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Hozz létre fiókot a(z) %@ hálózaton, hogy a Glasstual automatikusan bejelentkeztethessen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erstelle einen Account auf %@, damit Glasstual dich automatisch anmelden kann."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea una cuenta en %@ para que Glasstual pueda iniciar sesión automáticamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Créez un compte sur %@ pour que Glasstual puisse vous connecter automatiquement."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ にアカウントを作成すると、Glasstualが自動でサインインできます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Crie uma conta em %@ para que o Glasstual possa entrar automaticamente."
          }
        }
      }
    },
    "server-label": {
      "comment": "Label of the row naming the server in the Register Account sheet.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Server"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Szerver"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Server"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Servidor"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Serveur"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバ"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Servidor"
          }
        }
      }
    },
    "connects-to-register": {
      "comment": "Secondary text under the server name when the session is disconnected: registering connects first.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Glasstual connects to register."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Glasstual a regisztrációhoz kapcsolódik."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Glasstual verbindet sich zum Registrieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Glasstual se conectará para registrarte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Glasstual se connecte pour l’enregistrement."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Glasstualは登録のために接続します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Glasstual se conecta para registrar."
          }
        }
      }
    },
    "account-label": {
      "comment": "Label of the account name field.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Account Name"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Fióknév"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Account-Name"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nombre de cuenta"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nom du compte"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウント名"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nome da Conta"
          }
        }
      }
    },
    "account-follows-nickname-footnote": {
      "comment": "Footnote when the server names the account after the nickname.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This server names the account after your nickname. Use Change Nickname… to pick another."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez a szerver a beceneved alapján nevezi el a fiókot. Másikat a Becenév módosítása… menüponttal választhatsz."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Server benennt den Account nach deinem Nickname. Wähle mit „Nickname ändern…“ einen anderen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este servidor da a la cuenta el nombre de tu apodo. Usa Cambiar apodo… para elegir otro."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce serveur donne au compte le nom de votre pseudo. Utilisez Changer de pseudo… pour en choisir un autre."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このサーバではアカウント名はニックネームになります。別の名前にするには「ニックネームを変更…」を使用してください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este servidor dá à conta o nome do seu apelido. Use Alterar Apelido… para escolher outro."
          }
        }
      }
    },
    "account-unknown-footnote": {
      "comment": "Footnote under the account name field before the server's rules are known.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some servers require the account name to match your nickname."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egyes szerverek megkövetelik, hogy a fióknév megegyezzen a beceneveddel."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Manche Server verlangen, dass der Account-Name deinem Nickname entspricht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Algunos servidores exigen que el nombre de cuenta coincida con tu apodo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Certains serveurs exigent que le nom du compte corresponde à votre pseudo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバによっては、アカウント名をニックネームと同じにする必要があります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Alguns servidores exigem que o nome da conta seja igual ao seu apelido."
          }
        }
      }
    },
