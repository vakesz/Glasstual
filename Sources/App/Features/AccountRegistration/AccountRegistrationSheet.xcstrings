        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld–%2$lld caracteres"
          }
        }
      }
    },
    "password-bounds-minimum": {
      "comment": "Footnote with the shortest password the server accepts. The argument is the length.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "At least %lld characters"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Legalább %lld karakter"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mindestens %lld Zeichen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al menos %lld caracteres"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Au moins %lld caractères"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld文字以上"
          }
        },
