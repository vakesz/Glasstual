          }
        }
      }
    },
    "transport-asks-first": {
      "comment": "Transport warning footnote: the server's certificate was not checked, so Glasstual asks first before sending the password.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server’s certificate was not checked. Glasstual asks before sending the password."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A szerver tanúsítványa nem lett ellenőrizve. A Glasstual rákérdez a jelszó elküldése előtt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Zertifikat des Servers wurde nicht geprüft. Glasstual fragt nach, bevor das Passwort gesendet wird."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se verificó el certificado del servidor. Glasstual preguntará antes de enviar la contraseña."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le certificat du serveur n’a pas été vérifié. Glasstual demande avant d’envoyer le mot de passe."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバの証明書は確認されていません。Glasstualはパスワードを送信する前に確認します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O certificado do servidor não foi verificado. O Glasstual pergunta antes de enviar a senha."
          }
        }
      }
    },
    "transport-refuses": {
      "comment": "Transport warning footnote: Glasstual refuses to send the password because the connection lost the encryption it asked for.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This connection is not encrypted although encryption was requested, so Glasstual won’t send the password."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez a kapcsolat nincs titkosítva, pedig titkosítást kértél, ezért a Glasstual nem küldi el a jelszót."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Verbindung ist nicht verschlüsselt, obwohl Verschlüsselung angefordert wurde. Glasstual sendet das Passwort daher nicht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta conexión no está cifrada aunque se solicitó cifrado, así que Glasstual no enviará la contraseña."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette connexion n’est pas chiffrée alors que le chiffrement était demandé : Glasstual n’enverra pas le mot de passe."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "暗号化が要求されたのにこの接続は暗号化されていないため、Glasstualはパスワードを送信しません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta conexão não está criptografada, embora a criptografia tenha sido solicitada, então o Glasstual não enviará a senha."
          }
        }
      }
    },
    "replaces-saved-password": {
      "comment": "Footnote when a password is already saved for this server.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Registering replaces the password saved for this server."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A regisztráció lecseréli a szerverhez mentett jelszót."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Registrierung ersetzt das für diesen Server gesicherte Passwort."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al registrarte se sustituye la contraseña guardada para este servidor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’enregistrement remplace le mot de passe enregistré pour ce serveur."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "登録すると、このサーバに保存されているパスワードが置き換えられます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Registrar substitui a senha salva para este servidor."
          }
        }
      }
    },
