    "only-list-channels-with-at-least": {
      "comment": "Footer under the minimum channel member count filter, explaining that the server applies it. Legacy key: u7e-2s.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server applies this filter, so smaller channels are never sent."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ezt a szűrőt a kiszolgáló alkalmazza, így a kisebb csatornákat nem küldi el."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server wendet diesen Filter an. Kleinere Kanäle werden daher nicht gesendet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor aplica este filtro, por lo que nunca se envían canales más pequeños."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur applique ce filtre, de sorte que les canaux plus petits ne sont jamais envoyés."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバがこのフィルタを適用するため、これより小さいチャンネルは送信されません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O servidor aplica este filtro, portanto canais menores nunca são enviados."
          }
        }
      }
    },
