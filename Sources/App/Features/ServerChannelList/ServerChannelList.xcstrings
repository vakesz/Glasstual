{
  "sourceLanguage": "en",
  "strings": {
    "change-the-search-or-update": {
      "comment": "Description shown when the public channel table has no visible rows.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Change the search or update the list from the server."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Módosítsd a keresést, vagy frissítsd a listát a kiszolgálóról."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ändere die Suche oder aktualisiere die Liste vom Server."
          }
        }
      }
    },
    "channel-name": {
      "comment": "Column heading for public IRC channel names.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Channel Name"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Csatornanév"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kanalname"
          }
        }
      }
    },
    "join-selected-channels": {
      "comment": "Button that joins the selected public IRC channels.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Join Selected Channels"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Csatlakozás a kijelölt csatornákhoz"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ausgewählten Kanälen beitreten"
          }
        }
      }
    },
    "list-truncated-notice": {
      "comment": "Notice shown under the channel list when the server sent more channels than the window keeps. The argument is the number of channels the window kept, which the search field does not change.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "The server sent more channels than this window keeps; the first one is here. Narrow the search on the server to see the rest."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "The server sent more channels than this window keeps; the first %ld are here. Narrow the search on the server to see the rest."
                }
              }
            }
          }
        },
        "hu": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "A kiszolgáló több csatornát küldött, mint amennyit ez az ablak megőriz. Itt az első látható. A többi megtekintéséhez szűkítsd a kiszolgálón végzett keresést."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "A kiszolgáló több csatornát küldött, mint amennyit ez az ablak megőriz. Itt az első %ld látható. A többi megtekintéséhez szűkítsd a kiszolgálón végzett keresést."
                }
              }
            }
          }
        },
        "de": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Der Server hat mehr Kanäle gesendet, als dieses Fenster speichert. Hier wird der erste angezeigt. Grenze die Suche auf dem Server ein, um die übrigen zu sehen."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Der Server hat mehr Kanäle gesendet, als dieses Fenster speichert. Hier werden die ersten %ld angezeigt. Grenze die Suche auf dem Server ein, um die übrigen zu sehen."
                }
              }
            }
          }
        }
      }
    },
    "member-count": {
      "comment": "Column heading for the number of members in a public IRC channel.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Member Count"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Tagok száma"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mitgliederzahl"
          }
        }
      }
    },
    "minimum-users": {
      "comment": "Label for the minimum channel member count filter. Legacy key: u7e-1s.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Minimum users"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Minimális taglétszám"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mindestanzahl Benutzer"
          }
        }
      }
    },
    "no-channel-list": {
      "comment": "Title shown when a restored channel list window has no server behind it any more.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No Channel List"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nincs csatornalista"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Kanalliste"
          }
        }
      }
    },
    "no-channel-list-description": {
      "comment": "Description shown when a restored channel list window has no server behind it any more.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask a server for its public channels from the Server menu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Kiszolgáló menüből kérheted le egy kiszolgáló nyilvános csatornáit."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Frage über das Servermenü die öffentlichen Kanäle eines Servers ab."
          }
        }
      }
    },
    "no-public-channels": {
      "comment": "Empty-state title for the public channel list.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No Public Channels"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nincsenek nyilvános csatornák"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine öffentlichen Kanäle"
          }
        }
      }
    },
    "only-list-channels-with-at-least": {
      "comment": "Footer under the minimum channel member count filter, explaining that the server applies it. Legacy key: u7e-2s.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server applies this filter, so smaller channels are never sent."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ezt a szűrőt a kiszolgáló alkalmazza, így a kisebb csatornákat nem küldi el."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server wendet diesen Filter an. Kleinere Kanäle werden daher nicht gesendet."
          }
        }
      }
    },
    "public-channel-count": {
      "comment": "Channel list window subtitle, under the network name. The argument is the number of public channels the window kept. Legacy key: ct4-wh.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%ld public channel"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%ld public channels"
                }
              }
            }
          }
        },
        "hu": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%ld nyilvános csatorna"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%ld nyilvános csatorna"
                }
              }
            }
          }
        },
        "de": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%ld öffentlicher Kanal"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%ld öffentliche Kanäle"
                }
              }
            }
          }
        }
      }
    },
    "public-channel-list": {
      "comment": "Accessibility label for the table of public IRC channels.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Public Channel List"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyilvános csatornák listája"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffentliche Kanalliste"
          }
        }
      }
    },
    "requesting-channel-list": {
      "comment": "Progress text shown while requesting the public channel list from a server.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Requesting channel list…"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Csatornalista lekérése…"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kanalliste wird angefordert…"
          }
        }
      }
    },
    "search-channels": {
      "comment": "Placeholder in the public channel search field.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Search channels"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Csatornák keresése"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kanäle suchen"
          }
        }
      }
    },
    "topic": {
      "comment": "Column heading for public IRC channel topics.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Topic"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Téma"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Thema"
          }
        }
      }
    },
    "update-list": {
      "comment": "Button that asks the server for the public channel list again.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Refresh"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Frissítés"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktualisieren"
          }
        }
      }
    },
    "window-group-title": {
      "comment": "Title of the channel list window group, shown in the Window menu.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Channel List"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Csatornalista"
          }
        },
        "de": {
