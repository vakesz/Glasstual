    "no-channel-list-description": {
      "comment": "Description shown when a restored channel list window has no server behind it any more.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask a server for its public channels from the Server menu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Kiszolgáló menüből kérheted le egy kiszolgáló nyilvános csatornáit."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Frage über das Servermenü die öffentlichen Kanäle eines Servers ab."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pide a un servidor sus canales públicos desde el menú Servidor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demandez à un serveur ses canaux publics depuis le menu Serveur."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバメニューから、サーバに公開チャンネルを問い合わせます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Peça a um servidor os canais públicos dele pelo menu Servidor."
          }
        }
      }
    },
