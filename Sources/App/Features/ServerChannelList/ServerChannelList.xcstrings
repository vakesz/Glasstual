{
  "sourceLanguage": "en",
  "strings": {
    "change-the-search-or-update": {
      "comment": "Description shown when the public channel table has no visible rows.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Change the search or update the list from the server."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Módosítsd a keresést, vagy frissítsd a listát a kiszolgálóról."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ändere die Suche oder aktualisiere die Liste vom Server."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cambie la búsqueda o actualice la lista desde el servidor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Modifiez la recherche ou mettez à jour la liste depuis le serveur."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "サーバーから検索を変更するか、リストを更新してください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Altere a busca ou atualize a lista do servidor."
          }
        }
      }
    },
    "channel-name": {
      "comment": "Column heading for public IRC channel names.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
