          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "チャンネル名"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nome do canal"
          }
        }
      }
    },
    "join-selected-channels": {
      "comment": "Button that joins the selected public IRC channels.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Join Selected Channels"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Csatlakozás a kijelölt csatornákhoz"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ausgewählten Kanälen beitreten"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Únete a los canales seleccionados"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Rejoindre les chaînes sélectionnées"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "選択されたチャンネルに参加する"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Junte-se aos Canais Selecionados"
          }
        }
      }
    },
    "list-truncated-notice": {
      "comment": "Notice shown under the channel list when the server sent more channels than the window keeps. The argument is the number of channels the window kept, which the search field does not change.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "The server sent more channels than this window keeps; the first one is here. Narrow the search on the server to see the rest."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "The server sent more channels than this window keeps; the first %ld are here. Narrow the search on the server to see the rest."
                }
              }
            }
          }
        },
        "hu": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "A kiszolgáló több csatornát küldött, mint amennyit ez az ablak megőriz. Itt az első látható. A többi megtekintéséhez szűkítsd a kiszolgálón végzett keresést."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "A kiszolgáló több csatornát küldött, mint amennyit ez az ablak megőriz. Itt az első %ld látható. A többi megtekintéséhez szűkítsd a kiszolgálón végzett keresést."
                }
              }
            }
          }
        },
        "de": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Der Server hat mehr Kanäle gesendet, als dieses Fenster speichert. Hier wird der erste angezeigt. Grenze die Suche auf dem Server ein, um die übrigen zu sehen."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Der Server hat mehr Kanäle gesendet, als dieses Fenster speichert. Hier werden die ersten %ld angezeigt. Grenze die Suche auf dem Server ein, um die übrigen zu sehen."
                }
              }
            }
          }
        },
        "es": {
          "variations": {
            "plural": {
              "many": {
                "stringUnit": {
                  "state": "needs_review",
                  "value": "El servidor envió más canales de los que mantiene esta ventana; los primeros %ld están aquí. Restringe la búsqueda en el servidor para ver el resto."
                }
              },
              "one": {
                "stringUnit": {
                  "state": "needs_review",
                  "value": "El servidor envió más canales de los que mantiene esta ventana; el primero está aquí. Restringe la búsqueda en el servidor para ver el resto."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "needs_review",
                  "value": "El servidor envió más canales de los que mantiene esta ventana; los primeros %ld están aquí. Restringe la búsqueda en el servidor para ver el resto."
                }
              }
            }
          }
        },
        "fr": {
          "variations": {
            "plural": {
              "many": {
                "stringUnit": {
                  "state": "needs_review",
                  "value": "Le serveur a envoyé plus de canaux que cette fenêtre ne garde ; les premiers %ld sont ici. Affinez la recherche sur le serveur pour voir le reste."
                }
              },
              "one": {
                "stringUnit": {
                  "state": "needs_review",
                  "value": "Le serveur a envoyé plus de canaux que cette fenêtre ne garde ; le premier est ici. Affinez la recherche sur le serveur pour voir le reste."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "needs_review",
                  "value": "Le serveur a envoyé plus de canaux que cette fenêtre ne garde ; les premiers %ld sont ici. Affinez la recherche sur le serveur pour voir le reste."
                }
              }
            }
          }
        },
        "ja": {
          "variations": {
            "plural": {
              "other": {
                "stringUnit": {
                  "state": "needs_review",
                  "value": "サーバーはこのウィンドウが保持しているチャンネルよりも多くのチャンネルを送信しました。最初の%ldはここにあります。サーバーでの検索を絞り込んで、残りを確認してください。"
                }
              }
            }
          }
        },
        "pt-BR": {
          "variations": {
            "plural": {
              "many": {
                "stringUnit": {
                  "state": "needs_review",
                  "value": "O servidor enviou mais canais do que esta janela mantém; os primeiros %ld estão aqui. Restrinja a pesquisa no servidor para ver o resto."
                }
              },
              "one": {
                "stringUnit": {
                  "state": "needs_review",
                  "value": "O servidor enviou mais canais do que esta janela mantém; o primeiro está aqui. Restrinja a pesquisa no servidor para ver o resto."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "needs_review",
                  "value": "O servidor enviou mais canais do que esta janela mantém; os primeiros %ld estão aqui. Restrinja a pesquisa no servidor para ver o resto."
                }
              }
            }
          }
        }
      }
    },
