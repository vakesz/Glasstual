{
  "sourceLanguage": "en",
  "strings": {
    "change-the-search-or-update": {
      "comment": "Description shown when the public channel table has no visible rows.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Change the search or update the list from the server."
          }
        }
      }
    },
    "channel-name": {
      "comment": "Column heading for public IRC channel names.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Channel Name"
          }
        }
      }
    },
    "join-selected-channels": {
      "comment": "Button that joins the selected public IRC channels.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Join Selected Channels"
          }
        }
      }
    },
    "list-truncated-notice": {
      "comment": "Notice shown under the channel list when the server sent more channels than the window keeps. The argument is the number of channels the window kept, which the search field does not change.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "The server sent more channels than this window keeps; the first one is here. Narrow the search on the server to see the rest."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "The server sent more channels than this window keeps; the first %ld are here. Narrow the search on the server to see the rest."
                }
              }
            }
          }
        }
      }
    },
    "member-count": {
      "comment": "Column heading for the number of members in a public IRC channel.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Member Count"
          }
        }
      }
    },
    "minimum-users": {
      "comment": "Label for the minimum channel member count filter. Legacy key: u7e-1s.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Minimum users"
          }
        }
      }
    },
    "no-channel-list": {
      "comment": "Title shown when a restored channel list window has no server behind it any more.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No Channel List"
          }
        }
      }
    },
    "no-channel-list-description": {
      "comment": "Description shown when a restored channel list window has no server behind it any more.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask a server for its public channels from the Server menu."
          }
        }
      }
    },
    "no-public-channels": {
      "comment": "Empty-state title for the public channel list.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No Public Channels"
          }
        }
      }
    },
    "only-list-channels-with-at-least": {
      "comment": "Footer under the minimum channel member count filter, explaining that the server applies it. Legacy key: u7e-2s.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server applies this filter, so smaller channels are never sent."
          }
        }
      }
    },
    "public-channel-count": {
      "comment": "Channel list window subtitle, under the network name. The argument is the number of public channels the window kept. Legacy key: ct4-wh.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%ld public channel"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%ld public channels"
                }
              }
            }
          }
        }
      }
    },
    "public-channel-list": {
      "comment": "Accessibility label for the table of public IRC channels.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Public Channel List"
          }
        }
      }
    },
    "requesting-channel-list": {
      "comment": "Progress text shown while requesting the public channel list from a server.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Requesting channel list…"
          }
        }
      }
    },
    "search-channels": {
      "comment": "Placeholder in the public channel search field.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Search channels"
          }
        }
      }
    },
    "topic": {
      "comment": "Column heading for public IRC channel topics.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Topic"
          }
        }
      }
    },
    "update-list": {
      "comment": "Button that asks the server for the public channel list again.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Refresh"
          }
        }
      }
    },
    "window-group-title": {
      "comment": "Title of the channel list window group, shown in the Window menu.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Channel List"
          }
        }
      }
    }
  },
  "version": "1.0"
}
