        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O arquivo selecionado não é um tema de transcrição do Glasstual válido."
          }
        }
      }
    },
    "invalid-values": {
      "comment": "Error shown when a transcript theme edit falls outside the supported ranges.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That change was not applied: transcript theme values must stay within the supported ranges."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A módosítás nem lett alkalmazva: a megjelenési téma értékeinek a támogatott tartományokon belül kell maradniuk."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Änderung wurde nicht angewendet: Die Werte des Chatdesigns müssen innerhalb der unterstützten Bereiche bleiben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ese cambio no se aplicó: los valores del tema de transcripción deben estar dentro de los intervalos admitidos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette modification n’a pas été appliquée : les valeurs du thème de transcription doivent rester dans les plages prises en charge."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "その変更は適用されませんでした。トランスクリプトテーマの値は対応する範囲内である必要があります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Essa alteração não foi aplicada: os valores do tema de transcrição devem permanecer dentro dos intervalos suportados."
          }
        }
      }
    },
