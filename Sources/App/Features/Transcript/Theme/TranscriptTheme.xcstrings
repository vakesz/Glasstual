    "invalid-values": {
      "comment": "Error shown when a transcript theme edit falls outside the supported ranges.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That change was not applied: transcript theme values must stay within the supported ranges."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A módosítás nem lett alkalmazva: a megjelenési téma értékeinek a támogatott tartományokon belül kell maradniuk."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Änderung wurde nicht angewendet: Die Werte des Chatdesigns müssen innerhalb der unterstützten Bereiche bleiben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ese cambio no se aplicó: los valores del tema de la transcripción deben permanecer dentro de los rangos compatibles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ce changement n'a pas été appliqué : les valeurs du thème de transcription doivent rester dans les plages prises en charge."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "その変更は適用されませんでした：トランスクリプトのテーマ値はサポートされている範囲内に保たなければなりません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Essa mudança não foi aplicada: os valores do tema da transcrição devem permanecer dentro das faixas suportadas."
          }
        }
      }
    },
