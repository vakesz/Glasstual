    "missing-history-title" : {
      "comment" : "Transcript banner: some messages sent while the user was away were not loaded from the server's history.",
      "extractionState" : "manual",
      "generatesSymbol" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Some messages from while you were away weren’t loaded."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A távolléte alatt érkezett üzenetek egy része nem lett betöltve."
