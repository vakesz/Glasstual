    "matches-addresses-ending-in-info" : {
      "comment" : "IRC hostmask example and explanation.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "*!*@*.info (matches any address ending in “.info”)"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "*!*@*.info (minden \".info\" végű címre illeszkedik)"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "*!*@*.info (passt auf alle Adressen mit der Endung \".info\")"
          }
        }
      }
    },
    "matches-every-possible-user" : {
      "comment" : "IRC hostmask example and warning.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "*!*@* (matches every possible user — not recommended)"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "*!*@* (minden felhasználóra illeszkedik, nem ajánlott)"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "*!*@* (passt auf alle Benutzer, nicht empfohlen)"
          }
        }
      }
    },
    "matches-nicknames-starting-with-frank" : {
      "comment" : "IRC hostmask example and explanation.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "frank*!*@* (matches any nickname that starts with “frank”)"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "frank*!*@* (minden \"frank\" kezdetű becenévre illeszkedik)"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "frank*!*@* (passt auf alle Nicknamen, die mit \"frank\" beginnen)"
          }
        }
      }
    },
    "matches-username-matt" : {
      "comment" : "IRC hostmask example and explanation.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "*!matt@* (matches any username equal to “matt”)"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "*!matt@* (a \"matt\" felhasználónévre illeszkedik)"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "*!matt@* (passt auf den Benutzernamen \"matt\")"
          }
        }
      }
    },
