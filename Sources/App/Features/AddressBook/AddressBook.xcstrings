    "mute-messages-description" : {
      "comment" : "Explains how muting differs from ignoring messages.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Group messages in the transcript so you can expand them when needed. Notifications stay silent."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az üzenetek összecsukott csoportokba kerülnek, és szükség esetén kinyithatók. Az értesítések némák maradnak."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nachrichten werden im Verlauf gruppiert und können bei Bedarf aufgeklappt werden. Mitteilungen bleiben stumm."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agrupa los mensajes en la transcripción para que puedas ampliarlos cuando sea necesario. Las notificaciones permanecen en silencio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Regroupe les messages dans la transcription afin de pouvoir les développer au besoin. Les notifications restent silencieuses."
          }
        },
