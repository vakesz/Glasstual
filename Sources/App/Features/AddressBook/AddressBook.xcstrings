    },
    "tracking-method-description" : {
      "comment" : "Explanation of how Glasstual determines a tracked user's availability.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glasstual watches join, part, and quit activity in shared channels. When the server supports them, it also uses ISON, MONITOR, or WATCH to check availability outside shared channels."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Glasstual figyeli a közös csatornákon a csatlakozásokat és kilépéseket. Ha a kiszolgáló támogatja, az ISON, MONITOR vagy WATCH parancsokkal a közös csatornákon kívül is ellenőrzi az elérhetőséget."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glasstual beobachtet Beitritte, Austritte und Verbindungsabbrüche in gemeinsamen Kanälen. Falls der Server sie unterstützt, werden auch ISON, MONITOR oder WATCH verwendet, um die Verfügbarkeit außerhalb gemeinsamer Kanäle zu prüfen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Los relojes Glasstual se unen, participan y dejan de participar en la actividad en canales compartidos. Cuando el servidor los admite, también utiliza ISON, MONITOR o WATCH para comprobar la disponibilidad fuera de los canales compartidos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Les montres Glasstual participent, participent à une activité et quittent une activité dans les canaux partagés. Lorsque le serveur les prend en charge, il utilise également ISON, MONITOR ou WATCH pour vérifier la disponibilité en dehors des canaux partagés."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Glasstualウォッチは、共有チャンネルでのアクティビティへの参加、参加解除、離脱を行います。サーバーがそれらをサポートしている場合、共有チャンネル外の可用性を確認するためにISON、MONITOR、またはWATCHも使用します。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Os relógios Glasstual participam, participam de atividades e saem de atividades em canais compartilhados. Quando o servidor os suporta, ele também usa ISON, MONITOR ou WATCH para verificar a disponibilidade fora dos canais compartilhados."
          }
        }
      }
    },
