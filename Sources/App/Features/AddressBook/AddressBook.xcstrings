    "matches-addresses-ending-in-info" : {
      "comment" : "IRC hostmask example and explanation.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "*!*@*.info (matches any address ending in “.info”)"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "*!*@*.info (minden \".info\" végű címre illeszkedik)"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "*!*@*.info (passt auf alle Adressen mit der Endung \".info\")"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "*!*@*.info (coincide con cualquier dirección que termine en «.info»)"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "*!*@*.info (correspond à toute adresse se terminant par « .info »)"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "*!*@*.info (「.info」で終わるすべてのアドレスに一致します)"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "*!*@*.info (corresponde a qualquer endereço que termine em “.info”)"
          }
        }
      }
    },
    "matches-every-possible-user" : {
      "comment" : "IRC hostmask example and warning.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "*!*@* (matches every possible user — not recommended)"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "*!*@* (minden felhasználóra illeszkedik, nem ajánlott)"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "*!*@* (passt auf alle Benutzer, nicht empfohlen)"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "*!*@* (coincide con cada usuario posible — no recomendado)"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "*!*@* (correspond à tous les utilisateurs possibles — déconseillé)"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "*!*@* (すべてのユーザに一致します。非推奨)"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "*!*@* (corresponde a todos os usuários possíveis — não recomendado)"
          }
        }
      }
    },
    "matches-nicknames-starting-with-frank" : {
      "comment" : "IRC hostmask example and explanation.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "frank*!*@* (matches any nickname that starts with “frank”)"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "frank*!*@* (minden \"frank\" kezdetű becenévre illeszkedik)"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "frank*!*@* (passt auf alle Nicknamen, die mit \"frank\" beginnen)"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "frank*!*@* (coincide con cualquier apodo que empiece por «frank»)"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "frank*!*@* (correspond à tout pseudo commençant par « frank »)"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "frank*!*@* (「frank」で始まるすべてのニックネームに一致します)"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "frank*!*@* (corresponde a qualquer apelido que comece com “frank”)"
          }
        }
      }
    },
    "matches-username-matt" : {
      "comment" : "IRC hostmask example and explanation.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
