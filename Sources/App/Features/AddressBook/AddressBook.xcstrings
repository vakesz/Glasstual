      }
    },
    "tracking-method-description" : {
      "comment" : "Explanation of how Glasstual determines a tracked user's availability.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glasstual watches join, part, and quit activity in shared channels. When the server supports them, it also uses ISON, MONITOR, or WATCH to check availability outside shared channels."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Glasstual figyeli a közös csatornákon a csatlakozásokat és kilépéseket. Ha a kiszolgáló támogatja, az ISON, MONITOR vagy WATCH parancsokkal a közös csatornákon kívül is ellenőrzi az elérhetőséget."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glasstual beobachtet Beitritte, Austritte und Verbindungsabbrüche in gemeinsamen Kanälen. Falls der Server sie unterstützt, werden auch ISON, MONITOR oder WATCH verwendet, um die Verfügbarkeit außerhalb gemeinsamer Kanäle zu prüfen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glasstual vigila la actividad de entrada, salida y desconexión en los canales compartidos. Si el servidor los admite, también usa ISON, MONITOR o WATCH para comprobar la disponibilidad fuera de los canales compartidos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glasstual surveille les arrivées, les départs et les déconnexions dans les canaux partagés. Si le serveur les prend en charge, il utilise aussi ISON, MONITOR ou WATCH pour vérifier la disponibilité en dehors des canaux partagés."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glasstualは、共有チャンネルでの参加、退出、終了のアクティビティを監視します。サーバが対応している場合は、ISON、MONITOR、WATCHも使用して、共有チャンネル外での利用可否を確認します。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Glasstual monitora a entrada, a saída e a desconexão de usuários em canais compartilhados. Quando o servidor oferece suporte, ele também usa ISON, MONITOR ou WATCH para verificar a disponibilidade fora dos canais compartilhados."
          }
        }
      }
    },
