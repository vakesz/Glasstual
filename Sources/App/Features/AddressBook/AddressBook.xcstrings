        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "*!matt@* (coincide con cualquier nombre de usuario igual a «matt»)"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "*!matt@* (correspond à tout nom d’utilisateur égal à « matt »)"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "*!matt@* (ユーザ名が「matt」であるすべてのユーザに一致します)"
          }
        },
        "pt-BR" : {
