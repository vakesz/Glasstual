    "matches-addresses-ending-in-info" : {
      "comment" : "IRC hostmask example and explanation.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "*!*@*.info (matches any address ending in “.info”)"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "*!*@*.info (minden \".info\" végű címre illeszkedik)"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "*!*@*.info (passt auf alle Adressen mit der Endung \".info\")"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "*!*@*.info (coincide con cualquier dirección que termine en \".info\")"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "*!*@*.info (correspond à toute adresse se terminant par \".info\")"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "*!*@*.info（「.info」で終わる任意のアドレスに一致します）"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "*!*@*.info (encaixa em qualquer endereço que termine em \".info\")"
          }
        }
      }
    },
    "matches-every-possible-user" : {
      "comment" : "IRC hostmask example and warning.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "*!*@* (matches every possible user — not recommended)"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "*!*@* (minden felhasználóra illeszkedik, nem ajánlott)"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "*!*@* (passt auf alle Benutzer, nicht empfohlen)"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "*!*@* (coincide con cada usuario posible — no recomendado)"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "*!*@* (correspond à chaque utilisateur possible - non recommandé)"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "*!*@*（すべての可能なユーザーと一致します - 推奨されません）"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "*!*@* (encaixa em todo usuário possível — não recomendado)"
          }
        }
      }
    },
