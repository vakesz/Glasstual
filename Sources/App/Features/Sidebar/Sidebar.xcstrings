    "no-mentions-description": {
      "comment": "Sidebar favorites and attention filter interface.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Conversations where someone mentions you appear here."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unterhaltungen, in denen du erwähnt wirst, werden hier angezeigt."
