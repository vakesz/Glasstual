    "no-mentions-description": {
      "comment": "Sidebar favorites and attention filter interface.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Conversations where someone mentions you appear here."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unterhaltungen, in denen du erwähnt wirst, werden hier angezeigt."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Itt jelennek meg azok a beszélgetések, amelyekben megemlítenek."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las conversaciones en las que alguien te menciona aparecen aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les conversations où quelqu’un vous mentionne apparaissent ici."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "誰かがあなたにメンションした会話がここに表示されます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As conversas em que alguém menciona você aparecem aqui."
          }
        }
      }
    },
