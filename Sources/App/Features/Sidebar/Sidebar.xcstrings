        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Itt jelennek meg azok a beszélgetések, amelyekben megemlítenek."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Las conversaciones en las que alguien te menciona aparecen aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les conversations où quelqu'un vous mentionne apparaissent ici."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "誰かがあなたを言及している会話が表示されます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Conversas onde alguém menciona você aparecem aqui."
          }
