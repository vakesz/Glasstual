    "Appearance help": {
      "comment": "Server sidebar appearance customization.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use a color and icon to recognize this server in the sidebar and Favorites."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Szín és ikon segít felismerni ezt a kiszolgálót az oldalsávon és a kedvencek között."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Farbe und Symbol kennzeichnen diesen Server in der Seitenleiste und in den Favoriten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Utilice un color e icono para reconocer este servidor en la barra lateral y en Favoritos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Utilisez une couleur et une icône pour reconnaître ce serveur dans la barre latérale et les Favoris."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "サイドバーとお気に入りでこのサーバーを色とアイコンで認識します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Use uma cor e um ícone para reconhecer este servidor na barra lateral e Favoritos."
          }
        }
      }
    },
