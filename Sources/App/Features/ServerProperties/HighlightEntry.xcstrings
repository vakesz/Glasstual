    "channel-help" : {
      "comment" : "Explanation under the channel picker in a server highlight rule. Legacy key: channel-accessibility-hint.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose All Channels to apply this rule everywhere."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Válaszd az Összes csatorna lehetőséget, hogy a szabály mindenhol érvényes legyen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle Alle Kanäle, um diese Regel überall anzuwenden."
          }
        }
      }
    },
