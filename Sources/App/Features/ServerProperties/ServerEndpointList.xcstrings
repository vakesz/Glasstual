    "enter-a-whole-number-between-1" : {
      "comment" : "Validation message shown under the list when a row has no properly formatted server port. Legacy key: ox2-od.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enter a whole number between 1 and 65,535."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adj meg egy 1 és 65 535 közötti egész számot."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gib eine ganze Zahl zwischen 1 und 65.535 ein."
          }
        }
      }
    },
    "explanation" : {
      "comment" : "Explains that alternate servers are tried in the displayed order.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glasstual tries these servers from top to bottom. Use the arrow buttons to change their order; the first server is primary."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Glasstual fentről lefelé próbálja a kiszolgálókat. A nyílgombokkal módosíthatod a sorrendet; az első az elsődleges kiszolgáló."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glasstual versucht die Server von oben nach unten. Ändere die Reihenfolge mit den Pfeiltasten; der erste Server ist der primäre."
          }
        }
      }
    },
    "move-down" : {
