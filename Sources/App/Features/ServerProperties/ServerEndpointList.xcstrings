    "server-password-help" : {
      "comment" : "Explanation under the endpoint list, saying what the server password is and where it is kept.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sent with the PASS command when connecting, and stored in your keychain. This is not your NickServ password."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kapcsolódáskor a PASS paranccsal küldjük el, és a kulcskarikában tároljuk. Ez nem a NickServ-jelszavad."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wird beim Verbinden mit PASS gesendet und in deinem Schlüsselbund gespeichert. Dies ist nicht dein NickServ-Passwort."
          }
        }
      }
    },
    "value-you-entered-is-not" : {
