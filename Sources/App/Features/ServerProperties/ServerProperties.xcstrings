    "unsaved-changes-on-quit-body" : {
      "comment" : "Body of the alert shown when quitting while a Server Properties window has unsaved changes.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Do you want to review your changes before quitting? If you don’t, your changes will be lost."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Möchtest du deine Änderungen vor dem Beenden überprüfen? Andernfalls gehen sie verloren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Quieres revisar los cambios antes de salir? Si no lo haces, se perderán."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voulez-vous vérifier vos modifications avant de quitter ? Sinon, elles seront perdues."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Szeretnéd átnézni a módosításokat kilépés előtt? Ha nem, elvesznek."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "終了する前に変更内容を確認しますか？確認しない場合、変更は失われます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deseja revisar suas alterações antes de encerrar? Se não revisar, elas serão perdidas."
          }
        }
      }
    },
