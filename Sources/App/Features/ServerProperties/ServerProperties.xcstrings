    "there-are-no-certificates" : {
      "comment" : "Custom client-side certificate selection. Legacy key: 489-hG.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "There are no certificates in the keychain configured for identity purposes.\n\nCertificates must meet the following criteria:\n\t• Certificate is configured as type: “SSL Client”\n\t• Certificate has matching private key"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A kulcskarikában nincs személyazonosításra beállított tanúsítvány.\n\nA tanúsítványnak a következő feltételeknek kell megfelelnie:\n\t• Típusa: \"SSL Client\"\n\t• Rendelkezik hozzá tartozó privát kulccsal"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Im Schlüsselbund sind keine Zertifikate zur Identifizierung eingerichtet.\n\nZertifikate müssen folgende Kriterien erfüllen:\n\t• Zertifikatstyp: \"SSL Client\"\n\t• Passender privater Schlüssel vorhanden"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "No hay certificados en la llavero configurados para fines de identificación.\n\nLos certificados deben cumplir con los siguientes criterios:\n\t• El certificado está configurado como tipo: \"SSL Cliente\"\n\t• El certificado tiene una clave privada coincidente"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Il n’y a aucun certificat dans la clé USB configuré à des fins d’identité.\n\nLes certificats doivent répondre aux critères suivants :\n\t• Le certificat est configuré comme type : \"SSL Client\"\n\t• Le certificat possède une clé privée correspondante"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "本人確認のために設定されたキーチェーンには証明書がありません。\n\n証明書は以下の基準を満たしている必要があります。\n\t• 証明書はタイプとして「SSL Client」として構成されています。\n\t• 証明書には対応するプライベートキーがあります"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Não há certificados no chaveiro configurados para fins de identificação.\n\nOs certificados devem atender aos seguintes critérios:\n\t• O certificado está configurado como tipo: \"SSL Cliente\"\n\t• O certificado tem a chave privada correspondente"
          }
        }
      }
    },
