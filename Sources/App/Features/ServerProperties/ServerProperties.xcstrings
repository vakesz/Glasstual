    "autojoin-delay-after-connect-commands" : {
      "comment" : "Server properties Connect Commands pane. Stepper that sets how long the autojoin pauses after the commands were sent. The argument is the number of seconds.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Wait %ld second after these commands before joining"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Wait %ld seconds after these commands before joining"
                }
              }
            }
          }
        },
        "hu" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Várakozás %ld másodpercig a parancsok után, csatlakozás előtt"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Várakozás %ld másodpercig a parancsok után, csatlakozás előtt"
                }
              }
            }
          }
        },
        "de" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Nach diesen Befehlen %ld Sekunde vor dem Beitritt warten"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Nach diesen Befehlen %ld Sekunden vor dem Beitritt warten"
                }
              }
            }
          }
        }
      }
    },
