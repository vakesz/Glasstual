    "nick-serv-confirmation-explanation" : {
      "comment" : "Explains automatic joining and the exception to the optional fixed delay.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connect commands are sent before joining channels. NickServ identification waits for confirmation, for up to 30 seconds after sending. The delay above applies to other command lists."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A kapcsolódási parancsokat a csatornákhoz csatlakozás előtt küldjük el. A NickServ-azonosítás a küldés után legfeljebb 30 másodpercig vár megerősítésre. A fenti késleltetés a többi parancslistára vonatkozik."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verbindungsbefehle werden vor dem Kanalbeitritt gesendet. Die NickServ-Identifizierung wartet danach bis zu 30 Sekunden auf Bestätigung. Die obige Verzögerung gilt für andere Befehlslisten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Los comandos de conexión se envían antes de unirse a los canales. La identificación NickServ espera la confirmación durante hasta 30 segundos después del envío. El retraso anterior se aplica a otras listas de comandos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Les commandes de connexion sont envoyées avant de rejoindre les canaux. L'identification NickServ attend une confirmation, pendant jusqu'à 30 secondes après l'envoi. Le délai ci-dessus s'applique aux autres listes de commandes."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "接続コマンドはチャネルに参加する前に送信されます。NickServ識別子は送信後最大30秒間確認を待機します。上記の遅延は他のコマンドリストにも適用されます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Os comandos de conexão são enviados antes de ingressar em canais. A identificação NickServ aguarda confirmação, por até 30 segundos após o envio. O atraso acima se aplica a outras listas de comandos."
          }
        }
      }
    },
