    "please-enter-a-list-of-properly" : {
      "comment" : "Validation message shown when one of the alternative nicknames is not properly formatted. The argument is the nickname that failed. Legacy key: wlz-tb.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” is not a valid nickname. Separate alternative nicknames with spaces, for example: Guest1 Guest2 Guest3"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A(z) \"%@\" nem érvényes becenév. Az alternatív beceneveket szóközzel válaszd el, például: Guest1 Guest2 Guest3"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\" ist kein gültiger Nickname. Trenne alternative Nicknamen durch Leerzeichen, zum Beispiel: Guest1 Guest2 Guest3"
          }
        }
