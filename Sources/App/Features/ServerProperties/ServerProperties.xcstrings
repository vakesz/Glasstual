            "state" : "translated",
            "value" : "Die Datei enthält keinen unverschlüsselten privaten P-256-Schlüssel im PEM- oder PKCS-#8-Format."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El archivo no contiene una clave privada P-256 sin cifrar en formato PEM o PKCS #8."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le fichier ne contient pas de clé privée P-256 non chiffrée au format PEM ou PKCS #8."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このファイルには、PEMまたはPKCS #8形式の暗号化されていないP-256秘密鍵が含まれていません。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O arquivo não contém uma chave privada P-256 não criptografada no formato PEM ou PKCS #8."
          }
        }
      }
    },
