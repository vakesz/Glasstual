    "bouncer-network-managed-by" : {
      "comment" : "Shown in the properties of a bouncer network. The argument is the name of the connection the network comes from.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This network is managed through %@. Its server, identity and security settings come from there."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ezt a hálózatot a(z) %@ kapcsolaton keresztül kezeled. A kiszolgáló-, azonosító- és biztonsági beállításai onnan származnak."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Netzwerk wird über %@ verwaltet. Server-, Identitäts- und Sicherheitseinstellungen stammen von dort."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta red se gestiona a través de %@. Sus ajustes de servidor, identidad y seguridad proceden de allí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce réseau est géré via %@. Ses réglages de serveur, d’identité et de sécurité en proviennent."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このネットワークは%@を通じて管理されています。サーバ、アイデンティティ、セキュリティの設定は、そちらから取得されます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta rede é gerenciada por meio de %@. As configurações de servidor, identidade e segurança vêm de lá."
          }
        }
      }
    },
