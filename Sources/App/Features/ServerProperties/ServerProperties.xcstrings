    "endpoint-list-server-password-help" : {
      "comment" : "Explanation under the endpoint list, saying what the server password is and where it is kept.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sent with the PASS command when connecting, and stored in your keychain. This is not your NickServ password."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kapcsolódáskor a PASS paranccsal küldjük el, és a kulcskarikában tároljuk. Ez nem a NickServ-jelszavad."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wird beim Verbinden mit PASS gesendet und in deinem Schlüsselbund gespeichert. Dies ist nicht dein NickServ-Passwort."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se envía con el comando PASS al conectarse y se almacena en tu llavero. Esta no es tu contraseña de NickServ."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envoyé avec la commande PASS lors de la connexion et enregistré dans votre trousseau. Ce n’est pas votre mot de passe NickServ."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "接続時にPASSコマンドで送信され、キーチェーンに保存されます。これはNickServのパスワードではありません。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enviada com o comando PASS ao conectar e armazenada no seu chaveiro. Esta não é a sua senha do NickServ."
          }
        }
