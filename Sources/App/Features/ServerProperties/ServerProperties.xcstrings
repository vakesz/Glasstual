    "certificate-fingerprint-help" : {
      "comment" : "Explanation under the certificate fingerprints, saying what the copied command is for.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The command tells NickServ to recognise you by this certificate. Send it once you are identified."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A parancs arra utasítja a NickServet, hogy a tanúsítvány alapján ismerjen fel. Azonosítás után küldd el."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Befehl weist NickServ an, dich anhand dieses Zertifikats zu erkennen. Sende ihn, nachdem du dich identifiziert hast."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "El comando le indica a NickServ que le reconozca con este certificado. Envíelo una vez que haya sido identificado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La commande indique à NickServ de vous reconnaître à l'aide de ce certificat. Envoyez-le une fois que vous avez été identifié."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "このコマンドは、NickServにこの証明書であなたを認識するように指示します。識別されたら一度送信してください。"
