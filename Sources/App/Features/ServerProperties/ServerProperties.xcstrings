    "bouncer-network-delete-message" : {
      "comment" : "Message of the confirmation for deleting a bouncer network.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The bouncer removes the network and its settings. Conversations and history stay in Glasstual."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A bouncer törli a hálózatot és a beállításait. A beszélgetések és az előzmények megmaradnak a Glasstualban."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Bouncer entfernt das Netzwerk und seine Einstellungen. Unterhaltungen und Verlauf bleiben in Glasstual erhalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El bouncer elimina la red y sus ajustes. Las conversaciones y el historial permanecen en Glasstual."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le bouncer supprime le réseau et ses réglages. Les conversations et l’historique restent dans Glasstual."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "バウンサーがネットワークとその設定を削除します。会話と履歴はGlasstualに残ります。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O bouncer remove a rede e as configurações dela. As conversas e o histórico permanecem no Glasstual."
          }
        }
      }
    },
    "bouncer-network-failure" : {
      "comment" : "Shown in the bouncer networks pane when the bouncer refused a command. The first argument is the bouncer's description, the second its error code.",
      "extractionState" : "manual",
