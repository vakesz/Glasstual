    "there-are-no-certificates" : {
      "comment" : "Custom client-side certificate selection. Legacy key: 489-hG.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "There are no certificates in the keychain configured for identity purposes.\n\nCertificates must meet the following criteria:\n\t• Certificate is configured as type: “SSL Client”\n\t• Certificate has matching private key"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A kulcskarikában nincs személyazonosításra beállított tanúsítvány.\n\nA tanúsítványnak a következő feltételeknek kell megfelelnie:\n\t• Típusa: \"SSL Client\"\n\t• Rendelkezik hozzá tartozó privát kulccsal"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Im Schlüsselbund sind keine Zertifikate zur Identifizierung eingerichtet.\n\nZertifikate müssen folgende Kriterien erfüllen:\n\t• Zertifikatstyp: \"SSL Client\"\n\t• Passender privater Schlüssel vorhanden"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No hay certificados en el llavero configurados para identificación.\n\nLos certificados deben cumplir los siguientes criterios:\n\t• El certificado está configurado con el tipo «SSL Client»\n\t• El certificado tiene una clave privada coincidente"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucun certificat du trousseau n’est configuré pour l’identification.\n\nLes certificats doivent répondre aux critères suivants :\n\t• Le certificat est configuré avec le type : « SSL Client »\n\t• Le certificat possède une clé privée correspondante"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アイデンティティ用に設定されたキーチェーンに証明書がありません。\n\n証明書は次の条件を満たす必要があります。\n\t• 証明書のタイプが「SSL Client」に設定されている\n\t• 証明書に対応する秘密鍵がある"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não há certificados no chaveiro configurados para fins de identificação.\n\nOs certificados devem atender aos seguintes critérios:\n\t• O certificado está configurado com o tipo: “SSL Client”\n\t• O certificado tem uma chave privada correspondente"
          }
        }
      }
    },
