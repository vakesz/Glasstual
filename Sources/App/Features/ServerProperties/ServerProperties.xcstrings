    "explanation" : {
      "comment" : "Explains that alternate servers are tried in the displayed order.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glasstual tries these servers from top to bottom. Use the arrow buttons to change their order; the first server is primary."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Glasstual fentről lefelé próbálja a kiszolgálókat. A nyílgombokkal módosíthatod a sorrendet; az első az elsődleges kiszolgáló."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glasstual versucht die Server von oben nach unten. Ändere die Reihenfolge mit den Pfeiltasten; der erste Server ist der primäre."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glasstual prueba estos servidores de arriba abajo. Usa los botones de flecha para cambiar su orden; el primer servidor es el principal."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glasstual essaie ces serveurs de haut en bas. Utilisez les boutons fléchés pour modifier leur ordre ; le premier serveur est le serveur principal."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glasstualは、これらのサーバを上から順に試します。矢印ボタンで順序を変更できます。最初のサーバがプライマリです。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Glasstual tenta estes servidores de cima para baixo. Use os botões de seta para alterar a ordem; o primeiro servidor é o principal."
          }
        }
      }
    },
