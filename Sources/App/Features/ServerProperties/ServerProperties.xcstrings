    "connect-securely-web-socket-footer" : {
      "comment" : "Server properties, General. Footer shown for a WebSocket server, explaining the Connect securely switch.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "With “Connect securely” on, the connection uses wss:// (WebSocket over TLS); off, it uses unencrypted ws://."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mit „Sicher verbinden“ wird wss:// (WebSocket über TLS) verwendet, sonst das unverschlüsselte ws://."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Con «Conectar de forma segura» activado, la conexión usa wss:// (WebSocket sobre TLS); desactivado, usa ws:// sin cifrar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Avec « Se connecter de façon sécurisée », la connexion utilise wss:// (WebSocket sur TLS) ; sinon, ws:// non chiffré."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "A „Biztonságos kapcsolódás” bekapcsolásával a kapcsolat wss:// (WebSocket TLS-en át) protokollt használ, kikapcsolva a titkosítatlan ws://-t."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "「安全に接続」をオンにするとwss://（TLS上のWebSocket）、オフにすると暗号化されないws://を使用します。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Com “Conectar com segurança” ativado, a conexão usa wss:// (WebSocket sobre TLS); desativado, usa ws:// sem criptografia."
          }
        }
      }
    },
