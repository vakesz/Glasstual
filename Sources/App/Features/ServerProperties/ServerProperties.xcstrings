    "nick-serv-confirmation-explanation" : {
      "comment" : "Explains automatic joining and the exception to the optional fixed delay.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connect commands are sent before joining channels. NickServ identification waits for confirmation, for up to 30 seconds after sending. The delay above applies to other command lists."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A kapcsolódási parancsokat a csatornákhoz csatlakozás előtt küldjük el. A NickServ-azonosítás a küldés után legfeljebb 30 másodpercig vár megerősítésre. A fenti késleltetés a többi parancslistára vonatkozik."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verbindungsbefehle werden vor dem Kanalbeitritt gesendet. Die NickServ-Identifizierung wartet danach bis zu 30 Sekunden auf Bestätigung. Die obige Verzögerung gilt für andere Befehlslisten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los comandos de conexión se envían antes de unirse a los canales. La identificación con NickServ espera confirmación hasta 30 segundos después del envío. El retraso anterior se aplica a las demás listas de comandos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les commandes de connexion sont envoyées avant l’arrivée dans les canaux. L’identification NickServ attend une confirmation pendant 30 secondes maximum après l’envoi. Le délai ci-dessus s’applique aux autres listes de commandes."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "接続コマンドは、チャンネルに参加する前に送信されます。NickServによる識別は、送信後最大30秒間、確認を待ちます。上記の遅延は、ほかのコマンドリストに適用されます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os comandos de conexão são enviados antes de entrar nos canais. A identificação no NickServ aguarda a confirmação por até 30 segundos após o envio. O atraso acima se aplica às outras listas de comandos."
          }
        }
      }
    },
