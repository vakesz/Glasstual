    "connection-changed" : {
      "comment" : "Note above the message field when an answer arrives after the connection the question was asked on ended. %lld is the question number.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Question %lld was withdrawn: the connection it was about has ended."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Frage %lld wurde zurückgezogen: Die Verbindung, um die es ging, ist beendet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se retiró la pregunta %lld: la conexión a la que se refería ha terminado."
          }
        },
        "fr" : {
