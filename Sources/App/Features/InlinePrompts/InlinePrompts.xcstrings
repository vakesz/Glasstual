    "not-pending" : {
      "comment" : "Note above the message field when an answer arrives for a question that is not pending: it was already answered or withdrawn. %lld is the question number.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Question %lld is no longer waiting."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Frage %lld wartet nicht mehr."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La pregunta %lld ya no está esperando."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La question %lld n’attend plus."
          }
        },
