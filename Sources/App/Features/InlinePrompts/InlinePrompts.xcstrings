    "usage" : {
      "comment" : "Usage note above the message field when an answering command is typed without what it needs. /answer and the example are commands and stay untranslated.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Type /answer followed by the question number and the answer, such as /answer 3 send."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe /answer, gefolgt von der Nummer der Frage und der Antwort, zum Beispiel /answer 3 send."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escribe /answer seguido del número de la pregunta y la respuesta, por ejemplo /answer 3 send."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tapez /answer suivi du numéro de la question et de la réponse, par exemple /answer 3 send."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Írd be a /answer parancsot, utána a kérdés számát és a választ, például: /answer 3 send."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "/answer に続けて質問番号と答えを入力します（例：/answer 3 send）。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Digite /answer seguido do número da pergunta e da resposta, por exemplo /answer 3 send."
          }
        }
      }
    },
