    "signed-in-with": {
      "comment": "Sign In Again sheet: result after signing in. %1$@ is the account name; %2$@ is the SASL mechanism wire name.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Signed in as %1$@ with %2$@."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Bejelentkezve mint %1$@ (%2$@)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Angemeldet als %1$@ mit %2$@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesión iniciada como %1$@ con %2$@."
          }
        },
