{
  "sourceLanguage": "en",
  "strings": {
    "title": {
      "comment": "Sign In Again sheet: title of the sheet that signs a connected server in to services again with SASL.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign In Again"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Újbóli bejelentkezés"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erneut anmelden"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Volver a iniciar sesión"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Se reconnecter"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "再度サインイン"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Iniciar sessão novamente"
          }
        }
      }
    },
    "subtitle": {
      "comment": "Sign In Again sheet: subtitle under the title explaining the sheet.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Signs this connection in to services again with SASL, without reconnecting."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Újra bejelentkezteti ezt a kapcsolatot a szolgáltatásokba SASL-lel, újracsatlakozás nélkül."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Meldet diese Verbindung mit SASL erneut bei den Diensten an, ohne neu zu verbinden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuelve a iniciar sesión en los servicios con SASL para esta conexión, sin reconectar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reconnecte cette connexion aux services avec SASL, sans se reconnecter au serveur."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "再接続せずに、この接続をSASLでサービスに再度サインインさせます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia sessão novamente nos serviços com SASL para esta conexão, sem reconectar."
          }
        }
      }
    },
    "account": {
      "comment": "Sign In Again sheet: label of the row showing the services account the connection is signed in to.",
