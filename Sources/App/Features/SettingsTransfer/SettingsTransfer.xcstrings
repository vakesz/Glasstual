    "risky-changes-notice": {
      "comment": "Import preview. Explains the block that lists changes which can send commands or widen what Glasstual trusts.",
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This file changes settings that can send commands to servers or change what Glasstual trusts. Read each one before importing."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez a fájl olyan beállításokat módosít, amelyek parancsokat küldhetnek a kiszolgálóknak, vagy megváltoztathatják, miben bízik meg a Glasstual. Importálás előtt olvasd el mindegyiket."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Datei ändert Einstellungen, die Befehle an Server senden oder beeinflussen können, welchen Inhalten Glasstual vertraut. Lies jeden Eintrag vor dem Import."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Este archivo cambia la configuración que puede enviar comandos a servidores o cambiar lo en lo que Glasstual confía. Lea cada una antes de importarla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ce fichier modifie les paramètres qui peuvent envoyer des commandes aux serveurs ou modifier ce en quoi Glasstual fait confiance. Lisez chacun d'eux avant d'importer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "このファイルは、サーバーにコマンドを送信したり、Glasstualが信頼するものを変更したりできる設定を変更します。インポートする前に、それぞれを必ず読み込んでください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Este arquivo altera as configurações que podem enviar comandos para servidores ou alterar o que o Glasstual confia. Leia cada uma antes de importar."
          }
        }
      }
    },
