{
  "sourceLanguage": "en",
  "strings": {
    "apply-settings-and-add-or-update-servers": {
      "comment": "Import preview. What Merge will do, shown under the mode picker.",
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apply the settings in this file and add or update its servers. Keep other servers and settings. Servers being updated will disconnect. A recovery backup is saved first."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Alkalmazd a fájlban lévő beállításokat, és add hozzá vagy frissítsd a kiszolgálókat. A többi kiszolgáló és beállítás megmarad. A frissített kiszolgálók kapcsolata megszakad. Először helyreállítási mentés készül."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wende die Einstellungen aus dieser Datei an und füge die darin enthaltenen Server hinzu oder aktualisiere sie. Andere Server und Einstellungen bleiben erhalten. Aktualisierte Server werden getrennt. Zuerst wird eine Wiederherstellungssicherung erstellt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aplica la configuración de este archivo y añade o actualiza sus servidores. Mantén los demás servidores y configuraciones. Los servidores que se estén actualizando se desconectarán. Se guarda primero una copia de seguridad de recuperación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Appliquez les paramètres de ce fichier et ajoutez ou mettez à jour ses serveurs. Conservez les autres serveurs et paramètres. Les serveurs en cours de mise à jour seront déconnectés. Une sauvegarde de récupération est d'abord sauvegardée."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "このファイルの設定を適用し、サーバーを追加または更新します。他のサーバーや設定は保持します。更新中のサーバーは接続が切断されます。最初にリカバリバックアップが保存されます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aplique as configurações neste arquivo e adicione ou atualize seus servidores. Mantenha outros servidores e configurações. Os servidores que estiverem sendo atualizados serão desconectados. Uma cópia de segurança de recuperação é salva primeiro."
          }
        }
      }
    },
    "backups-notice": {
      "comment": "Configuration recovery policy, shown in Settings.",
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The five most recent protected local backups are kept here. They retain connect commands and certificate references so removed servers can be recovered. Keychain passwords and certificate objects are not copied. Folder access is not included."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Itt az öt legutóbbi védett helyi biztonsági mentés marad meg. Megőrzik a kapcsolódási parancsokat és a tanúsítványhivatkozásokat, így az eltávolított kiszolgálók visszaállíthatók. A kulcskarika jelszavai és tanúsítványai nem kerülnek bele. A mappahozzáférési engedélyeket sem tartalmazzák."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die fünf neuesten geschützten lokalen Sicherungen bleiben hier erhalten. Sie enthalten Verbindungsbefehle und Zertifikatsverweise, damit entfernte Server wiederhergestellt werden können. Schlüsselbundpasswörter und Zertifikatsobjekte werden nicht kopiert. Ordnerzugriffsrechte sind nicht enthalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Se conservan aquí las cinco copias de seguridad locales protegidas más recientes. Conservan los comandos de conexión y las referencias a certificados para que se puedan recuperar los servidores eliminados. Las contraseñas de la cartera de llaves y los objetos de certificado no se copian. El acceso a carpetas no está incluido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les cinq sauvegardes locales protégées les plus récentes sont conservées ici. Elles conservent les commandes de connexion et les références aux certificats afin que les serveurs supprimés puissent être récupérés. Les mots de passe de la clé USB et les objets de certificat ne sont pas copiés. L'accès aux dossiers n'est pas inclus."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ここには、最近の5つの保護されたローカルバックアップが保存されています。接続コマンドと証明書参照が保持されているため、削除されたサーバーを復元できます。キーチェーンのパスワードや証明書オブジェクトはコピーされません。フォルダへのアクセスは含まれていません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Os cinco backups locais protegidos mais recentes são mantidos aqui. Eles mantêm comandos de conexão e referências de certificados para que os servidores removidos possam ser recuperados. Senhas de Chaveiro e objetos de certificado não são copiados. O acesso a pastas não está incluído."
          }
        }
      }
    },
    "configuration-changed-after-preview": {
      "comment": "Error shown when the settings or servers changed between preparing a preview and applying it.",
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The current settings changed after this preview was prepared. Cancel and preview the file again. No imported settings were applied."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A jelenlegi beállítások megváltoztak az előnézet elkészítése óta. Szakítsd meg a műveletet, majd nyisd meg újra a fájl előnézetét. Egyetlen importált beállítás sem lett alkalmazva."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die aktuellen Einstellungen wurden seit dem Erstellen dieser Vorschau geändert. Brich ab und öffne die Vorschau erneut. Es wurden keine importierten Einstellungen angewendet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La configuración actual cambió después de preparar esta vista previa. Cancelar y volver a ver la vista previa del archivo. No se aplicaron configuraciones importadas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les paramètres actuels ont changé après la préparation de cette vue d'ensemble. Annulez et prévisualisez à nouveau le fichier. Aucun paramètre importé n'a été appliqué."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "このプレビューを作成した後、現在の設定が変更されました。キャンセルしてファイルを再度プレビューしてください。インポートされた設定は適用されませんでした。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "As configurações atuais mudaram após a preparação desta prévia. Cancelar e visualizar o arquivo novamente. Nenhuma configuração importada foi aplicada."
          }
        }
      }
    },
    "configuration-file-exceeds-size-limit": {
      "comment": "Error shown when a configuration file is larger, or more deeply nested, than the importer accepts.",
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The settings file exceeds the 16 MB size limit or contains too many nested values. No settings were changed."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A beállításfájl meghaladja a 16 MB-os mérethatárt, vagy túl sok egymásba ágyazott értéket tartalmaz. A beállítások nem változtak."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Einstellungsdatei überschreitet das Größenlimit von 16 MB oder enthält zu tief verschachtelte Werte. Es wurden keine Einstellungen geändert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "El archivo de configuración supera el límite de tamaño de 16 MB o contiene demasiados valores anidados. No se han modificado ninguna configuración."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le fichier de paramètres dépasse la limite de taille de 16 Mo ou contient trop de valeurs imbriquées. Aucune configuration n'a été modifiée."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "設定ファイルが16 MBのサイズ制限を超えているか、入れ子構造の値が多すぎるため、設定は変更されませんでした。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O arquivo de configurações excede o limite de tamanho de 16 MB ou contém muitos valores aninhados. Nenhuma configuração foi alterada."
          }
        }
      }
    },
    "configuration-imported-settings-changed": {
      "comment": "Counts in order: changed preferences, added servers, updated servers, removed servers, ignored keys.",
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Settings imported. Values changed: %1$lld. Servers added: %2$lld; updated: %3$lld; removed: %4$lld. Values not imported: %5$lld. The recovery backup is available in Settings."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A beállítások importálva. Módosított értékek: %1$lld. Hozzáadott kiszolgálók: %2$lld; frissítve: %3$lld; eltávolítva: %4$lld. Nem importált értékek: %5$lld. A helyreállítási mentés a Beállításokban érhető el."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einstellungen importiert. Geänderte Werte: %1$lld. Server hinzugefügt: %2$lld; aktualisiert: %3$lld; entfernt: %4$lld. Nicht importierte Werte: %5$lld. Die Wiederherstellungssicherung ist in den Einstellungen verfügbar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Configuración importada. Valores cambiados: %1$lld. Servidores añadidos: %2$lld; actualizados: %3$lld; eliminados: %4$lld. Valores no importados: %5$lld. La copia de seguridad de recuperación está disponible en Configuración."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Paramètres importés. Valeurs modifiées : %1$lld. Serveurs ajoutés : %2$lld ; mis à jour : %3$lld ; supprimés : %4$lld. Valeurs non importées : %5$lld. La sauvegarde de récupération est disponible dans Paramètres."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "設定がインポートされました。変更された値：%1$lld。追加されたサーバー：%2$lld；更新されたサーバー：%3$lld；削除されたサーバー：%4$lld。インポートされていない値：%5$lld。リカバリバックアップは設定で確認できます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Configurações importadas. Valores alterados: %1$lld. Servidores adicionados: %2$lld; atualizados: %3$lld; removidos: %4$lld. Valores não importados: %5$lld. A cópia de segurança de recuperação está disponível em Configurações."
          }
        }
      }
    },
    "configuration-snapshot-uses-a-newer-format": {
      "comment": "Error shown when a configuration file was written by a newer version of the application.",
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This settings file uses a newer format. Update Glasstual before importing it. No settings were changed."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez a beállításfájl újabb formátumot használ. Importálás előtt frissítsd a Glasstualt. A beállítások nem változtak."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Einstellungsdatei verwendet ein neueres Format. Aktualisiere Glasstual vor dem Import. Es wurden keine Einstellungen geändert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Este archivo de configuración utiliza un formato más nuevo. Actualice Glasstual antes de importarlo. No se han cambiado configuraciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ce fichier de paramètres utilise un format plus récent. Mettez à jour Glasstual avant de l'importer. Aucun paramètre n'a été modifié."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "この設定ファイルは新しい形式を使用しています。インポートする前にGlasstualを更新してください。設定は変更されていません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Este arquivo de configurações usa um formato mais novo. Atualize Glasstual antes de importá-lo. Nenhuma configuração foi alterada."
          }
        }
      }
    },
    "configuration-transfer-complete": {
      "comment": "Title of the alert shown after settings are imported or exported successfully.",
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Settings transfer complete"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Beállítások átvitele befejezve"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einstellungsübertragung abgeschlossen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Transferencia de configuración completada"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Transfert des paramètres terminé"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "設定の転送が完了しました"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Transferência de configurações concluída"
          }
        }
      }
    },
    "configuration-transfer-in-progress": {
      "comment": "Error shown when an import or export is started while another one is still running.",
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A settings transfer is already in progress."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Már folyamatban van egy beállításátvitel."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Einstellungsübertragung läuft bereits."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Una transferencia de configuraciones ya está en curso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Un transfert de paramètres est déjà en cours."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "設定の転送はすでに進行中です。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Uma transferência de configurações já está em andamento."
          }
        }
      }
    },
    "configuration-transfer-stopped": {
      "comment": "Title of the alert shown when a settings import or export fails.",
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Settings transfer stopped"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Beállítások átvitele leállt"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einstellungsübertragung gestoppt"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Se ha detenido la transferencia de configuraciones"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le transfert des paramètres a été arrêté"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "設定の転送が停止しました"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Transferência de configurações interrompida"
          }
        }
      }
    },
    "connect-commands-warning": {
      "comment": "Warning next to an export option that defaults to off. Commands are copied verbatim if the user opts in.",
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect commands may contain passwords or other private information. Enable this option only if you intend to include every command in the exported file. Keychain passwords and certificate references are never included in portable exports."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A kapcsolódási parancsok jelszavakat vagy más személyes adatokat tartalmazhatnak. Csak akkor kapcsold be ezt a lehetőséget, ha minden parancsot bele szeretnél foglalni az exportált fájlba. A kulcskarika jelszavai és a tanúsítványhivatkozások sosem kerülnek bele a hordozható exportokba."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbindungsbefehle können Passwörter oder andere private Informationen enthalten. Aktiviere diese Option nur, wenn du sämtliche Befehle in die exportierte Datei aufnehmen möchtest. Schlüsselbundpasswörter und Zertifikatsverweise werden nie in portable Exporte aufgenommen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Los comandos de conexión pueden contener contraseñas u otra información privada. Active esta opción solo si tiene la intención de incluir cada comando en el archivo exportado. Las contraseñas de la cartera de claves y las referencias de certificados nunca se incluyen en las exportaciones portátiles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les commandes de connexion peuvent contenir des mots de passe ou d'autres informations privées. Activez cette option uniquement si vous avez l'intention d'inclure chaque commande dans le fichier exporté. Les mots de passe de la clé USB et les références aux certificats ne sont jamais inclus dans les exportations portables."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "接続コマンドにはパスワードやその他の機密情報が含まれている場合があります。このオプションは、エクスポートされたファイルにすべてのコマンドを含めることを意図している場合にのみ有効にしてください。キーチェーンのパスワードや証明書の参照は、ポータブルエクスポートには一切含まれません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Os comandos de conexão podem conter senhas ou outras informações privadas. Ative esta opção apenas se você pretender incluir todos os comandos no arquivo exportado. As senhas da Chaveiro e as referências de certificados nunca são incluídas em exportações portáteis."
          }
        }
      }
    },
    "enter-a-valid-whole-number": {
      "comment": "Validation note under a Settings number field that was given something that is not a whole number.",
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter a valid whole number. The saved value has not changed."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Adj meg érvényes egész számot. A mentett érték nem változott."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib eine gültige ganze Zahl ein. Der gespeicherte Wert wurde nicht geändert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Introduzca un número entero válido. El valor guardado no ha cambiado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Entrez un nombre entier valide. La valeur enregistrée n'a pas changé."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "有効な整数を入力してください。保存された値は変更されていません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Digite um número inteiro válido. O valor salvo não mudou."
          }
        }
      }
    },
    "export-configuration": {
      "comment": "Settings button that exports settings to a file. The ellipsis marks a button that opens a dialog, so keep it.",
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Export Settings…"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Beállítások exportálása…"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einstellungen exportieren…"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Configuración de exportación..."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Paramètres d'exportation..."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "エクスポート設定…"
          }
        },
