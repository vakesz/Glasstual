    "restore-notice": {
      "comment": "Import preview. What Restore will do, shown under the mode picker.",
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Replace portable settings and remove servers missing from this snapshot. Changed or removed servers will disconnect. Restore proceeds only after a recovery backup has been saved."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Lecseréli a hordozható beállításokat, és eltávolítja a pillanatképből hiányzó kiszolgálókat. A módosított vagy eltávolított kiszolgálók kapcsolata megszakad. A visszaállítás csak helyreállítási mentés készítése után folytatódik."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ersetzt portable Einstellungen und entfernt Server, die in diesem Stand fehlen. Geänderte oder entfernte Server werden getrennt. Die Wiederherstellung erfolgt erst nach dem Sichern einer Wiederherstellungskopie."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Reemplaza la configuración portátil y elimina los servidores que faltan en esta captura de pantalla. Los servidores modificados o eliminados se desconectarán. La restauración solo se procede después de que se haya guardado una copia de seguridad de recuperación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Remplacez les paramètres portables et supprimez les serveurs manquants dans cette capture d'écran. Les serveurs modifiés ou supprimés seront déconnectés. La restauration n'est possible qu'après avoir sauvegardé une sauvegarde de récupération."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ポータブル設定を置き換え、このスナップショットに欠けているサーバーを削除します。変更または削除されたサーバーは接続が切断されます。復元は、リカバリバックアップが保存された後にのみ行われます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Substitua as configurações portáteis e remova os servidores ausentes desta captura de tela. Os servidores alterados ou removidos serão desconectados. A restauração só prossegue após uma cópia de segurança de recuperação ter sido salva."
          }
        }
      }
    },
