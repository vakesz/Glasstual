{
  "sourceLanguage": "en",
  "strings": {
    "apply-settings-and-add-or-update-servers": {
      "comment": "Import preview. What Merge will do, shown under the mode picker.",
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apply the settings in this file and add or update its servers. Keep other servers and settings. Servers being updated will disconnect. A recovery backup is saved first."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Alkalmazd a fájlban lévő beállításokat, és add hozzá vagy frissítsd a kiszolgálókat. A többi kiszolgáló és beállítás megmarad. A frissített kiszolgálók kapcsolata megszakad. Először helyreállítási mentés készül."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wende die Einstellungen aus dieser Datei an und füge die darin enthaltenen Server hinzu oder aktualisiere sie. Andere Server und Einstellungen bleiben erhalten. Aktualisierte Server werden getrennt. Zuerst wird eine Wiederherstellungssicherung erstellt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplica los ajustes de este archivo y añade o actualiza sus servidores. Conserva los demás servidores y ajustes. Los servidores que se actualicen se desconectarán. Antes se guarda una copia de seguridad de recuperación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Applique les réglages de ce fichier et ajoute ou met à jour ses serveurs. Conserve les autres serveurs et réglages. Les serveurs mis à jour seront déconnectés. Une sauvegarde de récupération est d’abord enregistrée."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このファイルの設定を適用し、サーバを追加または更新します。他のサーバと設定は保持されます。更新対象のサーバは切断されます。最初にリカバリ用バックアップが保存されます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplica os ajustes deste arquivo e adiciona ou atualiza os servidores dele. Mantém os outros servidores e ajustes. Os servidores atualizados serão desconectados. Um backup de recuperação é salvo antes."
          }
        }
      }
    },
    "backups-notice": {
      "comment": "Configuration recovery policy, shown in Settings.",
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The five most recent protected local backups are kept here. They retain connect commands and certificate references so removed servers can be recovered. Keychain passwords and certificate objects are not copied. Folder access is not included."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Itt az öt legutóbbi védett helyi biztonsági mentés marad meg. Megőrzik a kapcsolódási parancsokat és a tanúsítványhivatkozásokat, így az eltávolított kiszolgálók visszaállíthatók. A kulcskarika jelszavai és tanúsítványai nem kerülnek bele. A mappahozzáférési engedélyeket sem tartalmazzák."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die fünf neuesten geschützten lokalen Sicherungen bleiben hier erhalten. Sie enthalten Verbindungsbefehle und Zertifikatsverweise, damit entfernte Server wiederhergestellt werden können. Schlüsselbundpasswörter und Zertifikatsobjekte werden nicht kopiert. Ordnerzugriffsrechte sind nicht enthalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquí se conservan las cinco copias de seguridad locales protegidas más recientes. Incluyen los comandos de conexión y las referencias a certificados para poder recuperar los servidores eliminados. Las contraseñas del llavero y los objetos de certificado no se copian. No se incluye el acceso a carpetas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les cinq sauvegardes locales protégées les plus récentes sont conservées ici. Elles conservent les commandes de connexion et les références de certificats afin de pouvoir récupérer les serveurs supprimés. Les mots de passe du trousseau et les objets de certificat ne sont pas copiés. L’accès aux dossiers n’est pas inclus."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保護されたローカルバックアップが、最新の5件まで保持されます。接続コマンドと証明書の参照が含まれるため、削除したサーバを復元できます。キーチェーンのパスワードと証明書オブジェクトはコピーされません。フォルダへのアクセス権は含まれません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os cinco backups locais protegidos mais recentes são mantidos aqui. Eles retêm comandos de conexão e referências de certificados para que servidores removidos possam ser recuperados. As senhas do chaveiro e os objetos de certificado não são copiados. O acesso a pastas não está incluído."
          }
        }
      }
    },
    "configuration-changed-after-preview": {
      "comment": "Error shown when the settings or servers changed between preparing a preview and applying it.",
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The current settings changed after this preview was prepared. Cancel and preview the file again. No imported settings were applied."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A jelenlegi beállítások megváltoztak az előnézet elkészítése óta. Szakítsd meg a műveletet, majd nyisd meg újra a fájl előnézetét. Egyetlen importált beállítás sem lett alkalmazva."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die aktuellen Einstellungen wurden seit dem Erstellen dieser Vorschau geändert. Brich ab und öffne die Vorschau erneut. Es wurden keine importierten Einstellungen angewendet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los ajustes actuales cambiaron después de preparar esta vista previa. Cancela y vuelve a previsualizar el archivo. No se aplicó ningún ajuste importado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les réglages actuels ont changé après la préparation de cet aperçu. Annulez et prévisualisez à nouveau le fichier. Aucun réglage importé n’a été appliqué."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このプレビューの準備後に、現在の設定が変更されました。キャンセルして、もう一度ファイルをプレビューしてください。読み込んだ設定は適用されていません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os ajustes atuais mudaram depois que esta prévia foi preparada. Cancele e visualize o arquivo novamente. Nenhum ajuste importado foi aplicado."
          }
        }
      }
    },
    "configuration-file-exceeds-size-limit": {
      "comment": "Error shown when a configuration file is larger, or more deeply nested, than the importer accepts.",
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The settings file exceeds the 16 MB size limit or contains too many nested values. No settings were changed."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A beállításfájl meghaladja a 16 MB-os mérethatárt, vagy túl sok egymásba ágyazott értéket tartalmaz. A beállítások nem változtak."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Einstellungsdatei überschreitet das Größenlimit von 16 MB oder enthält zu tief verschachtelte Werte. Es wurden keine Einstellungen geändert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El archivo de ajustes supera el límite de tamaño de 16 MB o contiene demasiados valores anidados. No se modificó ningún ajuste."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fichier de réglages dépasse la limite de taille de 16 Mo ou contient trop de valeurs imbriquées. Aucun réglage n’a été modifié."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定ファイルが16 MBのサイズ制限を超えているか、入れ子の値が多すぎます。設定は変更されていません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O arquivo de ajustes excede o limite de tamanho de 16 MB ou contém valores aninhados demais. Nenhum ajuste foi alterado."
          }
        }
      }
    },
    "configuration-imported-settings-changed": {
      "comment": "Counts in order: changed preferences, added servers, updated servers, removed servers, ignored keys.",
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Settings imported. Values changed: %1$lld. Servers added: %2$lld; updated: %3$lld; removed: %4$lld. Values not imported: %5$lld. The recovery backup is available in Settings."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A beállítások importálva. Módosított értékek: %1$lld. Hozzáadott kiszolgálók: %2$lld; frissítve: %3$lld; eltávolítva: %4$lld. Nem importált értékek: %5$lld. A helyreállítási mentés a Beállításokban érhető el."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einstellungen importiert. Geänderte Werte: %1$lld. Server hinzugefügt: %2$lld; aktualisiert: %3$lld; entfernt: %4$lld. Nicht importierte Werte: %5$lld. Die Wiederherstellungssicherung ist in den Einstellungen verfügbar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajustes importados. Valores cambiados: %1$lld. Servidores añadidos: %2$lld; actualizados: %3$lld; eliminados: %4$lld. Valores no importados: %5$lld. La copia de seguridad de recuperación está disponible en Ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réglages importés. Valeurs modifiées : %1$lld. Serveurs ajoutés : %2$lld ; mis à jour : %3$lld ; supprimés : %4$lld. Valeurs non importées : %5$lld. La sauvegarde de récupération est disponible dans les réglages."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定を読み込みました。変更された値: %1$lld。追加されたサーバ: %2$lld、更新: %3$lld、削除: %4$lld。読み込まれなかった値: %5$lld。リカバリ用バックアップは設定で確認できます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajustes importados. Valores alterados: %1$lld. Servidores adicionados: %2$lld; atualizados: %3$lld; removidos: %4$lld. Valores não importados: %5$lld. O backup de recuperação está disponível em Ajustes."
          }
        }
      }
    },
    "configuration-snapshot-uses-a-newer-format": {
      "comment": "Error shown when a configuration file was written by a newer version of the application.",
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This settings file uses a newer format. Update Glasstual before importing it. No settings were changed."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez a beállításfájl újabb formátumot használ. Importálás előtt frissítsd a Glasstualt. A beállítások nem változtak."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Einstellungsdatei verwendet ein neueres Format. Aktualisiere Glasstual vor dem Import. Es wurden keine Einstellungen geändert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este archivo de ajustes usa un formato más reciente. Actualiza Glasstual antes de importarlo. No se modificó ningún ajuste."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce fichier de réglages utilise un format plus récent. Mettez à jour Glasstual avant de l’importer. Aucun réglage n’a été modifié."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この設定ファイルは、より新しい形式を使用しています。読み込む前にGlasstualをアップデートしてください。設定は変更されていません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este arquivo de ajustes usa um formato mais recente. Atualize o Glasstual antes de importá-lo. Nenhum ajuste foi alterado."
          }
        }
      }
    },
    "configuration-transfer-complete": {
      "comment": "Title of the alert shown after settings are imported or exported successfully.",
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Settings transfer complete"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Beállítások átvitele befejezve"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einstellungsübertragung abgeschlossen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Transferencia de ajustes completada"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Transfert des réglages terminé"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定の転送が完了しました"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Transferência de ajustes concluída"
          }
        }
      }
    },
    "configuration-transfer-in-progress": {
      "comment": "Error shown when an import or export is started while another one is still running.",
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A settings transfer is already in progress."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Már folyamatban van egy beállításátvitel."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Einstellungsübertragung läuft bereits."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya hay una transferencia de ajustes en curso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un transfert de réglages est déjà en cours."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定の転送はすでに実行中です。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Já há uma transferência de ajustes em andamento."
          }
        }
      }
    },
    "configuration-transfer-stopped": {
      "comment": "Title of the alert shown when a settings import or export fails.",
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Settings transfer stopped"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Beállítások átvitele leállt"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einstellungsübertragung gestoppt"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se detuvo la transferencia de ajustes"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Transfert des réglages interrompu"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定の転送が停止しました"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Transferência de ajustes interrompida"
          }
        }
      }
    },
    "connect-commands-warning": {
      "comment": "Warning next to an export option that defaults to off. Commands are copied verbatim if the user opts in.",
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect commands may contain passwords or other private information. Enable this option only if you intend to include every command in the exported file. Keychain passwords and certificate references are never included in portable exports."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A kapcsolódási parancsok jelszavakat vagy más személyes adatokat tartalmazhatnak. Csak akkor kapcsold be ezt a lehetőséget, ha minden parancsot bele szeretnél foglalni az exportált fájlba. A kulcskarika jelszavai és a tanúsítványhivatkozások sosem kerülnek bele a hordozható exportokba."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbindungsbefehle können Passwörter oder andere private Informationen enthalten. Aktiviere diese Option nur, wenn du sämtliche Befehle in die exportierte Datei aufnehmen möchtest. Schlüsselbundpasswörter und Zertifikatsverweise werden nie in portable Exporte aufgenommen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los comandos de conexión pueden contener contraseñas u otra información privada. Activa esta opción solo si quieres incluir todos los comandos en el archivo exportado. Las contraseñas del llavero y las referencias a certificados nunca se incluyen en las exportaciones portátiles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les commandes de connexion peuvent contenir des mots de passe ou d’autres informations privées. Activez cette option uniquement si vous voulez inclure chaque commande dans le fichier exporté. Les mots de passe du trousseau et les références de certificats ne sont jamais inclus dans les exportations portables."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続コマンドには、パスワードなどの個人情報が含まれている場合があります。書き出すファイルにすべてのコマンドを含める場合にのみ、このオプションを有効にしてください。キーチェーンのパスワードと証明書の参照は、ポータブルな書き出しには含まれません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os comandos de conexão podem conter senhas ou outras informações privadas. Ative esta opção somente se quiser incluir todos os comandos no arquivo exportado. As senhas do chaveiro e as referências de certificados nunca são incluídas em exportações portáteis."
          }
        }
      }
    },
    "enter-a-valid-whole-number": {
      "comment": "Validation note under a Settings number field that was given something that is not a whole number.",
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter a valid whole number. The saved value has not changed."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Adj meg érvényes egész számot. A mentett érték nem változott."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib eine gültige ganze Zahl ein. Der gespeicherte Wert wurde nicht geändert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduce un número entero válido. El valor guardado no ha cambiado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez un nombre entier valide. La valeur enregistrée n’a pas changé."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "有効な整数を入力してください。保存されている値は変更されていません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Digite um número inteiro válido. O valor salvo não foi alterado."
          }
        }
      }
    },
    "export-configuration": {
      "comment": "Settings button that exports settings to a file. The ellipsis marks a button that opens a dialog, so keep it.",
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Export Settings…"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Beállítások exportálása…"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einstellungen exportieren…"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Exportar ajustes…"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Exporter les réglages…"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定を書き出す…"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Exportar ajustes…"
          }
        }
      }
    },
    "export-options": {
      "comment": "Title of the sheet that asks what an exported settings file should include.",
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Export Settings"
          }
        },
