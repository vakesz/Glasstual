          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O texto com estes esquemas de link se torna clicável: %@"
          }
        }
      }
    },
    "servers-did-not-disconnect": {
      "comment": "Error shown when an import had to disconnect servers first and at least one of them did not disconnect in time. The import is abandoned and the servers reconnect.",
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some servers did not disconnect in time, so no imported settings were applied. Glasstual is reconnecting the servers it disconnected."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Néhány kiszolgáló kapcsolata nem szakadt meg időben, ezért az importált beállítások nem lettek alkalmazva. A Glasstual újracsatlakozik azokhoz a kiszolgálókhoz, amelyek kapcsolatát bontotta."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einige Server wurden nicht rechtzeitig getrennt. Daher wurden keine importierten Einstellungen angewendet. Glasstual verbindet die zuvor getrennten Server erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Algunos servidores no se desconectaron a tiempo, por lo que no se aplicó ningún ajuste importado. Glasstual está volviendo a conectar los servidores que desconectó."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Certains serveurs ne se sont pas déconnectés à temps ; aucun réglage importé n’a donc été appliqué. Glasstual reconnecte les serveurs qu’il avait déconnectés."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一部のサーバが時間内に切断されなかったため、読み込んだ設定は適用されませんでした。Glasstualは、切断したサーバに再接続しています。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Alguns servidores não se desconectaram a tempo, então nenhum ajuste importado foi aplicado. O Glasstual está reconectando os servidores que desconectou."
          }
        }
      }
    },
