    "legacy-notice": {
      "comment": "Import preview. Note shown for an older, partial configuration file, which can only be merged.",
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This legacy file contains only selected settings. It can be merged, but cannot be used to restore a complete configuration."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez a régi fájl csak néhány beállítást tartalmaz. Összevonható a jelenlegi beállításokkal, de teljes konfiguráció visszaállítására nem használható."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese ältere Datei enthält nur ausgewählte Einstellungen. Sie kann zusammengeführt werden, aber keine vollständige Konfiguration wiederherstellen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Este archivo de legado contiene solo la configuración seleccionada. Puede fusionarse, pero no se puede usar para restaurar una configuración completa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ce fichier de sauvegarde ne contient que les paramètres sélectionnés. Il peut être fusionné, mais ne peut pas être utilisé pour restaurer une configuration complète."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "このレガシーファイルには、選択された設定のみが含まれています。統合することはできますが、完全な構成を復元するために使用することはできません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Este arquivo de legado contém apenas configurações selecionadas. Ele pode ser mesclado, mas não pode ser usado para restaurar uma configuração completa."
          }
        }
      }
    },
    "local-recovery-notice": {
      "comment": "Import preview. What a protected local backup restores that a portable file cannot.",
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This protected local backup restores original connect commands and certificate references, including for removed servers. Keychain objects stay on this Mac and are not imported. Recovered servers do not connect automatically."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez a védett helyi biztonsági mentés visszaállítja az eredeti kapcsolódási parancsokat és tanúsítványhivatkozásokat, az eltávolított kiszolgálókét is. A kulcskarika elemei ezen a Macen maradnak, és nem lesznek importálva. A visszaállított kiszolgálókhoz nem kapcsolódunk automatikusan."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese geschützte lokale Sicherung stellt ursprüngliche Verbindungsbefehle und Zertifikatsverweise wieder her, auch für entfernte Server. Schlüsselbundobjekte bleiben auf diesem Mac und werden nicht importiert. Wiederhergestellte Server verbinden sich nicht automatisch."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Esta copia de seguridad local protegida restaura los comandos de conexión originales y las referencias de certificados, incluidas las de los servidores eliminados. Los objetos de la cartera de claves permanecen en este Mac y no se importan. Los servidores recuperados no se conectan automáticamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cette sauvegarde locale protégée restaure les commandes de connexion et les références de certificats d’origine, y compris pour les serveurs supprimés. Les objets de la clé USB restent sur ce Mac et ne sont pas importés. Les serveurs récupérés ne se connectent pas automatiquement."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "この保護されたローカルバックアップでは、削除されたサーバーを含む、元の接続コマンドと証明書参照が復元されます。キーチェーンオブジェクトはこのMacに残っており、インポートされません。復元されたサーバーは自動的に接続されません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Esta cópia de segurança local protegida restaura os comandos de conexão originais e as referências de certificados, incluindo para servidores removidos. Os objetos do Chaveiro permanecem neste Mac e não são importados. Os servidores recuperados não se conectam automaticamente."
          }
        }
      }
    },
