    "restore-notice": {
      "comment": "Import preview. What Restore will do, shown under the mode picker.",
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Replace portable settings and remove servers missing from this snapshot. Changed or removed servers will disconnect. Restore proceeds only after a recovery backup has been saved."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Lecseréli a hordozható beállításokat, és eltávolítja a pillanatképből hiányzó kiszolgálókat. A módosított vagy eltávolított kiszolgálók kapcsolata megszakad. A visszaállítás csak helyreállítási mentés készítése után folytatódik."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ersetzt portable Einstellungen und entfernt Server, die in diesem Stand fehlen. Geänderte oder entfernte Server werden getrennt. Die Wiederherstellung erfolgt erst nach dem Sichern einer Wiederherstellungskopie."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sustituye los ajustes portátiles y elimina los servidores que no figuran en esta instantánea. Los servidores modificados o eliminados se desconectarán. La restauración solo continúa después de guardar una copia de seguridad de recuperación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Remplace les réglages portables et supprime les serveurs absents de cet instantané. Les serveurs modifiés ou supprimés seront déconnectés. La restauration n’a lieu qu’après l’enregistrement d’une sauvegarde de récupération."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ポータブル設定を置き換え、このスナップショットに含まれていないサーバを削除します。変更または削除されたサーバは切断されます。復元は、リカバリ用バックアップが保存された後にのみ実行されます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Substitui os ajustes portáteis e remove os servidores ausentes deste instantâneo. Os servidores alterados ou removidos serão desconectados. A restauração só prossegue depois que um backup de recuperação for salvo."
          }
        }
      }
    },
