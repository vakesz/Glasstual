    "servers-did-not-disconnect": {
      "comment": "Error shown when an import had to disconnect servers first and at least one of them did not disconnect in time. The import is abandoned and the servers reconnect.",
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some servers did not disconnect in time, so no imported settings were applied. Glasstual is reconnecting the servers it disconnected."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Néhány kiszolgáló kapcsolata nem szakadt meg időben, ezért az importált beállítások nem lettek alkalmazva. A Glasstual újracsatlakozik azokhoz a kiszolgálókhoz, amelyek kapcsolatát bontotta."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einige Server wurden nicht rechtzeitig getrennt. Daher wurden keine importierten Einstellungen angewendet. Glasstual verbindet die zuvor getrennten Server erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Algunos servidores no se desconectaron a tiempo, por lo que no se aplicaron las configuraciones importadas. Glasstual está reconectando los servidores que desconectó."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Certains serveurs ne se sont pas déconnectés à temps, de sorte que aucune configuration importée n'a été appliquée. Glasstual se reconnecte aux serveurs qu'il a déconnectés."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "一部のサーバーが時間内に接続を切り離さなかったため、インポートされた設定は適用されませんでした。Glasstualは、切り離したサーバーを再接続しています。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Alguns servidores não se desconectaram a tempo, portanto nenhuma configuração importada foi aplicada. Glasstual está reconectando os servidores que desconectou."
          }
        }
      }
    },
