    "risky-changes-notice": {
      "comment": "Import preview. Explains the block that lists changes which can send commands or widen what Glasstual trusts.",
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This file changes settings that can send commands to servers or change what Glasstual trusts. Read each one before importing."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez a fájl olyan beállításokat módosít, amelyek parancsokat küldhetnek a kiszolgálóknak, vagy megváltoztathatják, miben bízik meg a Glasstual. Importálás előtt olvasd el mindegyiket."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Datei ändert Einstellungen, die Befehle an Server senden oder beeinflussen können, welchen Inhalten Glasstual vertraut. Lies jeden Eintrag vor dem Import."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este archivo cambia ajustes que pueden enviar comandos a servidores o modificar aquello en lo que Glasstual confía. Lee cada uno antes de importarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce fichier modifie des réglages qui peuvent envoyer des commandes aux serveurs ou modifier ce à quoi Glasstual fait confiance. Lisez-les un par un avant d’importer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このファイルは、サーバにコマンドを送信したり、Glasstualが信頼する対象を変更したりする設定を変更します。読み込む前に、それぞれの内容をよく確認してください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este arquivo altera ajustes que podem enviar comandos a servidores ou mudar aquilo em que o Glasstual confia. Leia cada um antes de importar."
          }
        }
      }
    },
