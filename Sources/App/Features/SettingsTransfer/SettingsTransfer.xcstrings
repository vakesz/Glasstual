    "risky-server-endpoint-same-server": {
      "comment": "Import preview. A server in the file connects to a different address than this Mac's copy, which keeps its saved passwords. The first argument is the server's name, the second is where it connects now, the third is where the file sends it.",
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Server “%1$@” would connect to %3$@ instead of %2$@. It keeps its saved passwords, so they would be sent to the new address."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A(z) \"%1$@\" kiszolgáló ide csatlakozna: %3$@ (eddig: %2$@). Megtartja a mentett jelszavait, így azok az új címre kerülnének elküldésre."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server \"%1$@\" würde sich mit %3$@ statt mit %2$@ verbinden. Er behält seine gespeicherten Passwörter, sie würden also an die neue Adresse gesendet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor «%1$@» se conectaría a %3$@ en lugar de a %2$@. Conserva sus contraseñas guardadas, por lo que se enviarían a la nueva dirección."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur « %1$@ » se connecterait à %3$@ au lieu de %2$@. Il conserve ses mots de passe enregistrés, qui seraient donc envoyés à la nouvelle adresse."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバ「%1$@」は%2$@ではなく%3$@に接続するようになります。保存済みのパスワードは引き継がれるため、新しいアドレスに送信されます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O servidor “%1$@” se conectaria a %3$@ em vez de %2$@. Ele mantém as senhas salvas, que seriam enviadas ao novo endereço."
          }
        }
      }
    },
    "risky-server-endpoint-new-kept": {
      "comment": "Import preview, Merge. A server in the file connects to a different address than this Mac's server with the same identity, so it is imported as a new server without secrets or history and this Mac's server is left alone. Arguments: the server's name, where this Mac's server connects, where the file's server connects.",
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Server “%1$@” connects to %3$@ in this file. It is imported as a new server, without saved passwords, certificate, connect commands or history. This Mac’s server connecting to %2$@ stays as it is."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A(z) \"%1$@\" kiszolgáló ebben a fájlban ide csatlakozik: %3$@. Új kiszolgálóként lesz importálva, mentett jelszavak, tanúsítvány, csatlakozási parancsok és előzmények nélkül. A Mac-en lévő, ide csatlakozó kiszolgáló (%2$@) változatlan marad."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server \"%1$@\" verbindet sich in dieser Datei mit %3$@. Er wird als neuer Server importiert, ohne gespeicherte Passwörter, Zertifikat, Verbindungsbefehle oder Verlauf. Der Server dieses Macs, der sich mit %2$@ verbindet, bleibt unverändert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor «%1$@» se conecta a %3$@ en este archivo. Se importa como un servidor nuevo, sin contraseñas guardadas, certificado, comandos de conexión ni historial. El servidor de este Mac que se conecta a %2$@ no cambia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans ce fichier, le serveur « %1$@ » se connecte à %3$@. Il est importé comme un nouveau serveur, sans mots de passe enregistrés, certificat, commandes de connexion ni historique. Le serveur de ce Mac qui se connecte à %2$@ reste inchangé."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このファイルでは、サーバ「%1$@」は%3$@に接続します。保存済みのパスワード、証明書、接続時コマンド、履歴を含まない新しいサーバとして読み込まれます。%2$@に接続するこのMacのサーバは変更されません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Neste arquivo, o servidor “%1$@” se conecta a %3$@. Ele é importado como um novo servidor, sem senhas salvas, certificado, comandos de conexão ou histórico. O servidor deste Mac que se conecta a %2$@ permanece como está."
          }
        }
      }
    },
    "risky-server-endpoint-new-removed": {
      "comment": "Import preview, Restore. A server in the file connects to a different address than this Mac's server with the same identity, so it replaces that server as a new one without secrets or history, and the replaced server's history is not carried over. Arguments: the server's name, where this Mac's server connects, where the file's server connects.",
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Server “%1$@” connects to %3$@ in this file and replaces this Mac’s server for %2$@. It starts as a new server, without saved passwords, certificate, connect commands or history. The replaced server is removed and its history is not carried over."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A(z) \"%1$@\" kiszolgáló ebben a fájlban ide csatlakozik: %3$@, és leváltja a Mac-en lévő, %2$@ címhez tartozó kiszolgálót. Új kiszolgálóként indul, mentett jelszavak, tanúsítvány, csatlakozási parancsok és előzmények nélkül. A leváltott kiszolgáló el lesz távolítva, az előzményei nem kerülnek át."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server \"%1$@\" verbindet sich in dieser Datei mit %3$@ und ersetzt den Server dieses Macs für %2$@. Er startet als neuer Server, ohne gespeicherte Passwörter, Zertifikat, Verbindungsbefehle oder Verlauf. Der ersetzte Server wird entfernt, sein Verlauf wird nicht übernommen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor «%1$@» se conecta a %3$@ en este archivo y sustituye al servidor de este Mac para %2$@. Empieza como un servidor nuevo, sin contraseñas guardadas, certificado, comandos de conexión ni historial. El servidor sustituido se elimina y su historial no se traslada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans ce fichier, le serveur « %1$@ » se connecte à %3$@ et remplace le serveur de ce Mac pour %2$@. Il démarre comme un nouveau serveur, sans mots de passe enregistrés, certificat, commandes de connexion ni historique. Le serveur remplacé est supprimé et son historique n’est pas repris."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このファイルでは、サーバ「%1$@」は%3$@に接続し、%2$@用のこのMacのサーバを置き換えます。保存済みのパスワード、証明書、接続時コマンド、履歴を含まない新しいサーバとして開始されます。置き換えられるサーバは削除され、その履歴は引き継がれません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Neste arquivo, o servidor “%1$@” se conecta a %3$@ e substitui o servidor deste Mac para %2$@. Ele começa como um novo servidor, sem senhas salvas, certificado, comandos de conexão ou histórico. O servidor substituído é removido e o histórico dele não é transferido."
          }
        }
      }
    },
