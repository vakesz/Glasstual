    "local-recovery-notice": {
      "comment": "Import preview. What a protected local backup restores that a portable file cannot.",
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This protected local backup restores original connect commands and certificate references, including for removed servers. Keychain objects stay on this Mac and are not imported. Recovered servers do not connect automatically."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez a védett helyi biztonsági mentés visszaállítja az eredeti kapcsolódási parancsokat és tanúsítványhivatkozásokat, az eltávolított kiszolgálókét is. A kulcskarika elemei ezen a Macen maradnak, és nem lesznek importálva. A visszaállított kiszolgálókhoz nem kapcsolódunk automatikusan."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese geschützte lokale Sicherung stellt ursprüngliche Verbindungsbefehle und Zertifikatsverweise wieder her, auch für entfernte Server. Schlüsselbundobjekte bleiben auf diesem Mac und werden nicht importiert. Wiederhergestellte Server verbinden sich nicht automatisch."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta copia de seguridad local protegida restaura los comandos de conexión originales y las referencias a certificados, incluidas las de los servidores eliminados. Los objetos del llavero permanecen en este Mac y no se importan. Los servidores recuperados no se conectan automáticamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette sauvegarde locale protégée restaure les commandes de connexion et les références de certificats d’origine, y compris pour les serveurs supprimés. Les objets du trousseau restent sur ce Mac et ne sont pas importés. Les serveurs récupérés ne se connectent pas automatiquement."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このローカルの保護されたバックアップでは、削除されたサーバを含め、元の接続コマンドと証明書の参照が復元されます。キーチェーンのオブジェクトはこのMacに残り、読み込まれません。復元されたサーバは自動的には接続されません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este backup local protegido restaura os comandos de conexão e as referências de certificados originais, inclusive de servidores removidos. Os objetos do chaveiro permanecem neste Mac e não são importados. Os servidores recuperados não se conectam automaticamente."
          }
        }
      }
    },
    "merge": {
