        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@中%1$@(%3$@/秒)を%4$@から受信 — 残り%5$@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ de %2$@ (%3$@/s) recebidos de %4$@ — %5$@ restantes"
          }
        }
      }
    },
