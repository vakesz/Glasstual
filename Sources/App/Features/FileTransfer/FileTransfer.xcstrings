    "preparing-the-transfer": {
      "comment": "Status covering every step between starting a transfer and reaching the peer: mapping the listening port, determining the local IP address, and initializing. Replaces the legacy per-step entries 495-90, j1z-88, 6t1-mb, onl-av, 42z-mg and pcv-kg, none of which told the user anything actionable.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Preparing the transfer…"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Átvitel előkészítése…"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Übertragung wird vorbereitet…"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Preparando la transferencia…"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Préparation du transfert…"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "転送の準備中…"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Preparando a transferência…"
          }
        }
      }
    },
    "quarantine-failed": {
      "comment": "Console notice when a file received over DCC could not be given the quarantine mark for files downloaded from the internet, so macOS will not run its download checks when it is opened. %1$@ is the file name.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” was received, but could not be marked as downloaded from the internet. macOS will not check it when it is opened."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A(z) „%1$@” megérkezett, de nem sikerült internetről letöltöttként megjelölni. A macOS nem fogja ellenőrizni megnyitáskor."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "„%1$@“ wurde empfangen, konnte aber nicht als aus dem Internet geladen markiert werden. macOS prüft die Datei beim Öffnen nicht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Se recibió «%1$@», pero no se pudo marcar como descargado de internet. macOS no lo comprobará al abrirlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "« %1$@ » a été reçu, mais n’a pas pu être marqué comme téléchargé depuis Internet. macOS ne le vérifiera pas à son ouverture."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "「%1$@」を受信しましたが、インターネットからダウンロードされたものとして印を付けられませんでした。開くときにmacOSによる確認は行われません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "“%1$@” foi recebido, mas não pôde ser marcado como baixado da internet. O macOS não o verificará ao abri-lo."
          }
        }
      }
    },
