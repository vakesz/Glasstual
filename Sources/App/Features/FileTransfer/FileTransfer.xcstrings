      }
    },
    "transfer-with-failed-could-not-read": {
      "comment": "File-transfer error when the source file cannot be opened or read. The argument is the peer nickname. Legacy key: nab-dx.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not read the file being sent to %@. Check that it still exists and that you can open it."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nem sikerült olvasni a(z) %@ részére küldendő fájlt. Ellenőrizd, hogy még létezik-e, és meg tudod-e nyitni."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die an %@ zu sendende Datei konnte nicht gelesen werden. Prüfe, ob sie noch vorhanden ist und du sie öffnen kannst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo leer el archivo que se está enviando a %@. Comprueba que aún existe y que puedes abrirlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de lire le fichier envoyé à %@. Vérifiez qu’il existe toujours et que vous pouvez l’ouvrir."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@に送信するファイルを読み取れませんでした。ファイルが存在し、開けることを確認してください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível ler o arquivo que está sendo enviado para %@. Verifique se ele ainda existe e se você pode abri-lo."
          }
        }
      }
    },
    "transfer-with-failed-file-handler-threw": {
      "comment": "File-transfer error when writing the destination file fails. The argument is the peer nickname. Legacy key: 05g-c8.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not write the file from %@. Check that the destination folder still exists and that you can write to it."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nem sikerült menteni %@ fájlját. Ellenőrizd, hogy a célmappa még létezik-e, és tudsz-e bele írni."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Datei von %@ konnte nicht geschrieben werden. Prüfe, ob der Zielordner noch vorhanden ist und du darin schreiben darfst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo escribir el archivo desde %@. Comprueba que la carpeta de destino sigue existiendo y que puedes escribir en ella."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d’écrire le fichier de %@. Vérifiez que le dossier de destination existe toujours et que vous pouvez y écrire."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@から受信したファイルを書き込めませんでした。保存先のフォルダが存在し、書き込めることを確認してください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível gravar o arquivo de %@. Verifique se a pasta de destino ainda existe e se você tem permissão para gravar nela."
          }
        }
      }
    },
    "transfer-with-failed-no-answer": {
      "comment": "File-transfer error when the peer never answered the connection attempt. The argument is the peer nickname.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ did not answer in time. They may be offline or behind a firewall."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ nem válaszolt időben. Lehet, hogy nincs csatlakozva, vagy tűzfal mögött van."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hat nicht rechtzeitig geantwortet. Die Person ist möglicherweise offline oder hinter einer Firewall."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ no respondió a tiempo. Es posible que esté sin conexión o detrás de un cortafuegos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ n’a pas répondu à temps. La personne est peut-être hors ligne ou derrière un pare-feu."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@が時間内に応答しませんでした。相手がオフラインか、ファイアウォールの内側にいる可能性があります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ não respondeu a tempo. A pessoa pode estar offline ou atrás de um firewall."
          }
        }
      }
    },
    "transfer-with-failed-no-space-left": {
      "comment": "File-transfer error when the destination device has no remaining space. The argument is the peer nickname. Legacy key: 79f-s0.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There is not enough free space to save the file from %@. Free some space, then start the transfer again."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nincs elég szabad hely %@ fájljának mentéséhez. Szabadíts fel helyet, majd indítsd újra az átvitelt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es ist nicht genügend Speicherplatz vorhanden, um die Datei von %@ zu sichern. Gib Speicherplatz frei und starte die Übertragung erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay suficiente espacio libre para guardar el archivo de %@. Libera algo de espacio y vuelve a iniciar la transferencia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il n’y a pas assez d’espace libre pour enregistrer le fichier de %@. Libérez de l’espace, puis relancez le transfert."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@から受信したファイルを保存するための空き容量が足りません。空き容量を確保してから、もう一度転送を開始してください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não há espaço livre suficiente para salvar o arquivo de %@. Libere espaço e inicie a transferência novamente."
          }
        }
      }
    },
    "transfer-with-failed-peer-closed": {
      "comment": "File-transfer error when the peer closed the connection early. The argument is the peer nickname.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ closed the connection before the transfer finished. Start it again to resume."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ lezárta a kapcsolatot az átvitel befejezése előtt. A folytatáshoz indítsd el újra az átvitelt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hat die Verbindung vor Abschluss der Übertragung geschlossen. Starte sie erneut, um fortzufahren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ cerró la conexión antes de que terminara la transferencia. Vuelve a iniciarla para reanudarla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ a fermé la connexion avant la fin du transfert. Relancez-le pour reprendre."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "転送が完了する前に%@が接続を閉じました。再開するには、もう一度開始してください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ fechou a conexão antes de a transferência terminar. Inicie-a novamente para retomar."
          }
        }
      }
    },
    "transfer-with-failed-proposed-resume-position": {
      "comment": "File-transfer error when resuming is impossible: the peer's resume position does not match the partly transferred file, or that file is gone or larger than the offer. Try Again starts the file over under a new name and keeps the partial file. The argument is the peer nickname. Legacy key: 0ov-tr.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not resume the transfer with %@. Choose Try Again to start it over from the beginning."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nem sikerült folytatni az átvitelt %@ gépével. Az Újrapróbálkozás lehetőséggel elölről kezdheted."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Übertragung mit %@ konnte nicht fortgesetzt werden. Wähle Erneut versuchen, um von vorne zu beginnen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo reanudar la transferencia con %@. Elige Inténtalo de nuevo para empezar desde el principio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de reprendre le transfert avec %@. Choisissez Réessayer pour le recommencer depuis le début."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@との転送を再開できませんでした。最初からやり直すには「再試行」を選択してください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível retomar a transferência com %@. Escolha Tentar novamente para recomeçar do início."
          }
        }
      }
    },
    "transfer-with-failed-resume-not-answered": {
      "comment": "File-transfer error when the peer never answered a request to resume. Try Again starts the file over under a new name and keeps the partial file. The argument is the peer nickname.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ did not agree to resume the transfer. Choose Try Again to start it over from the beginning."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ nem hagyta jóvá az átvitel folytatását. Az Újrapróbálkozás lehetőséggel elölről kezdheted."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hat dem Fortsetzen nicht zugestimmt. Wähle Erneut versuchen, um von vorne zu beginnen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ no aceptó reanudar la transferencia. Elige Inténtalo de nuevo para empezar desde el principio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ n’a pas accepté de reprendre le transfert. Choisissez Réessayer pour le recommencer depuis le début."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@が転送の再開に同意しませんでした。最初からやり直すには「再試行」を選択してください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ não concordou em retomar a transferência. Escolha Tentar novamente para recomeçar do início."
          }
        }
      }
    },
    "transfer-with-failed-stalled": {
      "comment": "File-transfer error when the connection to the peer stopped moving data: a write that did not complete, or a download that received nothing for too long. The argument is the peer nickname.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The connection to %@ stopped responding, so the transfer was cancelled. Start it again to resume."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kapcsolata nem válaszolt, ezért az átvitel megszakadt. A folytatáshoz indítsd el újra."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Verbindung zu %@ hat nicht mehr reagiert. Die Übertragung wurde abgebrochen. Starte sie erneut, um fortzufahren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La conexión con %@ dejó de responder, por lo que se canceló la transferencia. Vuelve a iniciarla para reanudarla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La connexion à %@ ne répond plus, le transfert a donc été annulé. Relancez-le pour reprendre."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@への接続が応答しなくなったため、転送がキャンセルされました。再開するには、もう一度開始してください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A conexão com %@ parou de responder, então a transferência foi cancelada. Inicie-a novamente para retomar."
          }
        }
      }
    },
    "transfer-with-failed-there-is-no": {
      "comment": "File-transfer error when no listening port is available. The argument is the peer nickname. Legacy key: vxc-sd.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No port was free for the transfer with %@. Widen the port range in File Transfer settings, then try again."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nincs szabad port a(z) %@ gépével végzett átvitelhez. Bővítsd a porttartományt a Fájlátvitel beállításaiban, majd próbáld újra."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Port für die Übertragung mit %@ verfügbar. Erweitere den Portbereich in den Dateiübertragungseinstellungen und versuche es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No había ningún puerto libre para la transferencia con %@. Amplía el rango de puertos en los ajustes de Transferencia de archivos y vuelve a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun port n’était libre pour le transfert avec %@. Élargissez la plage de ports dans les réglages Transfert de fichiers, puis réessayez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@との転送に使用できるポートがありませんでした。「ファイル転送」設定でポート範囲を広げてから、もう一度お試しください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma porta estava livre para a transferência com %@. Amplie o intervalo de portas nos ajustes de Transferência de arquivos e tente novamente."
          }
        }
      }
    },
    "transfer-with-failed-unknown-source-ip": {
      "comment": "File-transfer error when the local source IP address cannot be determined. The argument is the peer nickname. Legacy key: 47s-1s.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not work out this Mac’s IP address for the transfer with %@. Enter one in File Transfer settings, then try again."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nem sikerült meghatározni a Mac IP-címét a(z) %@ gépével végzett átvitelhez. Add meg a Fájlátvitel beállításaiban, majd próbáld újra."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die IP-Adresse dieses Mac für die Übertragung mit %@ konnte nicht ermittelt werden. Gib sie in den Dateiübertragungseinstellungen ein und versuche es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido determinar la dirección IP de este Mac para la transferencia con %@. Escribe una en los ajustes de Transferencia de archivos y vuelve a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de déterminer l’adresse IP de ce Mac pour le transfert avec %@. Saisissez-en une dans les réglages Transfert de fichiers, puis réessayez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@との転送に必要な、このMacのIPアドレスを特定できませんでした。「ファイル転送」設定でIPアドレスを入力してから、もう一度お試しください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível determinar o endereço IP deste Mac para a transferência com %@. Insira um nos ajustes de Transferência de arquivos e tente novamente."
          }
        }
      }
    },
    "transfer-with-failed-you-are-not": {
      "comment": "File-transfer error when the associated IRC connection is offline. The argument is the peer nickname. Legacy key: 12p-0v.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Transfer with %@ stopped because the connection to the server was lost. Reconnect, then start it again."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A(z) %@ gépével végzett átvitel leállt, mert megszakadt a kapcsolat a kiszolgálóval. Csatlakozz újra, majd indítsd el az átvitelt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Übertragung mit %@ wurde gestoppt, da die Serververbindung verloren ging. Stelle die Verbindung wieder her und starte sie erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La transferencia con %@ se ha detenido porque se perdió la conexión con el servidor. Vuelve a conectar y reiníciala."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le transfert avec %@ s’est arrêté, car la connexion au serveur a été perdue. Reconnectez-vous, puis relancez-le."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバへの接続が失われたため、%@との転送を停止しました。再接続してから、もう一度開始してください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A transferência com %@ foi interrompida porque a conexão com o servidor foi perdida. Reconecte-se e inicie-a novamente."
          }
        }
      }
    },
