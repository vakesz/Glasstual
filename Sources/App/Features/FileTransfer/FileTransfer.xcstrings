        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ de %2$@ (%3$@/s) recibido de %4$@ — %5$@ restante"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ de %2$@ (%3$@/s) reçu de %4$@ — %5$@ restant"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@（%2$@（%3$@/s））は%4$@から受け取りました — 残りは%5$@です。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ de %2$@ (%3$@/s) recebido de %4$@ — %5$@ restante"
          }
        }
      }
    },
