    "transfers-appear-here": {
      "comment": "Empty-state explanation in the file-transfer window.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Incoming and outgoing transfers appear here."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Itt jelennek meg a bejövő és kimenő átvitelek."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hier erscheinen eingehende und ausgehende Übertragungen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
