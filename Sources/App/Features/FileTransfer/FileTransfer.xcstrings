    "transfer-from-is-stopped": {
      "comment": "Status of an incoming transfer that is idle. The argument is the peer nickname. Legacy key: jvh-u7. Previously keyed transfer-from-is-stopped-control-click.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Transfer from %@ has not started. Choose Accept to begin."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ fájljának fogadása még nem kezdődött el. Az indításhoz válaszd az Elfogadás lehetőséget."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Übertragung von %@ wurde noch nicht gestartet. Wähle Annehmen, um zu beginnen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La transferencia desde %@ no ha comenzado. Elige Aceptar para comenzar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le transfert depuis %@ n’a pas démarré. Choisissez Accepter pour commencer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@からの転送は開始されていません。開始するには「許可」を選択してください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A transferência de %@ não foi iniciada. Escolha Aceitar para começar."
          }
        }
      }
    },
