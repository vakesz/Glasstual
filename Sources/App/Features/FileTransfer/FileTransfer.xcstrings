    "transfer-from-failed-because-the-sender": {
      "comment": "Error shown when a peer sends more data than the file transfer announced. The argument is the peer nickname. Legacy key: dcc-ovr.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ sent more than the offer stated, so the transfer was stopped."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ a jelzettnél több adatot küldött, ezért az átvitel leállt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hat mehr Daten als angekündigt gesendet. Die Übertragung wurde gestoppt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ envió más de lo que indicaba la oferta, por lo que la transferencia se detuvo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ a envoyé plus que l'offre indiquée, donc le transfert a été arrêté."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@は提示されたオファーを超えて送金したので、送金は停止されました。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ enviou mais do que a oferta estipulada, então a transferência foi interrompida."
          }
        }
      }
    },
