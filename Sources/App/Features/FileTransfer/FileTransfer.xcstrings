    "secure-transfer-details-verified": {
      "comment": "Help text of the lock on an encrypted file transfer. %1$@ is the TLS version such as TLS 1.3, %2$@ the cipher suite name and %3$@ the peer's SHA-256 certificate fingerprint.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Encrypted with %1$@ (%2$@). Certificate SHA-256: %3$@"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Titkosítás: %1$@ (%2$@). Tanúsítvány SHA-256: %3$@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verschlüsselt mit %1$@ (%2$@). Zertifikat SHA-256: %3$@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cifrada con %1$@ (%2$@). Certificado SHA-256: %3$@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiffré avec %1$@ (%2$@). Certificat SHA-256 : %3$@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@（%2$@）で暗号化。証明書 SHA-256: %3$@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Criptografada com %1$@ (%2$@). Certificado SHA-256: %3$@"
          }
        }
      }
    },
    "secure-transfer-details-unverified": {
      "comment": "Help text of the warning lock on an encrypted file transfer whose peer presented no certificate. %1$@ is the TLS version such as TLS 1.3 and %2$@ the cipher suite name.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Encrypted with %1$@ (%2$@). The other side presented no certificate, so nobody is verified."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Titkosítás: %1$@ (%2$@). A másik fél nem mutatott be tanúsítványt, így senki sincs ellenőrizve."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verschlüsselt mit %1$@ (%2$@). Die Gegenseite hat kein Zertifikat vorgelegt, daher ist niemand überprüft."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cifrada con %1$@ (%2$@). La otra parte no presentó ningún certificado, así que nadie está verificado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiffré avec %1$@ (%2$@). L’autre partie n’a présenté aucun certificat ; personne n’est donc vérifié."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@（%2$@）で暗号化。相手は証明書を提示しなかったため、検証されていません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Criptografada com %1$@ (%2$@). O outro lado não apresentou certificado, então ninguém foi verificado."
          }
        }
      }
    },
