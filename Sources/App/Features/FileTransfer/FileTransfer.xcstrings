        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@に送信されているファイルを読み取れませんでした。まだ存在し、開くことができるかご確認ください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Não foi possível ler o arquivo sendo enviado para %@. Verifique se ele ainda existe e se você pode abri-lo."
          }
        }
      }
    },
    "transfer-with-failed-file-handler-threw": {
      "comment": "File-transfer error when writing the destination file fails. The argument is the peer nickname. Legacy key: 05g-c8.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not write the file from %@. Check that the destination folder still exists and that you can write to it."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nem sikerült menteni %@ fájlját. Ellenőrizd, hogy a célmappa még létezik-e, és tudsz-e bele írni."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Datei von %@ konnte nicht geschrieben werden. Prüfe, ob der Zielordner noch vorhanden ist und du darin schreiben darfst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "No se pudo escribir el archivo desde %@. Comprueba que la carpeta de destino sigue existiendo y que puedes escribir en ella."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Impossible d'écrire le fichier depuis %@. Vérifiez que le dossier de destination existe toujours et que vous pouvez y écrire."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ からファイルを書き込めませんでした。宛先フォルダがまだ存在し、書き込めることを確認してください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Não foi possível escrever o arquivo de %@. Verifique se a pasta de destino ainda existe e se você pode escrevê-la."
          }
        }
      }
    },
    "transfer-with-failed-no-answer": {
      "comment": "File-transfer error when the peer never answered the connection attempt. The argument is the peer nickname.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ did not answer in time. They may be offline or behind a firewall."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ nem válaszolt időben. Lehet, hogy nincs csatlakozva, vagy tűzfal mögött van."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hat nicht rechtzeitig geantwortet. Die Person ist möglicherweise offline oder hinter einer Firewall."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ no respondió a tiempo. Puede que estén fuera de línea o detrás de un cortafuegos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ n'a pas répondu à temps. Ils peuvent être hors ligne ou derrière un pare-feu."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@は時間内に応答しませんでした。オフラインになっているか、ファイアウォールの向こうにいる可能性があります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ não respondeu a tempo. Eles podem estar offline ou atrás de um firewall."
          }
        }
      }
    },
    "transfer-with-failed-no-space-left": {
      "comment": "File-transfer error when the destination device has no remaining space. The argument is the peer nickname. Legacy key: 79f-s0.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There is not enough free space to save the file from %@. Free some space, then start the transfer again."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nincs elég szabad hely %@ fájljának mentéséhez. Szabadíts fel helyet, majd indítsd újra az átvitelt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es ist nicht genügend Speicherplatz vorhanden, um die Datei von %@ zu sichern. Gib Speicherplatz frei und starte die Übertragung erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "No hay suficiente espacio libre para guardar el archivo desde %@. Libere algo de espacio y vuelva a iniciar la transferencia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Il n'y a pas assez d'espace libre pour sauvegarder le fichier depuis %@. Libérez un peu d'espace, puis recommencez le transfert."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@からファイルを保存するのに十分な無料スペースがありません。スペースを空け、再度転送を開始してください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Não há espaço livre suficiente para salvar o arquivo de %@. Libere algum espaço e, em seguida, inicie a transferência novamente."
          }
        }
      }
    },
    "transfer-with-failed-peer-closed": {
      "comment": "File-transfer error when the peer closed the connection early. The argument is the peer nickname.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ closed the connection before the transfer finished. Start it again to resume."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ lezárta a kapcsolatot az átvitel befejezése előtt. A folytatáshoz indítsd el újra az átvitelt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hat die Verbindung vor Abschluss der Übertragung geschlossen. Starte sie erneut, um fortzufahren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ cerró la conexión antes de que se completara la transferencia. Reiniciarla para continuar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ a fermé la connexion avant que le transfert ne soit terminé. Redémarrez-le pour reprendre."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@は転送が完了する前に接続を閉じました。再開するには再度開始してください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ fechou a conexão antes que a transferência terminasse. Reinicie-a para retomar."
          }
        }
      }
    },
    "transfer-with-failed-proposed-resume-position": {
      "comment": "File-transfer error when resuming is impossible: the peer's resume position does not match the partly transferred file, or that file is gone or larger than the offer. Try Again starts the file over under a new name and keeps the partial file. The argument is the peer nickname. Legacy key: 0ov-tr.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not resume the transfer with %@. Choose Try Again to start it over from the beginning."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nem sikerült folytatni az átvitelt %@ gépével. Az Újrapróbálkozás lehetőséggel elölről kezdheted."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Übertragung mit %@ konnte nicht fortgesetzt werden. Wähle Erneut versuchen, um von vorne zu beginnen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "No se pudo reanudar la transferencia con %@. Elija Intentarlo de nuevo para volver a empezar desde el principio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Impossible de reprendre le transfert avec %@. Choisissez Réessayer pour le recommencer depuis le début."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@で転送を再開できませんでした。最初からやり直すには「もう一度試す」を選択してください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Não foi possível retomar a transferência com %@. Escolha Tentar novamente para recomeçar do início."
          }
        }
      }
    },
    "transfer-with-failed-resume-not-answered": {
      "comment": "File-transfer error when the peer never answered a request to resume. Try Again starts the file over under a new name and keeps the partial file. The argument is the peer nickname.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ did not agree to resume the transfer. Choose Try Again to start it over from the beginning."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ nem hagyta jóvá az átvitel folytatását. Az Újrapróbálkozás lehetőséggel elölről kezdheted."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hat dem Fortsetzen nicht zugestimmt. Wähle Erneut versuchen, um von vorne zu beginnen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ no aceptó reanudar la transferencia. Elige Intentarlo de nuevo para volver a empezar desde el principio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ n'a pas accepté de reprendre le transfert. Choisissez Réessayer pour le recommencer depuis le début."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@は転送を再開することに同意しませんでした。最初からやり直すには「もう一度試す」を選択してください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ não concordou em retomar a transferência. Escolha Tentar novamente para recomeçar do início."
          }
        }
      }
    },
    "transfer-with-failed-stalled": {
      "comment": "File-transfer error when the connection to the peer stopped moving data: a write that did not complete, or a download that received nothing for too long. The argument is the peer nickname.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The connection to %@ stopped responding, so the transfer was cancelled. Start it again to resume."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kapcsolata nem válaszolt, ezért az átvitel megszakadt. A folytatáshoz indítsd el újra."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Verbindung zu %@ hat nicht mehr reagiert. Die Übertragung wurde abgebrochen. Starte sie erneut, um fortzufahren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La conexión a %@ dejó de responder, por lo que la transferencia se canceló. Reiniciarla para continuar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La connexion à %@ a cessé de répondre, le transfert a donc été annulé. Redémarrez-la pour reprendre."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@への接続が応答しなくなったため、転送がキャンセルされました。再開するには再度開始してください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A conexão com %@ parou de responder, então a transferência foi cancelada. Inicie-a novamente para retomar."
          }
        }
      }
    },
    "transfer-with-failed-there-is-no": {
      "comment": "File-transfer error when no listening port is available. The argument is the peer nickname. Legacy key: vxc-sd.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No port was free for the transfer with %@. Widen the port range in File Transfer settings, then try again."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nincs szabad port a(z) %@ gépével végzett átvitelhez. Bővítsd a porttartományt a Fájlátvitel beállításaiban, majd próbáld újra."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Port für die Übertragung mit %@ verfügbar. Erweitere den Portbereich in den Dateiübertragungseinstellungen und versuche es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ningún puerto estaba libre para la transferencia con %@. Amplía el rango de puertos en la configuración de Transferencia de archivos y vuelve a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aucun port n'était disponible pour le transfert avec %@. Élargissez la plage de ports dans les paramètres du transfert de fichiers, puis réessayez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@での転送にはポートが空いていませんでした。ファイル転送設定でポート範囲を広げ、もう一度お試しください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nenhum porta estava livre para a transferência com %@. Amplie a faixa de portas nas configurações de Transferência de Arquivos e tente novamente."
          }
        }
      }
    },
    "transfer-with-failed-unknown-source-ip": {
      "comment": "File-transfer error when the local source IP address cannot be determined. The argument is the peer nickname. Legacy key: 47s-1s.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not work out this Mac’s IP address for the transfer with %@. Enter one in File Transfer settings, then try again."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nem sikerült meghatározni a Mac IP-címét a(z) %@ gépével végzett átvitelhez. Add meg a Fájlátvitel beállításaiban, majd próbáld újra."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die IP-Adresse dieses Mac für die Übertragung mit %@ konnte nicht ermittelt werden. Gib sie in den Dateiübertragungseinstellungen ein und versuche es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "No se ha podido determinar la dirección IP de este Mac para la transferencia con %@. Introduce una en la configuración de Transferencia de archivos y vuelve a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Impossible de déterminer l'adresse IP de ce Mac pour le transfert avec %@. Saisissez-en une dans les paramètres du transfert de fichiers, puis réessayez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@での転送用にこのMacのIPアドレスを特定できませんでした。ファイル転送設定に1つ入力してから、もう一度お試しください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Não foi possível determinar o endereço IP deste Mac para a transferência com %@. Insira um nas configurações de Transferência de Arquivos e tente novamente."
          }
        }
      }
    },
    "transfer-with-failed-you-are-not": {
      "comment": "File-transfer error when the associated IRC connection is offline. The argument is the peer nickname. Legacy key: 12p-0v.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Transfer with %@ stopped because the connection to the server was lost. Reconnect, then start it again."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A(z) %@ gépével végzett átvitel leállt, mert megszakadt a kapcsolat a kiszolgálóval. Csatlakozz újra, majd indítsd el az átvitelt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Übertragung mit %@ wurde gestoppt, da die Serververbindung verloren ging. Stelle die Verbindung wieder her und starte sie erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La transferencia con %@ se ha detenido porque se ha perdido la conexión con el servidor. Vuelve a conectarte y vuelve a iniciarla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le transfert avec %@ a été arrêté car la connexion au serveur a été perdue. Redéconnectez-vous, puis rouvrez-le."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@での転送は、サーバーへの接続が途絶えたため停止されました。再接続してから、再度開始してください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A transferência com %@ foi interrompida porque a conexão com o servidor foi perdida. Conecte-se novamente e reinicie-a."
          }
        }
      }
    },
