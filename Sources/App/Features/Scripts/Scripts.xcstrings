{
  "sourceLanguage": "en",
  "strings": {
    "script-no-input": {
      "comment": "Placeholder in a script failure diagnostic when the command had no arguments.",
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "(no input)"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "(nincs bemenet)"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "(keine Eingabe)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "(sin entrada)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "(aucune entrée)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "(入力なし)"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "(sem entrada)"
          }
        }
      }
    },
    "script-output-too-large": {
      "comment": "A script returned more than the allowed one MiB. None of its output is executed.",
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The script returned more than 1 MiB of output. No commands were executed."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A szkript kimenete meghaladta az 1 MiB méretet. Egyetlen parancs sem lett végrehajtva."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Skriptausgabe überschreitet 1 MiB. Es wurden keine Befehle ausgeführt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El script devolvió más de 1 MiB de salida. No se ejecutó ningún comando."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le script a renvoyé plus de 1 Mio de sortie. Aucune commande n’a été exécutée."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スクリプトの出力が1 MiBを超えました。コマンドは実行されませんでした。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O script retornou mais de 1 MiB de saída. Nenhum comando foi executado."
          }
        }
      }
    },
    "script-output-invalid-encoding": {
      "comment": "Script stdout could not be decoded as UTF-8. None of its output is executed.",
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The script output is not valid UTF-8. No commands were executed."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A szkript kimenete nem érvényes UTF-8 szöveg. Egyetlen parancs sem lett végrehajtva."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Skriptausgabe ist kein gültiges UTF-8. Es wurden keine Befehle ausgeführt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La salida del script no es UTF-8 válido. No se ejecutó ningún comando."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La sortie du script n’est pas de l’UTF-8 valide. Aucune commande n’a été exécutée."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スクリプトの出力が有効なUTF-8ではありません。コマンドは実行されませんでした。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A saída do script não é UTF-8 válido. Nenhum comando foi executado."
          }
        }
      }
    },
    "import-failed-title": {
      "comment": "Title of an add-on installation failure alert.",
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Add-on Could Not Be Installed"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nem sikerült telepíteni a kiegészítőt"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Add-on konnte nicht installiert werden"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo instalar el complemento"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d’installer l’extension"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アドオンをインストールできませんでした"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível instalar o complemento"
          }
        }
      }
    },
    "invalid-script": {
      "comment": "A script failed staged validation before installation.",
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This file is not a readable AppleScript. The installed copy has not been changed."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez a fájl nem olvasható AppleScript-szkript. A telepített példány nem változott."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Datei ist kein lesbares AppleScript. Die installierte Kopie wurde nicht geändert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este archivo no es un AppleScript legible. La copia instalada no se ha modificado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce fichier n’est pas un AppleScript lisible. La copie installée n’a pas été modifiée."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このファイルは読み取れないAppleScriptです。インストールされたコピーは変更されていません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este arquivo não é um AppleScript legível. A cópia instalada não foi alterada."
          }
        }
      }
    },
    "script-install-instructions": {
      "comment": "Explains that the user must install scripts using Finder because the sandbox cannot write Application Scripts. Argument is the destination folder path.",
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use Finder to copy the script into %@. If the folder does not exist, create it in Finder. Glasstual cannot write to this folder. Return to Glasstual after copying to refresh the script list."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Finderrel másold a szkriptet ide: %@. Ha a mappa nem létezik, hozd létre a Finderben. A Glasstual nem írhat ebbe a mappába. Másolás után térj vissza a Glasstualhoz a szkriptlista frissítéséhez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopiere das Skript mit dem Finder nach %@. Erstelle den Ordner im Finder, falls er noch nicht vorhanden ist. Glasstual kann nicht in diesen Ordner schreiben. Kehre nach dem Kopieren zu Glasstual zurück, um die Skriptliste zu aktualisieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa el Finder para copiar el script en %@. Si la carpeta no existe, créala en el Finder. Glasstual no puede escribir en esta carpeta. Vuelve a Glasstual después de copiar para actualizar la lista de scripts."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez le Finder pour copier le script dans %@. Si le dossier n’existe pas, créez-le dans le Finder. Glasstual ne peut pas écrire dans ce dossier. Revenez dans Glasstual après la copie pour actualiser la liste des scripts."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Finderを使用して、スクリプトを%@にコピーしてください。フォルダが存在しない場合は、Finderで作成してください。Glasstualはこのフォルダに書き込めません。コピーしたらGlasstualに戻り、スクリプトリストを更新してください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use o Finder para copiar o script para %@. Se a pasta não existir, crie-a no Finder. O Glasstual não pode gravar nesta pasta. Volte ao Glasstual após copiar para atualizar a lista de scripts."
          }
        }
      }
    },
    "script-install-title": {
      "comment": "Title of the user-mediated script installation instructions.",
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Install the Script in Finder"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Szkript telepítése a Finderben"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Skript im Finder installieren"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Instalar el script en el Finder"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Installer le script dans le Finder"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スクリプトをFinderでインストール"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Instalar o script no Finder"
          }
        }
      }
    }
  },
  "version": "1.0"
}
