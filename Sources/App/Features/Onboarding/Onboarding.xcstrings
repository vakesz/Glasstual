    "connection-unavailable": {
      "comment": "Alert title. Onboarding stays open and can retry if application services are unavailable when creating the connection.",
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The connection could not be created."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nem sikerült létrehozni a kapcsolatot."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Verbindung konnte nicht erstellt werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo crear la conexión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La connexion n’a pas pu être créée."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続を作成できませんでした。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A conexão não pôde ser criada."
          }
        }
      }
    },
    "connection-unavailable-recovery": {
      "comment": "Alert message shown when the first connection could not be created.",
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try again, or go back and continue without a network."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Próbáld újra, vagy lépj vissza, és folytasd hálózat nélkül."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Versuche es erneut oder gehe zurück und fahre ohne Netzwerk fort."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inténtalo de nuevo o vuelve atrás y continúa sin red."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réessayez, ou revenez en arrière et continuez sans réseau."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "もう一度お試しいただくか、戻ってネットワークなしで続けてください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tente novamente ou volte e continue sem uma rede."
          }
        }
      }
    },
    "enter-a-port-between-1": {
      "comment": "Network picker. Legacy key: np1-e2.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter a port between 1 and 65535."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Adj meg egy 1 és 65535 közötti portszámot."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib einen Port zwischen 1 und 65535 ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduce un puerto entre 1 y 65535."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez un port compris entre 1 et 65 535."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1〜65535のポートを入力してください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Digite uma porta entre 1 e 65535."
          }
        }
      }
    },
    "glasstual-is-an-irc-client-built": {
      "comment": "Step: Welcome and identity. Legacy key: id1-st.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Glasstual is an IRC client built for the Mac. Start by choosing how others will see you."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Glasstual egy Macre készült IRC-kliens. Először válaszd ki, hogyan lássanak mások."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Glasstual ist ein IRC-Client für den Mac. Wähle zuerst, wie andere dich sehen sollen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Glasstual es un cliente IRC diseñado para el Mac. Comienza eligiendo cómo te verán los demás."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Glasstual est un client IRC conçu pour le Mac. Commencez par choisir comment les autres vous verront."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Glasstualは、Mac向けに作られたIRCクライアントです。まず、ほかの人にどう表示されるかを選択しましょう。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Glasstual é um cliente IRC feito para o Mac. Comece escolhendo como os outros vão ver você."
          }
        }
      }
    },
    "glasstual-will-ask-macos-for-permission": {
      "comment": "Step: Notifications. Legacy key: nt1-pr.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Glasstual will ask macOS for permission to show notifications when you continue. You can change this at any time in System Settings."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A folytatáskor a Glasstual engedélyt kér a macOS-től az értesítések megjelenítésére. Ezt bármikor módosíthatod a Rendszerbeállításokban."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du fortfährst, bittet Glasstual macOS um Erlaubnis für Benachrichtigungen. Du kannst dies jederzeit in den Systemeinstellungen ändern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Glasstual pedirá permiso a macOS para mostrar notificaciones cuando continúes. Puedes cambiarlo en cualquier momento en Ajustes del Sistema."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Glasstual demandera à macOS l’autorisation d’afficher des notifications lorsque vous continuerez. Vous pouvez la modifier à tout moment dans Réglages Système."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "続けると、Glasstualは通知を表示する許可をmacOSに求めます。この設定は、システム設定でいつでも変更できます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Glasstual pedirá permissão ao macOS para exibir notificações quando você continuar. Você pode alterar isso a qualquer momento nos Ajustes do Sistema."
          }
        }
      }
    },
    "good-morning-everyone": {
      "comment": "Step: Look and feel. Legacy key: lf1-m1.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Good morning everyone"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Jó reggelt mindenkinek"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Guten Morgen zusammen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Buenos días a todos"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bonjour à tous"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "皆さん、おはようございます"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Bom dia a todos"
          }
        }
      }
    },
    "invalid-account": {
      "comment": "Validation failure for an IRC account name or a password containing control characters.",
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
