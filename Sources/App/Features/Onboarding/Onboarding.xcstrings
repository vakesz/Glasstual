{
  "sourceLanguage": "en",
  "strings": {
    "account-identity-help": {
      "comment": "Explains the existing shared SASL account and IRC USER identity contract, and that disabling SASL retains the password for NickServ.",
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When a password is saved, this account name is also sent as your IRC username. Turning off SASL keeps the password for NickServ identification."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ha elmentesz egy jelszót, ezt a fióknevet IRC-felhasználónévként is elküldjük. A SASL kikapcsolása után a jelszó megmarad a NickServ-azonosításhoz."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn ein Passwort gespeichert ist, wird dieser Kontoname auch als IRC-Benutzername gesendet. Beim Deaktivieren von SASL bleibt das Passwort für die NickServ-Identifizierung erhalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cuando se guarda una contraseña, este nombre de cuenta también se envía como su nombre de usuario IRC. Desactivar SASL mantiene la contraseña para la identificación de NickServ."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lorsque un mot de passe est enregistré, ce nom de compte est également envoyé comme votre nom d'utilisateur IRC. Désactiver SASL conserve le mot de passe pour l'identification NickServ."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "パスワードが保存されると、このアカウント名もIRCユーザー名として送信されます。SASLをオフにすると、NickServの識別のためにパスワードは保持されます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Quando uma senha é salva, este nome de conta também é enviado como seu nome de usuário IRC. Desativar SASL mantém a senha para a identificação NickServ."
          }
        }
      }
    },
    "account-name": {
      "comment": "Network picker. Legacy key: np1-an.",
