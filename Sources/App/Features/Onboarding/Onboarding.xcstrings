{
  "sourceLanguage": "en",
  "strings": {
    "account-identity-help": {
      "comment": "Explains the existing shared SASL account and IRC USER identity contract, and that disabling SASL retains the password for NickServ.",
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When a password is saved, this account name is also sent as your IRC username. Turning off SASL keeps the password for NickServ identification."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ha elmentesz egy jelszót, ezt a fióknevet IRC-felhasználónévként is elküldjük. A SASL kikapcsolása után a jelszó megmarad a NickServ-azonosításhoz."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn ein Passwort gespeichert ist, wird dieser Kontoname auch als IRC-Benutzername gesendet. Beim Deaktivieren von SASL bleibt das Passwort für die NickServ-Identifizierung erhalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando se guarda una contraseña, este nombre de cuenta también se envía como tu nombre de usuario IRC. Al desactivar SASL se conserva la contraseña para identificarse con NickServ."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorsqu’un mot de passe est enregistré, ce nom de compte est aussi envoyé comme nom d’utilisateur IRC. Si vous désactivez SASL, le mot de passe est conservé pour l’identification auprès de NickServ."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パスワードを保存すると、このアカウント名もIRCユーザ名として送信されます。SASLをオフにしても、NickServでの認証用にパスワードは保持されます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando uma senha é salva, este nome de conta também é enviado como seu nome de usuário IRC. Desativar o SASL mantém a senha para a identificação com o NickServ."
          }
        }
      }
    },
    "account-name": {
