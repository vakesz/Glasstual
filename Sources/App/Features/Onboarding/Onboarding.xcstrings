{
  "sourceLanguage" : "en",
  "strings" : {
    "account-identity-help" : {
      "comment" : "Explains the existing shared SASL account and IRC USER identity contract, and that disabling SASL retains the password for NickServ.",
      "extractionState" : "manual",
      "generatesSymbol" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When a password is saved, this account name is also sent as your IRC username. Turning off SASL keeps the password for NickServ identification."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ha elmentesz egy jelszót, ezt a fióknevet IRC-felhasználónévként is elküldjük. A SASL kikapcsolása után a jelszó megmarad a NickServ-azonosításhoz."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn ein Passwort gespeichert ist, wird dieser Kontoname auch als IRC-Benutzername gesendet. Beim Deaktivieren von SASL bleibt das Passwort für die NickServ-Identifizierung erhalten."
          }
        }
      }
    },
