    "choose-a-network-or-enter": {
      "comment": "Network picker. Legacy key: np1-e1.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a network or enter a server address."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Válassz hálózatot, vagy adj meg egy kiszolgálócímet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle ein Netzwerk oder gib eine Serveradresse ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Elige una red o introduce una dirección de servidor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Choisissez un réseau ou saisissez une adresse de serveur."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ネットワークを選択するか、サーバーアドレスを入力してください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Escolha uma rede ou insira um endereço de servidor."
          }
        }
      }
    },
    "choose-a-network-to-see-suggested": {
      "comment": "Step: First network. Legacy key: nw1-ep.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a network to see suggested channels."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az ajánlott csatornák megtekintéséhez válassz hálózatot."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle ein Netzwerk, um empfohlene Kanäle zu sehen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Elige una red para ver los canales sugeridos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Choisissez un réseau pour voir les chaînes suggérées."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "提案されたチャンネルを見るには、ネットワークを選択してください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Escolha uma rede para ver os canais sugeridos."
          }
        }
      }
    },
    "choose-how-conversations-are-displayed": {
      "comment": "Step: Look and feel. Legacy key: lf1-st.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose how conversations are displayed. You can change this later in Settings."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Válaszd ki a beszélgetések megjelenését. Ezt később módosíthatod a Beállításokban."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle, wie Gespräche angezeigt werden. Du kannst dies später in den Einstellungen ändern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Elige cómo se muestran las conversaciones. Puedes cambiar esto más tarde en Ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Choisissez la façon dont les conversations sont affichées. Vous pouvez modifier cela plus tard dans Paramètres."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "会話の表示方法を選択します。これは、後で「設定」で変更できます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Escolha como as conversas são exibidas. Você pode alterar isso mais tarde nas Configurações."
          }
        }
      }
    },
    "choose-what-glasstual-should-tell": {
      "comment": "Step: Notifications. Legacy key: nt1-st.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose what Glasstual should tell you about while you are busy with something else."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Válaszd ki, miről értesítsen a Glasstual, amikor mással foglalkozol."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle, worüber Glasstual dich informieren soll, während du mit etwas anderem beschäftigt bist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Elige lo que Glasstual debería decirte mientras estás ocupado con otra cosa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Choisissez ce que Glasstual devrait vous dire pendant que vous êtes occupé par autre chose."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Glasstualが他のことに忙しい間、あなたに何を伝えるべきかを選択してください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Escolha o que Glasstual deve lhe dizer enquanto você estiver ocupado com outra coisa."
          }
        }
      }
    },
    "classic-line-by-line-view": {
      "comment": "Step: Look and feel. Legacy key: lf1-ld.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Classic line-by-line view"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Klasszikus, soronkénti nézet"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klassische zeilenweise Ansicht"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vista clásica línea por línea"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vue classique ligne par ligne"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "クラシックな行ごとの表示"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Visualização clássica linha por linha"
          }
        }
      }
    },
    "connect-when-finished": {
      "comment": "Step: First network. Legacy key: nw1-cn.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect when finished"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapcsolódás a beállítás végén"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach Abschluss verbinden"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Conéctate cuando termines"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Connectez-vous une fois terminé"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "完了したら接続してください"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Conecte quando terminar"
          }
        }
      }
    },
    "connection-unavailable": {
      "comment": "Alert title. Onboarding stays open and can retry if application services are unavailable when creating the connection.",
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The connection could not be created."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nem sikerült létrehozni a kapcsolatot."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Verbindung konnte nicht erstellt werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "No se pudo crear la conexión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La connexion n'a pas pu être créée."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "接続できませんでした。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A conexão não pôde ser criada."
          }
        }
      }
    },
    "connection-unavailable-recovery": {
      "comment": "Alert message shown when the first connection could not be created.",
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try again, or go back and continue without a network."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Próbáld újra, vagy lépj vissza, és folytasd hálózat nélkül."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Versuche es erneut oder gehe zurück und fahre ohne Netzwerk fort."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Inténtalo de nuevo o vuelve atrás y continúa sin conexión a la red."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Réessayez, ou revenez en arrière et continuez sans réseau."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "もう一度試すか、ネットワークなしで戻ってから続行してください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tente novamente ou volte e continue sem rede."
          }
        }
      }
    },
    "enter-a-port-between-1": {
      "comment": "Network picker. Legacy key: np1-e2.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter a port between 1 and 65535."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Adj meg egy 1 és 65535 közötti portszámot."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib einen Port zwischen 1 und 65535 ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Introduzca un puerto entre 1 y 65535."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Entrez un port entre 1 et 65535."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "1と65535の間のポートを入力してください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Digite um porto entre 1 e 65535."
          }
        }
      }
    },
    "glasstual-is-an-irc-client-built": {
      "comment": "Step: Welcome and identity. Legacy key: id1-st.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Glasstual is an IRC client built for the Mac. Start by choosing how others will see you."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Glasstual egy Macre készült IRC-kliens. Először válaszd ki, hogyan lássanak mások."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Glasstual ist ein IRC-Client für den Mac. Wähle zuerst, wie andere dich sehen sollen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Glasstual es un cliente IRC diseñado para el Mac. Comienza eligiendo cómo los demás te verán."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Glasstual est un client IRC conçu pour le Mac. Commencez par choisir comment les autres vous verront."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Glasstualは、Mac用に構築されたIRCクライアントです。他の人があなたを見る方法を選択することから始めましょう。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Glasstual é um cliente IRC construído para o Mac. Comece escolhendo como os outros vão te ver."
          }
        }
      }
    },
    "glasstual-will-ask-macos-for-permission": {
      "comment": "Step: Notifications. Legacy key: nt1-pr.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Glasstual will ask macOS for permission to show notifications when you continue. You can change this at any time in System Settings."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A folytatáskor a Glasstual engedélyt kér a macOS-től az értesítések megjelenítésére. Ezt bármikor módosíthatod a Rendszerbeállításokban."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du fortfährst, bittet Glasstual macOS um Erlaubnis für Benachrichtigungen. Du kannst dies jederzeit in den Systemeinstellungen ändern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Glasstual le pedirá permiso a macOS para mostrar notificaciones cuando continúes. Puede cambiar esto en cualquier momento en la configuración del Sistema."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Glasstual demandera à macOS la permission de montrer les notifications lorsque vous continuerez. Vous pouvez modifier cela à tout moment dans les paramètres du système."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Glasstualが、続行すると通知を表示する許可をmacOSに求めます。これはいつでもシステム設定で変更できます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O Glasstual pedirá permissão ao macOS para exibir notificações quando você continuar. Você pode alterar isso a qualquer momento nas Configurações do Sistema."
          }
        }
      }
    },
    "good-morning-everyone": {
      "comment": "Step: Look and feel. Legacy key: lf1-m1.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Good morning everyone"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Jó reggelt mindenkinek"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Guten Morgen zusammen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Buenos días a todos"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bonjour à tous"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "皆さん、おはようございます"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bom dia a todos"
          }
        }
      }
    },
    "invalid-account": {
      "comment": "Validation failure for an IRC account name or a password containing control characters.",
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter a valid IRC username and a password without control characters."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Adj meg érvényes IRC-felhasználónevet és vezérlőkarakterek nélküli jelszót."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib einen gültigen IRC-Benutzernamen und ein Passwort ohne Steuerzeichen ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Introduzca un nombre de usuario IRC válido y una contraseña sin caracteres de control."
          }
        },
        "fr": {
