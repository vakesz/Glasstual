    "choose-a-network-or-enter": {
      "comment": "Network picker. Legacy key: np1-e1.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a network or enter a server address."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Válassz hálózatot, vagy adj meg egy kiszolgálócímet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle ein Netzwerk oder gib eine Serveradresse ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige una red o introduce una dirección de servidor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez un réseau ou saisissez une adresse de serveur."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ネットワークを選択するか、サーバアドレスを入力してください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha uma rede ou insira um endereço de servidor."
          }
        }
      }
    },
    "choose-a-network-to-see-suggested": {
      "comment": "Step: First network. Legacy key: nw1-ep.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a network to see suggested channels."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az ajánlott csatornák megtekintéséhez válassz hálózatot."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle ein Netzwerk, um empfohlene Kanäle zu sehen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige una red para ver los canales sugeridos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez un réseau pour voir les canaux suggérés."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "おすすめのチャンネルを表示するには、ネットワークを選択してください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha uma rede para ver os canais sugeridos."
          }
        }
      }
    },
    "choose-how-conversations-are-displayed": {
      "comment": "Step: Look and feel. Legacy key: lf1-st.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose how conversations are displayed. You can change this later in Settings."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Válaszd ki a beszélgetések megjelenését. Ezt később módosíthatod a Beállításokban."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle, wie Gespräche angezeigt werden. Du kannst dies später in den Einstellungen ändern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige cómo se muestran las conversaciones. Puedes cambiar esto más tarde en Ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez la façon dont les conversations sont affichées. Vous pourrez le modifier plus tard dans les réglages."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "会話の表示方法を選択します。あとで「設定」で変更できます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha como as conversas são exibidas. Você pode alterar isso depois nos Ajustes."
          }
        }
      }
    },
    "choose-what-glasstual-should-tell": {
      "comment": "Step: Notifications. Legacy key: nt1-st.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose what Glasstual should tell you about while you are busy with something else."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Válaszd ki, miről értesítsen a Glasstual, amikor mással foglalkozol."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle, worüber Glasstual dich informieren soll, während du mit etwas anderem beschäftigt bist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige de qué debe avisarte Glasstual mientras estás ocupado con otra cosa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez ce dont Glasstual doit vous informer pendant que vous êtes occupé à autre chose."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ほかの作業をしているときに、Glasstualがどのような内容を知らせるかを選択します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha sobre o que o Glasstual deve avisar você enquanto estiver ocupado com outra coisa."
          }
        }
      }
    },
