    "prompt-description" : {
      "comment" : "Description under the prompt title in the empty state of the history search window: explains what it finds.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Type words or a nickname to find messages in the history Glasstual has saved."
