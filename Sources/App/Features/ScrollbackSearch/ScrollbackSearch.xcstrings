        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Írj be szavakat vagy becenevet a Glasstual által mentett előzményekben található üzenetek kereséséhez."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gib Wörter oder einen Nicknamen ein, um Nachrichten im von Glasstual gespeicherten Verlauf zu finden."
