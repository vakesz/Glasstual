    "hint-irc-protocol-line": {
      "comment": "Slash-command discovery. Command names and literal subcommands stay unchanged; translate placeholder names and explanatory text.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter a complete IRC protocol line. Include a colon before a trailing parameter containing spaces."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Adj meg egy teljes IRC-protokollsort. A szóközöket tartalmazó utolsó paraméter elé írj kettőspontot."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib eine vollständige IRC-Protokollzeile ein. Setze vor einem letzten Parameter mit Leerzeichen einen Doppelpunkt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduce una línea completa de protocolo IRC. Incluye dos puntos antes de un parámetro final que contenga espacios."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez une ligne de protocole IRC complète. Faites précéder d’un deux-points (:) un dernier paramètre contenant des espaces."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "完全なIRCプロトコル行を入力します。スペースを含む末尾のパラメータの前には、コロンを付けます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Digite uma linha completa do protocolo IRC. Inclua dois-pontos antes de um parâmetro final que contenha espaços."
          }
        }
      }
    },
    "hint-list-status-clear": {
      "comment": "Slash-command discovery. Command names and literal subcommands stay unchanged; translate placeholder names and explanatory text.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "L lists entries, S requests status, C clears the list. Add or remove people in the People window."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az L listáz, az S állapotot kér, a C törli a listát. Személyeket a Személyek ablakban adhatsz hozzá vagy távolíthatsz el."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "L zeigt Einträge, S fragt den Status ab, C leert die Liste. Personen im Personen-Fenster hinzufügen oder entfernen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "L muestra las entradas, S solicita el estado y C vacía la lista. Añade o quita personas en la ventana Personas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L affiche les entrées, S demande le statut, C vide la liste. Ajoutez ou supprimez des personnes dans la fenêtre Personnes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Lでエントリを一覧表示し、Sでステータスを要求し、Cでリストをクリアします。ユーザの追加や削除は、「ユーザ」ウインドウで行います。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "L lista as entradas, S solicita o status, C limpa a lista. Adicione ou remova pessoas na janela Pessoas."
          }
        }
      }
    },
    "hint-local-text-protocol-log": {
      "comment": "Slash-command discovery. Command names and literal subcommands stay unchanged; translate placeholder names and explanatory text.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter text to display locally, or raw on / raw off to toggle the protocol log."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Adj meg helyben megjelenítendő szöveget, vagy a raw on / raw off paranccsal kapcsold az IRC-naplót."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib lokal anzuzeigenden Text ein oder schalte mit raw on / raw off das Protokoll ein oder aus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduce texto para mostrarlo localmente, o raw on / raw off para activar o desactivar el registro del protocolo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez le texte à afficher localement, ou raw on / raw off pour activer ou désactiver le journal du protocole."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ローカルに表示するテキストを入力するか、raw onまたはraw offでプロトコルログを切り替えます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Digite o texto a exibir localmente ou raw on / raw off para ativar ou desativar o registro do protocolo."
          }
        }
      }
    },
    "hint-message": {
      "comment": "Slash-command discovery. Command names and literal subcommands stay unchanged; translate placeholder names and explanatory text.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
