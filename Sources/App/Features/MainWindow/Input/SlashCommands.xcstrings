    "hint-add-remove-mask": {
      "comment": "Slash-command discovery. Command names and literal subcommands stay unchanged; translate placeholder names and explanatory text.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use + to add a mask or - to remove one. With no arguments, requests the list. Requires server support."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "+ jellel hozzáadhatsz, - jellel eltávolíthatsz egy maszkot. Argumentum nélkül listáz. Kiszolgálói támogatás szükséges."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit + eine Maske hinzufügen, mit - entfernen. Ohne Argumente wird die Liste angefordert. Serverunterstützung erforderlich."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Utilice + para añadir una máscara o - para eliminar una. Sin argumentos, solicita la lista. Requiere soporte del servidor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Utilisez + pour ajouter un masque ou - pour en supprimer un. Sans arguments, demande la liste. Nécessite le support du serveur."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "マスクを追加するには+を使用し、削除するには-を使用します。引数なしではリストをリクエストします。サーバーサポートが必要です。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Use + para adicionar uma máscara ou - para removê-la. Sem argumentos, solicita a lista. Requer suporte do servidor."
          }
        }
      }
    },
