            "state": "translated",
            "value": "Schreibe die Nachricht nach dem Befehl. Leerzeichen gehören zur Nachricht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escribe el mensaje después del comando. Los espacios forman parte del mensaje."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tapez le message après la commande. Les espaces font partie du message."
          }
        },
        "ja": {
