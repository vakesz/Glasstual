    "hint-seconds-repeat-management": {
      "comment": "Slash-command discovery. Command names and literal subcommands stay unchanged; translate placeholder names and explanatory text.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Seconds must be positive. Repeat 0 runs indefinitely. Use help for management commands."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A másodpercek száma pozitív legyen. A 0 ismétlés korlátlan futást jelent. A kezeléshez használd a help alparancsot."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sekunden müssen positiv sein. Wiederholungszahl 0 läuft unbegrenzt. help erklärt die Verwaltungsbefehle."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los segundos deben ser positivos. Repetir 0 se ejecuta indefinidamente. Usa help para los comandos de gestión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le nombre de secondes doit être positif. Avec la répétition 0, la commande s’exécute indéfiniment. Utilisez help pour les commandes de gestion."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "秒数は正の値にする必要があります。繰り返しに0を指定すると無期限に実行します。管理コマンドについてはhelpを使用してください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os segundos devem ser positivos. Repetir com 0 executa indefinidamente. Use help para os comandos de gerenciamento."
          }
        }
      }
    },
