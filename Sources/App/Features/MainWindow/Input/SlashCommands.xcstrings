    },
    "hint-list-status-clear": {
      "comment": "Slash-command discovery. Command names and literal subcommands stay unchanged; translate placeholder names and explanatory text.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "L lists entries, S requests status, C clears the list. Add or remove people through the Address Book."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az L listáz, az S állapotot kér, a C törli a listát. Személyeket a címjegyzékben adhatsz hozzá vagy távolíthatsz el."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "L zeigt Einträge, S fragt den Status ab, C leert die Liste. Personen über das Adressbuch hinzufügen oder entfernen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "L enumera las entradas, S solicita el estado, C limpia la lista. Añade o elimina personas a través del Libro de direcciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "L affiche les entrées, S demande le statut, C vide la liste. Ajoutez ou supprimez des personnes via le carnet d’adresses."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lキーで項目を表示し、Sキーでステータスを確認し、Cキーでリストをクリアします。アドレス帳から人を追加または削除できます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "L lista as entradas, S solicita o status, C apaga a lista. Adicione ou remova pessoas pelo Livro de Endereços."
          }
        }
      }
    },
    "hint-local-text-protocol-log": {
      "comment": "Slash-command discovery. Command names and literal subcommands stay unchanged; translate placeholder names and explanatory text.",
      "extractionState": "manual",
      "localizations": {
        "en": {
