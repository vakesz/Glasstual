    "hint-operator": {
      "comment": "Slash-command discovery. Command names and literal subcommands stay unchanged; translate placeholder names and explanatory text.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Requires server operator privileges. Supported masks, durations and options depend on the server."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiszolgálói operátorjog szükséges. A maszkok, időtartamok és lehetőségek a kiszolgálótól függenek."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erfordert Server-Operatorrechte. Unterstützte Masken, Zeitangaben und Optionen hängen vom Server ab."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Requiere privilegios de operador del servidor. Las máscaras, duraciones y opciones admitidas dependen del servidor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nécessite des privilèges d’opérateur de serveur. Les masques, durées et options pris en charge dépendent du serveur."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバオペレーターの権限が必要です。対応するマスク、期間、オプションはサーバによって異なります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Requer privilégios de operador do servidor. As máscaras, durações e opções compatíveis dependem do servidor."
          }
        }
      }
    },
