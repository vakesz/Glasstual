    "hint-targets": {
      "comment": "Slash-command discovery. Command names and literal subcommands stay unchanged; translate placeholder names and explanatory text.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use a nickname or channel as the target. Separate multiple targets with commas."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A cél becenév vagy csatorna lehet. Több célt vesszővel válassz el."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Als Ziel dient ein Nickname oder Kanal. Mehrere Ziele mit Kommas trennen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Utilice un apodo o un canal como objetivo. Separe varios objetivos con comas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Utilisez un surnom ou une chaîne comme cible. Séparez plusieurs cibles par des virgules."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ニックネームまたはチャンネルをターゲットとして使用します。複数のターゲットはカンマで区切ります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Use um apelido ou canal como alvo. Separe múltiplos alvos com vírgulas."
          }
        }
      }
    },
    "hint-topic": {
      "comment": "Slash-command discovery. Command names and literal subcommands stay unchanged; translate placeholder names and explanatory text.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Omit the channel to use the selected channel. Omit the topic to read it."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A csatornát elhagyva a kijelölt csatornára érvényes. A témát elhagyva lekéri azt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohne Kanalangabe gilt der ausgewählte Kanal. Ohne Thema wird das aktuelle Thema abgefragt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Omita el canal para usar el canal seleccionado. Omita el tema para leerlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Oubliez la chaîne pour utiliser la chaîne sélectionnée. Oubliez le sujet pour le lire."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "選択したチャンネルを使用するにはチャンネルを省略してください。読むにはトピックを省略してください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Omita o canal para usar o canal selecionado. Omita o tópico para lê-lo."
          }
        }
      }
    },
