    "hint-direct-chat-file-path": {
      "comment": "Slash-command discovery. Command names and literal subcommands stay unchanged; translate placeholder names and explanatory text.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use chat for a direct conversation or send with a file path for a file transfer."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A chat közvetlen beszélgetést indít, a send fájlútvonallal fájlt küld."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nutze chat für eine direkte Unterhaltung oder send mit einem Dateipfad für eine Übertragung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa chat para una conversación directa o send con una ruta de archivo para una transferencia de archivos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez chat pour une conversation directe, ou send avec un chemin de fichier pour un transfert de fichier."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
