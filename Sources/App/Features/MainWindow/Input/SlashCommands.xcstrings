    "hint-channels-comma-separated-keys": {
      "comment": "Slash-command discovery. Command names and literal subcommands stay unchanged; translate placeholder names and explanatory text.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Separate channels and their keys with commas. With no channel, rejoins the selected channel."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A csatornákat és kulcsaikat vesszővel válaszd el. Csatorna nélkül újracsatlakozik a kijelölt csatornához."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kanäle und Schlüssel mit Kommas trennen. Ohne Kanalangabe wird der ausgewählte Kanal erneut betreten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Separe los canales y sus teclas con comas. Sin canal, se une al canal seleccionado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Séparez les canaux et leurs clés par des virgules. Sans canal, rejoignez le canal sélectionné."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "チャンネルとキーはカンマで区切ります。チャンネルがない場合は、選択されたチャンネルに戻ります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Separe os canais e suas chaves com vírgulas. Sem canal, reintegre-se ao canal selecionado."
          }
        }
      }
    },
    "hint-chathistory-subcommands": {
      "comment": "Slash-command discovery. Command names and literal subcommands stay unchanged; translate placeholder names and explanatory text.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
