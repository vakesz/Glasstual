    "hint-irc-protocol-line": {
      "comment": "Slash-command discovery. Command names and literal subcommands stay unchanged; translate placeholder names and explanatory text.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter a complete IRC protocol line. Include a colon before a trailing parameter containing spaces."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Adj meg egy teljes IRC-protokollsort. A szóközöket tartalmazó utolsó paraméter elé írj kettőspontot."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib eine vollständige IRC-Protokollzeile ein. Setze vor einem letzten Parameter mit Leerzeichen einen Doppelpunkt."
          }
        }
      }
    },
    "hint-list-status-clear": {
      "comment": "Slash-command discovery. Command names and literal subcommands stay unchanged; translate placeholder names and explanatory text.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "L lists entries, S requests status, C clears the list. Add or remove people through the Address Book."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az L listáz, az S állapotot kér, a C törli a listát. Személyeket a címjegyzékben adhatsz hozzá vagy távolíthatsz el."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "L zeigt Einträge, S fragt den Status ab, C leert die Liste. Personen über das Adressbuch hinzufügen oder entfernen."
          }
        }
      }
    },
    "hint-local-text-protocol-log": {
      "comment": "Slash-command discovery. Command names and literal subcommands stay unchanged; translate placeholder names and explanatory text.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter text to display locally, or raw on / raw off to toggle the protocol log."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Adj meg helyben megjelenítendő szöveget, vagy a raw on / raw off paranccsal kapcsold az IRC-naplót."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib lokal anzuzeigenden Text ein oder schalte mit raw on / raw off das Protokoll ein oder aus."
          }
        }
      }
    },
    "hint-message": {
      "comment": "Slash-command discovery. Command names and literal subcommands stay unchanged; translate placeholder names and explanatory text.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
