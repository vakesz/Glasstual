    "hint-add-remove-mask": {
      "comment": "Slash-command discovery. Command names and literal subcommands stay unchanged; translate placeholder names and explanatory text.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use + to add a mask or - to remove one. With no arguments, requests the list. Requires server support."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "+ jellel hozzáadhatsz, - jellel eltávolíthatsz egy maszkot. Argumentum nélkül listáz. Kiszolgálói támogatás szükséges."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit + eine Maske hinzufügen, mit - entfernen. Ohne Argumente wird die Liste angefordert. Serverunterstützung erforderlich."
          }
        }
      }
    },
    "hint-all-joined-channels": {
      "comment": "Slash-command discovery. Command names and literal subcommands stay unchanged; translate placeholder names and explanatory text.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sends to every joined channel. Settings determine whether other connections are included."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Minden csatlakozott csatornára elküldi. A beállításoktól függ, hogy más kapcsolatokra is érvényes-e."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sendet an alle betretenen Kanäle. Die Einstellungen bestimmen, ob weitere Verbindungen einbezogen werden."
          }
        }
      }
    },
    "hint-channel": {
      "comment": "Slash-command discovery. Command names and literal subcommands stay unchanged; translate placeholder names and explanatory text.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
