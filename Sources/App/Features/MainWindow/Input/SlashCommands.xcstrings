          "stringUnit": {
            "state": "translated",
            "value": "ニックネームまたはチャンネルを対象として使用します。複数の対象はカンマで区切ります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use um apelido ou um canal como alvo. Separe vários alvos com vírgulas."
          }
        }
      }
    },
    "hint-topic": {
      "comment": "Slash-command discovery. Command names and literal subcommands stay unchanged; translate placeholder names and explanatory text.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
