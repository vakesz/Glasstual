          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Introduzca una línea de protocolo IRC completa. Incluya un punto y coma antes de un parámetro final que contenga espacios."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
