    "hint-redact": {
      "comment": "Slash-command discovery. Command names and literal subcommands stay unchanged; translate placeholder names and explanatory text.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The message id is the message's msgid tag. Without a message id, your most recent message in the conversation is deleted. Requires server support for message redaction."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az üzenetazonosító az üzenet msgid címkéje. Üzenetazonosító nélkül a beszélgetésben legutóbb küldött üzeneted törlődik. A kiszolgálónak támogatnia kell az üzenettörlést."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Nachrichten-ID ist das msgid-Tag der Nachricht. Ohne Nachrichten-ID wird deine letzte Nachricht in der Unterhaltung gelöscht. Der Server muss das Löschen von Nachrichten unterstützen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El identificador es la etiqueta msgid del mensaje. Sin identificador, se elimina tu último mensaje de la conversación. Requiere compatibilidad del servidor con la eliminación de mensajes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’identifiant du message est l’étiquette msgid du message. Sans identifiant, votre dernier message de la conversation est supprimé. Nécessite la prise en charge de la suppression de messages par le serveur."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メッセージIDは、メッセージのmsgidタグです。メッセージIDを省略すると、会話内で最後に送信した自分のメッセージが削除されます。サーバがメッセージの削除に対応している必要があります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O ID da mensagem é a tag msgid da mensagem. Sem o ID, sua mensagem mais recente na conversa é apagada. Requer suporte do servidor à remoção de mensagens."
          }
        }
      }
    },
