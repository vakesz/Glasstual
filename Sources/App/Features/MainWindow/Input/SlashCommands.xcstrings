    "hint-mode": {
      "comment": "Slash-command discovery. Command names and literal subcommands stay unchanged; translate placeholder names and explanatory text.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start with + or - to change modes on the selected channel, or enter a target first."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A kijelölt csatorna módjait + vagy - jellel kezdve módosíthatod, vagy először adj meg egy célt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beginne mit + oder -, um Modi des ausgewählten Kanals zu ändern, oder gib zuerst ein Ziel ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Empieza con + o - para cambiar los modos del canal seleccionado, o introduce primero un destino."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Commencez par + ou - pour changer de mode sur le canal sélectionné, ou saisissez d’abord une cible."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択中のチャンネルのモードを変更するには+または-で始めるか、最初に対象を入力します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Comece com + ou - para alterar os modos do canal selecionado ou digite um alvo primeiro."
          }
        }
      }
    },
