        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Exige des privilèges d'opérateur de serveur. Les masques, durées et options pris en charge dépendent du serveur."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "サーバーオペレーターの権限が必要です。サポートされているマスク、期間、オプションはサーバーによって異なります。"
