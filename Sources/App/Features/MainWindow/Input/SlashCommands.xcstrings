          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiszolgálói támogatás szükséges. IRCv3 CHATHISTORY-alparancsot használj, például LATEST, a céllal és argumentumokkal."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Serverunterstützung ist erforderlich. Nutze einen IRCv3-CHATHISTORY-Unterbefehl wie LATEST mit Ziel und Argumenten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Se requiere el soporte del servidor. Utiliza un subcomando IRCv3 CHATHISTORY como LATEST con su objetivo y argumentos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Un support serveur est requis. Utilisez une sous-commande IRCv3 CHATHISTORY telle que LATEST avec son objet cible et ses arguments."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "サーバーサポートが必要です。ターゲットと引数を指定したLATESTなどのIRCv3 CHATHISTORYサブコマンドを使用します。"
