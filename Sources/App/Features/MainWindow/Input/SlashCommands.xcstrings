    "hint-nickname-address-book": {
      "comment": "Slash-command discovery. Command names and literal subcommands stay unchanged; translate placeholder names and explanatory text.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter a nickname. If no matching user is available, the Address Book opens for editing."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Adj meg egy becenevet. Ha nincs megfelelő felhasználó, szerkesztésre megnyílik a címjegyzék."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib einen Nickname ein. Falls keine passende Person verfügbar ist, öffnet sich das Adressbuch zur Bearbeitung."
          }
        }
      }
