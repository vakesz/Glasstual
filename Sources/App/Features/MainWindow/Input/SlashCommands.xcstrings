        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A csatornát elhagyva a kijelölt csatornára érvényes. Megfelelő csatornajogosultság szükséges."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohne Kanalangabe gilt der ausgewählte Kanal. Entsprechende Kanalrechte sind erforderlich."
          }
        }
      }
    },
    "hint-channels": {
      "comment": "Slash-command discovery. Command names and literal subcommands stay unchanged; translate placeholder names and explanatory text.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Separate multiple channel names with spaces."
          }
        },
        "hu": {
