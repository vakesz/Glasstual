    "hint-add-remove-mask": {
      "comment": "Slash-command discovery. Command names and literal subcommands stay unchanged; translate placeholder names and explanatory text.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use + to add a mask or - to remove one. With no arguments, requests the list. Requires server support."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "+ jellel hozzáadhatsz, - jellel eltávolíthatsz egy maszkot. Argumentum nélkül listáz. Kiszolgálói támogatás szükséges."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit + eine Maske hinzufügen, mit - entfernen. Ohne Argumente wird die Liste angefordert. Serverunterstützung erforderlich."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa + para añadir una máscara o - para eliminar una. Sin argumentos, solicita la lista. Requiere compatibilidad del servidor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez + pour ajouter un masque ou - pour en retirer un. Sans argument, demande la liste. Nécessite la prise en charge par le serveur."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "+でマスクを追加し、-で削除します。引数を指定しない場合は、リストを要求します。サーバの対応が必要です。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use + para adicionar uma máscara ou - para remover uma. Sem argumentos, solicita a lista. Requer suporte do servidor."
          }
        }
      }
    },
    "hint-all-joined-channels": {
      "comment": "Slash-command discovery. Command names and literal subcommands stay unchanged; translate placeholder names and explanatory text.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sends to every joined channel. Settings determine whether other connections are included."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Minden csatlakozott csatornára elküldi. A beállításoktól függ, hogy más kapcsolatokra is érvényes-e."
