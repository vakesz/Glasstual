          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Remplacez <espaces réservés> par des valeurs. Les éléments entre [crochets] sont facultatifs."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "<placeholders>を値に置き換えます。[角括弧]内の項目は任意です。"
