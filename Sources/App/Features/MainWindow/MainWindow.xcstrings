    "get-started-description": {
      "comment": "Welcome screen description shown before the first server is configured.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Glasstual is a powerful, lightweight IRC client built for the Mac. Add your first server to get started."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Glasstual egy sokoldalú, könnyű IRC-kliens Macre. A kezdéshez add hozzá az első kiszolgálódat."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Glasstual ist ein leistungsfähiger, schlanker IRC-Client für den Mac. Füge deinen ersten Server hinzu, um loszulegen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Glasstual es un cliente IRC potente y ligero diseñado para el Mac. Añade tu primer servidor para empezar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Glasstual est un client IRC puissant et léger conçu pour le Mac. Ajoutez votre premier serveur pour commencer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Glasstualは、Mac向けに作られた、パワフルで軽量なIRCクライアントです。最初のサーバを追加して始めましょう。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Glasstual é um cliente IRC poderoso e leve, feito para o Mac. Adicione seu primeiro servidor para começar."
          }
        }
      }
    },
