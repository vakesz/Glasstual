        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Glasstual egy sokoldalú, könnyű IRC-kliens Macre. A kezdéshez add hozzá az első kiszolgálódat."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glasstual ist ein leistungsfähiger, schlanker IRC-Client für den Mac. Füge deinen ersten Server hinzu, um loszulegen."
