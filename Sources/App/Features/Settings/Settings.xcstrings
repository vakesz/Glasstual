          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A WHO parancs legnagyobb csatornamérete"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Maximale Kanalgröße für WHO"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "QUÉ comando el tamaño máximo del canal"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Commande WHO pour la taille maximale du canal"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
