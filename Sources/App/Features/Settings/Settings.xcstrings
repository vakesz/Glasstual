    },
    "ircv3-capability-bouncer-networks": {
      "comment": "Summary of the soju.im/bouncer-networks capability, shown beside its switch in Settings.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lists the networks of a soju bouncer account so each can be shown as its own server."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Felsorolja egy soju-bouncer fiókjának hálózatait, hogy mindegyik önálló kiszolgálóként jelenhessen meg."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Listet die Netzwerke eines soju-Bouncer-Kontos auf, damit jedes als eigener Server angezeigt werden kann."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Enumera las redes de una cuenta de bouncer soju para que cada una se muestre como un servidor propio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Liste les réseaux d’un compte bouncer soju afin que chacun puisse apparaître comme un serveur à part entière."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "sojuバウンサーアカウントのネットワークを一覧にし、それぞれを個別のサーバとして表示できるようにします。"
          }
        },
        "pt-BR": {
