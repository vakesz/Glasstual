    },
    "style-scrollback-save-limit-note": {
      "comment": "Explanation below the scrollback save limit field.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The maximum number of messages, per-channel, that are accessible through the scrollback.\n\nMessages are not saved between app launches unless “Restore scrollback from previous session” in the General section of Settings is enabled."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A beszélgetési előzményekben csatornánként elérhető üzenetek maximális száma.\n\nAz üzenetek csak akkor maradnak meg az alkalmazás újraindításakor, ha a Beállítások Általános részében engedélyezed az \"Előző munkamenet előzményeinek visszaállítása\" lehetőséget."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Maximale Anzahl der pro Kanal im Verlauf verfügbaren Nachrichten.\n\nNachrichten bleiben zwischen App-Starts nur erhalten, wenn unter Einstellungen › Allgemein die Option \"Verlauf der vorherigen Sitzung wiederherstellen\" aktiviert ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "El número máximo de mensajes por canal accesibles en el historial.\n\nLos mensajes no se guardan entre los inicios de la aplicación, salvo que esté activada la opción “Restaurar el historial de la sesión anterior” en la sección General de Configuración."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le nombre maximal de messages par canal accessibles dans l’historique.\n\nLes messages ne sont pas conservés d’un lancement à l’autre, sauf si l’option « Restaurer l’historique de la session précédente » est activée dans la section Général des réglages."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "スクロールバックを通じてアクセスできるチャネルごとのメッセージの最大数。\n\n設定の「一般」セクションで「前のセッションからのスクロールバックを復元」が有効になっている場合を除き、アプリを起動するたびにメッセージは保存されません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Número máximo de mensagens por canal acessíveis no histórico.\n\nAs mensagens não são salvas entre as inicializações do aplicativo, a menos que a opção “Restaurar o histórico da sessão anterior” esteja ativada na seção Geral dos Ajustes."
          }
        }
      }
    },
