          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Visszaállítod a taglista alapértelmezett színeit?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Farben der Mitgliederliste auf die Standardwerte zurücksetzen?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Restablecer los colores de la lista de miembros a sus valores predeterminados?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
