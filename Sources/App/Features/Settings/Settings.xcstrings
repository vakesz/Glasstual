    "channel-management-ban-format-note": {
      "comment": "Explanation below the hostmask ban format popup.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When used in the context of a hostmask, an asterisk (*) represents a wildcard character that is matched by any possible value."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Címmaszkban a csillag (*) helyettesítő karakter, amely bármilyen értékre illeszkedik."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In einer Hostmaske steht ein Sternchen (*) als Platzhalter für einen beliebigen Wert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cuando se utiliza en el contexto de una máscara de host, un asterisco (*) representa un carácter de valor opcional que se corresponde con cualquier valor posible."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lorsqu'il est utilisé dans le contexte d'un masque d'hôte, un astérisque (*) représente un caractère de caractère générique qui est associé à toute valeur possible."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ホストマスクの文脈で使用される場合、星印（*）は、任意の可能な値と一致するワイルドカード文字を表します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Quando usado no contexto de uma máscara de hospedeiro, um asterisco (*) representa um caractere de caractere aleatório que é correspondido por qualquer valor possível."
          }
        }
      }
    },
    "channel-management-ban-format-whainn": {
      "comment": "Ban format matching every nickname for one user name at one address.",
