    },
    "general-away-on-idle-note": {
      "comment": "Explanation below the idle-away checkbox. Also applies when another user's session is switched to.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Glasstual marks you present again as soon as you use the keyboard or mouse. Switching to another user also sets your status."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Glasstual azonnal megszünteti a távol állapotot, amint használod a billentyűzetet vagy az egeret. Másik felhasználóra váltás is beállítja az állapotot."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Glasstual setzt dich wieder auf anwesend, sobald du Tastatur oder Maus benutzt. Auch der Wechsel zu einem anderen Benutzer setzt den Status."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Glasstual te marca como presente en cuanto usas el teclado o el ratón. Tu estado también se establece al cambiar a otro usuario."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Glasstual vous marque de nouveau présent dès que vous utilisez le clavier ou la souris. Changer d’utilisateur modifie aussi votre statut."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーボードまたはマウスを使うとすぐに、Glasstualはあなたを在席に戻します。別のユーザに切り替えた場合も、不在に設定されます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Glasstual marca você como presente de novo assim que você usa o teclado ou o mouse. Trocar para outro usuário também define seu status."
          }
        }
      }
    },
