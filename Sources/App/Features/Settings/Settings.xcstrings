    "style-scrollback-save-limit-note": {
      "comment": "Explanation below the scrollback save limit field.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The maximum number of messages, per-channel, that are accessible through the scrollback.\n\nMessages are not saved between app launches unless “Restore scrollback from previous session” in the Behavior section of Settings is enabled."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A beszélgetési előzményekben csatornánként elérhető üzenetek maximális száma.\n\nAz üzenetek csak akkor maradnak meg az alkalmazás újraindításakor, ha a Beállítások Viselkedés részében engedélyezed az \"Előző munkamenet előzményeinek visszaállítása\" lehetőséget."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Maximale Anzahl der pro Kanal im Verlauf verfügbaren Nachrichten.\n\nNachrichten bleiben zwischen App-Starts nur erhalten, wenn unter Einstellungen › Verhalten die Option \"Verlauf der vorherigen Sitzung wiederherstellen\" aktiviert ist."
          }
        }
      }
    },
