    "channel-management-ban-format-exact": {
      "comment": "Ban format matching the exact hostmask.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "nickname!username@address"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "nickname!username@address"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "nickname!username@address"
          }
        }
      }
    },
    "channel-management-ban-format-label": {
      "comment": "Label of the popup choosing the default hostmask ban format.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hostmask ban format"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kitiltási címmaszk formátuma"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Format der Bann-Hostmaske"
          }
        }
      }
    },
    "channel-management-ban-format-note": {
      "comment": "Explanation below the hostmask ban format popup.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When used in the context of a hostmask, an asterisk (*) represents a wildcard character that is matched by any possible value."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Címmaszkban a csillag (*) helyettesítő karakter, amely bármilyen értékre illeszkedik."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In einer Hostmaske steht ein Sternchen (*) als Platzhalter für einen beliebigen Wert."
          }
        }
      }
    },
    "channel-management-ban-format-whainn": {
      "comment": "Ban format matching every nickname for one user name at one address.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "*!ident@address"
