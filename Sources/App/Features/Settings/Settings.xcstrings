{
  "sourceLanguage": "en",
  "strings": {
    "prevent-sleep-explanation": {
      "comment": "Explanation below the prevent-sleep preference toggle.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Do not allow your Mac to go to sleep, which would disconnect it from the Internet, while Glasstual has at least one connection open."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne engedje a Macet alvó állapotba lépni, ami bontaná az internetkapcsolatot, amíg a Glasstualnak legalább egy nyitott kapcsolata van."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verhindere den Ruhezustand des Mac und damit die Trennung der Internetverbindung, solange Glasstual mindestens eine offene Verbindung hat."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No permitas que tu Mac entre en reposo, lo que lo desconectaría de Internet, mientras Glasstual tenga al menos una conexión abierta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Empêchez le Mac de se mettre en veille, ce qui le déconnecterait d’Internet, tant que Glasstual a au moins une connexion ouverte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Glasstualに1つ以上の接続が開かれている間、Macがスリープしてインターネットから切断されないようにします。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Impede que o Mac entre em repouso, o que o desconectaria da internet, enquanto o Glasstual tiver pelo menos uma conexão aberta."
          }
        }
      }
    },
    "prevent-sleep-while-connected": {
      "comment": "Toggle that keeps the Mac awake while Glasstual is connected.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Prevent sleep while Glasstual is connected"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Alvó állapot megakadályozása, amíg a Glasstual kapcsolódik"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ruhezustand verhindern, solange Glasstual verbunden ist"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Evitar el reposo mientras Glasstual esté conectado"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Empêcher la mise en veille lorsque Glasstual est connecté"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Glasstualの接続中はスリープを防ぐ"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Impedir repouso enquanto o Glasstual estiver conectado"
          }
        }
      }
    },
