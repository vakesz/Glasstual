    "channel-management-ban-format-note": {
      "comment": "Explanation below the hostmask ban format popup.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When used in the context of a hostmask, an asterisk (*) represents a wildcard character that is matched by any possible value."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Címmaszkban a csillag (*) helyettesítő karakter, amely bármilyen értékre illeszkedik."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In einer Hostmaske steht ein Sternchen (*) als Platzhalter für einen beliebigen Wert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando se usa en una máscara de host, un asterisco (*) representa un comodín que coincide con cualquier valor posible."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans un masque d’hôte, un astérisque (*) représente un caractère générique qui correspond à n’importe quelle valeur possible."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ホストマスクでは、アスタリスク(*)は、あらゆる値に一致するワイルドカード文字を表します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "No contexto de uma máscara de host, um asterisco (*) representa um curinga que corresponde a qualquer valor possível."
          }
        }
      }
    },
