          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "0 (deaktivieren)"
          }
        }
      }
    },
    "flood-control-identify-delay-label": {
      "comment": "Label of the slider setting the delay before joins that do not wait for NickServ confirmation.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delay before channel joins"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Késleltetés a csatornákhoz csatlakozás előtt"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verzögerung vor dem Kanalbeitritt"
          }
        }
      }
    },
    "flood-control-identify-delay-note": {
      "comment": "Explanation below the delay before channel joins slider.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delay before joining channels, in seconds. NickServ identification uses confirmation instead and joins immediately when confirmed or after its 30-second deadline."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Késleltetés másodpercben a csatornákhoz csatlakozás előtt. NickServ-azonosítás esetén ehelyett a megerősítést várjuk: csatlakozás azonnal a megerősítéskor vagy a 30 másodperces határidő után."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verzögerung vor dem Kanalbeitritt in Sekunden. Bei NickServ-Identifizierung wird stattdessen auf die Bestätigung gewartet und danach sofort oder nach Ablauf von 30 Sekunden beigetreten."
          }
        }
      }
    },
    "flood-control-note": {
      "comment": "Flood-control explanation below the channel join delay sliders.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Joining too many channels at once may be detected as an attack by some IRC networks. You could be disconnected or banned as a result. A moderate delay of about 2.5 seconds is recommended when joining a large number of channels."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ha túl sok csatornához csatlakozol egyszerre, egyes IRC-hálózatok ezt támadásnak tekinthetik. Emiatt bonthatják a kapcsolatot vagy kitilthatnak. Sok csatorna esetén körülbelül 2,5 másodperces késleltetés ajánlott."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der gleichzeitige Beitritt zu zu vielen Kanälen kann von manchen IRC-Netzwerken als Angriff erkannt werden. Das kann zur Trennung oder zu einem Bann führen. Bei vielen Kanälen wird eine Verzögerung von etwa 2,5 Sekunden empfohlen."
          }
        }
      }
    },
    "flood-control-seconds-value": {
      "comment": "Current value of the join-delay slider. %@ is the number of seconds.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ seconds"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ másodperc"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Sekunden"
          }
        }
      }
    },
    "flood-control-who-limit-label": {
      "comment": "Label of the slider limiting which channels are polled for away status.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "WHO command maximum channel size"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A WHO parancs legnagyobb csatornamérete"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Maximale Kanalgröße für WHO"
          }
        }
      }
    },
    "flood-control-who-limit-note": {
      "comment": "Explanation below the WHO command channel size slider.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Glasstual must periodically poll the channels that you are in to find out when the away status of each user changes. This setting defines the maximum number of users a channel can contain before the channel is skipped over.\n\nA lower value is always better especially when in a large number of channels."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Glasstualnak rendszeresen le kell kérdeznie a csatornákat a felhasználók távolléti állapotának követéséhez. Ez a beállítás határozza meg azt a taglétszámot, amely felett egy csatorna kimarad.\n\nAz alacsonyabb érték előnyösebb, különösen sok csatorna esetén."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
