    "general-spotlight-direct-messages-note": {
      "comment": "Explanation below the direct-messages Spotlight checkbox.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Direct conversations are named after people, so they stay out of Spotlight unless you turn this on."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A privát beszélgetések személyekről kapják a nevüket, ezért csak akkor kerülnek a Spotlightba, ha ezt bekapcsolod."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Private Unterhaltungen sind nach Personen benannt und bleiben daher außerhalb von Spotlight, solange du dies nicht einschaltest."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las conversaciones directas llevan nombres de personas, por lo que no aparecen en Spotlight a menos que lo actives."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les conversations directes portent le nom de personnes ; elles restent donc hors de Spotlight, sauf si vous l’activez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ダイレクトの会話は人物名が付いているため、オンにしない限りSpotlightには表示されません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As conversas diretas têm o nome de pessoas, por isso ficam fora do Spotlight, a menos que você ative esta opção."
          }
        }
      }
    },
    "ircv3-capability-message-redaction": {
      "comment": "Summary of the draft/message-redaction IRCv3 capability, shown beside its switch in Settings.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lets you delete messages, and shows when others delete theirs."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Lehetővé teszi az üzenetek törlését, és megjeleníti, ha mások törlik a sajátjukat."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ermöglicht das Löschen von Nachrichten und zeigt an, wenn andere ihre löschen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite eliminar mensajes y muestra cuándo otros eliminan los suyos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Permet de supprimer des messages et indique quand d’autres suppriment les leurs."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メッセージを削除でき、他のユーザが削除したときも表示します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite apagar mensagens e mostra quando outras pessoas apagam as delas."
          }
        }
      }
    },
    "ircv3-capability-channel-rename": {
      "comment": "Summary of the draft/channel-rename IRCv3 capability, shown beside its switch in Settings.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keeps a channel's members and history when its name changes."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Megőrzi a csatorna tagjait és előzményeit, ha megváltozik a neve."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
