          }
        }
      }
    },
    "interface-reset-colors-confirmation-body": {
      "comment": "Body of the alert confirming a reset of the member-list colors. Says what is lost.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The colors you chose will be replaced. This action cannot be undone."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A választott színek felülíródnak. Ez a művelet nem vonható vissza."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine gewählten Farben werden ersetzt. Diese Aktion kann nicht rückgängig gemacht werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se reemplazarán los colores que elegiste. Esta acción no se puede deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les couleurs que vous avez choisies seront remplacées. Cette action est irréversible."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択した色は置き換えられます。この操作は取り消せません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As cores que você escolheu serão substituídas. Esta ação não pode ser desfeita."
          }
        }
      }
    },
    "interface-reset-theme-confirmation": {
      "comment": "Title of the alert confirming that the customised transcript theme will be replaced by a default one.",
