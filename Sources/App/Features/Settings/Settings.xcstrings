    "style-scrollback-save-limit": {
      "comment": "Label of the scrollback save limit field.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scrollback save limit"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Mentett előzmények korlátja"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Limit für gespeicherten Verlauf"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Límite de guardado del historial de desplazamiento"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Limite d’enregistrement de l’historique de défilement"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スクロールバックの保存上限"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Limite de histórico de rolagem salvo"
          }
        }
      }
    },
    "style-scrollback-save-limit-note": {
      "comment": "Explanation below the scrollback save limit field.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The maximum number of messages, per-channel, that are accessible through the scrollback.\n\nMessages are not saved between app launches unless “Restore scrollback from previous session” in the General section of Settings is enabled."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A beszélgetési előzményekben csatornánként elérhető üzenetek maximális száma.\n\nAz üzenetek csak akkor maradnak meg az alkalmazás újraindításakor, ha a Beállítások Általános részében engedélyezed az \"Előző munkamenet előzményeinek visszaállítása\" lehetőséget."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Maximale Anzahl der pro Kanal im Verlauf verfügbaren Nachrichten.\n\nNachrichten bleiben zwischen App-Starts nur erhalten, wenn unter Einstellungen › Allgemein die Option \"Verlauf der vorherigen Sitzung wiederherstellen\" aktiviert ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El número máximo de mensajes por canal accesibles en el historial de desplazamiento.\n\nLos mensajes no se conservan entre inicios de la app, salvo que esté activada la opción «Restaurar el historial de desplazamiento de la sesión anterior» en la sección General de Ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le nombre maximal de messages, par canal, accessibles dans l’historique de défilement.\n\nLes messages ne sont pas conservés d’un lancement à l’autre, sauf si « Restaurer l’historique de défilement de la session précédente » est activé dans la section Général des réglages."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スクロールバックでアクセスできるメッセージの、チャンネルごとの最大数です。\n\n設定の「一般」セクションで「前回のセッションのスクロールバックを復元」が有効になっていない限り、メッセージはアプリの起動をまたいで保存されません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O número máximo de mensagens, por canal, acessíveis pelo histórico de rolagem.\n\nAs mensagens não são salvas entre as aberturas do app, a menos que “Restaurar o histórico de rolagem da sessão anterior” esteja ativado na seção Geral dos Ajustes."
          }
        }
      }
    },
