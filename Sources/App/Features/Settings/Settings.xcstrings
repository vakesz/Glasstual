    "interface-reset-colors-confirmation": {
      "comment": "Title of the alert confirming that every member-list colour the user picked will be replaced by the defaults.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
