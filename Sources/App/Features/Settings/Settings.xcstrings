    "notifications-mute-note": {
      "comment": "Explanatory note under the mentions checkbox in the Notifications pane.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mute a single conversation from its Server or Channel properties."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egy adott beszélgetést a kiszolgáló vagy a csatorna beállításainál némíthat el."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine einzelne Unterhaltung kannst du in ihren Server- oder Kanaleinstellungen stummschalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Silenciar una conversación individual desde las propiedades del servidor o del canal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mettez une seule conversation en sourdine depuis les propriétés du serveur ou du canal."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバまたはチャンネルのプロパティから、個別の会話を消音できます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
