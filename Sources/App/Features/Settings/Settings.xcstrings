    "ircv3-capability-account-notify": {
      "comment": "Summary of the account-notify IRCv3 capability, shown beside its switch in Settings.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows when someone signs in to or out of a network account."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Jelzi, ha valaki be- vagy kijelentkezik egy hálózati fiókból."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt an, wenn sich jemand bei einem Netzwerkkonto an- oder abmeldet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra cuándo alguien inicia sesión o cierra sesión en una cuenta de red."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Indique quand quelqu’un se connecte à un compte réseau ou s’en déconnecte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ネットワークアカウントへのサインインまたはサインアウトを表示します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra quando alguém entra ou sai de uma conta da rede."
          }
        }
      }
    },
    "ircv3-capability-account-tag": {
      "comment": "Summary of the account-tag IRCv3 capability, shown beside its switch in Settings.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Marks each message with the network account its sender is signed in to."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Minden üzenethez hozzárendeli a küldő hálózati fiókját."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kennzeichnet jede Nachricht mit dem Netzwerkkonto des Absenders."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Marca cada mensaje con la cuenta de red en la que ha iniciado sesión su remitente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Associe à chaque message le compte réseau auquel son expéditeur est connecté."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各メッセージに、送信者がサインインしているネットワークアカウントを付与します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Marca cada mensagem com a conta da rede na qual o remetente está conectado."
          }
        }
      }
    },
    "ircv3-capability-away-notify": {
      "comment": "Summary of the away-notify IRCv3 capability, shown beside its switch in Settings.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows when people go away or come back without asking the server."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A kiszolgáló lekérdezése nélkül jelzi a távollétet és a visszatérést."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt Abwesenheit und Rückkehr ohne Abfragen beim Server an."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra cuándo las personas se ausentan o vuelven sin preguntar al servidor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Indique quand des personnes s’absentent ou reviennent, sans interroger le serveur."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバに問い合わせることなく、ユーザの離席や復帰を表示します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra quando as pessoas ficam ausentes ou voltam, sem precisar consultar o servidor."
          }
        }
      }
    },
    "ircv3-capability-batch": {
      "comment": "Summary of the batch IRCv3 capability, shown beside its switch in Settings.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lets the server group related messages so they arrive together."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Lehetővé teszi a kapcsolódó üzenetek csoportosítását, hogy együtt érkezzenek."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlaubt dem Server, zusammengehörige Nachrichten gemeinsam zu übermitteln."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite que el servidor agrupe los mensajes relacionados para que lleguen juntos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Permet au serveur de regrouper les messages liés afin qu’ils arrivent ensemble."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバが関連するメッセージをまとめて、一緒に届くようにします。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite que o servidor agrupe mensagens relacionadas para que cheguem juntas."
          }
        }
      }
    },
    "ircv3-capability-cap-notify": {
      "comment": "Summary of the cap-notify IRCv3 capability, shown beside its switch in Settings.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Picks up features a server turns on or off while you stay connected."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Követi a kiszolgáló által kapcsolódás közben be- vagy kikapcsolt funkciókat."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erkennt Funktionen, die der Server während der Verbindung ein- oder ausschaltet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Detecta las funciones que un servidor activa o desactiva mientras sigues conectado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Détecte les fonctionnalités qu’un serveur active ou désactive pendant que vous restez connecté."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続中にサーバがオンまたはオフにした機能を取得します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Detecta recursos que um servidor ativa ou desativa enquanto você permanece conectado."
          }
        }
      }
    },
    "ircv3-capability-chghost": {
      "comment": "Summary of the chghost IRCv3 capability, shown beside its switch in Settings.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Follows a person's address changing without showing them leave and rejoin."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Követi a felhasználó címváltozását kilépés és újracsatlakozás megjelenítése nélkül."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verfolgt Adressänderungen, ohne ein Verlassen und erneutes Beitreten anzuzeigen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sigue los cambios de dirección de una persona sin mostrar que se va y vuelve a entrar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Suit le changement d’adresse d’une personne sans la montrer partir puis revenir."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ユーザのアドレスが変わったときに、退出と再参加を表示せずに追従します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Acompanha a mudança de endereço de uma pessoa sem mostrar que ela saiu e entrou de novo."
          }
        }
      }
    },
    "ircv3-capability-extended-join": {
      "comment": "Summary of the extended-join IRCv3 capability, shown beside its switch in Settings.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows the account and real name of each person as they join a channel."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Csatlakozáskor megjeleníti a felhasználók fiókját és valódi nevét."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt beim Kanalbeitritt das Konto und den echten Namen an."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra la cuenta y el nombre real de cada persona cuando se une a un canal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche le compte et le nom réel de chaque personne qui rejoint un canal."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ユーザがチャンネルに参加したときに、そのアカウントと本名を表示します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra a conta e o nome real de cada pessoa quando ela entra em um canal."
          }
        }
      }
    },
    "ircv3-capability-extended-monitor": {
      "comment": "Summary of the extended-monitor IRCv3 capability, shown beside its switch in Settings.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Extends away, account and name notices to the people you watch for."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A távolléti, fiók- és névértesítéseket a követett felhasználókra is kiterjeszti."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erweitert Abwesenheits-, Konto- und Namensmeldungen auf beobachtete Benutzer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Extiende los avisos de ausencia, cuenta y nombre a las personas a las que sigues."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Étend les notifications d’absence, de compte et de nom aux personnes que vous surveillez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "離席、アカウント、名前の通知を、監視しているユーザにも拡張します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Estende os avisos de ausência, conta e nome às pessoas que você acompanha."
          }
        }
      }
    },
    "ircv3-capability-invite-notify": {
      "comment": "Summary of the invite-notify IRCv3 capability, shown beside its switch in Settings.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows invitations other members send to a channel you are in."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Megjeleníti a többi tag által küldött meghívásokat a csatornán."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt Einladungen an, die andere Mitglieder in einen deiner Kanäle senden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra las invitaciones que otros miembros envían a un canal en el que estás."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche les invitations que d’autres membres envoient vers un canal où vous êtes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "参加しているチャンネルに他のメンバーが送った招待を表示します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra os convites que outros membros enviam para um canal em que você está."
          }
        }
      }
    },
    "ircv3-capability-labeled-response": {
      "comment": "Summary of the labeled-response IRCv3 capability, shown beside its switch in Settings.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Matches each server reply to the command that asked for it."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Minden kiszolgálóválaszt a hozzá tartozó parancshoz rendel."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ordnet jede Serverantwort dem auslösenden Befehl zu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Asocia cada respuesta del servidor con el comando que la solicitó."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Associe chaque réponse du serveur à la commande qui l’a provoquée."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各サーバ応答を、それを要求したコマンドと対応付けます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Associa cada resposta do servidor ao comando que a solicitou."
          }
        }
      }
    },
    "ircv3-capability-message-tags": {
      "comment": "Summary of the message-tags IRCv3 capability, shown beside its switch in Settings.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Carries the extra detail other features attach to a message, such as its time."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Továbbítja az üzenetekhez kapcsolt kiegészítő adatokat, például az időpontot."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Überträgt zusätzliche Nachrichtendetails wie den Zeitstempel."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Transporta los detalles adicionales que otras funciones añaden a un mensaje, como su hora."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Transporte les détails supplémentaires que d’autres fonctionnalités joignent à un message, comme son heure."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "時刻など、他の機能がメッセージに付ける追加情報を保持します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Transporta os detalhes extras que outros recursos anexam a uma mensagem, como a hora dela."
          }
        }
      }
    },
    "ircv3-capability-multi-prefix": {
      "comment": "Summary of the multi-prefix IRCv3 capability, shown beside its switch in Settings.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows every rank a person holds in a channel instead of only the highest."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A felhasználó minden csatornarangját megjeleníti, nem csak a legmagasabbat."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt alle Kanalränge einer Person statt nur des höchsten an."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra todos los rangos que una persona tiene en un canal, no solo el más alto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche tous les rangs d’une personne dans un canal, et pas seulement le plus élevé."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "チャンネルでユーザが持つすべてのランクを、最上位のみではなく表示します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra todos os níveis que uma pessoa tem em um canal, e não apenas o mais alto."
          }
        }
      }
    },
    "ircv3-capability-multiline": {
      "comment": "Summary of the draft/multiline IRCv3 capability, shown beside its switch in Settings.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sends pasted text as one multi-line message and shows other people's the same way."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A beillesztett szöveget egyetlen többsoros üzenetként küldi el, és másokét is így jeleníti meg."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sendet eingefügten Text als eine mehrzeilige Nachricht und zeigt die Nachrichten anderer ebenso an."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Envía el texto pegado como un único mensaje de varias líneas y muestra igual los de otras personas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Envoie le texte collé sous forme d’un seul message multiligne et affiche de la même façon ceux des autres."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "貼り付けたテキストを複数行の1つのメッセージとして送信し、他のユーザのメッセージも同じように表示します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Envia o texto colado como uma única mensagem de várias linhas e mostra as de outras pessoas da mesma forma."
          }
        }
      }
    },
    "ircv3-capability-no-implicit-names": {
      "comment": "Summary of the draft/no-implicit-names IRCv3 capability, shown beside its switch in Settings.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stops the server sending a channel's member list on every join; the app asks for it instead."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Megakadályozza, hogy a kiszolgáló minden csatlakozáskor elküldje a csatorna tagjainak listáját; az alkalmazás kéri le helyette."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verhindert, dass der Server bei jedem Beitritt die Mitgliederliste eines Kanals sendet; die App fordert sie stattdessen an."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Evita que el servidor envíe la lista de miembros de un canal en cada entrada; la app la solicita por su cuenta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Empêche le serveur d’envoyer la liste des membres d’un canal à chaque arrivée ; l’app la demande à la place."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "参加のたびにサーバがチャンネルのメンバーリストを送信しないようにします。代わりにアプリが要求します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Impede que o servidor envie a lista de membros de um canal a cada entrada; o app a solicita em vez disso."
          }
        }
      }
    },
    "ircv3-capability-pre-away": {
      "comment": "Summary of the pre-away IRCv3 capability, shown beside its switch in Settings.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Marks you away as the connection starts, before you join anything."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Már a kapcsolódás kezdetén távollétet jelez, mielőtt csatlakoznál bárhová."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Markiert dich beim Verbindungsaufbau als abwesend, noch bevor du einem Kanal beitrittst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Te marca como ausente al iniciar la conexión, antes de que entres en ningún canal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous marque comme absent dès le début de la connexion, avant de rejoindre quoi que ce soit."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "何かに参加する前の接続開始時に、あなたを不在に設定します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Marca você como ausente quando a conexão começa, antes de entrar em qualquer canal."
          }
        }
      }
    },
    "ircv3-capability-sasl": {
      "comment": "Summary of the sasl IRCv3 capability, shown beside its switch in Settings.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Signs in to the network with your account before joining anything."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A csatornákhoz csatlakozás előtt bejelentkezik a hálózati fiókodba."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Meldet dich vor jedem Kanalbeitritt mit deinem Konto beim Netzwerk an."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia sesión en la red con tu cuenta antes de unirte a nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connecte au réseau avec votre compte avant de rejoindre quoi que ce soit."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "何かに参加する前に、アカウントでネットワークにサインインします。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Entra na rede com a sua conta antes de entrar em qualquer canal."
          }
        }
      }
    },
    "ircv3-capability-server-time": {
      "comment": "Summary of the server-time IRCv3 capability, shown beside its switch in Settings.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Timestamps a message with when the server saw it, not when it reached you."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az üzenet időpontja az lesz, amikor a kiszolgáló megkapta, nem amikor hozzád megérkezett."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwendet den Empfangszeitpunkt des Servers als Nachrichtenzeit statt deiner lokalen Empfangszeit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Marca cada mensaje con la hora a la que lo vio el servidor, no con la hora a la que te llegó."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Horodate un message selon le moment où le serveur l’a vu, et non celui où il vous est parvenu."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メッセージに、あなたに届いた時刻ではなく、サーバが受信した時刻をタイムスタンプとして付けます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra a hora de uma mensagem como a em que o servidor a viu, e não a em que ela chegou a você."
          }
        }
      }
    },
    "ircv3-capability-setname": {
      "comment": "Summary of the setname IRCv3 capability, shown beside its switch in Settings.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows when a person changes their real name."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Jelzi, ha valaki módosítja a valódi nevét."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt Änderungen des echten Namens an."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra cuándo una persona cambia su nombre real."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Indique quand une personne change son nom réel."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ユーザが本名を変更したときに表示します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra quando uma pessoa altera o nome real."
          }
        }
      }
    },
    "ircv3-capability-specification": {
      "comment": "Link beside an IRCv3 capability switch, opening the document that defines it.",
