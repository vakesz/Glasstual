          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conserva los miembros y el historial de un canal cuando cambia su nombre."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Conserve les membres et l’historique d’un canal lorsque son nom change."
          }
