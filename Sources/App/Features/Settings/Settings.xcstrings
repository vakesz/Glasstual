    "incoming-data-unicode-spam-note": {
      "comment": "Explanation below the combining diacritical marks checkbox, which filters unicode spam.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These characters are often combined to form “Zalgo text”, which is used by some users to disrupt chatrooms."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ezeket a karaktereket gyakran \"Zalgo-szöveggé\" kombinálják, amellyel egyes felhasználók megzavarják a csevegést."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Zeichen werden oft zu \"Zalgo-Text\" kombiniert, den manche Benutzer zur Störung von Chaträumen einsetzen."
