    "incoming-data-highlight-spam-note": {
      "comment": "Explanation below the highlight spam checkbox.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Do not notify you of a highlight if at least ten nicknames make up three quarters of a message."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne értesítsen említésről, ha egy üzenet háromnegyedét legalább tíz becenév teszi ki."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Benachrichtigung über eine Erwähnung, wenn drei Viertel der Nachricht aus mindestens zehn Nicknamen bestehen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No notificar una mención si al menos diez apodos componen tres cuartas partes de un mensaje."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne pas vous notifier d’une mention si au moins dix pseudos représentent les trois quarts d’un message."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "10件以上のニックネームがメッセージの4分の3を占める場合は、ハイライトを通知しません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não avisa sobre um destaque se pelo menos dez apelidos formarem três quartos de uma mensagem."
          }
        }
      }
    },
