            "state": "translated",
            "value": "Spécification"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "仕様"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Especificação"
          }
        }
      }
    },
    "ircv3-capability-standard-replies": {
      "comment": "Summary of the standard-replies IRCv3 capability, shown beside its switch in Settings.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lets the server describe a failure in a form the client can explain."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A kiszolgáló a kliens által értelmezhető formában írhatja le a hibákat."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlaubt dem Server, Fehler in einer vom Client verständlichen Form zu beschreiben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite que el servidor describa un fallo de forma que el cliente pueda explicarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Permet au serveur de décrire un échec sous une forme que le client peut expliquer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバが、クライアントが説明できる形式でエラーを伝えられるようにします。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite que o servidor descreva uma falha de uma forma que o cliente consiga explicar."
          }
        }
      }
    },
    "ircv3-capability-userhost-in-names": {
      "comment": "Summary of the userhost-in-names IRCv3 capability, shown beside its switch in Settings.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Learns each member's full address while a channel's member list arrives."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A csatorna taglistájával együtt lekéri minden tag teljes címét."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erhält mit der Mitgliederliste die vollständige Adresse jedes Mitglieds."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Averigua la dirección completa de cada miembro mientras llega la lista de miembros de un canal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apprend l’adresse complète de chaque membre à la réception de la liste des membres d’un canal."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "チャンネルのメンバーリストが届く際に、各メンバーの完全なアドレスを取得します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Descobre o endereço completo de cada membro enquanto a lista de membros de um canal chega."
          }
        }
      }
    },
    "ircv3-capability-znc-playback": {
      "comment": "Summary of the znc.in/playback IRCv3 capability, shown beside its switch in Settings.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Asks a ZNC bouncer for the messages you missed and nothing else."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Csak az elmulasztott üzeneteket kéri le a ZNC-közvetítőtől."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fordert vom ZNC-Bouncer nur die verpassten Nachrichten an."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pide a un bouncer ZNC solo los mensajes que te perdiste."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demande à un bouncer ZNC les messages que vous avez manqués, et rien d’autre."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ZNCバウンサーに、見逃したメッセージのみを要求します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pede a um bouncer ZNC as mensagens que você perdeu e nada mais."
          }
        }
      }
    },
    "ircv3-capability-znc-self-message": {
      "comment": "Summary of the znc.in/self-message IRCv3 capability, shown beside its switch in Settings.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Includes messages you sent from another client in ZNC playback."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A másik kliensből küldött üzeneteket is megjeleníti a ZNC-előzményekben."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bezieht von einem anderen Client gesendete Nachrichten in die ZNC-Wiedergabe ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Incluye en la reproducción de ZNC los mensajes que enviaste desde otro cliente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Inclut dans la relecture ZNC les messages que vous avez envoyés depuis un autre client."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ZNCの再生に、別のクライアントから送信したメッセージを含めます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Inclui na reprodução do ZNC as mensagens que você enviou de outro cliente."
          }
        }
      }
    },
    "ircv3-capability-znc-server-time": {
      "comment": "Summary of the znc.in/server-time IRCv3 capability, shown beside its switch in Settings.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Timestamps ZNC playback with when each message was originally sent."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A ZNC-előzményekben az üzenetek eredeti küldési időpontját használja."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwendet in der ZNC-Wiedergabe die ursprüngliche Sendezeit jeder Nachricht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Marca la hora de la reproducción de ZNC con la hora en que se envió originalmente cada mensaje."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Horodate la relecture ZNC selon le moment où chaque message a été envoyé à l’origine."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ZNCの再生に、各メッセージが元々送信された時刻のタイムスタンプを付けます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra na reprodução do ZNC a hora em que cada mensagem foi originalmente enviada."
          }
        }
      }
    },
    "ircv3-capability-znc-server-time-iso": {
      "comment": "Summary of the znc.in/server-time-iso IRCv3 capability, shown beside its switch in Settings.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Timestamps ZNC playback on bouncers too old for the standard capability."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A szabványos képességet nem támogató régi közvetítőknél is időbélyegzi a ZNC-előzményeket."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwendet Zeitstempel für ZNC-Wiedergaben auch bei Bouncern, die für die Standardfähigkeit zu alt sind."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Marca la hora de la reproducción de ZNC en bouncers demasiado antiguos para la capacidad estándar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Horodate la relecture ZNC sur les bouncers trop anciens pour la capacité standard."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "標準の機能に対応していない古いバウンサーで、ZNCの再生にタイムスタンプを付けます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra a hora na reprodução do ZNC em bouncers antigos demais para a capacidade padrão."
          }
        }
      }
    },
    "ircv3-capability-znc-tlsinfo": {
      "comment": "Summary of the znc.in/tlsinfo IRCv3 capability, shown beside its switch in Settings.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reports the encryption a ZNC bouncer uses to reach the network."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Jelzi a ZNC-közvetítő és a hálózat közötti titkosítást."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Meldet die Verschlüsselung zwischen ZNC-Bouncer und Netzwerk."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Informa del cifrado que usa un bouncer ZNC para conectarse a la red."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Signale le chiffrement qu’un bouncer ZNC utilise pour atteindre le réseau."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ZNCバウンサーがネットワークに接続する際に使用する暗号化を報告します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Informa a criptografia que um bouncer ZNC usa para chegar à rede."
          }
        }
      }
