    "interface-reset-theme-confirmation-body": {
      "comment": "Body of the alert confirming a reset of the transcript theme. Says what is lost.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The fonts and colors you chose will be replaced. Export the theme first to keep a copy. This action cannot be undone."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A választott betűtípusok és színek felülíródnak. Másolat megőrzéséhez először exportáld a témát. Ez a művelet nem vonható vissza."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine gewählten Schriften und Farben werden ersetzt. Exportiere das Design vorher, um eine Kopie zu behalten. Diese Aktion kann nicht rückgängig gemacht werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se reemplazarán las fuentes y los colores que elegiste. Exporta primero el tema para conservar una copia. Esta acción no se puede deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les polices et couleurs que vous avez choisies seront remplacées. Exportez d’abord le thème pour en conserver une copie. Cette action est irréversible."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択したフォントと色は置き換えられます。コピーを残すには、先にテーマを書き出してください。この操作は取り消せません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As fontes e cores que você escolheu serão substituídas. Exporte o tema primeiro para manter uma cópia. Esta ação não pode ser desfeita."
          }
        }
      }
    },
