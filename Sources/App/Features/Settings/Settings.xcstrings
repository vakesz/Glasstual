    "flood-control-identify-delay-label": {
      "comment": "Label of the slider setting the delay before joins that do not wait for NickServ confirmation.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delay before channel joins"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Késleltetés a csatornákhoz csatlakozás előtt"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verzögerung vor dem Kanalbeitritt"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Retraso antes de unirse a los canales"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Délai avant de rejoindre les canaux"
          }
        },
        "ja": {
