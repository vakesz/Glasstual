    "incoming-data-unicode-spam-note": {
      "comment": "Explanation below the combining diacritical marks checkbox, which filters unicode spam.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These characters are often combined to form “Zalgo text”, which is used by some users to disrupt chatrooms."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ezeket a karaktereket gyakran \"Zalgo-szöveggé\" kombinálják, amellyel egyes felhasználók megzavarják a csevegést."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Zeichen werden oft zu \"Zalgo-Text\" kombiniert, den manche Benutzer zur Störung von Chaträumen einsetzen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Estos caracteres a menudo se combinan para formar \"texto Zalgo\", que es utilizado por algunos usuarios para interrumpir las salas de chat."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ces caractères sont souvent combinés pour former du « texte Zalgo », qui est utilisé par certains utilisateurs pour perturber les salles de discussion."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "これらの文字はしばしば組み合わせて「Zalgoテキスト」を形成し、一部のユーザーがチャットルームを混乱させるために使用します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Esses caracteres são frequentemente combinados para formar \"texto Zalgo\", que é usado por alguns usuários para interromper salas de chat."
          }
        }
      }
    },
