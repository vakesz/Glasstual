    "notifications-announce-voiceover-note": {
      "comment": "Note below the VoiceOver announcements checkbox in the Notifications pane.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only while VoiceOver is running. Announcements are spoken even when the conversation is open."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur solange VoiceOver läuft. Ansagen erfolgen auch, wenn die Unterhaltung geöffnet ist."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Csak akkor, ha a VoiceOver fut. A bemondás akkor is megtörténik, ha a beszélgetés meg van nyitva."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo mientras VoiceOver está activo. Los avisos se leen aunque la conversación esté abierta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uniquement lorsque VoiceOver est actif. Les annonces sont lues même lorsque la conversation est ouverte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "VoiceOverの実行中のみ。会話が開いている場合も読み上げます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Somente enquanto o VoiceOver estiver em execução. Os anúncios são falados mesmo quando a conversa está aberta."
          }
        }
      }
    },
    "general-away-on-idle": {
      "comment": "Checkbox in the General pane: marks the user away after a period without keyboard or mouse input.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set away status when your Mac is idle"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Távol állapot beállítása, ha a Mac tétlen"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abwesenheitsstatus setzen, wenn der Mac inaktiv ist"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Establecer el estado de ausencia cuando el Mac esté inactivo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Définir le statut d’absence lorsque le Mac est inactif"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
