    "language-restart-help": {
      "comment": "App language preference in General settings. Changes apply after relaunch.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quit and reopen Glasstual to apply a language change."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A nyelv módosításához lépj ki a Glasstualból, majd nyisd meg újra."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beende Glasstual und öffne die App erneut, um die Sprache zu ändern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cierra y vuelve a abrir Glasstual para aplicar un cambio de idioma."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quittez et rouvrez Glasstual pour appliquer un changement de langue."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "言語の変更を反映するには、Glasstualを終了して再度開いてください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Saia do Glasstual e abra-o novamente para aplicar uma mudança de idioma."
          }
        }
      }
    },
