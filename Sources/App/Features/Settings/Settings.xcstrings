{
  "sourceLanguage": "en",
  "strings": {
    "prevent-sleep-explanation": {
      "comment": "Explanation below the prevent-sleep preference toggle.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Do not allow your Mac to go to sleep, which would disconnect it from the Internet, while Glasstual has at least one connection open."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne engedje a Macet alvó állapotba lépni, ami bontaná az internetkapcsolatot, amíg a Glasstualnak legalább egy nyitott kapcsolata van."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verhindere den Ruhezustand des Mac und damit die Trennung der Internetverbindung, solange Glasstual mindestens eine offene Verbindung hat."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "No permitas que tu Mac entre en modo de espera, lo que lo desconectaría de Internet, mientras Glasstual tenga al menos una conexión abierta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ne laissez pas votre Mac entrer en veille, ce qui le déconnecterait de l’Internet, pendant que Glasstual a au moins une connexion ouverte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Glasstualに少なくとも1つの接続がオープンしている間は、Macが睡眠モードに入り、インターネットから接続が切断されるのを防いでください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Não permita que o Mac entre no modo de sono, o que o desconectaria da Internet, enquanto Glasstual tiver pelo menos uma conexão aberta."
          }
        }
      }
    },
    "prevent-sleep-while-connected": {
      "comment": "Toggle that keeps the Mac awake while Glasstual is connected.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Prevent sleep while Glasstual is connected"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Alvó állapot megakadályozása, amíg a Glasstual kapcsolódik"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ruhezustand verhindern, solange Glasstual verbunden ist"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Prevenir el sueño mientras Glasstual está conectado"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Prévenir le sommeil lorsque Glasstual est connecté"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Glasstualが接続されている間は睡眠を防止する"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Prevenir o sono enquanto Glasstual está conectado"
          }
        }
      }
    },
