    "incoming-data-unicode-spam-note": {
      "comment": "Explanation below the combining diacritical marks checkbox, which filters unicode spam.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These characters are often combined to form “Zalgo text”, which is used by some users to disrupt chatrooms."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ezeket a karaktereket gyakran \"Zalgo-szöveggé\" kombinálják, amellyel egyes felhasználók megzavarják a csevegést."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Zeichen werden oft zu \"Zalgo-Text\" kombiniert, den manche Benutzer zur Störung von Chaträumen einsetzen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estos caracteres suelen combinarse para formar «texto Zalgo», que algunos usuarios utilizan para perturbar las salas de chat."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ces caractères sont souvent combinés pour former du « texte Zalgo », que certains utilisateurs emploient pour perturber les espaces de discussion."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
