    "language-restart-help": {
      "comment": "App language preference in General settings. Changes apply after relaunch.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quit and reopen Glasstual to apply a language change."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A nyelv módosításához lépj ki a Glasstualból, majd nyisd meg újra."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beende Glasstual und öffne die App erneut, um die Sprache zu ändern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cierra y vuelve a abrir Glasstual para aplicar un cambio de idioma."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Quittez et rouvrez Glasstual pour appliquer un changement de langue."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "言語を変更するには、Glasstualを終了して再度開いてください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Feche e reabra Glasstual para aplicar uma mudança de idioma."
          }
        }
      }
    },
    "notifications-notify-mentions": {
      "comment": "Checkbox in the Notifications pane.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notify me about mentions and private messages"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Értesítés az említésekről és a privát üzenetekről"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei Erwähnungen und privaten Nachrichten benachrichtigen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Notifícame sobre las menciones y los mensajes privados"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Avisez-moi des mentions et des messages privés"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "言及やプライベートメッセージについてお知らせしてください"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Notifique-me sobre menções e mensagens privadas"
          }
        }
      }
    },
