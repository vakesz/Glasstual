    "general-spotlight-note": {
      "comment": "Explanation below the Spotlight checkbox. Only names are indexed.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only names are indexed. Messages are never added to Spotlight. Turning this off removes everything Glasstual added."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Csak a nevek kerülnek az indexbe. Az üzenetek soha nem kerülnek a Spotlightba. A kikapcsolás eltávolít mindent, amit a Glasstual hozzáadott."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es werden nur Namen indiziert. Nachrichten werden nie zu Spotlight hinzugefügt. Beim Ausschalten wird alles entfernt, was Glasstual hinzugefügt hat."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se indexan los nombres. Los mensajes nunca se añaden a Spotlight. Al desactivarlo se elimina todo lo que Glasstual añadió."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seuls les noms sont indexés. Les messages ne sont jamais ajoutés à Spotlight. La désactivation supprime tout ce que Glasstual a ajouté."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "名前のみがインデックスされます。メッセージがSpotlightに追加されることはありません。オフにすると、Glasstualが追加したものがすべて削除されます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Somente os nomes são indexados. As mensagens nunca são adicionadas ao Spotlight. Desativar esta opção remove tudo o que o Glasstual adicionou."
          }
        }
      }
    },
