    "incoming-data-highlight-spam-note": {
      "comment": "Explanation below the highlight spam checkbox.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Do not notify you of a highlight if at least ten nicknames make up three quarters of a message."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne értesítsen említésről, ha egy üzenet háromnegyedét legalább tíz becenév teszi ki."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Benachrichtigung über eine Erwähnung, wenn drei Viertel der Nachricht aus mindestens zehn Nicknamen bestehen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "No te notificaremos de un destacado si al menos diez apodos constituyen tres cuartos de un mensaje."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ne vous informez pas d'un point fort si au moins dix surnoms représentent trois quarts d'un message."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "メッセージの少なくとも10のニックネームがメッセージの4分の3を占めている場合は、ハイライトについて通知しないでください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Não notifique você sobre um destaque se pelo menos dez apelidos compõem três quartos de uma mensagem."
          }
        }
      }
    },
