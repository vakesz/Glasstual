    "clear-list-confirmation-message" : {
      "comment" : "Body of the confirmation shown before the cached highlights of a connection are discarded.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The highlights logged for this connection are removed. This cannot be undone."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A kapcsolathoz naplózott említések törlődnek. Ez nem vonható vissza."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die protokollierten Hervorhebungen für diese Verbindung werden entfernt. Dies kann nicht rückgängig gemacht werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Los puntos destacados registrados para esta conexión se eliminan. Esto no se puede deshacer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Les points forts enregistrés pour cette connexion sont supprimés. Cela ne peut pas être annulé."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "この接続で記録されたハイライトは削除されます。この操作は元に戻すことはできません。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Os destaques registrados para esta conexão foram removidos. Isso não pode ser desfeito."
          }
        }
      }
    },
