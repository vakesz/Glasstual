{
  "sourceLanguage" : "en",
  "strings" : {
    "action-note" : {
      "comment" : "Explains the bullet prefix used for IRC action messages in the highlight list. Migrated from the legacy interface file.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Messages beginning with a bullet (•) are actions."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A ponttal (•) kezdődő üzenetek cselekvések."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nachrichten, die mit einem Punkt (•) beginnen, sind Aktionen."
          }
        }
      }
    },
    "channel" : {
      "comment" : "Column title for the channel that contains a highlighted message. Migrated from the legacy interface file.",
