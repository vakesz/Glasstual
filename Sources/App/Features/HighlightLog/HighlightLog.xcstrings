    "empty-description" : {
      "comment" : "Description shown when a server has no cached highlighted messages.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "New highlighted messages will appear here while Glasstual is running."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Glasstual futása alatt az új kiemelt üzenetek itt jelennek meg."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neue hervorgehobene Nachrichten erscheinen hier, während Glasstual läuft."
