    "clear-list-confirmation-message" : {
      "comment" : "Body of the confirmation shown before the cached highlights of a connection are discarded.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The highlights logged for this connection are removed. This action cannot be undone."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A kapcsolathoz naplózott említések törlődnek. Ez a művelet nem vonható vissza."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die protokollierten Hervorhebungen für diese Verbindung werden entfernt. Diese Aktion kann nicht rückgängig gemacht werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se eliminan las menciones registradas para esta conexión. Esta acción no se puede deshacer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les mentions enregistrées pour cette connexion seront supprimées. Cette action est irréversible."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この接続に記録されたハイライトが削除されます。この操作は取り消せません。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os destaques registrados para esta conexão serão removidos. Esta ação não pode ser desfeita."
          }
        }
      }
    },
    "clear-list-confirmation-title" : {
