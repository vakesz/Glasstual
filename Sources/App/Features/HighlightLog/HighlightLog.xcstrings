{
  "sourceLanguage" : "en",
  "strings" : {
    "action-note" : {
      "comment" : "Explains the bullet prefix used for IRC action messages in the highlight list. Migrated from the legacy interface file.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Messages beginning with a bullet (•) are actions."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A ponttal (•) kezdődő üzenetek cselekvések."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nachrichten, die mit einem Punkt (•) beginnen, sind Aktionen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Los mensajes que comienzan con un punto (•) son acciones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Les messages commençant par un point d'interrogation (•) sont des actions."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "（•）で始まるメッセージはアクションです。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mensagens que começam com um ponto (•) são ações."
          }
        }
      }
    },
