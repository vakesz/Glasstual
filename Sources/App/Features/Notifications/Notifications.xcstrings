    "body-user-available": {
      "comment": "Address Book notification description for an available nickname. Migrated from legacy key 97r-0l. Legacy translator context: ‘Notification bubble descriptions. These are only notifications that require localization. Many notifications just send the raw message received so they are not localized here’. Legacy translator context: ‘Address Book spoken text uses the actual notification message for that notification type. It is not defined here’.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "User with nickname “%1$@” is available"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A(z) \"%1$@\" becenevű felhasználó elérhető"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Benutzer mit dem Nicknamen \"%1$@\" ist verfügbar"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "El usuario con el apodo \"%1$@\" está disponible"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "L'utilisateur avec le surnom « %1$@ » est disponible"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ニックネーム「%1$@」のユーザーが利用可能です。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Usuário com o apelido “%1$@” está disponível"
          }
        }
      }
    },
