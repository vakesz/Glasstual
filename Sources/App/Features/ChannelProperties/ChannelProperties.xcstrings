{
  "sourceLanguage": "en",
  "strings": {
    "general-event-messages": {
      "comment": "Label for the channel general-event display picker.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "General event messages"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Általános eseményüzenetek"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Allgemeine Ereignismeldungen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mensajes generales de eventos"
          }
        },
        "fr": {
          "stringUnit": {
