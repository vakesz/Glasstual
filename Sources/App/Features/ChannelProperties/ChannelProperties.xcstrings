    "general-event-messages-collapse": {
      "comment": "Channel event display option that groups consecutive events in an expandable summary.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Collapse"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Összecsukás"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zusammenklappen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Contraer"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réduire"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "折りたたむ"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Recolher"
          }
        }
      }
    },
    "general-event-messages-hide": {
      "comment": "Channel event display option that hides events.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
