    "general-event-messages-help": {
      "comment": "Help for the channel event display picker. Collapsed groups can be expanded in the transcript.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Collapse groups consecutive channel events so you can expand them when needed."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az összecsukás csoportosítja az egymást követő csatornaeseményeket, hogy szükség esetén kinyithasd őket."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zusammenklappen fasst aufeinanderfolgende Kanalereignisse zusammen, die du bei Bedarf aufklappen kannst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Colapsa los grupos de eventos de canal consecutivos para que puedas expandirlos cuando sea necesario."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Faites se réduire les groupes d’événements consécutifs sur les canaux afin de pouvoir les agrandir lorsque cela est nécessaire."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "グループを連続するチャンネルイベントで折りたたんで、必要に応じて展開できるようにします。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Colapse os eventos consecutivos de canal para que você possa expandi-los quando necessário."
          }
        }
      }
    },
