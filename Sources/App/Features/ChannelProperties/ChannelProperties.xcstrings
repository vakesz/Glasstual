          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ acepta como máximo %2$ld bytes. Cualquier cosa más allá de eso puede ser cortada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ accepte au maximum %2$ld octets. Tout ce qui dépasse cela peut être coupé."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@は最大%2$ldバイトを受け付けます。それ以降のものは切り取られる可能性があります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ aceita no máximo %2$ld bytes. Qualquer coisa além disso pode ser cortada."
          }
        }
      }
