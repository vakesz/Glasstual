    "channel-key-field-hint": {
      "comment": "Accessibility hint for the text field containing the IRC channel key.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter the channel key used by members when joining."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Add meg a csatornakulcsot, amelyet a tagok csatlakozáskor használnak."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib den Kanalschlüssel ein, den Mitglieder beim Beitritt verwenden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduce la clave del canal que usan los miembros al unirse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez la clé du canal que les membres utilisent pour le rejoindre."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メンバーが参加するときに使用するチャンネルキーを入力します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Digite a chave do canal usada pelos membros ao entrar."
          }
        }
      }
    },
