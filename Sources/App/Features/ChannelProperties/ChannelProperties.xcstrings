            "value": "Masquer"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "非表示"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ocultar"
          }
        }
      }
    },
    "general-event-messages-help": {
      "comment": "Help for the channel event display picker. Collapsed groups can be expanded in the transcript.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Collapse groups consecutive channel events so you can expand them when needed."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az összecsukás csoportosítja az egymást követő csatornaeseményeket, hogy szükség esetén kinyithasd őket."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zusammenklappen fasst aufeinanderfolgende Kanalereignisse zusammen, die du bei Bedarf aufklappen kannst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Contraer agrupa los eventos consecutivos del canal para que puedas expandirlos cuando sea necesario."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réduire regroupe les événements consécutifs du canal afin que vous puissiez les développer au besoin."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "連続するチャンネルのイベントをグループ化して折りたたみ、必要に応じて展開できるようにします。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Recolher agrupa eventos consecutivos do canal para que você possa expandi-los quando necessário."
          }
        }
      }
    },
    "change-modes-button": {
