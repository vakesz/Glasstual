    "secret-key-too-long": {
      "comment": "Warning under the channel secret key field once the key is too long for the server. The first argument is the network name and the second is the maximum number of UTF-8 bytes.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ accepts at most %2$ld bytes. Anything past that may be cut off."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ legfeljebb %2$ld bájtot fogad el. Az ezen túli rész lemaradhat."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ akzeptiert höchstens %2$ld Byte. Alles darüber hinaus kann abgeschnitten werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ acepta como máximo %2$ld bytes. Lo que exceda ese límite puede cortarse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ accepte au maximum %2$ld octets. Tout ce qui dépasse peut être tronqué."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@が受け付けるのは最大%2$ldバイトです。それを超える部分は切り捨てられる場合があります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ aceita no máximo %2$ld bytes. O que passar disso pode ser cortado."
          }
        }
      }
    },
