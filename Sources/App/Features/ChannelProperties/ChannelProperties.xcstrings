    "secret-key-too-long": {
      "comment": "Warning under the channel secret key field once the key is too long for the server. The first argument is the network name and the second is the maximum number of UTF-8 bytes.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ accepts at most %2$ld bytes. Anything past that may be cut off."
          }
        },
        "hu": {
          "stringUnit": {
