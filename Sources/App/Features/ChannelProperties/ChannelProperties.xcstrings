            "state" : "translated",
            "value" : "Modi ändern"
          }
        }
      }
    },
    "channel-key-characters-over-limit" : {
      "comment" : "Footer below the channel key field once the key is longer than the server accepts. Replaces the warning alert that used to interrupt typing. The Change Modes button stays disabled until the key fits.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "substitutions" : {
            "arg1" : {
              "argNum" : 1,
              "formatSpecifier" : "lld",
              "variations" : {
                "plural" : {
                  "one" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "%arg byte too many"
                    }
                  },
                  "other" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "%arg bytes too many"
                    }
                  }
                }
              }
            }
          },
          "stringUnit" : {
            "state" : "translated",
            "value" : "%#@arg1@"
          }
        },
        "hu" : {
          "substitutions" : {
            "arg1" : {
              "argNum" : 1,
              "formatSpecifier" : "lld",
              "variations" : {
                "plural" : {
                  "one" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "%arg bájttal több"
                    }
                  },
                  "other" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "%arg bájttal több"
                    }
                  }
                }
              }
            }
          },
          "stringUnit" : {
            "state" : "translated",
            "value" : "%#@arg1@"
          }
        },
        "de" : {
          "substitutions" : {
            "arg1" : {
              "argNum" : 1,
              "formatSpecifier" : "lld",
              "variations" : {
                "plural" : {
                  "one" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "%arg Byte zu viel"
                    }
                  },
                  "other" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "%arg Byte zu viel"
                    }
                  }
                }
              }
            }
          },
          "stringUnit" : {
            "state" : "translated",
            "value" : "%#@arg1@"
          }
        }
      }
    },
