    "characters-remaining": {
      "comment": "Footer below the topic editor counting the UTF-8 bytes remaining before the server's topic limit. Replaces the warning alert that used to interrupt typing. Migrated from the legacy keys zm4-cr and 27l-qx.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "substitutions": {
            "arg1": {
              "argNum": 1,
