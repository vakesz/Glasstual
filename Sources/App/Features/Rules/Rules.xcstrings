{
  "sourceLanguage": "en",
  "strings": {
    "all-channels-selected": {
      "comment": "VoiceOver value for the server selection button in the rule editor.",
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All channels selected"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Minden csatorna kiválasztva"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Kanäle ausgewählt"
          }
        }
      }
    },
    "some-channels-selected": {
      "comment": "VoiceOver value for the server selection button in the rule editor.",
      "extractionState": "manual",
