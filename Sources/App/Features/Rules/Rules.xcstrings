    },
    "action-log-user": {
      "comment": "Log message for a filter action without a channel. Arguments are the filter title and user nickname. Migrated from legacy key yla-he.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Performing action defined by the filter “%1$@“ against the user “%2$@“"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A(z) \"%1$@\" szűrő műveletének végrehajtása a(z) \"%2$@\" felhasználón"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktion des Filters \"%1$@\" für Benutzer \"%2$@\" wird ausgeführt"
          }
        }
      }
    },
    "action-log-user-in-channel": {
      "comment": "Log message for a filter action in a channel. Arguments are the filter title, user nickname, and channel name. Migrated from legacy key jcm-xj.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Performing action defined by the filter “%1$@“ against the user “%2$@“ in the channel “%3$@“"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A(z) \"%1$@\" szűrő műveletének végrehajtása a(z) \"%2$@\" felhasználón a(z) \"%3$@\" csatornán"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktion des Filters \"%1$@\" für Benutzer \"%2$@\" im Kanal \"%3$@\" wird ausgeführt"
          }
        }
      }
    },
    "add-filter-button": {
      "comment": "Button that begins creating a chat filter.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add Filter"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Szűrő hozzáadása"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Filter hinzufügen"
          }
        }
      }
    },
    "cancel-button": {
      "comment": "Button that cancels deleting or editing a chat filter.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Mégse"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abbrechen"
          }
        }
      }
    },
    "delete-filter-button": {
      "comment": "Destructive button that confirms deleting a chat filter.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete Filter"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Szűrő törlése"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Filter löschen"
          }
        }
      }
    },
    "delete-filter-message": {
      "comment": "Message explaining that deleting a chat filter cannot be undone. Migrated from legacy key dj6-fn.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There is no undo and all data related to this filter will be erased."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez nem vonható vissza. A szűrőhöz tartozó összes adat törlődik."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies kann nicht rückgängig gemacht werden. Alle Daten dieses Filters werden gelöscht."
          }
        }
      }
    },
    "delete-filter-title": {
      "comment": "Title of the confirmation alert shown before deleting a chat filter. Migrated from legacy key c0k-xj.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete this filter?"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Törlöd ezt a szűrőt?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diesen Filter löschen?"
          }
        }
      }
    },
    "duplicate-filter-button": {
      "comment": "Menu item that duplicates the selected chat filter.",
