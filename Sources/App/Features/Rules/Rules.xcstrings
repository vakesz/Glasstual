    "edited-rule-removed": {
      "comment": "The edited rule was removed by an import or another settings change before the editor saved.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This rule no longer exists. Your changes were not saved."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez a szabály már nem létezik. A módosításaid nem lettek elmentve."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Regel ist nicht mehr vorhanden. Deine Änderungen wurden nicht gesichert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta regla ya no existe. Tus cambios no se han guardado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette règle n’existe plus. Vos modifications n’ont pas été enregistrées."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このルールは存在しなくなりました。変更は保存されませんでした。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta regra não existe mais. Suas alterações não foram salvas."
          }
        }
      }
    },
