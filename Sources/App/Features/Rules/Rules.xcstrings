    "no-filters-description": {
      "comment": "Explanation shown when no chat filters exist.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add a filter to hide, forward, or act on matching messages."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Adj hozzá szűrőt az illeszkedő üzenetek elrejtéséhez, továbbításához vagy műveletek végrehajtásához."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge einen Filter hinzu, um passende Nachrichten auszublenden, weiterzuleiten oder Aktionen auszuführen."
          }
        }
      }
    },
