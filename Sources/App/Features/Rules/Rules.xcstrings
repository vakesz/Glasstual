    "commands-invalid": {
      "comment": "Validation message for an invalid command list. Migrated from legacy key 9ri-sd. Next unused legacy key was 1014.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Please enter a properly formatted list of commands.\n\n• Commands must be a comma (,) separated list.\n• Commands must only contain the characters: a-z, A-Z, 0-9\n• Numerics must be whole numbers that are greater than zero (0) and less than or equal to 999."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Adj meg megfelelő formátumú parancslistát.\n\n• A parancsokat vesszővel (,) válaszd el.\n• A parancsok csak a következő karaktereket tartalmazhatják: a-z, A-Z, 0-9\n• A numerikus válaszok 0-nál nagyobb és legfeljebb 999 értékű egész számok lehetnek."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib eine korrekt formatierte Befehlsliste ein.\n\n• Trenne Befehle durch Kommas (,).\n• Befehle dürfen nur a-z, A-Z und 0-9 enthalten.\n• Numerische Antworten müssen ganze Zahlen größer als null (0) und höchstens 999 sein."
          }
        }
      }
    },
    "destination-invalid": {
      "comment": "Validation message for an improperly formatted filter destination. Migrated from legacy key 5kd-jt.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Please enter a properly formatted destination.\n\nAccepted characters: a-z, A-Z, 0-9, dashes (-), underscores (_), and spaces."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Adj meg megfelelő formátumú célt.\n\nElfogadott karakterek: a-z, A-Z, 0-9, kötőjel (-), aláhúzásjel (_) és szóköz."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib ein korrekt formatiertes Ziel ein.\n\nErlaubte Zeichen: a-z, A-Z, 0-9, Bindestriche (-), Unterstriche (_) und Leerzeichen."
          }
        }
      }
    },
    "destination-too-long": {
      "comment": "Validation message for a filter destination longer than the supported limit. Migrated from legacy key m0u-tw.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Please enter a shorter destination"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Adj meg rövidebb célt"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib ein kürzeres Ziel ein"
          }
        }
      }
    },
    "regular-expression-invalid": {
      "comment": "Validation message for a filter match field that is not a valid regular expression. The argument is the reason compilation failed.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Please enter a valid regular expression.\n\n%@"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Adj meg érvényes reguláris kifejezést.\n\n%@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib einen gültigen regulären Ausdruck ein.\n\n%@"
          }
        }
      }
    },
    "regular-expression-limits-explanation": {
      "comment": "Explanation of the limits placed on filter match patterns. The argument is the number of bytes of a message a pattern is matched against.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Patterns are matched against at most the first %@ bytes of a message. A pattern that can take a very long time to match cannot be saved, and one that runs too long while matching is skipped until the filters change."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A mintákat legfeljebb az üzenet első %@ bájtjával vetjük össze. A túl hosszú illesztési időt igénylő minta nem menthető. Ha futás közben tart túl sokáig az illesztés, a mintát a szűrők módosításáig kihagyjuk."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Muster werden mit höchstens den ersten %@ Byte einer Nachricht verglichen. Muster, deren Auswertung sehr lange dauern kann, können nicht gesichert werden. Dauert eine Auswertung zu lange, wird das Muster bis zur Änderung der Filter übersprungen."
          }
        }
      }
    },
    "regular-expression-nested-quantifier": {
      "comment": "Validation message shown beside a filter match field whose pattern repeats a group that already repeats without bound, or repeats alternatives that match the same text. The filter cannot be saved until the pattern is rewritten.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This pattern repeats a group that can match the same text in more than one way, such as (a+)+ or (.|\\s)*. A pattern of that shape can take a very long time to match, so it cannot be saved. Rewrite it without the nested repetition or the overlapping alternatives."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez a minta olyan csoportot ismétel, amely ugyanarra a szövegre többféleképpen illeszkedhet, például (a+)+ vagy (.|\\s)*. Az ilyen minta illesztése túl sokáig tarthat, ezért nem menthető. Írd át egymásba ágyazott ismétlések és átfedő alternatívák nélkül."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Muster wiederholt eine Gruppe, die auf mehrere Arten auf denselben Text passen kann, etwa (a+)+ oder (.|\\s)*. Die Auswertung kann sehr lange dauern, daher kann es nicht gesichert werden. Schreibe es ohne verschachtelte Wiederholungen oder überlappende Alternativen um."
          }
        }
      }
    },
