    "commands-invalid": {
      "comment": "Validation message for an invalid command list. Migrated from legacy key 9ri-sd. Next unused legacy key was 1014.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Please enter a properly formatted list of commands.\n\n• Commands must be a comma (,) separated list.\n• Commands must only contain the characters: a-z, A-Z, 0-9\n• Numerics must be whole numbers that are greater than zero (0) and less than or equal to 999."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Adj meg megfelelő formátumú parancslistát.\n\n• A parancsokat vesszővel (,) válaszd el.\n• A parancsok csak a következő karaktereket tartalmazhatják: a-z, A-Z, 0-9\n• A numerikus válaszok 0-nál nagyobb és legfeljebb 999 értékű egész számok lehetnek."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib eine korrekt formatierte Befehlsliste ein.\n\n• Trenne Befehle durch Kommas (,).\n• Befehle dürfen nur a-z, A-Z und 0-9 enthalten.\n• Numerische Antworten müssen ganze Zahlen größer als null (0) und höchstens 999 sein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Por favor, introduzca una lista de comandos correctamente formateada.\n\n• Los comandos deben ser una lista separada por comas (,)\n• Los comandos solo deben contener los caracteres: a-z, A-Z, 0-9\n• Los números deben ser números enteros que sean mayores que cero (0) y menores o iguales a 999."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Veuillez saisir une liste de commandes correctement formatée.\n\n• Les commandes doivent être une liste séparée par des virgules (,)\n• Les commandes ne doivent contenir que les caractères : a-z, A-Z, 0-9\n• Les nombres doivent être des nombres entiers supérieurs à zéro (0) et inférieurs ou égaux à 999."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "適切にフォーマットされたコマンドのリストを入力してください。\n\n• コマンドはカンマ（、）で区切られたリストである必要があります。\n• コマンドには、a-z、A-Z、0-9 の文字のみを含める必要があります。\n• 数字は0より大きく999以下である整数である必要があります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Por favor, insira uma lista de comandos corretamente formatada.\n\n• Os comandos devem ser uma lista separada por vírgula (,)\n• Os comandos devem conter apenas os caracteres: a-z, A-Z, 0-9\n• Os números devem ser números inteiros que sejam maiores que zero (0) e menores ou iguais a 999."
          }
        }
      }
    },
    "destination-invalid": {
      "comment": "Validation message for an improperly formatted filter destination. Migrated from legacy key 5kd-jt.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Please enter a properly formatted destination.\n\nAccepted characters: a-z, A-Z, 0-9, dashes (-), underscores (_), and spaces."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Adj meg megfelelő formátumú célt.\n\nElfogadott karakterek: a-z, A-Z, 0-9, kötőjel (-), aláhúzásjel (_) és szóköz."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib ein korrekt formatiertes Ziel ein.\n\nErlaubte Zeichen: a-z, A-Z, 0-9, Bindestriche (-), Unterstriche (_) und Leerzeichen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Por favor, introduzca un destino correctamente formateado.\n\nCaracteres aceptados: a-z, A-Z, 0-9, guiones (-), guiones bajos (_) y espacios."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Veuillez saisir une destination correctement formatée.\n\nCaractères acceptés : a-z, A-Z, 0-9, tirets (-), tirets souscripteurs (_) et espaces."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "適切にフォーマットされた目的地を入力してください。\n\n受け入れられる文字：a-z、A-Z、0-9、ハイフン（-）、アンダースコア（_）、スペース。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Por favor, insira um destino corretamente formatado.\n\nCaractere aceitos: a-z, A-Z, 0-9, traços de quebra (-), sublinhados (_), e espaços."
          }
        }
      }
    },
