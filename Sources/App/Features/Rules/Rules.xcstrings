            "state": "translated",
            "value": "Válassz olyan mappát, amelybe írhatsz, majd próbáld újra."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle einen beschreibbaren Ordner und versuche es erneut."
          }
        },
        "es": {
          "stringUnit": {
