    "delete-filter-message": {
      "comment": "Message explaining that deleting a chat filter cannot be undone. Migrated from legacy key dj6-fn.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There is no undo and all data related to this filter will be erased."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez nem vonható vissza. A szűrőhöz tartozó összes adat törlődik."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies kann nicht rückgängig gemacht werden. Alle Daten dieses Filters werden gelöscht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "No hay deshacer y todos los datos relacionados con este filtro serán borrados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Il n'y a pas d'annulation et toutes les données liées à ce filtre seront effacées."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "取り消しはありません。このフィルターに関連するすべてのデータは消去されます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Não há desfecho e todos os dados relacionados a este filtro serão apagados."
          }
        }
      }
    },
    "delete-filter-title": {
      "comment": "Title of the confirmation alert shown before deleting a chat filter. Migrated from legacy key c0k-xj.",
      "extractionState": "manual",
      "localizations": {
