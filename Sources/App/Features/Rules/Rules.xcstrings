    "export-failed-recovery": {
      "comment": "Recovery sentence under the filter export failure.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a folder you can write to and try again."
          }
        },
        "hu": {
