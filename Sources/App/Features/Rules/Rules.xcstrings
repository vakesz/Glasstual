    "edited-filter-removed": {
      "comment": "The edited filter was removed by an import or another settings change before the editor saved.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This filter no longer exists. Your changes were not saved."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez a szűrő már nem létezik. A módosításaid nem lettek elmentve."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Filter ist nicht mehr vorhanden. Deine Änderungen wurden nicht gesichert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este filtro ya no existe. Tus cambios no se han guardado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce filtre n’existe plus. Vos modifications n’ont pas été enregistrées."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このフィルタは存在しなくなりました。変更は保存されませんでした。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este filtro não existe mais. Suas alterações não foram salvas."
          }
        }
      }
    },
