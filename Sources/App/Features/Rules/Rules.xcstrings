    "action-log-user": {
      "comment": "Log message for a filter action without a channel. Arguments are the filter title and user nickname. Migrated from legacy key yla-he.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Performing action defined by the filter “%1$@“ against the user “%2$@“"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A(z) \"%1$@\" szűrő műveletének végrehajtása a(z) \"%2$@\" felhasználón"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktion des Filters \"%1$@\" für Benutzer \"%2$@\" wird ausgeführt"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se está aplicando la acción definida por el filtro «%1$@» al usuario «%2$@»"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Exécution de l’action définie par le filtre « %1$@ » contre l’utilisateur « %2$@ »"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フィルタ「%1$@」で定義されたアクションを、ユーザ「%2$@」に対して実行しています"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Executando a ação definida pelo filtro “%1$@” contra o usuário “%2$@”"
          }
        }
      }
    },
    "action-log-user-in-channel": {
      "comment": "Log message for a filter action in a channel. Arguments are the filter title, user nickname, and channel name. Migrated from legacy key jcm-xj.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Performing action defined by the filter “%1$@“ against the user “%2$@“ in the channel “%3$@“"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A(z) \"%1$@\" szűrő műveletének végrehajtása a(z) \"%2$@\" felhasználón a(z) \"%3$@\" csatornán"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktion des Filters \"%1$@\" für Benutzer \"%2$@\" im Kanal \"%3$@\" wird ausgeführt"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se está aplicando la acción definida por el filtro «%1$@» al usuario «%2$@» en el canal «%3$@»"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Exécution de l’action définie par le filtre « %1$@ » contre l’utilisateur « %2$@ » dans le canal « %3$@ »"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "チャンネル「%3$@」で、ユーザ「%2$@」に対して、フィルタ「%1$@」で定義されたアクションを実行しています"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Executando a ação definida pelo filtro “%1$@” contra o usuário “%2$@” no canal “%3$@”"
          }
        }
      }
    },
