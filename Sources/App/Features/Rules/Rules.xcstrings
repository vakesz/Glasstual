    "additional-commands-explanation": {
      "comment": "Explanation of the additional IRC command field.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add comma-separated named commands or numerics from 1 through 999 that are not listed above."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Adj meg vesszővel elválasztott parancsneveket vagy 1 és 999 közötti numerikus parancsokat, amelyek nem szerepelnek fent."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib durch Kommas getrennte Befehlsnamen oder numerische Antworten von 1 bis 999 ein, die oben nicht aufgeführt sind."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade comandos con nombre o numéricos del 1 al 999 que no figuren arriba, separados por comas."
