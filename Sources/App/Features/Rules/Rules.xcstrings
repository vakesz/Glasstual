          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Apagar filtro"
          }
        }
      }
    },
    "delete-filter-message": {
      "comment": "Message explaining that deleting a chat filter cannot be undone. Migrated from legacy key dj6-fn.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All data related to this filter will be erased. This action cannot be undone."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A szűrőhöz tartozó összes adat törlődik. Ez a művelet nem vonható vissza."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Daten dieses Filters werden gelöscht. Diese Aktion kann nicht rückgängig gemacht werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se borrarán todos los datos relacionados con este filtro. Esta acción no se puede deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toutes les données associées à ce filtre seront effacées. Cette action est irréversible."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このフィルタに関連するすべてのデータが消去されます。この操作は取り消せません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos os dados relacionados a este filtro serão apagados. Esta ação não pode ser desfeita."
          }
        }
      }
    },
    "delete-filter-title": {
      "comment": "Title of the confirmation alert shown before deleting a chat filter. Migrated from legacy key c0k-xj.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete this filter?"
