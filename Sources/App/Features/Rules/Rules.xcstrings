    "export-failed-recovery": {
      "comment": "Recovery sentence under the rule export failure.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a folder you can write to and try again."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Válassz olyan mappát, amelybe írhatsz, majd próbáld újra."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle einen beschreibbaren Ordner und versuche es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige una carpeta en la que puedas escribir e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez un dossier dans lequel vous pouvez écrire, puis réessayez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "書き込み可能なフォルダを選択して、もう一度お試しください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha uma pasta na qual você possa gravar e tente novamente."
          }
        }
      }
    },
    "rule-description": {
      "comment": "Description of a rule. The argument is the rule title. Migrated from legacy key dka-bx.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rule “%@“"
