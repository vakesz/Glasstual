            "value": "Supprimer la règle"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ルールを削除"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Apagar regra"
          }
        }
      }
    },
    "delete-rule-message": {
      "comment": "Message explaining that deleting a rule cannot be undone. Migrated from legacy key dj6-fn.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All data related to this rule will be erased. This action cannot be undone."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A szabályhoz tartozó összes adat törlődik. Ez a művelet nem vonható vissza."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Daten dieser Regel werden gelöscht. Diese Aktion kann nicht rückgängig gemacht werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se borrarán todos los datos relacionados con esta regla. Esta acción no se puede deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toutes les données associées à cette règle seront effacées. Cette action est irréversible."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このルールに関連するすべてのデータが消去されます。この操作は取り消せません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos os dados relacionados a esta regra serão apagados. Esta ação não pode ser desfeita."
          }
        }
      }
    },
    "delete-rule-title": {
      "comment": "Title of the confirmation alert shown before deleting a rule. Migrated from legacy key c0k-xj.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete this rule?"
