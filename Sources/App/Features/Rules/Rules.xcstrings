    "edited-filter-removed": {
      "comment": "The edited filter was removed by an import or another settings change before the editor saved.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This filter no longer exists. Your changes were not saved."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez a szűrő már nem létezik. A módosításaid nem lettek elmentve."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Filter ist nicht mehr vorhanden. Deine Änderungen wurden nicht gesichert."
          }
        }
      }
    },
    "forwarded-message": {
      "comment": "Message forwarded by a chat filter. Arguments are the IRC command and original message. Migrated from legacy key dct-7h.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Message(%1$@): %2$@"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Üzenet (%1$@): %2$@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nachricht (%1$@): %2$@"
          }
        }
      }
