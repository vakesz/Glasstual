    "commands-invalid": {
      "comment": "Validation message for an invalid command list. Migrated from legacy key 9ri-sd. Next unused legacy key was 1014.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Please enter a properly formatted list of commands.\n\n• Commands must be a comma (,) separated list.\n• Commands must only contain the characters: a-z, A-Z, 0-9\n• Numerics must be whole numbers that are greater than zero (0) and less than or equal to 999."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Adj meg megfelelő formátumú parancslistát.\n\n• A parancsokat vesszővel (,) válaszd el.\n• A parancsok csak a következő karaktereket tartalmazhatják: a-z, A-Z, 0-9\n• A numerikus válaszok 0-nál nagyobb és legfeljebb 999 értékű egész számok lehetnek."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib eine korrekt formatierte Befehlsliste ein.\n\n• Trenne Befehle durch Kommas (,).\n• Befehle dürfen nur a-z, A-Z und 0-9 enthalten.\n• Numerische Antworten müssen ganze Zahlen größer als null (0) und höchstens 999 sein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduce una lista de comandos con el formato correcto.\n\n• Los comandos deben ir separados por comas (,).\n• Los comandos solo pueden contener los caracteres: a-z, A-Z, 0-9\n• Los códigos numéricos deben ser números enteros mayores que cero (0) y menores o iguales que 999."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez une liste de commandes correctement formatée.\n\n• Les commandes doivent être séparées par des virgules (,).\n• Les commandes ne doivent contenir que les caractères : a-z, A-Z, 0-9.\n• Les codes numériques doivent être des nombres entiers supérieurs à zéro (0) et inférieurs ou égaux à 999."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コマンドのリストを正しい形式で入力してください。\n\n• コマンドは、カンマ(,)で区切ったリストにしてください。\n• コマンドに使用できる文字は、a-z、A-Z、0-9のみです。\n• 数値コマンドは、0より大きく999以下の整数にしてください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Insira uma lista de comandos formatada corretamente.\n\n• Os comandos devem ser uma lista separada por vírgulas (,).\n• Os comandos devem conter apenas os caracteres: a-z, A-Z, 0-9\n• Os códigos numéricos devem ser números inteiros maiores que zero (0) e menores ou iguais a 999."
          }
        }
      }
    },
    "destination-invalid": {
      "comment": "Validation message for an improperly formatted filter destination. Migrated from legacy key 5kd-jt.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Please enter a properly formatted destination.\n\nAccepted characters: a-z, A-Z, 0-9, dashes (-), underscores (_), and spaces."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Adj meg megfelelő formátumú célt.\n\nElfogadott karakterek: a-z, A-Z, 0-9, kötőjel (-), aláhúzásjel (_) és szóköz."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib ein korrekt formatiertes Ziel ein.\n\nErlaubte Zeichen: a-z, A-Z, 0-9, Bindestriche (-), Unterstriche (_) und Leerzeichen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduce un destino con el formato correcto.\n\nCaracteres admitidos: a-z, A-Z, 0-9, guiones (-), guiones bajos (_) y espacios."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez une destination correctement formatée.\n\nCaractères acceptés : a-z, A-Z, 0-9, tirets (-), tirets bas (_) et espaces."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "宛先を正しい形式で入力してください。\n\n使用できる文字: a-z、A-Z、0-9、ハイフン(-)、アンダースコア(_)、スペース。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Insira um destino formatado corretamente.\n\nCaracteres aceitos: a-z, A-Z, 0-9, hifens (-), sublinhados (_) e espaços."
          }
        }
      }
    },
