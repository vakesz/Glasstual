    },
    "channel-rename-conflict": {
      "comment": "Channel rename: Printed when the server renamed a channel to the name of a channel that is still open here, so the rename is not applied. The first argument is the old channel name, the second the new one.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not apply the rename of %1$@ to %2$@: a channel with that name is already open."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nem sikerült alkalmazni a(z) %1$@ csatorna átnevezését (új név: %2$@): ilyen nevű csatorna már meg van nyitva."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Umbenennung von %1$@ in %2$@ konnte nicht übernommen werden: Ein Kanal mit diesem Namen ist bereits geöffnet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo aplicar el cambio de nombre de %1$@ a %2$@: ya hay un canal abierto con ese nombre."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d’appliquer le renommage de %1$@ en %2$@ : un canal portant ce nom est déjà ouvert."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@から%2$@への名前変更を適用できませんでした。その名前のチャンネルがすでに開いています。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível aplicar a mudança de nome de %1$@ para %2$@: já há um canal aberto com esse nome."
          }
        }
      }
    },
