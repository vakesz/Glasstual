    "you-cannot-send-private-messages": {
      "comment": "Miscellaneous messages related to IRC events. Legacy key: 11i-ev.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You cannot send private messages to %@. Anything that you send to them will be ignored until you are added to their list of recognized users."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nem küldhetsz privát üzenetet ennek: %@. Az üzeneteidet figyelmen kívül hagyja, amíg fel nem vesz az engedélyezett felhasználói közé."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst %@ keine privaten Nachrichten senden. Deine Nachrichten werden ignoriert, bis du zur Liste zugelassener Benutzer hinzugefügt wirst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "No puedes enviar mensajes privados a %@. Cualquier cosa que les envíes será ignorada hasta que se te añada a su lista de usuarios reconocidos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vous ne pouvez pas envoyer de messages privés à %@. Tout ce que vous leur envoyerez sera ignoré jusqu'à ce que vous soyez ajouté à leur liste d'utilisateurs reconnus."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@にはプライベートメッセージを送ることができません。彼らに送ったメッセージは、認識されたユーザーリストに追加されるまで無視されます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Você não pode enviar mensagens privadas para %@. Qualquer coisa que você enviar para eles será ignorada até que você seja adicionado à lista de usuários reconhecidos deles."
          }
        }
      }
    },
