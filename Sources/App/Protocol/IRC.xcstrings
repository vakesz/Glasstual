    "tried-to-send-you-a-private": {
      "comment": "Miscellaneous messages related to IRC events. Legacy key: 3yj-in.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ (%2$@) tried to send you a private message, but it was ignored due to \u0002umode +g\u0002. Perform “/accept %1$@” to allow this user to communicate with you."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ (%2$@) privát üzenetet próbált küldeni, de a \u0002+g felhasználói mód\u0002 miatt figyelmen kívül maradt. Az engedélyezéshez írd be: /accept %1$@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ (%2$@) hat versucht, dir eine private Nachricht zu senden. Sie wurde wegen \u0002Benutzermodus +g\u0002 ignoriert. Mit /accept %1$@ kannst du Nachrichten dieses Benutzers zulassen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ (%2$@) intentó enviarte un mensaje privado, pero fue ignorado debido a \u0002umode +g\u0002. Realice “/accept %1$@” para permitir que este usuario se comunique con usted."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ (%2$@) a essayé de vous envoyer un message privé, mais il a été ignoré en raison de \u0002umode +g\u0002.  Effectuez “/accept %1$@” pour permettre à cet utilisateur de communiquer avec vous."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@（%2$@）からプライベートメッセージを送信しようとしましたが、無視されました。 \u0002umode +g\u0002. このユーザーがあなたとコミュニケーションを取れるようにするために、“/accept %1$@”を実行します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ (%2$@) tentou lhe enviar uma mensagem privada, mas foi ignorada devido a \u0002umode +g\u0002. Execute “/accept %1$@” para permitir que este usuário se comunique com você."
          }
        }
      }
    },
