        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este servidor no admite el historial de chat."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce serveur ne prend pas en charge l’historique de discussion."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このサーバはチャット履歴に対応していません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este servidor não oferece suporte a histórico de chat."
          }
        }
      }
    },
    "this-server-only-accepts-utf-8": {
      "comment": "ISUPPORT driven messages. Legacy key: y3h-ud.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This server only accepts UTF-8. The configured encoding is ignored for this connection."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A kiszolgáló csak UTF-8-at fogad el. A beállított kódolás ennél a kapcsolatnál figyelmen kívül marad."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Server akzeptiert nur UTF-8. Die konfigurierte Zeichenkodierung wird für diese Verbindung ignoriert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este servidor solo acepta UTF-8. La codificación configurada se ignora para esta conexión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce serveur n’accepte que l’UTF-8. L’encodage configuré est ignoré pour cette connexion."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このサーバはUTF-8のみを受け付けます。この接続では、設定されたエンコーディングは無視されます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este servidor aceita apenas UTF-8. A codificação configurada é ignorada para esta conexão."
          }
        }
      }
    },
