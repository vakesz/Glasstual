    "nickname-retries-exhausted": {
      "comment": "Console warning after the server refused every nickname the client tried while registering; the client stops retrying and waits for the user to choose one.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server refused every nickname that was tried. Choose another one with the /nick command to continue."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A kiszolgáló minden kipróbált becenevet elutasított. A folytatáshoz válassz másikat a /nick paranccsal."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server hat alle versuchten Nicknamen abgelehnt. Wähle mit /nick einen anderen, um fortzufahren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor rechazó todos los apodos que se intentaron. Elige otro con el comando /nick para continuar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur a refusé chaque pseudo essayé. Choisissez-en un autre avec la commande /nick pour continuer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバが、試したすべてのニックネームを拒否しました。続けるには、/nickコマンドで別のニックネームを選択してください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O servidor recusou todos os apelidos tentados. Escolha outro com o comando /nick para continuar."
          }
        }
      }
    },
    "nick-serv-identification-timed-out": {
      "comment": "Warning after the identification command was written and the authentication deadline elapsed.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "NickServ has not confirmed identification within 30 seconds. Joining configured channels anyway."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A NickServ 30 másodpercen belül nem erősítette meg az azonosítást. Ennek ellenére csatlakozunk a beállított csatornákhoz."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
