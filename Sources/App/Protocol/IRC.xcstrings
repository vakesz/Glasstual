    "sts-upgrade-changes-transport": {
      "comment": "Strict Transport Security (STS). Console line when a plain WebSocket connection moves to IRC over TLS. The argument is the port number.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Strict Transport Security applies to this host. Connecting over IRC with TLS on port %@ instead of WebSocket."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Für diesen Host gilt Strict Transport Security. Statt über WebSocket wird über IRC mit TLS auf Port %@ verbunden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Strict Transport Security se aplica a este host. Conectando mediante IRC con TLS en el puerto %@ en lugar de WebSocket."
