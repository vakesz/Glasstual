    "minutes-have-elapsed-since-last-response": {
      "comment": "Miscellaneous messages related to IRC events. Legacy key: bps-la.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%.0f minutes have elapsed since last response from this connection. Disconnecting due to timeout."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%.0f perc telt el a kapcsolat utolsó válasza óta. Kapcsolat bontása időtúllépés miatt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Seit der letzten Antwort dieser Verbindung sind %.0f Minuten vergangen. Verbindung wegen Zeitüberschreitung getrennt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Han transcurrido %.0f minutos desde la última respuesta de esta conexión. Se está desconectando por tiempo de espera agotado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%.0f minutes se sont écoulées depuis la dernière réponse de cette connexion. Déconnexion pour cause de délai dépassé."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%.0f分間、この接続から応答がありません。タイムアウトにより切断します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Passaram-se %.0f minutos desde a última resposta desta conexão. Desconectando por tempo esgotado."
          }
        }
      }
    },
