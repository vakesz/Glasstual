            "value": "O primeiro servidor se conecta via WebSocket: %@. As alterações valem a partir da próxima conexão."
          }
        }
      }
    },
    "received-secure-file-transfer-request": {
      "comment": "File transfer server console messages. Printed when someone offers a file over an encrypted (TLS) connection with DCC SSEND. %1$@ is the sender's nickname, %2$@ the file name and %3$@ the file size.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Received encrypted file transfer request from %1$@, %2$@ (%3$@)"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Titkosított fájlátviteli kérés érkezett tőle: %1$@, %2$@ (%3$@)"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verschlüsselte Dateiübertragungsanfrage von %1$@ erhalten, %2$@ (%3$@)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se recibió una solicitud de transferencia cifrada de %1$@, %2$@ (%3$@)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demande de transfert chiffré reçue de %1$@, %2$@ (%3$@)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@から暗号化されたファイル転送のリクエストを受信しました: %2$@（%3$@）"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pedido de transferência criptografada recebido de %1$@, %2$@ (%3$@)"
          }
        }
      }
    },
    "trying-secure-file-transfer": {
      "comment": "File transfer server console messages. Printed when this user offers a file over an encrypted (TLS) connection with DCC SSEND. %1$@ is the receiver's nickname, %2$@ the file name and %3$@ the file size.",
      "extractionState": "manual",
      "localizations": {
