    "command-responses-which-are-normally-hidden": {
      "comment": "Hidden command responses messages. Legacy key: yem-td.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "⍅ Command responses which are normally hidden will be output to this window until it is closed by control clicking (right clicking) it. ⍆"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "⍅ Az általában rejtett parancsválaszok ebben az ablakban jelennek meg, amíg be nem zárod a Control billentyűvel kattintva vagy jobb kattintással. ⍆"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "⍅ Normalerweise ausgeblendete Befehlsantworten werden in diesem Fenster angezeigt, bis du es per Control-Klick oder Rechtsklick schließt. ⍆"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "⍅ Las respuestas de comandos que normalmente están ocultas se imprimirán en esta ventana hasta que se cierre haciendo clic con el control (haciendo clic derecho) en ella. ⍆"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "⍅ Les réponses aux commandes qui sont normalement masquées seront affichées dans cette fenêtre jusqu'à ce qu'elle soit fermée en cliquant avec le bouton droit de la souris. ⍆"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "⍅ 通常隠されているコマンドレスポンスは、コントロールクリック（右クリック）で閉じるまでこのウィンドウに出力されます。⍆"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "⍅ As respostas de comando que normalmente estão ocultas serão exibidas nesta janela até que ela seja fechada clicando com o botão direito do mouse. ⍆"
          }
        }
      }
    },
