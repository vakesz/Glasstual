    "channel-config-needs-channel": {
      "comment": "Printed when /channelconfig names no saved channel and was not typed in one. The example is a command and stays untranslated.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Name a channel saved on this server, such as /channelconfig #channel list."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenne einen auf diesem Server gespeicherten Kanal, zum Beispiel /channelconfig #channel list."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Indica un canal guardado en este servidor, por ejemplo /channelconfig #channel list."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Indiquez un salon enregistré sur ce serveur, par exemple /channelconfig #channel list."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Adj meg egy ezen a szerveren mentett csatornát, például: /channelconfig #channel list."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
