    "timer-command-can-be-used" : {
      "comment" : "/timer/ command. Legacy key: xkq-rt.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The timer command can be used to perform a command after a specific amount of time and optionally repeat it.\n\nTo learn more, type:\n\t“/timer help <topic>”\n\nAvailable topics: ADD, REMOVE, LIST, STOP, RESTART"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A timer paranccsal megadott idő elteltével végrehajthatsz egy parancsot, és igény szerint ismételheted is.\n\nTovábbi információ:\n\t\"/timer help <topic>\"\n\nElérhető témák: ADD, REMOVE, LIST, STOP, RESTART"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit dem Befehl timer kannst du einen Befehl nach einer bestimmten Zeit ausführen und bei Bedarf wiederholen.\n\nWeitere Informationen:\n\t\"/timer help <topic>\"\n\nVerfügbare Themen: ADD, REMOVE, LIST, STOP, RESTART"
          }
        }
      }
    },
