    "joining-channels-has-been-delayed-because": {
      "comment": "Miscellaneous messages related to IRC events. Legacy key: r5h-fj.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Joining channels has been delayed because you haven’t identified. Perform “/autojoin” to join channels without identifying."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A csatornákhoz való csatlakozás késik, mert még nem azonosítottad magad. A /autojoin paranccsal azonosítás nélkül is csatlakozhatsz."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Kanalbeitritt wurde verzögert, da du dich noch nicht identifiziert hast. Mit /autojoin kannst du ohne Identifizierung beitreten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Unirse a los canales se ha retrasado porque no te has identificado. Ejecuta “/autojoin” para unirte a los canales sin identificarte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "L'adhésion aux canaux a été retardée car vous ne vous êtes pas identifié. Effectuez “/autojoin” pour rejoindre les canaux sans vous identifier."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "チャンネルへの参加は、識別情報が設定されていないため遅延しています。識別情報なしでチャンネルに参加するには、“/autojoin”を実行してください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A inscrição em canais foi atrasada porque você não se identificou. Execute “/autojoin” para se inscrever em canais sem se identificar."
          }
        }
      }
    },
    "join-refused-name-too-long": {
      "comment": "ISUPPORT driven messages. Console notice when the client does not send a JOIN at all because the channel name is longer than the server's advertised CHANNELLEN. %1$@ is the channel name, %2$ld the longest name this server accepts.",
