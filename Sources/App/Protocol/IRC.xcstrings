    "sasl-unavailable-requires-tls": {
      "comment": "/sasl status: OAUTHBEARER is only sent over an encrypted (TLS) connection. Lower case.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "requires a TLS connection"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "TLS-kapcsolatot igényel"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "erfordert eine TLS-Verbindung"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "requiere una conexión TLS"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "nécessite une connexion TLS"
          }
        },
        "ja": {
