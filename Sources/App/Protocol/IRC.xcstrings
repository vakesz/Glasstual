        }
      }
    },
    "config-invalid-value": {
      "comment": "Printed when /serverconfig or /channelconfig gets an invalid value for a setting. %1$@ is the setting name, %2$@ what was typed, %3$@ what it accepts, such as “on | off”.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ does not take “%2$@”. It takes %3$@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ akzeptiert „%2$@“ nicht. Erlaubt ist %3$@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ no admite «%2$@». Admite %3$@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ n’accepte pas « %2$@ ». Valeurs possibles : %3$@."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ nem fogadja el ezt: „%2$@”. Elfogadott: %3$@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ に「%2$@」は指定できません。指定できる値：%3$@。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ não aceita “%2$@”. Aceita %3$@."
          }
        }
      }
    },
    "config-secret-on-command-line": {
      "comment": "Printed when a secret is typed after a /serverconfig or /channelconfig secret setting. %@ is the command to type alone, such as /serverconfig server-password.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Type %@ alone and enter the secret in the secure field. Nothing was saved."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe nur %@ und gib das Geheimnis in das gesicherte Feld ein. Es wurde nichts gesichert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escribe solo %@ e introduce el secreto en el campo seguro. No se guardó nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tapez seulement %@ et saisissez le secret dans le champ sécurisé. Rien n’a été enregistré."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Csak ennyit írj be: %@, a titkot pedig a biztonságos mezőbe add meg. Semmi sem lett mentve."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ だけを入力し、秘密情報はセキュアフィールドに入力してください。何も保存されていません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Digite apenas %@ e informe o segredo no campo seguro. Nada foi salvo."
          }
        }
      }
    },
    "config-secret-prompt-body": {
      "comment": "Explanation in the question asking for a secret setting after /serverconfig or /channelconfig. %@ is the server name.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It is saved in your keychain for %@ and never shown in the conversation."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es wird für %@ in deinem Schlüsselbund gesichert und nie in der Unterhaltung angezeigt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se guarda en tu llavero para %@ y nunca se muestra en la conversación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il est enregistré dans votre trousseau pour %@ et n’apparaît jamais dans la conversation."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A kulcskarikádba kerül ehhez: %@, és soha nem jelenik meg a beszélgetésben."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 用にキーチェーンに保存され、会話に表示されることはありません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ele é guardado nas suas chaves para %@ e nunca aparece na conversa."
          }
        }
      }
    },
