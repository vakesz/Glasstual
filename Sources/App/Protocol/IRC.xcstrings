    "message-that-you-are-sending" : {
      "comment" : "Large messages warning. Legacy key: u4c-7i.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The message that you are sending is very large which means it will be split up into multiple messages. Sending too many messages at once is often considered disruptive and may result in a ban."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az üzeneted nagyon hosszú, ezért több üzenetre lesz felosztva. A túl sok üzenet egyidejű küldését gyakran zavarónak tekintik, és kitiltást eredményezhet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Nachricht ist sehr lang und wird daher auf mehrere Nachrichten aufgeteilt. Zu viele Nachrichten auf einmal gelten oft als störend und können zu einem Bann führen."
          }
        }
      }
    },
