            "state": "translated",
            "value": "“/timer stop <identifier>”\n\nStop the timer assigned to \u0002<identifier>\u0002.\n\nThe identifier for a timer can be found using “/timer list”"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "\"/timer stop <identifier>\"\n\nA \u0002<identifier>\u0002 azonosítójú időzítő leállítása.\n\nAz azonosítót a \"/timer list\" paranccsal találhatod meg."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "\"/timer stop <identifier>\"\n\nDen Timer mit der ID \u0002<identifier>\u0002 stoppen.\n\nDie ID findest du mit \"/timer list\"."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "“/timer stop <identifier>”\n\nDetiene el temporizador asignado a \u0002<identifier>\u0002.\n\nEl identificador de un temporizador se puede consultar con “/timer list”"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« /timer stop <identifiant> »\n\nArrête le minuteur associé à \u0002<identifiant>\u0002.\n\nL’identifiant d’un minuteur s’obtient avec « /timer list »"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「/timer stop <identifier>」\n\n\u0002<identifier>\u0002に割り当てられたタイマーを停止します。\n\nタイマーの識別子は「/timer list」で確認できます"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "“/timer stop <identificador>”\n\nPara o temporizador atribuído a \u0002<identificador>\u0002.\n\nO identificador de um temporizador pode ser obtido com “/timer list”"
          }
        }
      }
    },
    "timer-with-identifier-cant-be-restarted": {
