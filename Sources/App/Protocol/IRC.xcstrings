          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Intentando transferencia cifrada a %1$@, %2$@ (%3$@)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tentative de transfert chiffré vers %1$@, %2$@ (%3$@)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@への暗号化されたファイル転送を試行しています: %2$@（%3$@）"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tentando transferência criptografada para %1$@, %2$@ (%3$@)"
          }
        }
      }
    },
    "secure-file-offer-declined-by-setting": {
      "comment": "File transfer server console messages. Printed when someone offers a file over an encrypted (TLS) connection while the setting that accepts secure offers is off. %1$@ is the sender's nickname and %2$@ the offered file name.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ offered %2$@ over an encrypted connection, but secure offers are turned off in File Transfers settings. The offer was declined."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ titkosított kapcsolaton ajánlotta fel ezt: %2$@, de a biztonságos ajánlatok ki vannak kapcsolva a Fájlátvitel beállításaiban. Az ajánlat elutasítva."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ hat %2$@ über eine verschlüsselte Verbindung angeboten, aber sichere Angebote sind in den Dateiübertragungseinstellungen ausgeschaltet. Das Angebot wurde abgelehnt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ofreció %2$@ mediante una conexión cifrada, pero las ofertas seguras están desactivadas en los ajustes de Transferencias. Se rechazó la oferta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ a proposé %2$@ via une connexion chiffrée, mais les offres sécurisées sont désactivées dans les réglages Transferts de fichiers. L’offre a été refusée."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@が暗号化された接続で%2$@を送ろうとしましたが、ファイル転送設定で安全なオファーがオフになっています。オファーを拒否しました。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ofereceu %2$@ por uma conexão criptografada, mas as ofertas seguras estão desativadas nos ajustes de Transferências. A oferta foi recusada."
          }
        }
      }
    },
    "secure-chat-offer-declined-by-setting": {
      "comment": "Direct chat (DCC CHAT) messages. Printed when someone asks for an encrypted (TLS) direct chat with DCC SCHAT while the setting that accepts secure offers is off. %@ is the sender's nickname.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ wants to start an encrypted direct chat, but secure offers are turned off in File Transfers settings. The request was declined."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ titkosított közvetlen csevegést szeretne indítani, de a biztonságos ajánlatok ki vannak kapcsolva a Fájlátvitel beállításaiban. A kérés elutasítva."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ möchte einen verschlüsselten direkten Chat starten, aber sichere Angebote sind in den Dateiübertragungseinstellungen ausgeschaltet. Die Anfrage wurde abgelehnt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ quiere iniciar un chat directo cifrado, pero las ofertas seguras están desactivadas en los ajustes de Transferencias. Se rechazó la solicitud."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ souhaite démarrer une discussion directe chiffrée, mais les offres sécurisées sont désactivées dans les réglages Transferts de fichiers. La demande a été refusée."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@が暗号化されたダイレクトチャットを開始しようとしていますが、ファイル転送設定で安全なオファーがオフになっています。リクエストを拒否しました。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ quer iniciar um bate-papo direto criptografado, mas as ofertas seguras estão desativadas nos ajustes de Transferências. O pedido foi recusado."
          }
        }
      }
    },
    "wants-to-start-a-secure-direct-chat": {
      "comment": "Direct chat (DCC CHAT) messages. Printed when someone asks for an encrypted (TLS) direct chat with DCC SCHAT. %@ is the sender's nickname.",
