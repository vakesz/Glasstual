    "message-that-you-are-sending": {
      "comment": "Large messages warning. Legacy key: u4c-7i.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The message that you are sending is very large which means it will be split up into multiple messages. Sending too many messages at once is often considered disruptive and may result in a ban."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az üzeneted nagyon hosszú, ezért több üzenetre lesz felosztva. A túl sok üzenet egyidejű küldését gyakran zavarónak tekintik, és kitiltást eredményezhet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Nachricht ist sehr lang und wird daher auf mehrere Nachrichten aufgeteilt. Zu viele Nachrichten auf einmal gelten oft als störend und können zu einem Bann führen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "El mensaje que estás enviando es muy grande, lo que significa que se dividirá en varios mensajes. Enviar demasiados mensajes a la vez a menudo se considera disruptivo y puede resultar en una prohibición."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le message que vous envoyez est très volumineux, ce qui signifie qu'il sera divisé en plusieurs messages. Envoyer trop de messages en même temps est souvent considéré comme perturbateur et peut entraîner une interdiction."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "送信しているメッセージが非常に大きいため、複数のメッセージに分割されます。一度にメッセージを多すぎるほど送信することは、しばしば妨害行為とみなされ、禁止される可能性があります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A mensagem que você está enviando é muito grande, o que significa que será dividida em várias mensagens. Enviar muitas mensagens de uma vez é frequentemente considerado disruptivo e pode resultar em uma proibição."
          }
        }
      }
    },
