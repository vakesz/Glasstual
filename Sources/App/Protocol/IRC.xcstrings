          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Discussion directe chiffrée avec %1$@ établie (%2$@, certificat vérifié)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
