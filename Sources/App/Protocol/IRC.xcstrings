    "sasl-mechanism-unknown": {
      "comment": "/sasl mechanism: the typed name is not a mechanism Glasstual speaks. %1$@ is the typed name; %2$@ lists the mechanism wire names. Keep “automatic” untranslated: it is typed.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ isn’t a SASL mechanism Glasstual can use. Choose one of %2$@, or automatic."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A(z) %1$@ nem olyan SASL-mechanizmus, amelyet a Glasstual használni tud. Válasszon ezek közül: %2$@, vagy automatic."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ist kein SASL-Mechanismus, den Glasstual verwenden kann. Wählen Sie %2$@ oder automatic."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ no es un mecanismo SASL que Glasstual pueda usar. Elija uno de %2$@, o automatic."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ n’est pas un mécanisme SASL que Glasstual peut utiliser. Choisissez parmi %2$@, ou automatic."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@はGlasstualで使用できるSASLメカニズムではありません。%2$@、またはautomaticから選択してください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ não é um mecanismo SASL que o Glasstual possa usar. Escolha um entre %2$@, ou automatic."
          }
        }
      }
    },
    "sasl-mechanism-set": {
      "comment": "/sasl mechanism: confirmation. %@ is the mechanism wire name.",
      "extractionState": "manual",
      "localizations": {
