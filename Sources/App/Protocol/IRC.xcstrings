{
  "sourceLanguage": "en",
  "strings": {
    "nickname-retries-exhausted": {
      "comment": "Console warning after the server refused every nickname the client tried while registering; the client stops retrying and waits for the user to choose one.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server refused every nickname that was tried. Choose another one with the /nick command to continue."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A kiszolgáló minden kipróbált becenevet elutasított. A folytatáshoz válassz másikat a /nick paranccsal."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server hat alle versuchten Nicknamen abgelehnt. Wähle mit /nick einen anderen, um fortzufahren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor rechazó todos los apodos que se intentaron. Elige otro con el comando /nick para continuar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur a refusé chaque pseudo essayé. Choisissez-en un autre avec la commande /nick pour continuer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバが、試したすべてのニックネームを拒否しました。続けるには、/nickコマンドで別のニックネームを選択してください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O servidor recusou todos os apelidos tentados. Escolha outro com o comando /nick para continuar."
          }
        }
      }
    },
    "nick-serv-identification-timed-out": {
      "comment": "Warning after the identification command was written and the authentication deadline elapsed.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "NickServ has not confirmed identification within 30 seconds. Joining configured channels anyway."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A NickServ 30 másodpercen belül nem erősítette meg az azonosítást. Ennek ellenére csatlakozunk a beállított csatornákhoz."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "NickServ hat die Identifizierung nicht innerhalb von 30 Sekunden bestätigt. Den konfigurierten Kanälen wird trotzdem beigetreten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "NickServ no ha confirmado la identificación en un plazo de 30 segundos. Se unirá a los canales configurados de todos modos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "NickServ n’a pas confirmé l’identification dans les 30 secondes. Les canaux configurés sont rejoints malgré tout."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "NickServが30秒以内に識別を確認しませんでした。設定済みのチャンネルに、そのまま参加します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O NickServ não confirmou a identificação em 30 segundos. Entrando nos canais configurados mesmo assim."
          }
        }
      }
    },
    "added-ignore-that-matches-with-pattern": {
      "comment": "/ignore/ command. Legacy key: ret-20.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Added ignore that matches \u0002%1$@\u0002 with pattern: %2$@"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Mellőzési szabály hozzáadva ehhez: \u0002%1$@\u0002. Minta: %2$@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ignorierregel für \u0002%1$@\u0002 mit folgendem Muster hinzugefügt: %2$@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se añadió un ignorado que coincide con \u0002%1$@\u0002 con el patrón: %2$@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Exclusion ajoutée correspondant à \u0002%1$@\u0002 avec le motif : %2$@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0002%1$@\u0002に一致する無視を追加しました。パターン: %2$@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Regra de ignorar adicionada para \u0002%1$@\u0002 com o padrão: %2$@"
          }
        }
      }
    },
    "all-timers-removed": {
      "comment": "/timer/ command. Legacy key: 808-bs.",
