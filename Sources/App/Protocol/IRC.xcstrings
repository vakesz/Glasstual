          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível salvar o certificado de %1$@: %2$@"
          }
        }
      }
    },
    "dcc-question-no-longer-needed": {
      "comment": "Secure DCC messages. Printed when a question about a connection is withdrawn because the connection ended first. %@ is the short identifier of the question, such as d1.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Question %@ is no longer needed: the connection it was about has ended."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A(z) %@ kérdésre már nincs szükség: a kapcsolat, amelyre vonatkozott, véget ért."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Frage %@ ist nicht mehr nötig: Die Verbindung, um die es ging, wurde beendet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La pregunta %@ ya no es necesaria: la conexión a la que se refería ha terminado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La question %@ n’est plus nécessaire : la connexion concernée est terminée."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "質問%@は不要になりました。対象の接続が終了しました。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A pergunta %@ não é mais necessária: a conexão a que se referia terminou."
          }
        }
      }
    },
    "dcc-question-unknown": {
      "comment": "Secure DCC messages. Printed when /dcc accept, /dcc decline or /dcc trust names a question that is not waiting for an answer, because it never existed or was already answered. %@ is the identifier the user typed.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No question %@ is waiting for an answer."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nincs válaszra váró %@ kérdés."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Frage %@ wartet auf eine Antwort."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay ninguna pregunta %@ esperando respuesta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune question %@ n’attend de réponse."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "応答を待っている質問%@はありません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma pergunta %@ está aguardando resposta."
          }
        }
      }
    },
    "dcc-question-wrong-answer": {
      "comment": "Secure DCC messages. Printed when the answer typed does not fit the question, such as /dcc accept for a certificate question or replace for a first-time certificate. %1$@ is the identifier of the question and %2$@ the answer the user typed.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Question %1$@ cannot be answered with %2$@."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A(z) %1$@ kérdésre nem lehet ezzel válaszolni: %2$@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Frage %1$@ kann nicht mit %2$@ beantwortet werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La pregunta %1$@ no se puede responder con %2$@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de répondre à la question %1$@ par %2$@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "質問%1$@には%2$@で応答できません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A pergunta %1$@ não pode ser respondida com %2$@."
          }
        }
      }
    },
    "dcc-too-many-questions": {
      "comment": "Secure DCC messages. Printed when a secure connection is refused because too many questions about other connections are still waiting for an answer. %@ is the peer's nickname.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Refused a secure connection with %@: too many questions are waiting for an answer."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Biztonságos kapcsolat elutasítva vele: %@: túl sok kérdés vár válaszra."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sichere Verbindung mit %@ abgelehnt: Zu viele Fragen warten auf eine Antwort."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se rechazó una conexión segura con %@: hay demasiadas preguntas esperando respuesta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connexion sécurisée avec %@ refusée : trop de questions attendent une réponse."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@との安全な接続を拒否しました。応答を待っている質問が多すぎます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma conexão segura com %@ foi recusada: há perguntas demais aguardando resposta."
          }
        }
      }
    },
