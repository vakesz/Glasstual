    "please-take-notice-the-preference-labeled": {
      "comment": "Address type migration warning. Legacy key: w05-ph.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00034\u0002Please take notice:\u0002\u0003 The preference labeled “Prefer IPv4”, which you had enabled, no longer exists. \u0002IPv6 has been disabled for this connection\u0002 to offer you similar behavior. See the \u0002Network Socket\u0002 section of \u0002Server Properties\u0002 to change which protocols are enabled (IPv4 and/or IPv6)."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00034\u0002Figyelem:\u0002\u0003 Az általad bekapcsolt \"IPv4 előnyben részesítése\" beállítás már nem létezik. A hasonló működés érdekében \u0002az IPv6 le lett tiltva ennél a kapcsolatnál\u0002. Az engedélyezett protokollokat (IPv4 és/vagy IPv6) a \u0002Kiszolgáló tulajdonságai\u0002 ablak \u0002Hálózati kapcsolat\u0002 részében módosíthatod."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00034\u0002Bitte beachten:\u0002\u0003 Die von dir aktivierte Einstellung \"IPv4 bevorzugen\" gibt es nicht mehr. Für ein ähnliches Verhalten wurde \u0002IPv6 für diese Verbindung deaktiviert\u0002. Unter \u0002Netzwerkverbindung\u0002 in den \u0002Servereigenschaften\u0002 kannst du die aktivierten Protokolle (IPv4 und/oder IPv6) ändern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00034\u0002Ten en cuenta:\u0002\u0003 la preferencia «Preferir IPv4», que tenías activada, ya no existe. \u0002Se ha desactivado IPv6 para esta conexión\u0002 para ofrecerte un comportamiento similar. Consulta la sección \u0002Socket de red\u0002 de las \u0002Propiedades del servidor\u0002 para cambiar qué protocolos están activados (IPv4 y/o IPv6)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00034\u0002Remarque :\u0002\u0003 La préférence « Préférer IPv4 », que vous aviez activée, n’existe plus. \u0002IPv6 a été désactivé pour cette connexion\u0002 afin de reproduire un comportement similaire. Consultez la section \u0002Socket réseau\u0002 des \u0002Propriétés du serveur\u0002 pour choisir les protocoles activés (IPv4 et/ou IPv6)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00034\u0002ご注意:\u0002\u0003 有効にしていた「IPv4を優先」の設定は廃止されました。同様の動作にするため、\u0002この接続ではIPv6が無効になっています\u0002。有効にするプロトコル(IPv4またはIPv6、あるいは両方)を変更するには、\u0002サーバのプロパティ\u0002の\u0002ネットワークソケット\u0002セクションを確認してください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00034\u0002Atenção:\u0002\u0003 A preferência “Preferir IPv4”, que você tinha ativado, não existe mais. \u0002O IPv6 foi desativado para esta conexão\u0002 para oferecer um comportamento semelhante. Veja a seção \u0002Socket de rede\u0002 em \u0002Propriedades do servidor\u0002 para alterar quais protocolos estão ativados (IPv4 e/ou IPv6)."
          }
        }
      }
    },
    "please-use-the-address-book": {
      "comment": "/monitor/ command errors. Legacy key: khw-4y.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Please use \u0002People\u0002 to add or remove tracked users. Open \u0002People\u0002 using the keyboard shortcut \u0002Control 3\u0002."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A követett felhasználókat a \u0002Személyek\u0002 ablakban adhatod hozzá és távolíthatod el. A \u0002Személyek\u0002 ablakot a \u0002Control 3\u0002 billentyűparanccsal nyithatod meg."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwende \u0002Personen\u0002, um beobachtete Benutzer hinzuzufügen oder zu entfernen. Öffne \u0002Personen\u0002 mit \u0002Control 3\u0002."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa \u0002Personas\u0002 para añadir o quitar usuarios rastreados. Abre \u0002Personas\u0002 con el atajo de teclado \u0002Control 3\u0002."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez \u0002Personnes\u0002 pour ajouter ou retirer des utilisateurs suivis. Ouvrez \u0002Personnes\u0002 avec le raccourci clavier \u0002Contrôle 3\u0002."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "追跡対象のユーザを追加または削除するには、\u0002ユーザ\u0002を使用してください。キーボードショートカット\u0002Control 3\u0002で\u0002ユーザ\u0002を開けます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use \u0002Pessoas\u0002 para adicionar ou remover usuários acompanhados. Abra \u0002Pessoas\u0002 com o atalho de teclado \u0002Control 3\u0002."
          }
        }
      }
    },
    "presence-list-is-full": {
      "comment": "ISUPPORT driven messages. Console notice when some nicknames are not added to the server's presence list (MONITOR or WATCH) because it is already as full as the server said it gets. %1$ld is how many nicknames were left out, %2$ld how many entries this server tracks in total.",
