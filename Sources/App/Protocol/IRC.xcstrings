          "stringUnit": {
            "state": "translated",
            "value": "Verschlüsselter direkter Chat mit %1$@ hergestellt (%2$@, Zertifikat nicht überprüft)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
