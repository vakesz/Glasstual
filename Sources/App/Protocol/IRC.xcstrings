    "channel-renamed-with-reason": {
      "comment": "Channel rename: Printed in a channel the server renamed, with the reason it gave. The first argument is the old channel name, the second the new one, the third the reason.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
