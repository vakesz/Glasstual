            "state": "translated",
            "value": "Möchtest du diese Nachricht wirklich senden?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "¿Estás seguro de que quieres enviar este mensaje?"
          }
        },
        "fr": {
