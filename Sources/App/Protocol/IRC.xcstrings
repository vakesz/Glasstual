    "cannot-remove-ignore-for-because-glasstual" : {
      "comment" : "/ignore/ command. Legacy key: vrx-1f.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cannot remove ignore for \u0002%@\u0002 because Glasstual isn’t sure which to remove. More than one ignore exists that matches this user. To remove a specific ignore, open the \u0002Address Book\u0002 using the keyboard shortcut \u0002Control 3\u0002."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nem egyértelmű, melyik mellőzési szabályt kell eltávolítani ehhez: \u0002%@\u0002. Több szabály is illeszkedik erre a felhasználóra. Egy adott szabály eltávolításához nyisd meg a \u0002Címjegyzéket\u0002 a \u0002Control 3\u0002 billentyűparanccsal."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Ignorierregel für \u0002%@\u0002 kann nicht eindeutig bestimmt werden. Mehrere Regeln passen auf diesen Benutzer. Öffne das \u0002Adressbuch\u0002 mit \u0002Control 3\u0002, um eine bestimmte Regel zu entfernen."
          }
        }
      }
    },
