    "please-take-notice-the-preference-labeled" : {
      "comment" : "Address type migration warning. Legacy key: w05-ph.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\u00034\u0002Please take notice:\u0002\u0003 The preference labeled “Prefer IPv4”, which you had enabled, no longer exists. \u0002IPv6 has been disabled for this connection\u0002 to offer you similar behavior. See the \u0002Network Socket\u0002 section of \u0002Server Properties\u0002 to change which protocols are enabled (IPv4 and/or IPv6)."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\u00034\u0002Figyelem:\u0002\u0003 Az általad bekapcsolt \"IPv4 előnyben részesítése\" beállítás már nem létezik. A hasonló működés érdekében \u0002az IPv6 le lett tiltva ennél a kapcsolatnál\u0002. Az engedélyezett protokollokat (IPv4 és/vagy IPv6) a \u0002Kiszolgáló tulajdonságai\u0002 ablak \u0002Hálózati kapcsolat\u0002 részében módosíthatod."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\u00034\u0002Bitte beachten:\u0002\u0003 Die von dir aktivierte Einstellung \"IPv4 bevorzugen\" gibt es nicht mehr. Für ein ähnliches Verhalten wurde \u0002IPv6 für diese Verbindung deaktiviert\u0002. Unter \u0002Netzwerkverbindung\u0002 in den \u0002Servereigenschaften\u0002 kannst du die aktivierten Protokolle (IPv4 und/oder IPv6) ändern."
          }
        }
      }
    },
    "please-use-the-address-book" : {
      "comment" : "/monitor/ command errors. Legacy key: khw-4y.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Please use the \u0002Address Book\u0002 to add or remove tracked users. Open the \u0002Address Book\u0002 using the keyboard shortcut \u0002Control 3\u0002."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A követett felhasználókat a \u0002Címjegyzékben\u0002 adhatod hozzá és távolíthatod el. A \u0002Címjegyzéket\u0002 a \u0002Control 3\u0002 billentyűparanccsal nyithatod meg."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwende das \u0002Adressbuch\u0002, um beobachtete Benutzer hinzuzufügen oder zu entfernen. Öffne das \u0002Adressbuch\u0002 mit \u0002Control 3\u0002."
          }
        }
      }
    },
