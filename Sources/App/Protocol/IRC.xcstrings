    "joining-channels-has-been-delayed-because": {
      "comment": "Miscellaneous messages related to IRC events. Legacy key: r5h-fj.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Joining channels has been delayed because you haven’t identified. Perform “/autojoin” to join channels without identifying."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A csatornákhoz való csatlakozás késik, mert még nem azonosítottad magad. A /autojoin paranccsal azonosítás nélkül is csatlakozhatsz."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Kanalbeitritt wurde verzögert, da du dich noch nicht identifiziert hast. Mit /autojoin kannst du ohne Identifizierung beitreten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La unión a los canales se ha retrasado porque no te has identificado. Ejecuta «/autojoin» para unirte a los canales sin identificarte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’arrivée dans les canaux a été retardée, car vous ne vous êtes pas identifié. Saisissez « /autojoin » pour rejoindre les canaux sans vous identifier."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ニックネームを識別していないため、チャンネルへの参加が遅延されています。識別せずにチャンネルに参加するには、「/autojoin」を実行してください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A entrada nos canais foi adiada porque você não se identificou. Execute “/autojoin” para entrar nos canais sem se identificar."
          }
        }
      }
    },
