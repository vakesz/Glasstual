    "cannot-disable-the-feature-because": {
      "comment": "/defaults/ command. Legacy key: d7y-pv.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cannot disable the feature “%@” because it is not supported"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A(z) \"%@\" funkció nem tiltható le, mert nem támogatott"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Funktion \"%@\" kann nicht deaktiviert werden, da sie nicht unterstützt wird"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se puede desactivar la función «%@» porque no es compatible"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de désactiver la fonctionnalité « %@ », car elle n’est pas prise en charge"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」機能は未対応のため、無効にできません"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não é possível desativar o recurso “%@” porque ele não é compatível"
          }
        }
      }
    },
    "cannot-enable-the-feature-because": {
      "comment": "/defaults/ command. Legacy key: pc4-67.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cannot enable the feature “%@” because it is not supported"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A(z) \"%@\" funkció nem engedélyezhető, mert nem támogatott"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Funktion \"%@\" kann nicht aktiviert werden, da sie nicht unterstützt wird"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se puede activar la función «%@» porque no es compatible"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d’activer la fonctionnalité « %@ », car elle n’est pas prise en charge"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」機能は未対応のため、有効にできません"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não é possível ativar o recurso “%@” porque ele não é compatível"
          }
        }
      }
    },
