    "command-responses-which-are-normally-hidden": {
      "comment": "Hidden command responses messages. Legacy key: yem-td.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "⍅ Command responses which are normally hidden will be output to this window until it is closed by control clicking (right clicking) it. ⍆"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "⍅ Az általában rejtett parancsválaszok ebben az ablakban jelennek meg, amíg be nem zárod a Control billentyűvel kattintva vagy jobb kattintással. ⍆"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "⍅ Normalerweise ausgeblendete Befehlsantworten werden in diesem Fenster angezeigt, bis du es per Control-Klick oder Rechtsklick schließt. ⍆"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "⍅ Las respuestas de comandos que normalmente están ocultas se mostrarán en esta ventana hasta que la cierres con clic secundario (Control-clic) sobre ella. ⍆"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "⍅ Les réponses aux commandes, normalement masquées, s’afficheront dans cette fenêtre jusqu’à sa fermeture par un clic avec la touche Contrôle (clic droit). ⍆"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "⍅ 通常は非表示のコマンド応答は、コントロールクリック(右クリック)で閉じるまで、このウインドウに出力されます。⍆"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "⍅ As respostas de comando normalmente ocultas serão exibidas nesta janela até que ela seja fechada com Control-clique (clique com o botão direito). ⍆"
          }
        }
      }
    },
