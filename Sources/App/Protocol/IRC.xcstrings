                      "value" : "%arg karakter"
                    }
                  }
                }
              }
            }
          },
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nem csatlakozunk ide: %1$@, mert a kiszolgáló legfeljebb %#@arg2@ hosszúságú csatornaneveket fogad el."
          }
        },
        "de" : {
          "substitutions" : {
            "arg2" : {
