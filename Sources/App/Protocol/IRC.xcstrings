            "state": "translated",
            "value": "Nem küldhető operátori üzenet, mert a kiszolgáló nem támogatja a \u0002+o\u0002 módot."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Operatornachricht kann nicht gesendet werden, da dieser Server den Modus \u0002+o\u0002 nicht unterstützt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se puede enviar el mensaje al operador porque el modo \u0002+o\u0002 no es compatible con este servidor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d’envoyer un message d’opérateur, car le mode \u0002+o\u0002 n’est pas pris en charge par ce serveur."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このサーバはモード\u0002+o\u0002に対応していないため、オペレーターにメッセージを送信できません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não é possível enviar mensagem a operadores porque o modo \u0002+o\u0002 não é compatível com este servidor."
          }
        }
      }
    },
