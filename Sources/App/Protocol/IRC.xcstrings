          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "NickServ no ha confirmado la identificación en un plazo de 30 segundos. Se unirá a los canales configurados de todos modos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "NickServ n’a pas confirmé l’identification dans les 30 secondes. Les canaux configurés sont rejoints malgré tout."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "NickServが30秒以内に識別を確認しませんでした。設定済みのチャンネルに、そのまま参加します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O NickServ não confirmou a identificação em 30 segundos. Entrando nos canais configurados mesmo assim."
          }
        }
      }
