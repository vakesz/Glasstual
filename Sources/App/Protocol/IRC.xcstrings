    "are-you-plugged-into-the-server": {
      "comment": "/lagcheck/ command. Legacy key: 0jp-93.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Are you plugged into the server?"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Biztosan kapcsolódsz a kiszolgálóhoz?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Besteht überhaupt eine Verbindung zum Server?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Estás conectado al servidor?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Êtes-vous connecté au serveur ?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバに接続していますか？"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você está conectado ao servidor?"
          }
        }
      }
    },
    "are-you-sure-you-want": {
      "comment": "Large messages warning. Legacy key: lql-8i.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Are you sure you want to send this message?"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Biztosan elküldöd ezt az üzenetet?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Möchtest du diese Nachricht wirklich senden?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Seguro que quieres enviar este mensaje?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Voulez-vous vraiment envoyer ce message ?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このメッセージを送信してもよろしいですか？"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tem certeza de que deseja enviar esta mensagem?"
          }
        }
      }
    },
