    "config-not-resettable": {
      "comment": "Printed when /serverconfig reset names a setting with no default, such as the address or TLS. %1$@ is the setting name (untranslated token), %2$@ the command to set it instead.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ has no default to go back to. Set it with %2$@ followed by the value."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ hat keinen Standardwert. Lege den Wert mit %2$@ fest."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ no tiene un valor predeterminado. Establécelo con %2$@ seguido del valor."
