    "server-traffic-will-be-output": {
      "comment": "Raw mode messages. Legacy key: ik6-dl.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "⍅ Server traffic will be output to this window until it is closed by control clicking (right clicking) it. ⍆"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "⍅ A kiszolgáló forgalma ebben az ablakban jelenik meg, amíg be nem zárod a Control billentyűvel kattintva vagy jobb kattintással. ⍆"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "⍅ Der Serververkehr wird in diesem Fenster angezeigt, bis du es per Control-Klick oder Rechtsklick schließt. ⍆"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "⍅ El tráfico del servidor se mostrará en esta ventana hasta que la cierres con clic secundario (Control-clic) sobre ella. ⍆"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "⍅ Le trafic du serveur s’affichera dans cette fenêtre jusqu’à sa fermeture par un clic avec la touche Contrôle (clic droit). ⍆"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "⍅ サーバのトラフィックは、コントロールクリック(右クリック)で閉じるまで、このウインドウに出力されます。⍆"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "⍅ O tráfego do servidor será exibido nesta janela até que ela seja fechada com Control-clique (clique com o botão direito). ⍆"
          }
        }
      }
    },
