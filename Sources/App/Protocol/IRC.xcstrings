    "ignore-already-exists-that-matches": {
      "comment": "/ignore/ command. Legacy key: 5ix-zn.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An ignore already exists that matches \u0002%@\u0002. To modify this ignore, open the \u0002Address Book\u0002 using the keyboard shortcut \u0002Control 3\u0002."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Már létezik mellőzési szabály ehhez: \u0002%@\u0002. Módosításához nyisd meg a \u0002Címjegyzéket\u0002 a \u0002Control 3\u0002 billentyűparanccsal."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es gibt bereits eine Ignorierregel für \u0002%@\u0002. Öffne das \u0002Adressbuch\u0002 mit \u0002Control 3\u0002, um sie zu ändern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya existe una regla para ignorar que coincide con \u0002%@\u0002. Para modificarla, abre la \u0002Libreta de direcciones\u0002 con el atajo de teclado \u0002Control 3\u0002."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une exclusion correspondant à \u0002%@\u0002 existe déjà. Pour modifier cette exclusion, ouvrez le \u0002carnet d’adresses\u0002 avec le raccourci clavier \u0002Contrôle 3\u0002."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0002%@\u0002に一致する無視がすでに存在します。この無視を変更するには、キーボードショートカット\u0002Control 3\u0002で\u0002アドレス帳\u0002を開いてください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Já existe uma regra de ignorar que corresponde a \u0002%@\u0002. Para modificá-la, abra o \u0002Catálogo de Endereços\u0002 com o atalho de teclado \u0002Control 3\u0002."
          }
        }
      }
    },
