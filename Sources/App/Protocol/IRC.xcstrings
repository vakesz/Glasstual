    "ignore-unknown-flag": {
      "comment": "Printed when /ignore gets an unknown flag. %1$@ is what was typed, %2$@ the flags it takes (untranslated tokens).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unknown ignore flag “%1$@”. Use %2$@, or the same with a minus sign."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unbekannte Ignorieren-Option „%1$@“. Verwende %2$@ oder dieselben mit Minuszeichen."
