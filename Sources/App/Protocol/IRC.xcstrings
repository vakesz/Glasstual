    "declined-unsupported-dcc-offer": {
      "comment": "File transfer server console messages. Printed when someone sends a kind of DCC offer Glasstual does not support, such as a turbo transfer. %1$@ is the sender's nickname and %2$@ the DCC command word they used, such as TSEND; it is not translated.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ sent a DCC %2$@ offer, which Glasstual does not support. The offer was declined."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ DCC %2$@ ajánlatot küldött, de ezt a Glasstual nem támogatja. Az ajánlat elutasítva."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ hat ein DCC-%2$@-Angebot gesendet, das Glasstual nicht unterstützt. Das Angebot wurde abgelehnt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ envió una oferta DCC %2$@, que Glasstual no admite. Se rechazó la oferta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ a envoyé une offre DCC %2$@, que Glasstual ne prend pas en charge. L’offre a été refusée."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@がDCC %2$@のオファーを送信しましたが、Glasstualはこれに対応していません。オファーを拒否しました。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ enviou uma oferta DCC %2$@, que o Glasstual não aceita. A oferta foi recusada."
          }
        }
      }
    },
