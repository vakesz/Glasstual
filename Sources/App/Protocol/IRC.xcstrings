    "message-that-you-are-sending": {
      "comment": "Large messages warning. Legacy key: u4c-7i.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The message that you are sending is very large which means it will be split up into multiple messages. Sending too many messages at once is often considered disruptive and may result in a ban."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az üzeneted nagyon hosszú, ezért több üzenetre lesz felosztva. A túl sok üzenet egyidejű küldését gyakran zavarónak tekintik, és kitiltást eredményezhet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Nachricht ist sehr lang und wird daher auf mehrere Nachrichten aufgeteilt. Zu viele Nachrichten auf einmal gelten oft als störend und können zu einem Bann führen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El mensaje que estás enviando es muy grande, por lo que se dividirá en varios mensajes. Enviar demasiados mensajes a la vez suele considerarse molesto y puede acarrear un bloqueo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le message que vous envoyez est très volumineux et sera donc scindé en plusieurs messages. Envoyer trop de messages à la fois est souvent considéré comme perturbateur et peut entraîner un bannissement."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "送信しようとしているメッセージが非常に大きいため、複数のメッセージに分割されます。一度に多数のメッセージを送信すると、迷惑行為とみなされることが多く、BANされる場合があります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A mensagem que você está enviando é muito grande, o que significa que será dividida em várias mensagens. Enviar muitas mensagens de uma vez costuma ser considerado abusivo e pode resultar em banimento."
          }
        }
      }
    },
