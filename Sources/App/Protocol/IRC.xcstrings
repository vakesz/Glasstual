          }
        }
      }
    },
    "dcc-chat-offer-answer-hint": {
      "comment": "Direct chat (DCC CHAT) messages. Printed under a direct chat request so it can be answered by typing. %@ is the short identifier of the question, such as d1; keep the commands as written.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Answer with /dcc accept %1$@ or /dcc decline %1$@."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Válaszolj ezzel: /dcc accept %1$@ vagy /dcc decline %1$@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Antworte mit /dcc accept %1$@ oder /dcc decline %1$@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Responde con /dcc accept %1$@ o /dcc decline %1$@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Répondez avec /dcc accept %1$@ ou /dcc decline %1$@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "/dcc accept %1$@ または /dcc decline %1$@ で応答してください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Responda com /dcc accept %1$@ ou /dcc decline %1$@."
          }
        }
      }
    },
    "dcc-trust-first-use-question": {
      "comment": "Secure DCC messages. Printed when a peer presents a certificate for the first time, so the question can be answered by typing. %1$@ is the peer's nickname, %2$@ the SHA-256 fingerprint and %3$@ the short identifier of the question, such as d1; keep the commands and answer words as written.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Certificate from %1$@: SHA-256 %2$@. Answer with /dcc trust %3$@ remember, once or reject."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanúsítvány tőle: %1$@: SHA-256 %2$@. Válaszolj ezzel: /dcc trust %3$@ remember, once vagy reject."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zertifikat von %1$@: SHA-256 %2$@. Antworte mit /dcc trust %3$@ remember, once oder reject."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Certificado de %1$@: SHA-256 %2$@. Responde con /dcc trust %3$@ remember, once o reject."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Certificat de %1$@ : SHA-256 %2$@. Répondez avec /dcc trust %3$@ remember, once ou reject."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@の証明書: SHA-256 %2$@。/dcc trust %3$@ remember、once、reject のいずれかで応答してください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Certificado de %1$@: SHA-256 %2$@. Responda com /dcc trust %3$@ remember, once ou reject."
          }
        }
      }
    },
    "dcc-trust-changed-question": {
      "comment": "Secure DCC messages. Printed when a peer presents a certificate that differs from the one the user trusted, so the question can be answered by typing. %1$@ is the peer's nickname, %2$@ the SHA-256 fingerprint presented now and %3$@ the short identifier of the question, such as d1; keep the commands and answer words as written.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@'s certificate has changed: it is now SHA-256 %2$@. Someone may be impersonating %1$@. Answer with /dcc trust %3$@ replace or reject."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ tanúsítványa megváltozott: most SHA-256 %2$@. Lehet, hogy valaki %1$@ nevében lép fel. Válaszolj ezzel: /dcc trust %3$@ replace vagy reject."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Zertifikat von %1$@ hat sich geändert: Es ist jetzt SHA-256 %2$@. Möglicherweise gibt sich jemand als %1$@ aus. Antworte mit /dcc trust %3$@ replace oder reject."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El certificado de %1$@ ha cambiado: ahora es SHA-256 %2$@. Puede que alguien se esté haciendo pasar por %1$@. Responde con /dcc trust %3$@ replace o reject."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le certificat de %1$@ a changé : il est désormais SHA-256 %2$@. Quelqu’un se fait peut-être passer pour %1$@. Répondez avec /dcc trust %3$@ replace ou reject."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@の証明書が変更されました。現在は SHA-256 %2$@ です。誰かが%1$@になりすましている可能性があります。/dcc trust %3$@ replace または reject で応答してください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O certificado de %1$@ mudou: agora é SHA-256 %2$@. Alguém pode estar se passando por %1$@. Responda com /dcc trust %3$@ replace ou reject."
          }
        }
      }
    },
    "dcc-trust-remembered": {
      "comment": "Secure DCC messages. Printed when the user trusts a peer's certificate and asks to remember it. %@ is the peer's nickname.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Trusted %@'s certificate and saved it for later connections."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ tanúsítványa megbízhatóként elmentve a későbbi kapcsolatokhoz."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dem Zertifikat von %@ wird vertraut; es wurde für spätere Verbindungen gesichert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se confió en el certificado de %@ y se guardó para próximas conexiones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le certificat de %@ est approuvé et enregistré pour les prochaines connexions."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@の証明書を信頼し、今後の接続のために保存しました。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O certificado de %@ foi considerado confiável e salvo para próximas conexões."
          }
        }
      }
    },
    "dcc-trust-once": {
      "comment": "Secure DCC messages. Printed when the user trusts a peer's certificate for one connection only. %@ is the peer's nickname.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Trusted %@'s certificate for this connection only."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ tanúsítványa csak erre a kapcsolatra megbízható."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dem Zertifikat von %@ wird nur für diese Verbindung vertraut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se confió en el certificado de %@ solo para esta conexión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le certificat de %@ est approuvé pour cette connexion uniquement."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@の証明書をこの接続に限り信頼しました。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O certificado de %@ foi considerado confiável apenas para esta conexão."
          }
        }
      }
    },
    "dcc-trust-replaced": {
      "comment": "Secure DCC messages. Printed when the user replaces the saved certificate of a peer with the one presented now. %@ is the peer's nickname.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Replaced the saved certificate for %@."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ mentett tanúsítványa lecserélve."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das gesicherte Zertifikat von %@ wurde ersetzt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se reemplazó el certificado guardado de %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le certificat enregistré de %@ a été remplacé."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@の保存済み証明書を置き換えました。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O certificado salvo de %@ foi substituído."
          }
        }
      }
    },
    "dcc-trust-rejected": {
      "comment": "Secure DCC messages. Printed when the user does not trust a peer's certificate. %@ is the peer's nickname.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Did not trust %@'s certificate. The connection was refused."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ tanúsítványa nem megbízható. A kapcsolat elutasítva."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dem Zertifikat von %@ wurde nicht vertraut. Die Verbindung wurde abgelehnt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se confió en el certificado de %@. Se rechazó la conexión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le certificat de %@ n’a pas été approuvé. La connexion a été refusée."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@の証明書を信頼しませんでした。接続を拒否しました。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O certificado de %@ não foi considerado confiável. A conexão foi recusada."
          }
        }
      }
    },
    "dcc-trust-save-failed": {
      "comment": "Secure DCC messages. Printed when a trusted certificate could not be written to disk. %1$@ is the peer's nickname and %2$@ the reason the system gave.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The certificate for %1$@ could not be saved: %2$@"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ tanúsítványát nem sikerült menteni: %2$@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Zertifikat von %1$@ konnte nicht gesichert werden: %2$@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo guardar el certificado de %1$@: %2$@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d’enregistrer le certificat de %1$@ : %2$@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@の証明書を保存できませんでした: %2$@"
          }
