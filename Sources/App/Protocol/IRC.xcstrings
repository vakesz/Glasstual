    "config-unknown-setting": {
      "comment": "Printed when /serverconfig or /channelconfig names an unknown setting. %1$@ is what was typed, %2$@ the command that lists them, such as /serverconfig list.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There is no setting “%1$@”. Type %2$@ to see them all."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es gibt keine Einstellung „%1$@“. Tippe %2$@, um alle zu sehen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay ningún ajuste «%1$@». Escribe %2$@ para verlos todos."
          }
        },
        "fr": {
