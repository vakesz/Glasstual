          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Bate-papo direto criptografado com %1$@ estabelecido (%2$@, certificado verificado)"
          }
        }
      }
    },
    "secure-direct-chat-established-unverified": {
      "comment": "Direct chat (DCC CHAT) messages. Printed when an encrypted direct chat is connected but the peer presented no certificate, so nobody is verified. %1$@ is the peer's nickname and %2$@ the TLS version, such as TLS 1.3.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
