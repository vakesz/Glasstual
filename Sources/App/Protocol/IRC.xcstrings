    "sasl-token-prompt-body": {
      "comment": "Explanation in the question asking for an OAuth token after /sasl token. OAUTHBEARER is a mechanism name and stays untranslated.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The token is saved in your keychain for this server and used to sign in with OAUTHBEARER. It is never shown in the conversation."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Token wird für diesen Server in deinem Schlüsselbund gesichert und zur Anmeldung mit OAUTHBEARER verwendet. Es wird nie in der Unterhaltung angezeigt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El token se guarda en tu llavero para este servidor y se usa para iniciar sesión con OAUTHBEARER. Nunca se muestra en la conversación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le jeton est enregistré dans votre trousseau pour ce serveur et sert à vous connecter avec OAUTHBEARER. Il n’apparaît jamais dans la conversation."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A token a kulcskarikádba kerül ehhez a szerverhez, és az OAUTHBEARER bejelentkezéshez használja az app. Soha nem jelenik meg a beszélgetésben."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "トークンはこのサーバ用にキーチェーンに保存され、OAUTHBEARER でのサインインに使われます。会話に表示されることはありません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O token é guardado nas suas chaves para este servidor e usado para entrar com OAUTHBEARER. Ele nunca aparece na conversa."
          }
        }
      }
    },
