    "you-cannot-send-private-messages": {
      "comment": "Miscellaneous messages related to IRC events. Legacy key: 11i-ev.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You cannot send private messages to %@. Anything that you send to them will be ignored until you are added to their list of recognized users."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nem küldhetsz privát üzenetet ennek: %@. Az üzeneteidet figyelmen kívül hagyja, amíg fel nem vesz az engedélyezett felhasználói közé."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst %@ keine privaten Nachrichten senden. Deine Nachrichten werden ignoriert, bis du zur Liste zugelassener Benutzer hinzugefügt wirst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No puedes enviar mensajes privados a %@. Todo lo que le envíes se ignorará hasta que te añada a su lista de usuarios reconocidos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous ne pouvez pas envoyer de messages privés à %@. Tout ce que vous lui enverrez sera ignoré tant que vous ne serez pas ajouté à sa liste d’utilisateurs reconnus."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@にはダイレクトメッセージを送信できません。相手の認識済みユーザリストに追加されるまで、送信した内容は無視されます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você não pode enviar mensagens privadas para %@. Tudo o que você enviar será ignorado até que você seja adicionado à lista de usuários reconhecidos dessa pessoa."
          }
        }
      }
    },
    "you-have-exceeded-the-maximum-away": {
      "comment": "/away/ command. Legacy key: 41y-p2.",
      "extractionState": "manual",
