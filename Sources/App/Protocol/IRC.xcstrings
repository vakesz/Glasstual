          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Discussion directe chiffrée avec %1$@ établie (%2$@, certificat non vérifié)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@との暗号化されたダイレクトチャットを確立しました（%2$@、証明書は未検証）"
          }
