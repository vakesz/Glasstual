{
  "sourceLanguage": "en",
  "strings": {
    "nickname-retries-exhausted": {
      "comment": "Console warning after the server refused every nickname the client tried while registering; the client stops retrying and waits for the user to choose one.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server refused every nickname that was tried. Choose another one with the /nick command to continue."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A kiszolgáló minden kipróbált becenevet elutasított. A folytatáshoz válassz másikat a /nick paranccsal."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server hat alle versuchten Nicknamen abgelehnt. Wähle mit /nick einen anderen, um fortzufahren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "El servidor rechazó todos los apodos que se intentaron. Elige otro con el comando /nick para continuar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le serveur a refusé chaque surnom qui a été essayé. Choisissez un autre avec la commande /nick pour continuer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "サーバーは試されたすべてのニックネームを拒否しました。続行するには、/nickコマンドで別のものを選択してください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O servidor recusou todos os apelidos que foram tentados. Escolha outro com o comando /nick para continuar."
          }
        }
      }
    },
    "nick-serv-identification-timed-out": {
      "comment": "Warning after the identification command was written and the authentication deadline elapsed.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "NickServ has not confirmed identification within 30 seconds. Joining configured channels anyway."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A NickServ 30 másodpercen belül nem erősítette meg az azonosítást. Ennek ellenére csatlakozunk a beállított csatornákhoz."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "NickServ hat die Identifizierung nicht innerhalb von 30 Sekunden bestätigt. Den konfigurierten Kanälen wird trotzdem beigetreten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "NickServ no ha confirmado la identificación en un plazo de 30 segundos. Se unirá a los canales configurados de todos modos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "NickServ n'a pas confirmé son identification dans les 30 secondes. Je rejoins les canaux configurés de toute façon."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "NickServは30秒以内に身元確認を完了していません。設定されたチャンネルに引き続き参加します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "NickServ não confirmou a identificação em 30 segundos. Entrando nos canais configurados de qualquer forma."
          }
        }
      }
    },
    "added-ignore-that-matches-with-pattern": {
      "comment": "/ignore/ command. Legacy key: ret-20.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Added ignore that matches \u0002%1$@\u0002 with pattern: %2$@"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Mellőzési szabály hozzáadva ehhez: \u0002%1$@\u0002. Minta: %2$@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ignorierregel für \u0002%1$@\u0002 mit folgendem Muster hinzugefügt: %2$@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Se ha añadido ignorar que coincide \u0002%1$@\u0002 con patrón: %2$@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ignorer ajouté qui correspond \u0002%1$@\u0002 avec le motif : %2$@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "一致する無視を追加しました \u0002%1$@\u0002 パターン付き：%2$@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Adicionado ignorar que corresponde \u0002%1$@\u0002 com padrão: %2$@"
          }
        }
      }
    },
