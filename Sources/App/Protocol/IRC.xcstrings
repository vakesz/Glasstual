    "tried-to-send-you-a-private": {
      "comment": "Miscellaneous messages related to IRC events. Legacy key: 3yj-in.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ (%2$@) tried to send you a private message, but it was ignored due to \u0002umode +g\u0002. Perform “/accept %1$@” to allow this user to communicate with you."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ (%2$@) privát üzenetet próbált küldeni, de a \u0002+g felhasználói mód\u0002 miatt figyelmen kívül maradt. Az engedélyezéshez írd be: /accept %1$@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ (%2$@) hat versucht, dir eine private Nachricht zu senden. Sie wurde wegen \u0002Benutzermodus +g\u0002 ignoriert. Mit /accept %1$@ kannst du Nachrichten dieses Benutzers zulassen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ (%2$@) intentó enviarte un mensaje privado, pero se ignoró debido a \u0002umode +g\u0002. Ejecuta «/accept %1$@» para permitir que este usuario se comunique contigo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ (%2$@) a essayé de vous envoyer un message privé, mais il a été ignoré en raison de \u0002umode +g\u0002. Saisissez « /accept %1$@ » pour autoriser cet utilisateur à communiquer avec vous."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@(%2$@)がダイレクトメッセージを送信しようとしましたが、\u0002umode +g\u0002により無視されました。この相手からの連絡を許可するには、「/accept %1$@」を実行してください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ (%2$@) tentou enviar uma mensagem privada para você, mas ela foi ignorada devido ao \u0002umode +g\u0002. Execute “/accept %1$@” para permitir que este usuário se comunique com você."
          }
        }
      }
    },
