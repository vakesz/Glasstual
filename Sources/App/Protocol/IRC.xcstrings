    "channel-rename-kept-old": {
      "comment": "Channel rename: Printed in the renamed channel when a saved channel that already had the new name was kept under another name, with its history. The first argument is the new channel name, the second the name the saved channel now has.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A saved channel already named %1$@ was kept as %2$@, with its history."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
