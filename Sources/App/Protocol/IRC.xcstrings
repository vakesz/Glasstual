    "timer-identifier-is-not-properly-formatted": {
      "comment": "/timer/ command. Legacy key: p6l-o4.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Timer identifier is not properly formatted. Type “/timer list” for a list of timers."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az időzítő azonosítójának formátuma hibás. Az időzítők listájához írd be: /timer list"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Timer-ID ist nicht korrekt formatiert. Mit /timer list erhältst du eine Liste der Timer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El identificador del temporizador no tiene el formato correcto. Escribe «/timer list» para ver la lista de temporizadores."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’identifiant du minuteur est mal formaté. Saisissez « /timer list » pour obtenir la liste des minuteurs."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タイマーの識別子の形式が正しくありません。タイマーの一覧を表示するには、「/timer list」と入力してください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O identificador do temporizador não está formatado corretamente. Digite “/timer list” para ver a lista de temporizadores."
          }
        }
      }
    },
    "timer-interval-must-be-a-whole": {
      "comment": "/timer/ command. Legacy key: 327-pv.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Timer interval must be a whole number that is grater than zero (0). Type “/timer help” for more information."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az időzítő időközének nullánál (0) nagyobb egész számnak kell lennie. További információ: /timer help"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Timer-Intervall muss eine ganze Zahl größer als null (0) sein. Weitere Informationen mit /timer help."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El intervalo del temporizador debe ser un número entero mayor que cero (0). Escribe «/timer help» para obtener más información."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’intervalle du minuteur doit être un nombre entier supérieur à zéro (0). Saisissez « /timer help » pour plus d’informations."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タイマーの間隔は、0より大きい整数にしてください。詳しくは「/timer help」と入力してください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O intervalo do temporizador deve ser um número inteiro maior que zero (0). Digite “/timer help” para obter mais informações."
          }
        }
      }
    },
    "timer-list-list-timers": {
      "comment": "/timer/ command. Legacy key: x1n-ve.",
