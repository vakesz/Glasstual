          "stringUnit": {
            "state": "translated",
            "value": "A saved channel already named %1$@ was kept as %2$@, with its history."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A(z) %1$@ nevű mentett csatorna megmaradt %2$@ néven, az előzményeivel együtt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
