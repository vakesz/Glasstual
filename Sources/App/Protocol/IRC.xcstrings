    "secure-direct-chat-established-verified": {
      "comment": "Direct chat (DCC CHAT) messages. Printed when an encrypted direct chat is connected and the peer's certificate was verified. %1$@ is the peer's nickname and %2$@ the TLS version, such as TLS 1.3.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Encrypted direct chat with %1$@ established (%2$@, certificate verified)"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Titkosított közvetlen csevegés létrejött vele: %1$@ (%2$@, tanúsítvány ellenőrizve)"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verschlüsselter direkter Chat mit %1$@ hergestellt (%2$@, Zertifikat überprüft)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
