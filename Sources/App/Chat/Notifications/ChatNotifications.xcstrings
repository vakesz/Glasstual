{
  "sourceLanguage": "en",
  "strings": {
    "announcement-disconnected": {
      "comment": "Spoken by VoiceOver when a connection drops unexpectedly. The argument is the network name.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Disconnected from %@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbindung zu %@ getrennt"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapcsolat bontva: %@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desconectado de %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déconnecté de %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@から切断されました"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desconectado de %@"
          }
        }
      }
    },
    "announcement-highlight": {
      "comment": "Spoken by VoiceOver when a highlight arrives. Arguments are the sender nickname, the conversation name and the message text.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Highlight from %1$@ in %2$@: %3$@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hervorhebung von %1$@ in %2$@: %3$@"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Említés itt: %2$@, feladó: %1$@: %3$@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mención de %1$@ en %2$@: %3$@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mention de %1$@ dans %2$@ : %3$@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@で%1$@からのハイライト: %3$@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Destaque de %1$@ em %2$@: %3$@"
          }
        }
      }
    },
