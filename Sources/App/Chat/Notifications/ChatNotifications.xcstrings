    "body-invited": {
      "comment": "Notification bubble description for a channel invitation. Arguments are the inviter nickname and channel name. Migrated from legacy key xl5-dn. Legacy translator context: ‘Notification bubble descriptions. These are only notifications that require localization. Many notifications just send the raw message received so they are not localized here’.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ invited you to join %2$@"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ meghívott erre a csatornára: %2$@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ hat dich nach %2$@ eingeladen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ te invitó a unirte a %2$@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ vous a invité à rejoindre %2$@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@から%2$@への参加に招待されました"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ convidou você para entrar em %2$@"
          }
        }
      }
    },
