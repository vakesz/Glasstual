          }
        }
      }
    },
    "key-value-restricted": {
      "comment": "/metadata output for a key value with restricted visibility. The arguments are the key, the value and the server's visibility word.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ = %2$@ (visible to: %3$@)"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ = %2$@ (látható: %3$@)"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ = %2$@ (sichtbar für: %3$@)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ = %2$@ (visible para: %3$@)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ = %2$@ (visible par : %3$@)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ = %2$@（表示対象：%3$@）"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ = %2$@ (visível para: %3$@)"
          }
        }
      }
    },
    "key-refused": {
      "comment": "/metadata output when the server refused one key. The arguments are the key and the reason.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: %2$@"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: %2$@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: %2$@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: %2$@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ : %2$@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@：%2$@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: %2$@"
          }
        }
      }
    },
    "sync-later": {
      "comment": "/metadata output when the server postponed a sync. The argument is the target.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server will send the metadata for %@ later."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A szerver később küldi el a(z) %@ metaadatait."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server sendet die Metadaten für %@ später."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor enviará los metadatos de %@ más tarde."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur enverra les métadonnées de %@ plus tard."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ のメタデータはサーバから後で送信されます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O servidor enviará os metadados de %@ mais tarde."
          }
        }
      }
    },
    "sync-gave-up": {
      "comment": "Debug line when Glasstual stopped asking a server that kept postponing a metadata sync. The argument is the target.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stopped asking for the metadata of %@ after the server postponed it several times."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A(z) %@ metaadatainak lekérése leállt, miután a szerver többször elhalasztotta."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Metadaten für %@ werden nicht mehr angefragt, nachdem der Server sie mehrmals verschoben hat."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se dejaron de pedir los metadatos de %@ porque el servidor los aplazó varias veces."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les métadonnées de %@ ne sont plus demandées après plusieurs reports du serveur."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバが何度も延期したため、%@ のメタデータの要求を停止しました。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os metadados de %@ deixaram de ser pedidos depois que o servidor os adiou várias vezes."
          }
        }
      }
    },
