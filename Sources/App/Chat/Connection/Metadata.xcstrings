    "invalid-key": {
      "comment": "/metadata refusal for a key with characters the protocol does not allow. The argument is the key.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” is not a valid key. Keys use lowercase letters, digits and _ . / -."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A(z) „%@” nem érvényes kulcs. A kulcsok kisbetűket, számjegyeket és _ . / - karaktereket tartalmazhatnak."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ ist kein gültiger Schlüssel. Schlüssel bestehen aus Kleinbuchstaben, Ziffern und _ . / -."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” no es una clave válida. Las claves usan minúsculas, dígitos y _ . / -."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %@ » n’est pas une clé valide. Les clés utilisent des minuscules, des chiffres et _ . / -."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」は有効なキーではありません。キーには小文字、数字、_ . / - を使用します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” não é uma chave válida. As chaves usam letras minúsculas, dígitos e _ . / -."
          }
        }
      }
    },
    "too-many-subscriptions": {
      "comment": "/metadata sub refusal: the server allows only so many subscriptions. The argument is the limit.",
      "extractionState": "manual",
      "localizations": {
