{
  "sourceLanguage": "en",
  "strings": {
    "failure-invalid-target": {
      "comment": "Metadata failure: the server does not know the target.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server doesn’t know that target."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A szerver nem ismeri ezt a célt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server kennt dieses Ziel nicht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor no conoce ese destino."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur ne connaît pas cette cible."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバはその対象を認識していません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O servidor não conhece esse destino."
          }
        }
      }
    },
    "failure-key-invalid": {
      "comment": "Metadata failure: the server refuses the key name.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server doesn’t accept that key."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A szerver nem fogadja el ezt a kulcsot."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server akzeptiert diesen Schlüssel nicht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor no acepta esa clave."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur n’accepte pas cette clé."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバはそのキーを受け付けません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O servidor não aceita essa chave."
          }
        }
      }
    },
    "failure-key-no-permission": {
      "comment": "Metadata failure: no permission for the key on that target.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You don’t have permission to change that key."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nincs jogosultságod módosítani ezt a kulcsot."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast keine Berechtigung, diesen Schlüssel zu ändern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No tienes permiso para cambiar esa clave."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous n’avez pas l’autorisation de modifier cette clé."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "そのキーを変更する権限がありません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você não tem permissão para alterar essa chave."
          }
        }
      }
    },
    "failure-limit-reached-count": {
      "comment": "Metadata failure: the target holds as many keys as the server allows. The argument is the limit.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server allows %lld profile keys, and they are all in use."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A szerver %lld profilkulcsot enged, és mind foglalt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server erlaubt %lld Profilschlüssel, und alle sind belegt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor permite %lld claves de perfil y todas están en uso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur autorise %lld clés de profil, et elles sont toutes utilisées."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバで使用できるプロフィールのキーは%lld個で、すべて使用中です。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O servidor permite %lld chaves de perfil, e todas estão em uso."
          }
        }
      }
    },
    "failure-limit-reached": {
      "comment": "Metadata failure: the target holds as many keys as the server allows, limit unknown.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server allows no more profile keys."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A szerver nem enged több profilkulcsot."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server erlaubt keine weiteren Profilschlüssel."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor no permite más claves de perfil."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur n’autorise pas d’autres clés de profil."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバではこれ以上プロフィールのキーを使用できません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O servidor não permite mais chaves de perfil."
          }
        }
      }
    },
    "failure-value-invalid-bytes": {
      "comment": "Metadata failure: the value is too long or not valid text. The argument is the maximum length in bytes.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server doesn’t accept that value. It may be too long (at most %lld bytes)."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A szerver nem fogadja el ezt az értéket. Lehet, hogy túl hosszú (legfeljebb %lld bájt)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server akzeptiert diesen Wert nicht. Er ist eventuell zu lang (höchstens %lld Byte)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor no acepta ese valor. Puede ser demasiado largo (máximo %lld bytes)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur n’accepte pas cette valeur. Elle est peut-être trop longue (%lld octets au maximum)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバはその値を受け付けません。長すぎる可能性があります（最大%lldバイト）。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O servidor não aceita esse valor. Talvez seja longo demais (no máximo %lld bytes)."
          }
        }
      }
    },
    "failure-value-invalid": {
      "comment": "Metadata failure: the value is too long or not valid text.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server doesn’t accept that value. It may be too long."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A szerver nem fogadja el ezt az értéket. Lehet, hogy túl hosszú."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server akzeptiert diesen Wert nicht. Er ist eventuell zu lang."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor no acepta ese valor. Puede ser demasiado largo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur n’accepte pas cette valeur. Elle est peut-être trop longue."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバはその値を受け付けません。長すぎる可能性があります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O servidor não aceita esse valor. Talvez seja longo demais."
          }
        }
      }
    },
    "failure-rate-limit-exhausted": {
      "comment": "Metadata failure: the server kept asking to wait and Glasstual gave up.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server kept asking to wait. Try again later."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A szerver többször is várakozást kért. Próbáld újra később."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server hat wiederholt um Geduld gebeten. Versuche es später erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor siguió pidiendo esperar. Inténtalo más tarde."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur a demandé d’attendre à plusieurs reprises. Réessayez plus tard."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバが待機を求め続けました。しばらくしてからもう一度お試しください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O servidor continuou pedindo para esperar. Tente novamente mais tarde."
          }
        }
      }
    },
    "failure-subcommand-invalid": {
      "comment": "Metadata failure: the server does not know the subcommand.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server doesn’t support that metadata command."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A szerver nem támogatja ezt a metaadat-parancsot."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server unterstützt diesen Metadatenbefehl nicht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor no admite ese comando de metadatos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur ne prend pas en charge cette commande de métadonnées."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバはそのメタデータコマンドに対応していません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O servidor não oferece suporte a esse comando de metadados."
          }
        }
      }
    },
    "failure-not-connected": {
      "comment": "Metadata failure: the session is not connected.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect to the server to change your profile."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A profilod módosításához kapcsolódj a szerverhez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbinde dich mit dem Server, um dein Profil zu ändern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conéctate al servidor para cambiar tu perfil."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez-vous au serveur pour modifier votre profil."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロフィールを変更するには、サーバに接続してください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conecte-se ao servidor para alterar seu perfil."
          }
        }
      }
    },
    "unsupported": {
      "comment": "Metadata is unsupported on this server or not available yet.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This server doesn’t support profiles."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez a szerver nem támogatja a profilokat."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Server unterstützt keine Profile."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este servidor no admite perfiles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce serveur ne prend pas en charge les profils."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このサーバはプロフィールに対応していません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este servidor não oferece suporte a perfis."
          }
        }
      }
    },
    "query-header": {
      "comment": "Header line of /metadata output. The arguments are the target and the subcommand, such as GET.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Metadata %2$@ for %1$@:"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Metaadatok (%2$@) – %1$@:"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Metadaten %2$@ für %1$@:"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Metadatos %2$@ de %1$@:"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Métadonnées %2$@ pour %1$@ :"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ のメタデータ %2$@："
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Metadados %2$@ de %1$@:"
          }
        }
      }
    },
    "no-metadata": {
