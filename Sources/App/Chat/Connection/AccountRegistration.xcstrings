          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le mot de passe n’a pas été envoyé, car la connexion n’est pas chiffrée alors que le chiffrement était demandé."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "暗号化が要求されたにもかかわらず接続が暗号化されていないため、パスワードは送信されませんでした。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A senha não foi enviada porque a conexão não está criptografada, embora a criptografia tenha sido solicitada."
          }
        }
      }
    },
