    "registered-and-saved": {
      "comment": "Console line after a registration succeeded and the password was saved. The argument is the account name.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Account “%@” is registered. The password is saved in your keychain and Glasstual signs in with SASL from now on."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A(z) „%@” fiók regisztrálva. A jelszó a kulcskarikádba került, és a Glasstual mostantól SASL-lel jelentkezik be."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Account „%@“ ist registriert. Das Passwort ist in deinem Schlüsselbund gesichert, und Glasstual meldet sich ab jetzt per SASL an."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La cuenta “%@” está registrada. La contraseña se guardó en tu llavero y Glasstual iniciará sesión con SASL a partir de ahora."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le compte « %@ » est enregistré. Le mot de passe est enregistré dans votre trousseau et Glasstual se connecte désormais avec SASL."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウント「%@」を登録しました。パスワードはキーチェーンに保存され、今後Glasstualは SASL でサインインします。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A conta “%@” está registrada. A senha foi salva nas suas chaves e o Glasstual passa a entrar com SASL."
          }
        }
      }
    },
    "registered-not-saved": {
      "comment": "Console line after a registration succeeded but the password could not be saved. The argument is the account name.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Account “%@” is registered, but the password could not be saved in your keychain."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A(z) „%@” fiók regisztrálva, de a jelszót nem sikerült a kulcskarikába menteni."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Account „%@“ ist registriert, aber das Passwort konnte nicht in deinem Schlüsselbund gesichert werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La cuenta “%@” está registrada, pero no se pudo guardar la contraseña en tu llavero."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le compte « %@ » est enregistré, mais le mot de passe n’a pas pu être enregistré dans votre trousseau."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウント「%@」を登録しましたが、パスワードをキーチェーンに保存できませんでした。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A conta “%@” está registrada, mas não foi possível salvar a senha nas suas chaves."
          }
        }
      }
    },
    "verified-without-password": {
      "comment": "Console line after /verify succeeded for an account registered earlier, with no password to save. The argument is the account name.",
      "extractionState": "manual",
      "localizations": {
