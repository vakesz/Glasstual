          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La cuenta “%@” está verificada. Añade su contraseña en Propiedades del servidor para iniciar sesión automáticamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le compte « %@ » est vérifié. Ajoutez son mot de passe dans les propriétés du serveur pour vous connecter automatiquement."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウント「%@」を確認しました。自動でサインインするには、サーバのプロパティでパスワードを追加してください。"
