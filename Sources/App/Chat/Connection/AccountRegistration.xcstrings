    "summary-before-connect": {
      "comment": "/register summary line: registration works before connecting completes.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "• You can register before connecting completes."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "• A kapcsolódás befejezése előtt is regisztrálhatsz."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "• Du kannst dich registrieren, bevor die Verbindung vollständig hergestellt ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "• Puedes registrarte antes de que termine la conexión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "• Vous pouvez vous enregistrer avant la fin de la connexion."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "• 接続が完了する前に登録できます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "• Você pode se registrar antes de a conexão terminar."
          }
        }
      }
    },
    "summary-usage": {
      "comment": "/register usage line. The command syntax stays untranslated.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To register, type /register <account | *> <email | *> <password>, or choose Server › Register Account…"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Regisztráláshoz írd be: /register <account | *> <email | *> <password>, vagy válaszd a Kiszolgáló › Fiók regisztrálása… menüpontot."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib zum Registrieren /register <account | *> <email | *> <password> ein oder wähle „Server“ › „Account registrieren…“."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para registrarte, escribe /register <account | *> <email | *> <password> o elige Servidor › Registrar cuenta…"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour vous enregistrer, tapez /register <account | *> <email | *> <password> ou choisissez Serveur › Enregistrer un compte…"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "登録するには /register <account | *> <email | *> <password> と入力するか、「サーバ」›「アカウントを登録…」を選択してください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para se registrar, digite /register <account | *> <email | *> <password> ou escolha Servidor › Registrar Conta…"
          }
        }
      }
    },
    "summary-after-connecting": {
      "comment": "What /register prints before Glasstual knows whether the server supports registration.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Glasstual learns whether this server supports account registration when it connects. Type /register <account | *> <email | *> <password> to connect and register."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Glasstual kapcsolódáskor tudja meg, hogy a szerver támogatja-e a fiókregisztrációt. Kapcsolódáshoz és regisztráláshoz írd be: /register <account | *> <email | *> <password>."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Glasstual erfährt beim Verbinden, ob dieser Server die Account-Registrierung unterstützt. Gib /register <account | *> <email | *> <password> ein, um zu verbinden und dich zu registrieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Glasstual sabrá al conectarse si este servidor admite el registro de cuentas. Escribe /register <account | *> <email | *> <password> para conectarte y registrarte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Glasstual apprend lors de la connexion si ce serveur prend en charge l’enregistrement de compte. Tapez /register <account | *> <email | *> <password> pour vous connecter et vous enregistrer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このサーバがアカウント登録に対応しているかは、Glasstualが接続したときにわかります。接続して登録するには /register <account | *> <email | *> <password> と入力してください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Glasstual descobre ao conectar se este servidor oferece suporte ao registro de contas. Digite /register <account | *> <email | *> <password> para conectar e se registrar."
          }
        }
      }
    },
    "password-prompt-title": {
      "comment": "Title of the question asking for the new account's password after /register with an account and email. %@ is the account name.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a password for %@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Passwort für %@ wählen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige una contraseña para %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez un mot de passe pour %@"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Válassz jelszót ehhez: %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ のパスワードを設定"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha uma senha para %@"
          }
        }
      }
    },
    "password-prompt-body": {
      "comment": "Explanation in the question asking for the new account's password. %@ is the server name.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The password is sent to %@ to register the account, and saved in your keychain once it succeeds. It is never shown in the conversation."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Passwort wird an %@ gesendet, um den Account zu registrieren, und nach Erfolg in deinem Schlüsselbund gesichert. Es wird nie in der Unterhaltung angezeigt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La contraseña se envía a %@ para registrar la cuenta y se guarda en tu llavero cuando lo consigue. Nunca se muestra en la conversación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le mot de passe est envoyé à %@ pour enregistrer le compte, puis enregistré dans votre trousseau en cas de réussite. Il n’apparaît jamais dans la conversation."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A jelszót a fiók regisztrálásához elküldi az app ide: %@, és siker esetén a kulcskarikádba menti. Soha nem jelenik meg a beszélgetésben."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パスワードはアカウント登録のために %@ に送信され、成功するとキーチェーンに保存されます。会話に表示されることはありません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A senha é enviada a %@ para registrar a conta e guardada nas suas chaves quando der certo. Ela nunca aparece na conversa."
          }
        }
      }
    },
