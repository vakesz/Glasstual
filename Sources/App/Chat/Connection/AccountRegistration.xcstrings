          }
        }
      }
    },
    "failure-withheld-unconfigured-host": {
      "comment": "Account registration failure: the password was withheld because the host is not one of the configured servers.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The password was not sent, because this connection went to a server that is not one of the network’s configured servers."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A jelszó nem lett elküldve, mert ez a kapcsolat olyan szerverhez vezet, amely nem tartozik a hálózat beállított szerverei közé."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Passwort wurde nicht gesendet, weil diese Verbindung zu einem Server führt, der nicht zu den konfigurierten Servern des Netzwerks gehört."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se envió la contraseña porque esta conexión se dirigió a un servidor que no es uno de los configurados para la red."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le mot de passe n’a pas été envoyé, car cette connexion mène à un serveur qui ne fait pas partie des serveurs configurés du réseau."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この接続はネットワークに設定されたサーバ以外に接続しているため、パスワードは送信されませんでした。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A senha não foi enviada porque esta conexão foi para um servidor que não está entre os servidores configurados da rede."
          }
        }
      }
    },
    "failure-withheld-unverified-certificate": {
      "comment": "Account registration failure: the password was withheld because nobody checked the certificate.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
