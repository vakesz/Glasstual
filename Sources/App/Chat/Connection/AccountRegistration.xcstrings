{
  "sourceLanguage": "en",
  "strings": {
    "failure-account-exists": {
      "comment": "Account registration failure: the server already has an account with that name.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An account with that name already exists."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Már létezik ilyen nevű fiók."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Account mit diesem Namen existiert bereits."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya existe una cuenta con ese nombre."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un compte portant ce nom existe déjà."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "その名前のアカウントはすでに存在します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Já existe uma conta com esse nome."
          }
        }
      }
    },
    "failure-bad-account-name": {
      "comment": "Account registration failure: the server refuses the account name.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server doesn’t accept that account name."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A szerver nem fogadja el ezt a fióknevet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server akzeptiert diesen Account-Namen nicht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor no acepta ese nombre de cuenta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur n’accepte pas ce nom de compte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバはそのアカウント名を受け付けません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O servidor não aceita esse nome de conta."
          }
        }
      }
    },
    "failure-account-name-must-be-nickname": {
      "comment": "Account registration failure: the account must be named after the nickname.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This server requires the account name to match your nickname."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez a szerver megköveteli, hogy a fióknév megegyezzen a beceneveddel."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Server verlangt, dass der Account-Name deinem Nickname entspricht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este servidor exige que el nombre de cuenta coincida con tu apodo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce serveur exige que le nom du compte corresponde à votre pseudo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このサーバでは、アカウント名をニックネームと同じにする必要があります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este servidor exige que o nome da conta seja igual ao seu apelido."
          }
        }
      }
    },
    "failure-needs-nickname": {
      "comment": "Account registration failure: the server wants a nickname first.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server needs a nickname before an account can be registered."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A szervernek becenévre van szüksége a fiók regisztrálása előtt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server braucht einen Nickname, bevor ein Account registriert werden kann."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor necesita un apodo antes de poder registrar una cuenta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur a besoin d’un pseudo avant de pouvoir enregistrer un compte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウントを登録する前に、サーバにニックネームを設定する必要があります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O servidor precisa de um apelido antes de registrar uma conta."
          }
        }
      }
    },
    "failure-already-authenticated": {
      "comment": "Account registration failure or unavailability: the connection is already signed in to an account.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You’re already signed in to an account on this server."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Már be vagy jelentkezve egy fiókba ezen a szerveren."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du bist auf diesem Server bereits bei einem Account angemeldet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya has iniciado sesión con una cuenta en este servidor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous êtes déjà connecté à un compte sur ce serveur."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このサーバではすでにアカウントにサインインしています。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você já está conectado a uma conta neste servidor."
          }
        }
      }
    },
    "failure-weak-password": {
      "comment": "Account registration failure: the server considers the password too weak.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server says the password is too weak. Choose a stronger one."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A szerver szerint a jelszó túl gyenge. Válassz erősebbet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Laut Server ist das Passwort zu schwach. Wähle ein sichereres."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor indica que la contraseña es demasiado débil. Elige una más segura."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur indique que le mot de passe est trop faible. Choisissez-en un plus robuste."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバによると、パスワードが弱すぎます。より強力なパスワードを選択してください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O servidor informa que a senha é fraca demais. Escolha uma mais forte."
          }
        }
      }
    },
    "failure-unacceptable-password": {
      "comment": "Account registration failure: the server refuses the password.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server doesn’t accept that password."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A szerver nem fogadja el ezt a jelszót."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server akzeptiert dieses Passwort nicht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor no acepta esa contraseña."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur n’accepte pas ce mot de passe."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバはそのパスワードを受け付けません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O servidor não aceita essa senha."
          }
        }
      }
    },
    "failure-invalid-email": {
      "comment": "Account registration failure: the server says the email address is malformed.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server says the email address is not valid."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A szerver szerint az e-mail-cím érvénytelen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Laut Server ist die E-Mail-Adresse ungültig."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor indica que la dirección de correo no es válida."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur indique que l’adresse e-mail n’est pas valide."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバによると、メールアドレスが有効ではありません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O servidor informa que o endereço de e-mail não é válido."
          }
        }
      }
    },
    "failure-unacceptable-email": {
      "comment": "Account registration failure: the server refuses the email address.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server doesn’t accept that email address."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A szerver nem fogadja el ezt az e-mail-címet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server akzeptiert diese E-Mail-Adresse nicht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor no acepta esa dirección de correo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur n’accepte pas cette adresse e-mail."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバはそのメールアドレスを受け付けません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O servidor não aceita esse endereço de e-mail."
          }
        }
      }
    },
    "failure-complete-connection-required": {
      "comment": "Account registration failure: the server wants the connection to finish first.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server asks you to finish connecting before registering. Try again."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A szerver azt kéri, hogy a regisztráció előtt fejeződjön be a kapcsolódás. Próbáld újra."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server verlangt, dass die Verbindung vor der Registrierung abgeschlossen wird. Versuche es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor pide que termine la conexión antes de registrarte. Inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur demande de terminer la connexion avant l’enregistrement. Réessayez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバは登録の前に接続を完了するよう求めています。もう一度お試しください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O servidor pede que a conexão termine antes do registro. Tente novamente."
          }
        }
      }
    },
    "failure-invalid-code": {
      "comment": "Account registration failure: the verification code is wrong.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The verification code is not correct."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az ellenőrző kód nem helyes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Bestätigungscode ist nicht korrekt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El código de verificación no es correcto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le code de vérification est incorrect."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "確認コードが正しくありません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O código de verificação não está correto."
          }
        }
      }
    },
    "failure-temporarily-unavailable": {
      "comment": "Account registration failure: registration is temporarily unavailable.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Account registration is temporarily unavailable on this server. Try again later."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A fiókregisztráció átmenetileg nem érhető el ezen a szerveren. Próbáld újra később."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Account-Registrierung ist auf diesem Server vorübergehend nicht verfügbar. Versuche es später erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El registro de cuentas no está disponible temporalmente en este servidor. Inténtalo más tarde."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’enregistrement de compte est temporairement indisponible sur ce serveur. Réessayez plus tard."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このサーバではアカウント登録が一時的に利用できません。しばらくしてからもう一度お試しください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O registro de contas está temporariamente indisponível neste servidor. Tente novamente mais tarde."
          }
        }
      }
    },
    "failure-account-required": {
      "comment": "Account registration failure: the server only admits signed-in users.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This server only accepts users who are signed in to an account. If an account is still waiting for its code, connect again and use /verify to finish it."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez a szerver csak fiókba bejelentkezett felhasználókat enged be. Ha egy fiók még a kódjára vár, kapcsolódj újra, és fejezd be a /verify paranccsal."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Server akzeptiert nur Benutzer, die bei einem Account angemeldet sind. Wartet ein Account noch auf seinen Code, verbinde dich erneut und schließe ihn mit /verify ab."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este servidor solo acepta usuarios que han iniciado sesión con una cuenta. Si una cuenta aún espera su código, vuelve a conectarte y usa /verify para completarla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce serveur n’accepte que les utilisateurs connectés à un compte. Si un compte attend encore son code, reconnectez-vous et utilisez /verify pour le finaliser."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このサーバはアカウントにサインインしたユーザのみを受け付けます。コード待ちのアカウントがある場合は、再接続して /verify で完了してください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este servidor aceita apenas usuários conectados a uma conta. Se uma conta ainda estiver aguardando o código, conecte-se novamente e use /verify para concluí-la."
          }
        }
      }
    },
    "failure-already-in-progress": {
      "comment": "Account registration failure or unavailability: another registration is running on this connection.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An account registration is already in progress."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Már folyamatban van egy fiókregisztráció."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Account-Registrierung läuft bereits."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya hay un registro de cuenta en curso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un enregistrement de compte est déjà en cours."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウント登録はすでに進行中です。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Já há um registro de conta em andamento."
          }
        }
      }
    },
    "failure-other": {
      "comment": "Account registration failure with a reply code Glasstual does not know. The argument is the server's code, such as SOME_CODE.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server refused the registration (%@)."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A szerver elutasította a regisztrációt (%@)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server hat die Registrierung abgelehnt (%@)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor rechazó el registro (%@)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur a refusé l’enregistrement (%@)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバが登録を拒否しました（%@）。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O servidor recusou o registro (%@)."
          }
        }
      }
    },
    "failure-unsupported": {
      "comment": "Account registration failure or unavailability: the server does not support registration.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This server doesn’t support account registration."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez a szerver nem támogatja a fiókregisztrációt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Server unterstützt keine Account-Registrierung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este servidor no admite el registro de cuentas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce serveur ne prend pas en charge l’enregistrement de compte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このサーバはアカウント登録に対応していません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este servidor não oferece suporte ao registro de contas."
          }
        }
      }
    },
    "failure-not-connected": {
      "comment": "Account registration failure: the session is not connected.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect to the server to register an account."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Fiók regisztrálásához kapcsolódj a szerverhez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbinde dich mit dem Server, um einen Account zu registrieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conéctate al servidor para registrar una cuenta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez-vous au serveur pour enregistrer un compte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウントを登録するには、サーバに接続してください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conecte-se ao servidor para registrar uma conta."
          }
        }
      }
    },
    "failure-timed-out": {
      "comment": "Account registration failure: the server never answered.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server didn’t answer the registration request."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A szerver nem válaszolt a regisztrációs kérésre."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server hat auf die Registrierungsanfrage nicht geantwortet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor no respondió a la solicitud de registro."
          }
        },
