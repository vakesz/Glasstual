    "failure-withheld-plaintext": {
      "comment": "Account registration failure: the password was withheld from an unencrypted connection that should have been encrypted.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The password was not sent, because the connection is not encrypted although encryption was requested."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A jelszó nem lett elküldve, mert a kapcsolat nincs titkosítva, pedig titkosítást kértél."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
