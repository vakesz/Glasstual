    "account-required-hint": {
      "comment": "Console hint printed when the server requires an account, naming the menu item and the command that register one.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This server requires an account. Choose Server › Register Account… or type /register to create one."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez a szerver fiókot követel meg. Válaszd a Kiszolgáló › Fiók regisztrálása… menüpontot, vagy írd be a /register parancsot."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Server verlangt einen Account. Wähle „Server“ › „Account registrieren…“ oder gib /register ein, um einen zu erstellen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este servidor requiere una cuenta. Elige Servidor › Registrar cuenta… o escribe /register para crear una."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce serveur exige un compte. Choisissez Serveur › Enregistrer un compte… ou tapez /register pour en créer un."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このサーバではアカウントが必要です。「サーバ」›「アカウントを登録…」を選択するか、/register と入力して作成してください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este servidor exige uma conta. Escolha Servidor › Registrar Conta… ou digite /register para criar uma."
          }
        }
      }
    },
    "verification-required": {
      "comment": "Console line when the server asks to verify an account no registration of this session asked for. The arguments are the account and the server's message.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Account “%1$@” needs verification: %2$@"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A(z) „%1$@” fiókot meg kell erősíteni: %2$@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Account „%1$@“ muss bestätigt werden: %2$@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La cuenta “%1$@” necesita verificación: %2$@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le compte « %1$@ » doit être vérifié : %2$@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウント「%1$@」の確認が必要です：%2$@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A conta “%1$@” precisa de verificação: %2$@"
          }
        }
      }
    },
    "verification-required-command-hint": {
      "comment": "Console hint after the server sent a verification code. The argument is the account name; <code> stays untranslated as command syntax.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check your email, then enter the code with /verify %@ <code>."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nézd meg az e-mailjeidet, majd add meg a kódot így: /verify %@ <code>."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sieh in deinen E-Mails nach und gib den Code dann mit /verify %@ <code> ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Revisa tu correo y luego introduce el código con /verify %@ <code>."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Consultez vos e-mails, puis saisissez le code avec /verify %@ <code>."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メールを確認し、/verify %@ <code> でコードを入力してください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifique seu e-mail e digite o código com /verify %@ <code>."
          }
        }
      }
    },
