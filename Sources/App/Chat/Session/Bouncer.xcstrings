{
  "sourceLanguage" : "en",
  "strings" : {
    "certificate-conversion-error" : {
      "comment" : "Error shown when ZNC certificate information cannot be converted for display. Migrated from legacy key wco-zv.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "An error occurred while converting certificate information to a friendlier format"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hiba történt a tanúsítványadatok olvashatóbb formátumba alakításakor"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beim Umwandeln der Zertifikatsinformationen in ein lesbareres Format ist ein Fehler aufgetreten"
          }
        }
      }
    },
    "close-button" : {
      "comment" : "Title of the button that closes the certificate information panel.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Close"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bezárás"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schließen"
          }
        }
      }
    },
    "detach-confirmation" : {
      "comment" : "Confirmation shown after detaching a channel. The argument is the channel name. Migrated from legacy key 0fr-kb.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The \u0002detach\u0002 command has been sent for the channel \u0002%@\u0002. Automatic join on connect for this channel has been disabled as well. Use the command \u0002attach\u0002 at any time to be returned to this channel and have automatic join turned back on."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A \u0002detach\u0002 parancs elküldve a(z) \u0002%@\u0002 csatornához. A csatornához való automatikus csatlakozás is ki lett kapcsolva. Az \u0002attach\u0002 paranccsal bármikor visszatérhetsz, és újra bekapcsolhatod az automatikus csatlakozást."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Befehl \u0002detach\u0002 wurde für den Kanal \u0002%@\u0002 gesendet. Der automatische Beitritt beim Verbinden wurde ebenfalls deaktiviert. Mit \u0002attach\u0002 kannst du jederzeit zurückkehren und den automatischen Beitritt wieder aktivieren."
          }
        }
      }
    },
    "no-information-available" : {
      "comment" : "Message shown when ZNC has no certificate information. Migrated from legacy key moh-hg.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No information is available"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nincs elérhető információ"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keine Informationen verfügbar"
          }
        }
      }
    },
    "znc-connection-required" : {
      "comment" : "Message shown when a ZNC-only command is used on another server. Migrated from legacy key xex-nl.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This command is not available because you aren't connected to ZNC"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ez a parancs nem érhető el, mert nem ZNC-hez kapcsolódsz"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Befehl ist nicht verfügbar, da du nicht mit ZNC verbunden bist"
          }
        }
      }
    }
  },
  "version" : "1.0"
}
