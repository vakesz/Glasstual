    "detach-confirmation" : {
      "comment" : "Confirmation shown after detaching a channel. The argument is the channel name. Migrated from legacy key 0fr-kb.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The \u0002detach\u0002 command has been sent for the channel \u0002%@\u0002. Automatic join on connect for this channel has been disabled as well. Use the command \u0002attach\u0002 at any time to be returned to this channel and have automatic join turned back on."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A \u0002detach\u0002 parancs elküldve a(z) \u0002%@\u0002 csatornához. A csatornához való automatikus csatlakozás is ki lett kapcsolva. Az \u0002attach\u0002 paranccsal bármikor visszatérhetsz, és újra bekapcsolhatod az automatikus csatlakozást."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Befehl \u0002detach\u0002 wurde für den Kanal \u0002%@\u0002 gesendet. Der automatische Beitritt beim Verbinden wurde ebenfalls deaktiviert. Mit \u0002attach\u0002 kannst du jederzeit zurückkehren und den automatischen Beitritt wieder aktivieren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "El \u0002Desatacar\u0002 Se ha enviado el comando para el canal \u0002%@\u0002. La conexión automática al conectarse a este canal también ha sido desactivada. Use el comando \u0002Adjuntar\u0002 en cualquier momento para ser devuelto a este canal y tener la incorporación automática desactivada nuevamente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Le \u0002détacher\u0002 La commande a été envoyée pour le canal \u0002%@\u0002.  L'adhésion automatique lors de la connexion à cette chaîne a également été désactivée. Utilisez la commande \u0002attacher\u0002 à tout moment pour être retourné sur cette chaîne et avoir le rattachement automatique réactivé."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "それ \u0002取り外す\u0002 チャンネルに対してコマンドが送信されました。 \u0002%@\u0002このチャンネルの接続時の自動参加も無効になっています。コマンドを使用してください。 \u0002添付する\u0002 いつでもこのチャンネルに戻し、自動参加を再度有効にすることができます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "O \u0002separar\u0002 comando foi enviado para o canal \u0002%@\u0002. A adesão automática ao conectar para este canal também foi desativada. Use o comando \u0002anexar\u0002 a qualquer momento para ser devolvido a este canal e ter a inscrição automática reativada."
          }
        }
      }
    },
