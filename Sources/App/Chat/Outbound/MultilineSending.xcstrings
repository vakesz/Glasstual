{
  "sourceLanguage": "en",
  "strings": {
    "choice-body": {
      "comment": "Body of the choice alert for pasted text. The placeholder is the number of lines, always two or more.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The text has %lld lines. The server can deliver it as one multi-line message, or it can be sent as separate messages, one for each line."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A szöveg %lld sorból áll. A kiszolgáló egyetlen többsoros üzenetként kézbesítheti, vagy soronként külön üzenetben is elküldheted."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Text hat %lld Zeilen. Der Server kann ihn als eine mehrzeilige Nachricht zustellen, oder er kann zeilenweise als einzelne Nachrichten gesendet werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El texto tiene %lld líneas. El servidor puede entregarlo como un único mensaje de varias líneas, o se puede enviar como mensajes separados, uno por línea."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le texte compte %lld lignes. Le serveur peut le remettre en un seul message multiligne, ou il peut être envoyé en messages séparés, un par ligne."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テキストは%lld行あります。サーバは、複数行の1件のメッセージとして配信できます。または、1行ごとに個別のメッセージとして送信することもできます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O texto tem %lld linhas. O servidor pode entregá-lo como uma única mensagem de várias linhas, ou ele pode ser enviado em mensagens separadas, uma por linha."
          }
        }
      }
    },
    "choice-title": {
      "comment": "Title of the choice shown before pasted text is sent that the server can deliver as one multi-line message.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Send this text as one message?"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egyetlen üzenetként küldöd el ezt a szöveget?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diesen Text als eine Nachricht senden?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Enviar este texto como un solo mensaje?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Envoyer ce texte en un seul message ?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このテキストを1つのメッセージとして送信しますか？"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Enviar este texto como uma única mensagem?"
          }
        }
      }
    },
    "send-as-one-button": {
      "comment": "Button that sends pasted text as one message.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Send as One Message"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Küldés egy üzenetként"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Als eine Nachricht senden"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Enviar como un solo mensaje"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Envoyer en un seul message"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1つのメッセージとして送信"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Enviar como uma só mensagem"
          }
        }
      }
    },
    "send-line-by-line-button": {
      "comment": "Button that sends pasted text line by line, one message for each line.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Send Line by Line"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Küldés soronként"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeilenweise senden"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Enviar línea por línea"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Envoyer ligne par ligne"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1行ずつ送信"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Enviar linha por linha"
          }
        }
      }
    },
    "truncate-and-send-button": {
      "comment": "Button to truncate pasted text and send the first part as one message.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Send First Part"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Első rész küldése"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ersten Teil senden"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Enviar la primera parte"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Envoyer la première partie"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最初の部分を送信"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Enviar a primeira parte"
          }
        }
      }
    },
    "truncated-bytes-body": {
      "comment": "Body of the alert when pasted text would be truncated because it is too large. The placeholder is the most bytes the server accepts.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server accepts at most %lld bytes in a multi-line message, and this text is larger. You can send only the first part as one message, send every line separately, or cancel."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A kiszolgáló legfeljebb %lld bájtot fogad el egy többsoros üzenetben, ez a szöveg viszont nagyobb. Elküldheted csak az első részt egy üzenetként, minden sort külön elküldhetsz, vagy megszakíthatod."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server akzeptiert in einer mehrzeiligen Nachricht höchstens %lld Byte, dieser Text ist jedoch größer. Du kannst nur den ersten Teil als eine Nachricht senden, jede Zeile einzeln senden oder abbrechen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor acepta como máximo %lld bytes en un mensaje de varias líneas, y este texto es mayor. Puedes enviar solo la primera parte como un mensaje, enviar cada línea por separado o cancelar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur accepte au plus %lld octets dans un message multiligne, et ce texte est plus volumineux. Vous pouvez n’envoyer que la première partie en un message, envoyer chaque ligne séparément ou annuler."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバは複数行メッセージで最大%lldバイトまで受け付けますが、このテキストはそれを超えています。最初の部分だけを1つのメッセージとして送信するか、各行を個別に送信するか、キャンセルできます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O servidor aceita no máximo %lld bytes em uma mensagem de várias linhas, e este texto é maior. Você pode enviar somente a primeira parte como uma mensagem, enviar cada linha separadamente ou cancelar."
          }
        }
      }
    },
    "truncated-lines-body": {
      "comment": "Body of the alert when pasted text would be truncated because it has too many lines. The placeholder is the most lines the server accepts.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server accepts at most %lld lines in a multi-line message, and this text has more. You can send only the first part as one message, send every line separately, or cancel."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A kiszolgáló legfeljebb %lld sort fogad el egy többsoros üzenetben, ez a szöveg viszont több sorból áll. Elküldheted csak az első részt egy üzenetként, minden sort külön elküldhetsz, vagy megszakíthatod."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server akzeptiert in einer mehrzeiligen Nachricht höchstens %lld Zeilen, dieser Text hat jedoch mehr. Du kannst nur den ersten Teil als eine Nachricht senden, jede Zeile einzeln senden oder abbrechen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor acepta como máximo %lld líneas en un mensaje de varias líneas, y este texto tiene más. Puedes enviar solo la primera parte como un mensaje, enviar cada línea por separado o cancelar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur accepte au plus %lld lignes dans un message multiligne, et ce texte en compte davantage. Vous pouvez n’envoyer que la première partie en un message, envoyer chaque ligne séparément ou annuler."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバは複数行メッセージで最大%lld行まで受け付けますが、このテキストはそれより多くの行があります。最初の部分だけを1つのメッセージとして送信するか、各行を個別に送信するか、キャンセルできます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O servidor aceita no máximo %lld linhas em uma mensagem de várias linhas, e este texto tem mais. Você pode enviar somente a primeira parte como uma mensagem, enviar cada linha separadamente ou cancelar."
          }
        }
      }
    },
    "truncated-title": {
      "comment": "Title of the alert shown when pasted text is too long for one message and would have to be truncated.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This text is too long for one message"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez a szöveg túl hosszú egyetlen üzenethez"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Text ist für eine Nachricht zu lang"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este texto es demasiado largo para un mensaje"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce texte est trop long pour un seul message"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このテキストは1つのメッセージには長すぎます"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este texto é longo demais para uma mensagem"
          }
        }
      }
    }
  },
  "version": "1.0"
}
