    "certificate-for-this-server-is-invalid": {
      "comment": "Legacy key: 85z-qw.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The certificate for this server is invalid. You might be connecting to a server that is pretending to be “%@”, which could put your confidential information at risk. Would you like to connect to the server anyway?"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A kiszolgáló tanúsítványa érvénytelen. Lehet, hogy egy olyan kiszolgálóhoz kapcsolódsz, amely \"%@\" néven adja ki magát, és veszélyeztetheti a bizalmas adataidat. Ennek ellenére is csatlakozni szeretnél?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Zertifikat dieses Servers ist ungültig. Möglicherweise verbindest du dich mit einem Server, der sich als \"%@\" ausgibt und deine vertraulichen Daten gefährdet. Möchtest du dich trotzdem verbinden?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "El certificado de este servidor es inválido. Es posible que esté conectándose a un servidor que está haciéndose pasar por “%@”, lo que podría poner en riesgo su información confidencial. ¿Desea conectarse al servidor de todos modos?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le certificat pour ce serveur est invalide. Vous pourriez vous connecter à un serveur qui se fait passer pour « %@ », ce qui pourrait mettre vos informations confidentielles en danger. Souhaitez-vous quand même vous connecter au serveur ?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "このサーバーの証明書は無効です。「%@」を装っているサーバーに接続している可能性があります。これにより、機密情報がリスクにさらされる可能性があります。それでもサーバーに接続しますか？"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O certificado para este servidor é inválido. Você pode estar se conectando a um servidor que está se passando por “%@”, o que poderia colocar suas informações confidenciais em risco. Você gostaria de se conectar ao servidor de qualquer forma?"
          }
        }
      }
    },
    "certificate-was-not-trusted": {
      "comment": "Legacy key: k3t-vq.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\nThe certificate was not trusted by the system: %@"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\nA rendszer nem bízik meg a tanúsítványban: %@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\nDas System vertraut dem Zertifikat nicht: %@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "\n\nEl certificado no fue confiado por el sistema: %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "\n\nLe certificat n'a pas été crédité par le système : %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "\n\nシステムは証明書を信頼していませんでした：%@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "\n\nO certificado não foi confiado pelo sistema: %@"
          }
        }
      }
    },
