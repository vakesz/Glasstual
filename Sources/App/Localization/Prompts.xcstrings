        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toutes les données associées à cette conversation privée, à l’exception des journaux, seront effacées. Cette action est irréversible."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
