    "could-not-open-saved-conversation-history": {
      "comment": "Title of the alert shown when the saved conversation history could not be opened. Legacy key: h99-3q.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Glasstual could not open your saved conversation history. Please report this problem at https://github.com/vakesz/Glasstual/issues"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Glasstual nem tudta megnyitni a mentett beszélgetési előzményeket. Jelentsd a hibát itt: https://github.com/vakesz/Glasstual/issues"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Glasstual konnte deinen gespeicherten Gesprächsverlauf nicht öffnen. Bitte melde das Problem unter https://github.com/vakesz/Glasstual/issues"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Glasstual no pudo abrir tu historial de conversaciones guardado. Informa de este problema en https://github.com/vakesz/Glasstual/issues"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Glasstual n’a pas pu ouvrir l’historique de vos conversations enregistrées. Signalez ce problème sur https://github.com/vakesz/Glasstual/issues"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Glasstualは保存済みの会話履歴を開けませんでした。この問題は https://github.com/vakesz/Glasstual/issues で報告してください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Glasstual não conseguiu abrir seu histórico de conversas salvo. Informe este problema em https://github.com/vakesz/Glasstual/issues"
          }
        }
      }
    },
