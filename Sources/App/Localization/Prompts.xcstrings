            "value": "「%1$@」に接続し、次のチャンネルに参加するリンクをクリックしました: %2$@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você clicou em um link que vai conectá-lo a “%1$@” e entrar nos canais: %2$@"
