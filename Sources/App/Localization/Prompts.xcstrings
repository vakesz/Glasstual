    "wants-to-start-a-direct-chat": {
      "comment": "Direct chat (DCC CHAT) request. Legacy key: dcc-c2.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ wants to start a direct chat with you. A direct chat is a connection between the two of you that does not go through the IRC server, so the other person will learn your IP address."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ közvetlen csevegést szeretne indítani veled. Ez közvetlen kapcsolat kettőtök között, amely nem az IRC-kiszolgálón keresztül zajlik, így a másik fél megismeri az IP-címedet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ möchte einen direkten Chat mit dir starten. Dabei entsteht eine direkte Verbindung zwischen euch, die nicht über den IRC-Server läuft. Die andere Person erfährt dadurch deine IP-Adresse."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ quiere iniciar un chat directo contigo. Un chat directo es una conexión entre los dos que no pasa por el servidor IRC, por lo que la otra persona conocerá tu dirección IP."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ souhaite démarrer une discussion directe avec vous. Une discussion directe est une connexion entre vous deux qui ne passe pas par le serveur IRC ; l’autre personne connaîtra donc votre adresse IP."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@があなたとダイレクトチャットを開始しようとしています。ダイレクトチャットは、IRCサーバを経由せず、あなたと相手との間で直接行う接続のため、相手にあなたのIPアドレスが知られます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ quer iniciar um chat direto com você. Um chat direto é uma conexão entre vocês dois que não passa pelo servidor IRC, portanto a outra pessoa saberá seu endereço IP."
          }
        }
      }
    },
