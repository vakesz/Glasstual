    "your-current-preferences-could-not-be-backed-up": {
      "comment": "Reason shown when the backup taken before an import could not be written.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your current settings could not be backed up, so nothing was changed."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nem sikerült biztonsági mentést készíteni a jelenlegi beállításokról, ezért semmi sem változott."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine aktuellen Einstellungen konnten nicht gesichert werden. Daher wurde nichts geändert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo hacer una copia de seguridad de los ajustes actuales, por lo que no se ha cambiado nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de sauvegarder vos réglages actuels, donc rien n’a été modifié."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在の設定をバックアップできなかったため、何も変更されませんでした。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível fazer backup dos seus ajustes atuais, então nada foi alterado."
          }
        }
      }
    },
    "keychain-quit-save-failed-body": {
      "comment": "Explanation during app termination after a password save or deletion failed. The user can retry or explicitly quit with these changes unsaved.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some password changes have not been saved. Try again before quitting, or quit without saving these changes."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Néhány jelszómódosítás nem lett elmentve. Próbáld újra kilépés előtt, vagy lépj ki ezek mentése nélkül."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einige Passwortänderungen wurden nicht gesichert. Versuche es vor dem Beenden erneut oder beende die App ohne diese Änderungen zu sichern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Algunos cambios de contraseña no se han guardado. Inténtalo de nuevo antes de salir o sal sin guardar estos cambios."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Certaines modifications de mot de passe n’ont pas été enregistrées. Réessayez avant de quitter, ou quittez sans enregistrer ces modifications."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一部のパスワードの変更が保存されていません。終了する前にもう一度お試しください。または、これらの変更を保存せずに終了することもできます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Algumas alterações de senha não foram salvas. Tente novamente antes de sair ou saia sem salvar essas alterações."
          }
        }
      }
    },
    "keychain-quit-without-saving": {
      "comment": "Explicit action to finish quitting even though password changes could not be saved.",
