    "moderation-kick-body": {
      "comment": "Body of the moderation kick confirmation sheet.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "They are removed from the channel and can join again."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A csatornáról kikerülnek, de újra csatlakozhatnak."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie werden aus dem Kanal entfernt und können erneut beitreten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se les expulsa del canal y pueden volver a unirse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ils sont retirés du canal et peuvent le rejoindre à nouveau."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "チャンネルから追い出されますが、再度参加できます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Eles são removidos do canal, mas podem entrar novamente."
          }
        }
      }
    },
    "moderation-ban-body": {
      "comment": "Body of the moderation ban confirmation sheet.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "They cannot join the channel again until the ban is removed."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nem csatlakozhatnak újra a csatornához, amíg a kitiltást fel nem oldják."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie können dem Kanal erst wieder beitreten, wenn der Bann aufgehoben wird."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No podrán volver a unirse al canal hasta que se quite el bloqueo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ils ne peuvent pas rejoindre le canal tant que le bannissement n’est pas levé."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "BANが解除されるまで、チャンネルに再度参加できません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Eles não poderão entrar no canal novamente até que o banimento seja removido."
          }
        }
      }
    },
