    "keychain-quit-save-failed-body": {
      "comment": "Explanation during app termination after a password save or deletion failed. The user can retry or explicitly quit with these changes unsaved.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some password changes have not been saved. Try again before quitting, or quit without saving these changes."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Néhány jelszómódosítás nem lett elmentve. Próbáld újra kilépés előtt, vagy lépj ki ezek mentése nélkül."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einige Passwortänderungen wurden nicht gesichert. Versuche es vor dem Beenden erneut oder beende die App ohne diese Änderungen zu sichern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Algunos cambios de contraseña no se han guardado. Inténtalo de nuevo antes de salir, o sal sin guardar estos cambios."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Certaines modifications de mot de passe n'ont pas été enregistrées. Réessayez avant de quitter, ou quittez sans enregistrer ces modifications."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "パスワードの変更がいくつか保存されませんでした。終了する前にもう一度試してください。または、これらの変更を保存せずに終了してください。"
          }
        },
