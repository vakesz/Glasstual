    "encryption-with-a-digital-certificate-keeps-information": {
      "comment": "Legacy key: iun-45.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Encryption with a digital certificate keeps information private as it’s sent to or from the server “%1$@”\n\nInformation encrypted using: %2$@"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A digitális tanúsítvánnyal végzett titkosítás megvédi a(z) \"%1$@\" kiszolgálóval váltott adatokat\n\nAz adatok titkosítása: %2$@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Verschlüsselung mit einem digitalen Zertifikat schützt die Daten beim Austausch mit dem Server \"%1$@\"\n\nVerwendete Verschlüsselung: %2$@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El cifrado con un certificado digital mantiene la información privada mientras se envía hacia o desde el servidor «%1$@»\n\nInformación cifrada con: %2$@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le chiffrement par certificat numérique préserve la confidentialité des informations envoyées au serveur « %1$@ » ou reçues de celui-ci\n\nInformations chiffrées avec : %2$@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デジタル証明書による暗号化により、サーバ「%1$@」との間で送受信される情報の機密性が保たれます\n\n情報の暗号化に使用: %2$@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A criptografia com um certificado digital mantém as informações privadas quando enviadas para o servidor “%1$@” ou recebidas dele\n\nInformações criptografadas usando: %2$@"
          }
        }
      }
    },
    "generic-acknowledgement-button-title-ok": {
