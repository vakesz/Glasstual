{
  "sourceLanguage": "en",
  "strings": {
    "action-title-for-accepting-accept": {
      "comment": "Action title for accepting an incoming file transfer or direct chat (DCC CHAT) request. Consolidates the identical legacy dcc-c4 entry. Legacy key: qpv-go.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Accept"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Elfogadás"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Annehmen"
          }
        }
      }
    },
    "are-you-sure-you-want-to-open-the-file-named": {
      "comment": "Legacy key: xfl-8e.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Are you sure you want to open the file named “%@” with Glasstual?"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Biztosan megnyitod a(z) \"%@\" fájlt a Glasstuallal?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Möchtest du die Datei \"%@\" wirklich mit Glasstual öffnen?"
          }
        }
      }
    },
    "are-you-sure-you-want-to-quit-glasstual": {
      "comment": "Legacy key: 6vj-2p.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Are you sure you want to quit Glasstual?"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Biztosan kilépsz a Glasstualból?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Möchtest du Glasstual wirklich beenden?"
          }
        }
      }
    },
    "cancel": {
      "comment": "Legacy key: qso-2g.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Mégse"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abbrechen"
          }
        }
      }
    },
    "certificate-for-this-server-is-invalid": {
      "comment": "Legacy key: 85z-qw.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The certificate for this server is invalid. You might be connecting to a server that is pretending to be “%@”, which could put your confidential information at risk. Would you like to connect to the server anyway?"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A kiszolgáló tanúsítványa érvénytelen. Lehet, hogy egy olyan kiszolgálóhoz kapcsolódsz, amely \"%@\" néven másnak adja ki magát, és veszélyeztetheti a bizalmas adataidat. Ennek ellenére kapcsolódsz?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Zertifikat dieses Servers ist ungültig. Möglicherweise verbindest du dich mit einem Server, der sich als \"%@\" ausgibt und deine vertraulichen Daten gefährdet. Möchtest du dich trotzdem verbinden?"
          }
        }
      }
    },
    "certificate-was-not-trusted": {
      "comment": "Legacy key: k3t-vq.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\nThe certificate was not trusted by the system: %@"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\nA rendszer nem bízik meg a tanúsítványban: %@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\nDas System vertraut dem Zertifikat nicht: %@"
          }
        }
      }
    },
    "choose-file": {
      "comment": "Legacy key: 502-6h.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose File"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Fájl kiválasztása"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Datei auswählen"
          }
        }
      }
    },
    "close": {
      "comment": "Legacy key: aqw-q1.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Bezárás"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schließen"
          }
        }
      }
    },
    "connection-named-is-already-configured": {
      "comment": "Legacy key: a9z-9f.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The connection named “%1$@” is already configured to connect to this server address.\n\nDo you want to add these channels to that connection or would you rather create a new connection?"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A(z) \"%1$@\" kapcsolat már ehhez a kiszolgálócímhez van beállítva.\n\nEhhez a kapcsolathoz adod hozzá ezeket a csatornákat, vagy új kapcsolatot hozol létre?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Verbindung \"%1$@\" ist bereits für diese Serveradresse eingerichtet.\n\nMöchtest du diese Kanäle zu dieser Verbindung hinzufügen oder eine neue Verbindung erstellen?"
          }
        }
      }
    },
    "connection-named-is-already-configured-to-connect-to": {
      "comment": "Legacy key: mx1-qz.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The connection named “%1$@” is already configured to connect to this server address.\n\nDo you want to add this channel to that connection or would you rather create a new connection?"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A(z) \"%1$@\" kapcsolat már ehhez a kiszolgálócímhez van beállítva.\n\nEhhez a kapcsolathoz adod hozzá ezt a csatornát, vagy új kapcsolatot hozol létre?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Verbindung \"%1$@\" ist bereits für diese Serveradresse eingerichtet.\n\nMöchtest du diesen Kanal zu dieser Verbindung hinzufügen oder eine neue Verbindung erstellen?"
          }
        }
      }
    },
    "continue": {
      "comment": "Legacy key: zjw-bd.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Continue"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Folytatás"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fortfahren"
          }
        }
      }
    },
    "could-not-open-saved-conversation-history": {
      "comment": "Title of the alert shown when the saved conversation history could not be opened. Legacy key: h99-3q.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Glasstual could not open your saved conversation history. Please report this problem at https://github.com/vakesz/Glasstual/issues"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Glasstual nem tudta megnyitni a mentett beszélgetési előzményeket. Jelentsd a hibát itt: https://github.com/vakesz/Glasstual/issues"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Glasstual konnte deinen gespeicherten Gesprächsverlauf nicht öffnen. Bitte melde das Problem unter https://github.com/vakesz/Glasstual/issues"
          }
        }
      }
    },
    "create-new-connection": {
      "comment": "Action title for creating a new connection. Consolidates the identical legacy sv9-8s entry. Legacy key: xca-5h.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create New Connection"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Új kapcsolat létrehozása"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Neue Verbindung erstellen"
          }
        }
      }
    },
    "delete": {
      "comment": "Verb on the button that confirms deleting the item an alert names (a channel, a server, an entry). Destructive.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete"
          }
        },
        "hu": {
          "stringUnit": {
