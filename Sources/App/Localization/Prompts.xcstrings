          }
        }
      }
    },
    "do-not-ask-me-again": {
      "comment": "Label of the suppression checkbox on an alert that has no wording of its own; matches the standard macOS phrasing.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Do not ask me again"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne kérdezze újra"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht erneut fragen"
          }
        }
      }
    },
    "do-not-show-this-message-again": {
      "comment": "Legacy key: 68u-z9.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Do not show this message again"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne jelenjen meg újra ez az üzenet"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Meldung nicht mehr anzeigen"
          }
        }
      }
    },
    "do-you-want-to-delete-named": {
      "comment": "Confirmation title for deleting the selected connection or channel; %@ is its name. Consolidates the identical legacy i8o-7z entry. Legacy key: 0kz-wd.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Do you want to delete “%@”?"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Törlöd ezt: \"%@\"?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Möchtest du \"%@\" löschen?"
          }
        }
      }
    },
    "encryption-with-a-digital-certificate-keeps": {
      "comment": "Legacy key: ihy-mz.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Encryption with a digital certificate keeps information private as it’s sent to or from the server “%1$@”"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A digitális tanúsítvánnyal végzett titkosítás megvédi a(z) \"%1$@\" kiszolgálóval váltott adatokat"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Verschlüsselung mit einem digitalen Zertifikat schützt die Daten beim Austausch mit dem Server \"%1$@\""
          }
        }
      }
    },
    "encryption-with-a-digital-certificate-keeps-information": {
      "comment": "Legacy key: iun-45.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Encryption with a digital certificate keeps information private as it’s sent to or from the server “%1$@”\n\nInformation encrypted using: %2$@"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A digitális tanúsítvánnyal végzett titkosítás megvédi a(z) \"%1$@\" kiszolgálóval váltott adatokat\n\nAz adatok titkosítása: %2$@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Verschlüsselung mit einem digitalen Zertifikat schützt die Daten beim Austausch mit dem Server \"%1$@\"\n\nVerwendete Verschlüsselung: %2$@"
          }
        }
      }
    },
    "generic-acknowledgement-button-title-ok": {
      "comment": "Generic acknowledgement button title. Consolidates the identical legacy u5k-9n entry. Legacy key: c7s-dq.",
      "extractionState": "manual",
