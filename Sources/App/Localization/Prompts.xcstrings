        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sair sem salvar"
          }
        }
      }
    },
    "keychain-save-failed-title": {
      "comment": "Title shown when saving or deleting a password in the keychain failed. Pending settings edits remain available for retry.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Passwords could not be saved"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nem sikerült menteni a jelszavakat"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Passwörter konnten nicht gesichert werden"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron guardar las contraseñas"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les mots de passe n’ont pas pu être enregistrés"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パスワードを保存できませんでした"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível salvar as senhas"
          }
        }
      }
    },
