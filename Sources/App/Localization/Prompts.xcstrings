    "could-not-open-saved-conversation-history": {
      "comment": "Title of the alert shown when the saved conversation history could not be opened. Legacy key: h99-3q.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Glasstual could not open your saved conversation history. Please report this problem at https://github.com/vakesz/Glasstual/issues"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Glasstual nem tudta megnyitni a mentett beszélgetési előzményeket. Jelentsd a hibát itt: https://github.com/vakesz/Glasstual/issues"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Glasstual konnte deinen gespeicherten Gesprächsverlauf nicht öffnen. Bitte melde das Problem unter https://github.com/vakesz/Glasstual/issues"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Glasstual no pudo abrir su historial de conversaciones guardado. Por favor, informe de este problema en https://github.com/vakesz/Glasstual/issues"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Glasstual n'a pas pu ouvrir votre historique de conversations enregistrées. Veuillez signaler ce problème à https://github.com/vakesz/Glasstual/issues."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Glasstualでは、保存済みの会話履歴を開けられませんでした。この問題はhttps://github.com/vakesz/Glasstual/issuesで報告してください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Glasstual não pôde abrir seu histórico de conversas salvado. Por favor, reporte este problema em https://github.com/vakesz/Glasstual/issues"
          }
        }
      }
    },
