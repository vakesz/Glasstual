{
  "sourceLanguage": "en",
  "strings": {
    "action-title-for-accepting-accept": {
      "comment": "Action title for accepting an incoming file transfer or direct chat (DCC CHAT) request. Consolidates the identical legacy dcc-c4 entry. Legacy key: qpv-go.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Accept"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Elfogadás"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Annehmen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aceptar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "accepter"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "受け入れる"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "aceitar"
          }
        }
      }
    },
    "are-you-sure-you-want-to-open-the-file-named": {
      "comment": "Legacy key: xfl-8e.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Are you sure you want to open the file named “%@” with Glasstual?"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Biztosan megnyitod a(z) \"%@\" fájlt a Glasstuallal?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Möchtest du die Datei \"%@\" wirklich mit Glasstual öffnen?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "¿Estás seguro de que quieres abrir el archivo llamado “%@” con Glasstual?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Êtes-vous sûr de vouloir ouvrir le fichier nommé « %@ » avec Glasstual ?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "「%@」という名前のファイルを「Glasstual」で開きたいですか？"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Você tem certeza de que quer abrir o arquivo chamado \"%@\" com Glasstual?"
          }
        }
      }
    },
    "are-you-sure-you-want-to-quit-glasstual": {
      "comment": "Legacy key: 6vj-2p.",
      "extractionState": "manual",
      "localizations": {
