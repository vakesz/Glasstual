    "there-is-no-undo-and-all": {
      "comment": "Legacy key: 516-ms.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All data related to this channel, except for logs, will be erased. This action cannot be undone."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A naplók kivételével a csatornához tartozó összes adat törlődik. Ez a művelet nem vonható vissza."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Daten dieses Kanals außer den Protokollen werden gelöscht. Diese Aktion kann nicht rückgängig gemacht werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se borrarán todos los datos relacionados con este canal, excepto los registros. Esta acción no se puede deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toutes les données associées à ce canal, à l’exception des journaux, seront effacées. Cette action est irréversible."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このチャンネルに関連するログ以外のすべてのデータが消去されます。この操作は取り消せません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos os dados relacionados a este canal, exceto os registros, serão apagados. Esta ação não pode ser desfeita."
          }
        }
      }
    },
