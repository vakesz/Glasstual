    "encryption-with-a-digital-certificate-keeps": {
      "comment": "Legacy key: ihy-mz.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Encryption with a digital certificate keeps information private as it’s sent to or from the server “%1$@”"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A digitális tanúsítvánnyal végzett titkosítás megvédi a(z) \"%1$@\" kiszolgálóval váltott adatokat"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Verschlüsselung mit einem digitalen Zertifikat schützt die Daten beim Austausch mit dem Server \"%1$@\""
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "El cifrado con un certificado digital mantiene la información privada mientras se envía a o desde el servidor \"%1$@\"."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le chiffrement avec un certificat numérique maintient les informations privées lorsqu'elles sont envoyées vers ou depuis le serveur « %1$@ »."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "デジタル証明書による暗号化により、「%1$@」サーバーへの送信または受信時に情報が機密保持されます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A criptografia com um certificado digital mantém as informações privadas enquanto são enviadas para ou a partir do servidor \"%1$@\"."
          }
        }
      }
    },
