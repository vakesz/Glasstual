            "state": "translated",
            "value": "Salir sin guardar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quitter sans enregistrer"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存せずに終了"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sair sem salvar"
          }
        }
      }
    },
