{
  "sourceLanguage": "en",
  "strings": {
    "action-title-for-accepting-accept": {
      "comment": "Action title for accepting an incoming file transfer or direct chat (DCC CHAT) request. Consolidates the identical legacy dcc-c4 entry. Legacy key: qpv-go.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Accept"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Elfogadás"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Annehmen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aceptar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Accepter"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "許可"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aceitar"
          }
        }
      }
    },
    "are-you-sure-you-want-to-quit-glasstual": {
      "comment": "Legacy key: 6vj-2p.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Are you sure you want to quit Glasstual?"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Biztosan kilépsz a Glasstualból?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Möchtest du Glasstual wirklich beenden?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Seguro que quieres salir de Glasstual?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Voulez-vous vraiment quitter Glasstual ?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Glasstualを終了してもよろしいですか？"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tem certeza de que deseja sair do Glasstual?"
          }
        }
      }
    },
