    "connection-named-is-already-configured": {
      "comment": "Legacy key: a9z-9f.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The connection named “%1$@” is already configured to connect to this server address.\n\nDo you want to add these channels to that connection or would you rather create a new connection?"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A(z) \"%1$@\" kapcsolat már ehhez a kiszolgálócímhez van beállítva.\n\nEhhez a kapcsolathoz adod hozzá ezeket a csatornákat, vagy új kapcsolatot hozol létre?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Verbindung \"%1$@\" ist bereits für diese Serveradresse eingerichtet.\n\nMöchtest du diese Kanäle zu dieser Verbindung hinzufügen oder eine neue Verbindung erstellen?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La conexión llamada «%1$@» ya está configurada para conectarse a esta dirección de servidor.\n\n¿Quieres añadir estos canales a esa conexión o prefieres crear una nueva?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La connexion nommée « %1$@ » est déjà configurée pour se connecter à cette adresse de serveur.\n\nVoulez-vous ajouter ces canaux à cette connexion ou préférez-vous créer une nouvelle connexion ?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%1$@」という接続は、すでにこのサーバアドレスに接続するように設定されています。\n\nこれらのチャンネルをその接続に追加しますか？それとも新しい接続を作成しますか？"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A conexão chamada “%1$@” já está configurada para se conectar a este endereço de servidor.\n\nDeseja adicionar esses canais a essa conexão ou prefere criar uma nova conexão?"
          }
        }
      }
    },
    "connection-named-is-already-configured-to-connect-to": {
      "comment": "Legacy key: mx1-qz.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The connection named “%1$@” is already configured to connect to this server address.\n\nDo you want to add this channel to that connection or would you rather create a new connection?"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A(z) \"%1$@\" kapcsolat már ehhez a kiszolgálócímhez van beállítva.\n\nEhhez a kapcsolathoz adod hozzá ezt a csatornát, vagy új kapcsolatot hozol létre?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Verbindung \"%1$@\" ist bereits für diese Serveradresse eingerichtet.\n\nMöchtest du diesen Kanal zu dieser Verbindung hinzufügen oder eine neue Verbindung erstellen?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La conexión llamada «%1$@» ya está configurada para conectarse a esta dirección de servidor.\n\n¿Quieres añadir este canal a esa conexión o prefieres crear una nueva?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La connexion nommée « %1$@ » est déjà configurée pour se connecter à cette adresse de serveur.\n\nVoulez-vous ajouter ce canal à cette connexion ou préférez-vous créer une nouvelle connexion ?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%1$@」という接続は、すでにこのサーバアドレスに接続するように設定されています。\n\nこのチャンネルをその接続に追加しますか？それとも新しい接続を作成しますか？"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A conexão chamada “%1$@” já está configurada para se conectar a este endereço de servidor.\n\nDeseja adicionar este canal a essa conexão ou prefere criar uma nova conexão?"
          }
        }
      }
    },
