          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten en cuenta que no se pueden importar los siguientes elementos: complementos personalizados, ubicación de descarga de transferencias de archivos, ubicación de los registros y contraseñas."
          }
        },
