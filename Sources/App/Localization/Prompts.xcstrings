    "certificate-for-this-server-is-invalid": {
      "comment": "Legacy key: 85z-qw.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The certificate for this server is invalid. You might be connecting to a server that is pretending to be “%@”, which could put your confidential information at risk. Would you like to connect to the server anyway?"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A kiszolgáló tanúsítványa érvénytelen. Lehet, hogy egy olyan kiszolgálóhoz kapcsolódsz, amely \"%@\" néven adja ki magát, és veszélyeztetheti a bizalmas adataidat. Ennek ellenére is csatlakozni szeretnél?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Zertifikat dieses Servers ist ungültig. Möglicherweise verbindest du dich mit einem Server, der sich als \"%@\" ausgibt und deine vertraulichen Daten gefährdet. Möchtest du dich trotzdem verbinden?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El certificado de este servidor no es válido. Es posible que te estés conectando a un servidor que se hace pasar por «%@», lo que podría poner en riesgo tu información confidencial. ¿Quieres conectarte al servidor de todos modos?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le certificat de ce serveur n’est pas valide. Vous vous connectez peut-être à un serveur qui se fait passer pour « %@ », ce qui pourrait mettre en danger vos informations confidentielles. Voulez-vous tout de même vous connecter au serveur ?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このサーバの証明書は無効です。「%@」になりすましているサーバに接続している可能性があり、機密情報が危険にさらされるおそれがあります。それでもサーバに接続しますか？"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O certificado deste servidor é inválido. Você pode estar se conectando a um servidor que finge ser “%@”, o que pode colocar suas informações confidenciais em risco. Deseja conectar ao servidor mesmo assim?"
          }
        }
      }
    },
    "certificate-was-not-trusted": {
      "comment": "Legacy key: k3t-vq.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\nThe certificate was not trusted by the system: %@"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\nA rendszer nem bízik meg a tanúsítványban: %@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\nDas System vertraut dem Zertifikat nicht: %@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\nEl sistema no confía en el certificado: %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\nLe certificat n’est pas approuvé par le système : %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\nこの証明書はシステムに信頼されませんでした: %@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\nO certificado não foi considerado confiável pelo sistema: %@"
          }
        }
      }
    },
