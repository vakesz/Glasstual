          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos os dados relacionados a este servidor, exceto os registros, serão apagados. Esta ação não pode ser desfeita."
          }
        }
      }
    },
    "there-is-no-undo-and-all-data-related": {
      "comment": "Legacy key: 61s-jc.",
      "extractionState": "manual",
      "localizations": {
