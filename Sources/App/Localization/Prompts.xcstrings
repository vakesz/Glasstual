    "direct-chat-request": {
      "comment": "Direct chat (DCC CHAT) request. Legacy key: dcc-c3.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Direct chat request from %@"
          }
        },
