          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Möchtest du Glasstual wirklich beenden?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Seguro que quieres salir de Glasstual?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Voulez-vous vraiment quitter Glasstual ?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Glasstualを終了してもよろしいですか？"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tem certeza de que deseja sair do Glasstual?"
          }
        }
      }
    },
