    "glasstual-cant-verify-the-identity": {
      "comment": "Legacy key: m8b-58.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Glasstual can’t verify the identity of the server “%@”"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Glasstual nem tudja ellenőrizni a(z) \"%@\" kiszolgáló személyazonosságát"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Glasstual kann die Identität des Servers \"%@\" nicht überprüfen"
          }
        }
      }
    },
    "glasstual-is-unable-to-access": {
      "comment": "Alert title shown when the saved security-scoped bookmark for the log folder no longer resolves. Legacy key: 6ep-0d.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Glasstual can no longer reach the folder set as its log location."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Glasstual már nem éri el a naplózás célmappáját."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Glasstual kann den als Protokollspeicherort festgelegten Ordner nicht mehr erreichen."
          }
        }
      }
    },
    "glasstual-is-using-an-encrypted-connection": {
