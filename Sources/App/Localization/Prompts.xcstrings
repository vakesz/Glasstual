    "drop-send-body": {
      "comment": "Body of the sheet that confirms sending dropped files. The argument is the recipient.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ will be asked to accept the transfer."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kérést kap az átvitel elfogadására."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ wird gebeten, die Übertragung anzunehmen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se pedirá a %@ que acepte la transferencia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ devra accepter le transfert."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@に、転送の承認が求められます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ receberá uma solicitação para aceitar a transferência."
          }
        }
      }
    },
