    "credentials-unverified-certificate-title" : {
      "comment" : "Title of the alert asking whether to send the account password to a server whose certificate was not checked because certificate checking is turned off for the network.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Send your password to an unverified server?"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Elküldi a jelszavát egy nem ellenőrzött kiszolgálónak?"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Passwort an einen ungeprüften Server senden?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "¿Enviar la contraseña a un servidor sin verificar?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Envoyer votre mot de passe à un serveur non vérifié ?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "検証されていないサーバにパスワードを送信しますか?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Enviar sua senha a um servidor não verificado?"
          }
        }
      }
    },
    "credentials-withheld-over-plaintext" : {
      "comment" : "Console notice, printed at most once per connection, when the client refuses to send the account password (SASL PLAIN or a NickServ IDENTIFY) because a connection that was meant to be encrypted is not.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The account password was not sent: this connection was expected to be encrypted but is not."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A fiók jelszava nem lett elküldve: ennek a kapcsolatnak titkosítottnak kellett volna lennie, de nem az."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Kontopasswort wurde nicht gesendet: Diese Verbindung sollte verschlüsselt sein, ist es aber nicht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La contraseña de la cuenta no se envió: se esperaba que esta conexión estuviera cifrada, pero no lo está."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le mot de passe du compte n’a pas été envoyé : cette connexion devait être chiffrée, mais ne l’est pas."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アカウントのパスワードは送信されませんでした。この接続は暗号化されている必要がありますが、暗号化されていません。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A senha da conta não foi enviada: esta conexão deveria estar criptografada, mas não está."
          }
        }
      }
    },
    "credentials-withheld-unconfigured-host" : {
      "comment" : "Console notice when the connection goes to a host that is not one of the network's configured servers, for example a server-sent redirect, so the account password is not sent to it. %1$@ is the host.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The account password will not be sent to %1$@: it is not one of this network's configured servers."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A fiók jelszava nem lesz elküldve ide: %1$@. Nem tartozik a hálózat beállított kiszolgálói közé."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Kontopasswort wird nicht an %1$@ gesendet: Dieser Server gehört nicht zu den konfigurierten Servern dieses Netzwerks."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La contraseña de la cuenta no se enviará a %1$@: no es uno de los servidores configurados de esta red."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le mot de passe du compte ne sera pas envoyé à %1$@ : ce n’est pas l’un des serveurs configurés pour ce réseau."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アカウントのパスワードは%1$@に送信されません。このネットワークに設定されたサーバではありません。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A senha da conta não será enviada para %1$@: esse não é um dos servidores configurados desta rede."
          }
        }
      }
    },
    "credentials-withheld-unverified-certificate" : {
      "comment" : "Console notice, printed at most once per connection, when the client does not send the account password (SASL PLAIN or a NickServ IDENTIFY) because the server's certificate was not verified and the user did not allow it.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The account password was not sent: this server’s certificate was not verified."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "A fiók jelszava nem lett elküldve: a kiszolgáló tanúsítványa nem lett ellenőrizve."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Das Kontopasswort wurde nicht gesendet: Das Zertifikat dieses Servers wurde nicht geprüft."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La contraseña de la cuenta no se envió: no se verificó el certificado de este servidor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Le mot de passe du compte n’a pas été envoyé : le certificat de ce serveur n’a pas été vérifié."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "アカウントのパスワードは送信されませんでした。このサーバの証明書は検証されていません。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "A senha da conta não foi enviada: o certificado deste servidor não foi verificado."
          }
        }
      }
    },
    "direct-chat-offer-refused-address" : {
      "comment" : "Console notice when a DCC CHAT offer names an address the client refuses to dial (loopback, a private network, a documentation range). %1$@ is the sender's nickname, %2$@ the address the offer named.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Refused a direct chat request from %1$@: %2$@ is not an address this client will connect to."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ közvetlen csevegési kérése elutasítva: a kliens nem kapcsolódik ehhez a címhez: %2$@."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Direkte Chatanfrage von %1$@ abgelehnt: Dieser Client stellt keine Verbindung zu %2$@ her."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se rechazó una solicitud de chat directo de %1$@: %2$@ no es una dirección a la que se conectará este cliente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Demande de discussion directe refusée de %1$@ : %2$@ n’est pas une adresse à laquelle ce client se connectera."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@からのダイレクトチャットのリクエストを拒否しました。%2$@は、このクライアントが接続するアドレスではありません。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pedido de chat direto de %1$@ recusado: %2$@ não é um endereço ao qual este cliente se conectará."
          }
        }
      }
    },
    "direct-chat-request-with-address" : {
      "comment" : "Body of the alert that asks whether to accept a DCC CHAT offer that names the address the client would dial. %1$@ is the sender's nickname, %2$@ the address. The sibling wants-to-start-a-direct-chat in Prompts.xcstrings is used for a passive offer, which names no address.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ wants to start a direct chat with you from %2$@. A direct chat is a connection between the two of you that does not go through the IRC server, so the other person will learn your IP address."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ közvetlen csevegést szeretne indítani veled erről a címről: %2$@. Ez közvetlen kapcsolat kettőtök között, amely nem az IRC-kiszolgálón keresztül zajlik, így a másik fél megismeri az IP-címedet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ möchte von %2$@ aus einen direkten Chat mit dir starten. Dabei entsteht eine direkte Verbindung zwischen euch, die nicht über den IRC-Server läuft. Die andere Person erfährt dadurch deine IP-Adresse."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ quiere iniciar un chat directo contigo desde %2$@. Un chat directo es una conexión entre los dos que no pasa por el servidor IRC, por lo que la otra persona conocerá tu dirección IP."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ souhaite démarrer une discussion directe avec vous depuis %2$@. Une discussion directe est une connexion entre vous deux qui ne passe pas par le serveur IRC ; l’autre personne connaîtra donc votre adresse IP."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@が、%2$@からダイレクトチャットを開始しようとしています。ダイレクトチャットは、IRCサーバを経由せず、あなたと相手との間で直接行う接続のため、相手にあなたのIPアドレスが知られます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ quer iniciar um chat direto com você a partir de %2$@. Um chat direto é uma conexão entre vocês dois que não passa pelo servidor IRC, portanto a outra pessoa saberá seu endereço IP."
          }
        }
      }
    },
    "file-transfer-offer-refused-crowded" : {
      "comment" : "Console notice when an incoming file transfer offer is dropped because the file transfer list already holds as many downloads as it will track. %@ is the sender's nickname.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ignored a file transfer offer from %@: too many downloads are listed already. Clear the finished ones and ask them to send it again."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ fájlátviteli ajánlata figyelmen kívül hagyva: már túl sok letöltés van a listában. Távolítsd el a befejezetteket, majd kérd a fájl újbóli küldését."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dateiangebot von %@ ignoriert: Es sind bereits zu viele Downloads aufgelistet. Entferne abgeschlossene Übertragungen und bitte um erneutes Senden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se ignoró una oferta de transferencia de archivos de %@: ya hay demasiadas descargas en la lista. Borra las finalizadas y pídele que la envíe de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Offre de transfert de fichier ignorée de %@ : trop de téléchargements sont déjà listés. Effacez ceux qui sont terminés et demandez à la personne de le renvoyer."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@からのファイル転送の申し出を無視しました。ダウンロードの一覧に項目が多すぎます。完了したものを消去してから、もう一度送信してもらってください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oferta de transferência de arquivo de %@ ignorada: já há downloads demais na lista. Limpe os concluídos e peça para a pessoa enviar novamente."
          }
        }
      }
    },
    "outgoing-line-refused-encoding" : {
      "comment" : "Console notice that a line the user typed was not sent, because the text encoding configured for this connection turned it into bytes the IRC protocol treats as line breaks or as the end of the line.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "An outgoing line was not sent, because this server’s text encoding would have split it into several lines."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Egy kimenő sor nem lett elküldve, mert a kiszolgálóhoz beállított szövegkódolás több sorra bontotta volna."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine ausgehende Zeile wurde nicht gesendet, weil die Textkodierung dieses Servers sie in mehrere Zeilen aufgeteilt hätte."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se envió una línea saliente porque la codificación de texto de este servidor la habría dividido en varias líneas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une ligne sortante n’a pas été envoyée, car l’encodage de texte de ce serveur l’aurait découpée en plusieurs lignes."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このサーバのテキストエンコーディングでは複数の行に分割されてしまうため、送信行を送信しませんでした。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma linha de saída não foi enviada porque a codificação de texto deste servidor a teria dividido em várias linhas."
          }
        }
      }
    },
    "outgoing-line-truncated" : {
      "comment" : "Console notice when a line this client was about to send was longer than the server accepts and had to be cut, so not all of what the user typed reached the server. %1$ld is the length of the assembled line in bytes, %2$ld how many bytes this server carries.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "An outgoing line of %1$ld bytes was trimmed to the %2$ld this server accepts; the rest was not sent."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Egy %1$ld bájtos kimenő sor a kiszolgáló által elfogadott %2$ld bájtra lett rövidítve; a többi nem lett elküldve."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine ausgehende Zeile mit %1$ld Byte wurde auf die vom Server akzeptierten %2$ld Byte gekürzt. Der Rest wurde nicht gesendet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una línea saliente de %1$ld bytes se recortó a %2$ld, el máximo que acepta este servidor; el resto no se envió."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une ligne sortante de %1$ld octets a été tronquée à %2$ld octets, la limite acceptée par ce serveur ; le reste n’a pas été envoyé."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "送信行(%1$ldバイト)を、このサーバが受け付ける%2$ldバイトに切り詰めました。残りは送信されませんでした。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma linha de saída de %1$ld bytes foi reduzida para os %2$ld que este servidor aceita; o restante não foi enviado."
          }
        }
      }
    },
    "outgoing-unprinted-lines-held-back" : {
      "comment" : "Console notice when a /smsg, /sme or silent connect command stops part way: so many of the lines it already sent are still waiting for the server's echo that the client could no longer keep the next one's echo out of the transcript, so it sent nothing more.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The rest of the message was not sent: too many lines sent without being shown are still waiting for the server to echo them."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Az üzenet többi része nem lett elküldve: túl sok megjelenítés nélkül elküldött sor vár még arra, hogy a kiszolgáló visszaküldje."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Der Rest der Nachricht wurde nicht gesendet: Zu viele ohne Anzeige gesendete Zeilen warten noch darauf, dass der Server sie zurücksendet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "El resto del mensaje no se envió: demasiadas líneas enviadas sin mostrarse siguen esperando a que el servidor las devuelva."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Le reste du message n’a pas été envoyé : trop de lignes envoyées sans être affichées attendent encore que le serveur les renvoie."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "メッセージの残りは送信されませんでした。表示せずに送信した行のうち、サーバからのエコーを待っているものが多すぎます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "O restante da mensagem não foi enviado: linhas demais enviadas sem serem exibidas ainda aguardam que o servidor as devolva."
          }
        }
      }
    },
    "sasl-authentication-timed-out" : {
      "comment" : "Console notice when the server acknowledged the SASL capability and then never answered the authentication exchange, so the client gave up on it and finished registering.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The server did not answer the SASL authentication request in time."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A kiszolgáló nem válaszolt időben a SASL-hitelesítési kérésre."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Server hat nicht rechtzeitig auf die SASL-Authentifizierungsanfrage geantwortet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El servidor no respondió a la solicitud de autenticación SASL a tiempo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le serveur n’a pas répondu à la demande d’authentification SASL dans les délais."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サーバがSASL認証リクエストに時間内に応答しませんでした。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O servidor não respondeu ao pedido de autenticação SASL a tempo."
          }
        }
      }
    },
    "sasl-credentials-contain-a-null-character" : {
      "comment" : "Console notice when the configured SASL user name or password contains a U+0000 character. SASL PLAIN separates its fields with that character, so a field containing one cannot be sent.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The SASL user name or password contains a null character, which cannot be sent."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A SASL-felhasználónév vagy -jelszó nullkaraktert tartalmaz, amely nem küldhető el."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der SASL-Benutzername oder das Passwort enthält ein Nullzeichen, das nicht gesendet werden kann."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El nombre de usuario o contraseña SASL contiene un carácter nulo, que no se puede enviar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le nom d’utilisateur ou le mot de passe SASL contient un caractère nul, qui ne peut pas être envoyé."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SASLのユーザ名またはパスワードにヌル文字が含まれているため、送信できません。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O nome de usuário ou a senha SASL contém um caractere nulo, que não pode ser enviado."
          }
        }
      }
    },
    "sasl-ecdsa-challenge-invalid" : {
      "comment" : "Console notice when the challenge of a SASL ECDSA exchange was not valid base64, had the wrong length or arrived out of order, so the exchange was abandoned.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SASL ECDSA authentication failed because the server sent an unusable challenge."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A SASL ECDSA-hitelesítés sikertelen, mert a kiszolgáló használhatatlan kihívást küldött."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die SASL-ECDSA-Authentifizierung ist fehlgeschlagen, weil der Server eine unbrauchbare Challenge gesendet hat."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La autenticación SASL ECDSA falló porque el servidor envió un desafío inutilizable."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’authentification SASL ECDSA a échoué : le serveur a envoyé un défi inutilisable."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サーバが使用できないチャレンジを送信したため、SASL ECDSA認証に失敗しました。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A autenticação SASL ECDSA falhou porque o servidor enviou um desafio inválido."
          }
        }
      }
    },
    "sasl-ecdsa-key-unavailable" : {
      "comment" : "Console notice when SASL ECDSA was chosen but its signing key was missing or unreadable in the Keychain, so the exchange was abandoned.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SASL ECDSA authentication failed because the signing key could not be read from the Keychain."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A SASL ECDSA-hitelesítés sikertelen, mert az aláírókulcs nem olvasható a Kulcskarikából."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die SASL-ECDSA-Authentifizierung ist fehlgeschlagen, weil der Signaturschlüssel nicht aus dem Schlüsselbund gelesen werden konnte."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La autenticación SASL ECDSA falló porque no se pudo leer la clave de firma del llavero."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’authentification SASL ECDSA a échoué : la clé de signature n’a pas pu être lue dans le trousseau."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "署名鍵をキーチェーンから読み取れなかったため、SASL ECDSA認証に失敗しました。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A autenticação SASL ECDSA falhou porque não foi possível ler a chave de assinatura do chaveiro."
          }
        }
      }
    }
  },
  "version" : "1.0"
}
