{
  "sourceLanguage" : "en",
  "strings" : {
    "sasl-oauth-token-rejected" : {
      "comment" : "Console line when the server refuses the SASL OAUTHBEARER token. %@ is the error status the server reported, such as invalid_token; it is not translated.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The server rejected the OAuth token (%@)."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A kiszolgáló elutasította az OAuth-tokent (%@)."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Server hat das OAuth-Token abgelehnt (%@)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El servidor rechazó el token de OAuth (%@)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le serveur a refusé le jeton OAuth (%@)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サーバがOAuthトークンを拒否しました（%@）。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O servidor rejeitou o token OAuth (%@)."
          }
        }
      }
    },
    "sasl-oauth-token-rejected-without-status" : {
      "comment" : "Console line when the server refuses the SASL OAUTHBEARER token without a readable reason.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The server rejected the OAuth token."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A kiszolgáló elutasította az OAuth-tokent."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Server hat das OAuth-Token abgelehnt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El servidor rechazó el token de OAuth."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le serveur a refusé le jeton OAuth."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サーバがOAuthトークンを拒否しました。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O servidor rejeitou o token OAuth."
          }
        }
      }
    },
    "sasl-oauth-requires-tls" : {
      "comment" : "Console line when SASL OAUTHBEARER would run on an unencrypted connection; the token is not sent.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The OAuth token is only sent over a TLS connection, so it wasn’t sent."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az OAuth-token csak TLS-kapcsolaton keresztül kerül elküldésre, ezért nem lett elküldve."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das OAuth-Token wird nur über eine TLS-Verbindung gesendet und wurde daher nicht gesendet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El token de OAuth solo se envía mediante una conexión TLS, así que no se envió."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le jeton OAuth n’est envoyé que par une connexion TLS ; il n’a donc pas été envoyé."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OAuthトークンはTLS接続でのみ送信されるため、送信しませんでした。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O token OAuth só é enviado por uma conexão TLS, por isso não foi enviado."
          }
        }
      }
    },
    "sasl-oauth-exchange-invalid" : {
      "comment" : "Console line when the server's half of the SASL OAUTHBEARER exchange does not follow RFC 7628.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SASL OAuth sign-in failed: the server’s reply wasn’t part of the exchange."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A SASL OAuth-bejelentkezés sikertelen: a kiszolgáló válasza nem volt része a cserének."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SASL-OAuth-Anmeldung fehlgeschlagen: Die Antwort des Servers gehörte nicht zum Austausch."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Error al iniciar sesión con SASL OAuth: la respuesta del servidor no formaba parte del intercambio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Échec de la connexion SASL OAuth : la réponse du serveur ne faisait pas partie de l’échange."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SASL OAuthのサインインに失敗しました：サーバの応答が交換の一部ではありませんでした。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Falha no início de sessão SASL OAuth: a resposta do servidor não fazia parte da troca."
          }
        }
      }
    },
    "credentials-changed-certificate-body" : {
      "comment" : "Body of the alert asking whether to send the account password to a server whose certificate is not checked, shown instead of the usual body when the user allowed this host before and it now presents a different certificate. %1$@ is the server's host name.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ is presenting a different certificate from the one it had when you allowed your password to be sent. Its certificate is still not checked, because certificate checking is turned off for this network. Someone else may be answering at this address."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "A(z) %1$@ más tanúsítványt mutat be, mint amikor engedélyezte a jelszava elküldését. A tanúsítványa továbbra sincs ellenőrizve, mert a tanúsítványellenőrzés ki van kapcsolva ennél a hálózatnál. Lehet, hogy valaki más válaszol ezen a címen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%1$@ zeigt ein anderes Zertifikat als damals, als Sie das Senden Ihres Passworts erlaubt haben. Das Zertifikat wird weiterhin nicht geprüft, weil die Zertifikatsprüfung für dieses Netzwerk ausgeschaltet ist. Möglicherweise antwortet jemand anderes unter dieser Adresse."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%1$@ presenta un certificado distinto del que tenía cuando permitió enviar su contraseña. Su certificado sigue sin comprobarse porque la comprobación de certificados está desactivada para esta red. Es posible que otra persona esté respondiendo en esta dirección."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%1$@ présente un certificat différent de celui qu’il avait lorsque vous avez autorisé l’envoi de votre mot de passe. Son certificat n’est toujours pas vérifié, car la vérification des certificats est désactivée pour ce réseau. Quelqu’un d’autre répond peut-être à cette adresse."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%1$@は、パスワードの送信を許可したときとは異なる証明書を提示しています。このネットワークでは証明書の検証がオフになっているため、この証明書も検証されていません。別の誰かがこのアドレスで応答している可能性があります。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%1$@ está apresentando um certificado diferente daquele que tinha quando você permitiu o envio da sua senha. O certificado continua sem verificação, porque a verificação de certificados está desativada para esta rede. Outra pessoa pode estar respondendo neste endereço."
          }
        }
      }
    },
    "credentials-unverified-certificate-body" : {
      "comment" : "Body of the alert asking whether to send the account password (SASL PLAIN or a NickServ IDENTIFY) to a server whose certificate was not checked because certificate checking is turned off for the network. %1$@ is the server's host name.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The certificate of %1$@ was not checked, because certificate checking is turned off for this network. Your account password would be sent to the server without proof that it is the real %1$@."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "A(z) %1$@ tanúsítványa nem lett ellenőrizve, mert a tanúsítványellenőrzés ki van kapcsolva ennél a hálózatnál. A fiók jelszava úgy kerülne elküldésre, hogy nincs bizonyíték arra, hogy a kiszolgáló valóban a(z) %1$@."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Das Zertifikat von %1$@ wurde nicht geprüft, weil die Zertifikatsprüfung für dieses Netzwerk ausgeschaltet ist. Ihr Kontopasswort würde gesendet, ohne dass belegt ist, dass der Server wirklich %1$@ ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "El certificado de %1$@ no se comprobó porque la comprobación de certificados está desactivada para esta red. Su contraseña de cuenta se enviaría al servidor sin garantía de que sea realmente %1$@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Le certificat de %1$@ n’a pas été vérifié, car la vérification des certificats est désactivée pour ce réseau. Le mot de passe de votre compte serait envoyé au serveur sans preuve qu’il s’agit bien de %1$@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "このネットワークでは証明書の検証がオフになっているため、%1$@の証明書は検証されていません。このサーバが本物の%1$@であるという証明がないまま、アカウントのパスワードが送信されます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "O certificado de %1$@ não foi verificado, porque a verificação de certificados está desativada para esta rede. A senha da sua conta seria enviada ao servidor sem prova de que ele é mesmo %1$@."
          }
        }
      }
    },
    "credentials-unverified-certificate-dont-send" : {
