            "state" : "translated",
            "value" : "Saisissez un nom réel sur une seule ligne."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本名は1行で入力してください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Digite um nome real em uma linha."
          }
        }
      }
    },
