    "nickname-invalid" : {
      "comment" : "Validation error for an invalid IRC nickname. Migrated from legacy key och-j5.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A nickname can contain letters, digits and - [ ] \\ ` _ ^ { | } and cannot start with a digit."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A becenév betűket, számjegyeket és a - [ ] \\ ` _ ^ { | } karaktereket tartalmazhatja, és nem kezdődhet számjeggyel."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Nickname darf Buchstaben, Ziffern und - [ ] \\ ` _ ^ { | } enthalten und nicht mit einer Ziffer beginnen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Un apodo puede contener letras, dígitos y - [ ] \\ ` _ ^ { | } y no puede comenzar con un dígito."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Un surnom peut contenir des lettres, des chiffres et - [ ] \\ ` _ ^ { | } et ne peut pas commencer par un chiffre."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ニックネームには文字、数字、- [ ] \\ ` _ ^ { | }が含まれ、数字で始まらないでください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Um apelido pode conter letras, números e - [ ] \\ ` _ ^ { | } e não pode começar com um número."
          }
        }
      }
    },
    "real-name-invalid" : {
      "comment" : "Validation error shown beside the real name field, in the server properties Identity pane and on the onboarding identity step, when the name is empty or spans more than one line. Legacy key: agy-bp.",
