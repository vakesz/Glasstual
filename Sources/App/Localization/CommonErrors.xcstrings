    "internet-port-invalid" : {
      "comment" : "Validation error for an invalid internet port. Migrated from legacy key l0c-nb.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enter a whole number between 1 and 65,535."
          }
