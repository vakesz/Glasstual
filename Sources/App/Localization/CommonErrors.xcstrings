      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enter a real name on one line."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add meg a valódi nevedet egy sorban."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gib deinen echten Namen in einer Zeile ein."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Introduce un nombre real en una sola línea."
          }
        },
        "fr" : {
