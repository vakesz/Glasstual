// Base.xcconfig
//
// Settings shared by every target in Glasstual.xcodeproj. Per-configuration
// overrides live in Debug.xcconfig / Release.xcconfig; signing lives in
// Signing.xcconfig. Target-specific metadata (product name, bundle id,
// Info.plist, entitlements) lives in project.yml.

// ---- Product identity -----------------------------------------------------

GLASSTUAL_PRODUCT_NAME = Glasstual
GLASSTUAL_BUNDLE_IDENTIFIER = com.vakesz.glasstual
GLASSTUAL_GROUP_CONTAINER_IDENTIFIER = group.$(DEVELOPMENT_TEAM).$(GLASSTUAL_BUNDLE_IDENTIFIER)

// Fallback version. Scripts/UpdateVersion.sh (run as a scheme pre-action)
// writes Version.generated.xcconfig with CURRENT_PROJECT_VERSION derived
// from the date of the last git commit; that file is included at the bottom.
MARKETING_VERSION = 1.0.2
CURRENT_PROJECT_VERSION = 0

// The generated BuildConfig.h is written here by the BuildConfig aggregate
// target. Every target that includes it depends on that target.
GLASSTUAL_BUILD_HEADERS_DIR = $(BUILT_PRODUCTS_DIR)/GlasstualBuildHeaders
HEADER_SEARCH_PATHS = $(inherited) "$(GLASSTUAL_BUILD_HEADERS_DIR)"

// ---- Platform -------------------------------------------------------------

SDKROOT = macosx
MACOSX_DEPLOYMENT_TARGET = 26.0
ARCHS = arm64
ONLY_ACTIVE_ARCH = YES
VALID_ARCHS = arm64

// ---- Languages ------------------------------------------------------------

GCC_C_LANGUAGE_STANDARD = gnu17
CLANG_CXX_LANGUAGE_STANDARD = gnu++20
CLANG_ENABLE_MODULES = YES
CLANG_ENABLE_OBJC_ARC = YES
CLANG_ENABLE_OBJC_WEAK = YES
GCC_ENABLE_OBJC_EXCEPTIONS = YES
ENABLE_STRICT_OBJC_MSGSEND = YES
GCC_NO_COMMON_BLOCKS = YES
DEFINES_MODULE = YES

SWIFT_VERSION = 6.0 // also set in project.yml; XcodeGen presets outrank xcconfig
SWIFT_STRICT_CONCURRENCY = complete
SWIFT_APPROACHABLE_CONCURRENCY = YES
SWIFT_UPCOMING_FEATURE_MEMBER_IMPORT_VISIBILITY = YES
SWIFT_INSTALL_OBJC_HEADER = NO
SWIFT_EMIT_LOC_STRINGS = YES

// ---- Warnings -------------------------------------------------------------

WARNING_CFLAGS = -Wall -Wextra -Wno-unused-parameter -Wobjc-circular-container -Winfinite-recursion
CLANG_WARN_ASSIGN_ENUM = YES
CLANG_WARN_ATOMIC_IMPLICIT_SEQ_CST = YES
CLANG_WARN_BLOCK_CAPTURE_AUTORELEASING = YES
CLANG_WARN_BOOL_CONVERSION = YES
CLANG_WARN_COMMA = YES
CLANG_WARN_CONSTANT_CONVERSION = YES
CLANG_WARN_DEPRECATED_OBJC_IMPLEMENTATIONS = YES
CLANG_WARN_DOCUMENTATION_COMMENTS = NO
CLANG_WARN_EMPTY_BODY = YES
CLANG_WARN_ENUM_CONVERSION = YES
CLANG_WARN_IMPLICIT_FALLTHROUGH = YES
CLANG_WARN_INFINITE_RECURSION = YES
CLANG_WARN_INT_CONVERSION = YES
CLANG_WARN_NON_LITERAL_NULL_CONVERSION = YES
CLANG_WARN_OBJC_IMPLICIT_RETAIN_SELF = YES
CLANG_WARN_OBJC_LITERAL_CONVERSION = YES
CLANG_WARN_QUOTED_INCLUDE_IN_FRAMEWORK_HEADER = YES
CLANG_WARN_RANGE_LOOP_ANALYSIS = YES
CLANG_WARN_SEMICOLON_BEFORE_METHOD_BODY = YES
CLANG_WARN_STRICT_PROTOTYPES = YES
CLANG_WARN_SUSPICIOUS_MOVE = YES
CLANG_WARN_UNGUARDED_AVAILABILITY = YES_AGGRESSIVE
CLANG_WARN_UNREACHABLE_CODE = YES
CLANG_WARN__DUPLICATE_METHOD_MATCH = YES
GCC_WARN_64_TO_32_BIT_CONVERSION = YES
GCC_WARN_ABOUT_DEPRECATED_FUNCTIONS = YES
GCC_WARN_ABOUT_MISSING_NEWLINE = YES
GCC_WARN_ABOUT_RETURN_TYPE = YES
GCC_WARN_TYPECHECK_CALLS_TO_PRINTF = YES
GCC_WARN_UNDECLARED_SELECTOR = YES
GCC_WARN_UNINITIALIZED_AUTOS = YES
GCC_WARN_UNUSED_FUNCTION = YES
GCC_WARN_UNUSED_LABEL = YES
GCC_WARN_UNUSED_VARIABLE = YES

// ---- Static analyzer ------------------------------------------------------

CLANG_ANALYZER_GCD_PERFORMANCE = YES
CLANG_ANALYZER_LOCALIZABILITY_NONLOCALIZED = YES
CLANG_ANALYZER_SECURITY_FLOATLOOPCOUNTER = YES
CLANG_ANALYZER_SECURITY_INSECUREAPI_RAND = YES
CLANG_ANALYZER_SECURITY_INSECUREAPI_STRCPY = YES
CLANG_STATIC_ANALYZER_MODE = deep
CLANG_USE_OPTIMIZATION_PROFILE = NO

// ---- Build behaviour ------------------------------------------------------

ALWAYS_SEARCH_USER_PATHS = NO
APPLY_RULES_IN_COPY_FILES = YES
ASSETCATALOG_COMPILER_GENERATE_SWIFT_ASSET_SYMBOL_EXTENSIONS = YES
COPY_PHASE_STRIP = NO
DEAD_CODE_STRIPPING = YES
DEBUG_INFORMATION_FORMAT = dwarf-with-dsym
ENABLE_MODULE_VERIFIER = YES
ENABLE_USER_SCRIPT_SANDBOXING = YES
GCC_GENERATE_DEBUGGING_SYMBOLS = YES
GENERATE_INFOPLIST_FILE = NO
LOCALIZATION_PREFERS_STRING_CATALOGS = NO
STRING_CATALOG_GENERATE_SYMBOLS = NO
REMOVE_HEADERS_FROM_EMBEDDED_BUNDLES = YES
ALWAYS_EMBED_SWIFT_STANDARD_LIBRARIES = NO
EXTRACT_APP_INTENTS_METADATA = NO
ENABLE_DEBUG_DYLIB = NO

LD_RUNPATH_SEARCH_PATHS = @loader_path/../Frameworks @executable_path/../Frameworks

// Security
ENABLE_HARDENED_RUNTIME = YES

#include "Signing.xcconfig"
#include? "Version.generated.xcconfig"
