
// Main application

GLASSTUAL_WORKSPACE_DIR = ${PROJECT_DIR}/../..

HEADER_SEARCH_PATHS = "${GLASSTUAL_WORKSPACE_TEMP_DIR}/Build Headers/" "${GLASSTUAL_WORKSPACE_DIR}/Sources/Shared/Headers/**"
FRAMEWORK_SEARCH_PATHS = "${GLASSTUAL_WORKSPACE_TEMP_DIR}/SharedBuildProducts-Frameworks/**" "${GLASSTUAL_WORKSPACE_DIR}/Frameworks/Static Libraries/Libraries"
LIBRARY_SEARCH_PATHS = "${GLASSTUAL_WORKSPACE_TEMP_DIR}/SharedBuildProducts-Frameworks/**" "${GLASSTUAL_WORKSPACE_DIR}/Frameworks/Static Libraries/Libraries"

PRODUCT_BUNDLE_IDENTIFIER = ${GLASSTUAL_BUNDLE_IDENTIFIER}

PRODUCT_NAME = ${GLASSTUAL_PRODUCT_NAME}

WRAPPER_EXTENSION = app

ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon

PRODUCT_MODULE_NAME = Glasstual

CONFIGURATION_BUILD_DIR = $(GLASSTUAL_WORKSPACE_DIR)/Build Results/$(CONFIGURATION)

GCC_PREFIX_HEADER = ${PROJECT_DIR}/Classes/Headers/Private/GlasstualPrivate.h

SWIFT_OBJC_BRIDGING_HEADER = ${PROJECT_DIR}/Classes/Headers/Private/SwiftBridgingHeaderPrivate.h
SWIFT_STRICT_CONCURRENCY = complete

// This Objective-C/Swift app does not declare App Intents. Avoid running the
// metadata processor and emitting a warning for a framework we do not link.
EXTRACT_APP_INTENTS_METADATA = NO

ALWAYS_EMBED_SWIFT_STANDARD_LIBRARIES = YES

REMOVE_HEADERS_FROM_EMBEDDED_BUNDLES = NO

INFOPLIST_FILE = ${GLASSTUAL_WORKSPACE_TEMP_DIR}/Info.plist

#include "Preserve Symbols.xcconfig"
