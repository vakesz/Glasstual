
// XPC services

// GLASSTUAL_WORKSPACE_DIR is replaced by the build script
GLASSTUAL_WORKSPACE_DIR = ${PROJECT_DIR}/../..

CONFIGURATION_BUILD_DIR = ${GLASSTUAL_WORKSPACE_TEMP_DIR}/SharedBuildProducts-XPCServices

CODE_SIGN_ENTITLEMENTS = ${GLASSTUAL_WORKSPACE_DIR}/Configurations/Sandbox/Inherited.entitlements

HEADER_SEARCH_PATHS = $(inherited) "${GLASSTUAL_WORKSPACE_TEMP_DIR}/Build Headers/" "${GLASSTUAL_WORKSPACE_DIR}/Sources/Shared/Headers/**"
LIBRARY_SEARCH_PATHS = $(inherited) "${GLASSTUAL_WORKSPACE_TEMP_DIR}/SharedBuildProducts-Frameworks/**" "${GLASSTUAL_WORKSPACE_DIR}/Frameworks/Static Libraries/Libraries"
FRAMEWORK_SEARCH_PATHS = $(inherited) "${GLASSTUAL_WORKSPACE_TEMP_DIR}/SharedBuildProducts-Frameworks/**" "${GLASSTUAL_WORKSPACE_DIR}/Frameworks/Static Libraries/Libraries"

WRAPPER_EXTENSION = xpc

GCC_PREPROCESSOR_DEFINITIONS = $(inherited) GLASSTUAL_BUILDING_XPC_SERVICE=1

// Link against frameworks in app itself rather than creating copies
// ./(self) ../(Contents) ../(.xpc bundle) ../(XPCServices) ../(Contents)
LD_RUNPATH_SEARCH_PATHS = $(inherited) @loader_path/../../../../Frameworks
