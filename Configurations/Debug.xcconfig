// Debug.xcconfig -- development builds.

#include "Base.xcconfig"

GLASSTUAL_BUILD_SCHEME_TOKEN = debug

GCC_OPTIMIZATION_LEVEL = 0
GCC_PREPROCESSOR_DEFINITIONS = $(inherited) DEBUG=1
SWIFT_ACTIVE_COMPILATION_CONDITIONS = $(inherited) DEBUG
SWIFT_OPTIMIZATION_LEVEL = -Onone
SWIFT_COMPILATION_MODE = singlefile

DEPLOYMENT_POSTPROCESSING = NO
ENABLE_NS_ASSERTIONS = YES
ENABLE_TESTABILITY = YES
VALIDATE_PRODUCT = NO

RUN_CLANG_STATIC_ANALYZER = NO

// Debug builds are signed with the local development identity only; hardened
// runtime would prevent attaching the debugger to the XPC services.
ENABLE_HARDENED_RUNTIME = NO
CODE_SIGN_INJECT_BASE_ENTITLEMENTS = YES
