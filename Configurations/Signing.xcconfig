// Signing.xcconfig
//
// The only file a contributor needs to edit to build Glasstual locally.
// Do not change signing through the Xcode target editor; the generated
// project is overwritten by `xcodegen generate`.
//
// Release builds in CI override these on the xcodebuild command line with a
// Developer ID identity and per-target provisioning profiles
// (GLASSTUAL_*_PROVISIONING_PROFILE, see .github/workflows/release.yml).

CODE_SIGN_STYLE = Automatic
CODE_SIGN_IDENTITY = Apple Development
DEVELOPMENT_TEAM = H8W5DK3FN2
PROVISIONING_PROFILE_SPECIFIER =

// Names of provisioning profiles used by manual (CI) signing. Empty means
// automatic signing.
GLASSTUAL_MAIN_PROVISIONING_PROFILE =
GLASSTUAL_IRC_PROVISIONING_PROFILE =
GLASSTUAL_SCROLLBACK_PROVISIONING_PROFILE =
GLASSTUAL_INLINE_CONTENT_PROVISIONING_PROFILE =
GLASSTUAL_CORE_MEDIA_PROVISIONING_PROFILE =
