# Fallback flags for clangd when compile_commands.json is absent
# (`make compile-commands` produces it). Objective-C with the app's prefix
# header so that headers parse on their own in the editor.
CompileFlags:
  Add:
    - -xobjective-c
    - -fobjc-arc
    - -fmodules
    - -fblocks
    - -std=gnu17
    - -isysroot
    - /Applications/Xcode.app/Contents/Developer/Platforms/MacOSX.platform/Developer/SDKs/MacOSX.sdk
    - -include
    - Sources/App/Classes/Headers/Private/GlasstualPrivate.h
    - -ISources/App/Classes/Headers
    - -ISources/App/Classes/Headers/Private
    - -ISources/App/Classes/Headers/Internal
    - -ISources/Shared/Headers
    # Framework headers come from the built products; run `make build` once.
    - -FDerivedData/Build/Products/Debug
    - -F/Applications/Xcode.app/Contents/Developer/Platforms/MacOSX.platform/Developer/SDKs/MacOSX.sdk/System/Library/Frameworks
Diagnostics:
  Suppress:
    - pp_file_not_found
