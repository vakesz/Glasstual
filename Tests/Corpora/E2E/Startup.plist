<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Connection -&gt; Confirm Quit</key><false/>
	<key>Logging -&gt; Reload Scrollback On Launch</key><true/>
	<key>File Transfers -&gt; Request Reply Action</key><integer>2</integer>
	<!-- FileTransferIPAddressSource.manual, so a DCC fixture offers the address
	     below instead of asking a router or a third party for one. -->
	<key>File Transfers -&gt; IP Address Detection Method</key><integer>3</integer>
	<key>File Transfers -&gt; Manually Entered IP Address</key><string>127.0.0.1</string>
	<key>Sessions -&gt; Server Sessions</key>
	<array><dict>
		<key>dictionaryVersion</key><integer>1</integer>
		<key>connectionName</key><string>E2E</string>
		<key>nickname</key><string>e2euser</string>
		<key>username</key><string>e2euser</string>
		<key>realName</key><string>Synthetic E2E User</string>
		<key>proxyType</key><integer>0</integer>
		<key>autoConnect</key><false/>
		<key>autoReconnect</key><false/>
		<key>validateServerCertificateChain</key><true/>
		<key>setInvisibleModeOnConnect</key><false/>
		<key>performPongTimer</key><false/>
		<key>performDisconnectOnReachabilityChange</key><false/>
		<key>normalLeavingComment</key><string>E2E_QUIT</string>
		<key>conversationList</key><array/>
	</dict></array>
</dict>
</plist>
